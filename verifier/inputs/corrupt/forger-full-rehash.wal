cal_id":"t22_o4","terms":["ferroptosis markers rise in I/R and OGD/R models"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"overexpression compromised baicalin-generated protective effect in H9c2 cells","kind":"observe","local_id":"t22_o6","terms":["ACSL4 overexpression blunts baicalin protection"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"baicalin prevents against myocardial ischemia/reperfusion injury via suppressing ACSL4-controlled ferroptosis","kind":"observe","local_id":"t22_o7","terms":["proposed mechanism: ACSL4-controlled ferroptosis"]},{"as_of":null,"based_on":["t22_o1"],"kind":"claim","local_id":"t22_c1","object":"myocardial ischemia/reperfusion injury","predicate":"reported to confer protection against","stance":"reported","subject":"baicalin","text":"Baicalin is reported to protect the myocardium against ischemia/reperfusion injury; it is described as a natural flavonoid glycoside."},{"as_of":null,"based_on":["t22_o2"],"kind":"claim","local_id":"t22_c2","object":"mechanism of protection","predicate":"has not been fully understood","stance":"open","subject":"baicalin cardioprotective mechanism","text":"The mechanism by which baicalin protects against myocardial I/R injury is stated to be not fully understood."},{"as_of":null,"based_on":["t22_o3"],"kind":"claim","local_id":"t22_c3","object":"OGD/R-triggered cell viability loss in H9c2 cells","predicate":"reported to prevent","stance":"reported","subject":"baicalin","text":"Baicalin is reported to prevent loss of cell viability in H9c2 cells subjected to OGD/R."},{"as_of":null,"based_on":["t22_o6"],"kind":"claim","local_id":"t22_c5","object":"baicalin protective effect in H9c2 cells","predicate":"reported to compromise baicalin-generated protection when overexpressed","stance":"reported","subject":"ACSL4","text":"ACSL4 overexpression is reported to compromise the protective effect of baicalin in H9c2 cells, implying ACSL4 is needed for the protection to operate."},{"based_on":["t22_o6","t22_o7"],"falsifier":"ACSL4 knockdown or inhibition fails to reduce ferroptosis markers or injury, or baicalin still protects when ACSL4 is overexpressed.","kind":"hypothesis","local_id":"t22_h1","text":"Baicalin protects against myocardial I/R injury by suppressing ACSL4-dependent ferroptosis, so ACSL4 loss should reproduce the protection."}],"scope":{"docs":["d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de"],"ranges":[["d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de",0,2280]],"topic":null}},"engine_root":"dd31200fa1305195c3c6ddac3d20ae170599243901eab00a8af67ded1269ce6d","outcome":{"kind":"records","result":{"accepted":["dd576f65943655980d6b518cb4710bb539d86598a3ccf2440903f7f5ca4d831e","0f42c1dbaa798004f445a245e9e73f4f8514db82fa21d167384ecb562f73fd36","94c6cbd323dbec6c28f0d1aa09b8d6379bd4074ec9184fecbc49902f08a944d2","62422b673c5d20a165c80246f2b405dabcce463c935d8af9d4d2e32aa7f586a8","e0ae7e7144b53f0bd4c3fb16d3925c33e5844a534c77f15de9507d41b9fca2da","004b1fd5330dde2b0707ff06d21269fdfded40471a036e214b6a6bf93dd537f0","422e264fce542817c1f8c437aaa42ccb54739fe67212bb2a5e2d6bcb862f6980","fab33466d3c0cbf7b5504f5d84ce95a126feed53a1a6e9eb8648ac6415102179","c52a7ce10010a92f90e3bfd1e50e2eb64cf53809b7ccd58e38b333f19bab9bc0","596921262a437c8d8983435e6531a8c9c3c02765c6fc3e3df2a343a600e87ac7","67768fc4e3bbbb20b53ddccc655dc171068b5bccccb176f6faee141528874aec"],"error":null,"failed_index":null}},"request_hash":"0d18606ec571a2619ca8f9dc62a766c4bf314af1c135e356355797382214227b","submission_id":"T22-49aa559c03e6c148#1"},"hash":"56431fa541097820cd909ac78551fdc892dbc31a9e1030dae0425d89769e81cd","header":{"body_hash":"5aae34eba269a5b5a59d5cfb688b2387f07f4f5911644ef9087de7016eeeb485","format":"sbgk-session-log/3","previous":"5d729fee0ff00f8232d33791ba6c38ff6fa0ac8cafa8a2678db1ab1a666e6ec3","records_root":"10b3c9f97d0d1eea75234d3133b16a2061f8ea7d1cff4c81befa0540b30cb2c4"