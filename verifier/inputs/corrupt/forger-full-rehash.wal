":["@2543fb12361b04b1","@d845cf1c90cdac09"],"kind":"claim","local_id":"t33_c4","object":"MIRI; combined use reduced scar area","predicate":"reported to inhibit ferroptosis during","stance":"reported","subject":"dexrazoxane; ponatinib","text":"Dexrazoxane or ponatinib is reported to inhibit ferroptosis during MIRI, and combined treatment with both markedly reduced the myocardial infarction scar area."},{"as_of":null,"based_on":["@690cdb063c75ce35"],"kind":"claim","local_id":"t33_c5","object":"IRI in isolated perfused hearts (in vitro)","predicate":"reported to prevent","stance":"reported","subject":"deferoxamine","text":"Deferoxamine is reported to prevent IRI in isolated perfused hearts in vitro, cited as evidence ferroptosis is crucial to IRI; the records do not state ferroptosis inhibition as its mechanism."},{"as_of":null,"based_on":["@800dce0abe70d859","@6e41a435d946b5ea"],"kind":"claim","local_id":"t33_c6","object":"ischemic reperfusion organ injury; myocardial cells in MIRI","predicate":"reported to alleviate and protect against","stance":"reported","subject":"ferroptosis inhibitors","text":"Ferroptosis inhibitors are reported to alleviate ischemic reperfusion organ injury, and blocking ferroptosis is reported to protect myocardial cells in MIRI; no specific compound is named there."}],"scope":{"docs":[],"ranges":[],"topic":null}},"engine_root":"e8db3000414241472d62e071c48e9fe5ceea7f4584e71acded846bc118df1023","outcome":{"kind":"records","result":{"accepted":["a35dcf845e5bf82150e76585bc41d8a34da0bb593cb92d55b7b248a67f72c597","d47c0840e2b726932ff01f3e9c0db9b11e5af29a7817ebc8973f207d004030c8","771d0821072913c0fcef1a8d5de9ad4da10f254df639d5e2906cc3ea4e004f8a","373ae6a165c7b9195699e6bba2d11806627238faab1223276dd6d81e45195783","950ddd3e49420420b50eb6699096689eb1166af59d0d857fdc1102b196aaab2f","35cc90e4e91e244623bbf9e0484a582218629c275cc649740418cd99a6be6631"],"error":null,"failed_index":null}},"request_hash":"9e854ee4875873ce47aa2e2dce4bdf2d1e8176e13b89e8e643ac3413