{"body":{"actor":"w1","audit_root":"10fc062ef8b5fd5dcdec64e9aacb35130844f163111717fffb7c43df52108700","command":{"allowed_records":["365ae9fb0cc44e725fa0d2de0689fec700d542b00dcf815a3dcd3dec48fe3889","4a7b9b4b679f4a3e457033edb67d814162543a07bbd6607182b84c552168225f","68d496f719eefdeadd68cc8fa1c507aa91d6e156b39c7b8e4266c9ceaf46c5ef","69ae6f64ae891c52f8ae1941cf20ce71cb78926c6b047390234a4a06e8c520b0","6f0ff3bf9ad296c5661b98fe021f26761a38e5bbf05983577bf7b3322e76eb77","72bb7299aeed4327bb9a52d6503efcb56be03d734738368149981ecf6912dc95","9026b2ce369c12781d95960bd95ed7f8fe3745adfa12204c62340bd8d77344c7","a400583ce667ce35482f11198679bfb202abd3949671e75fd709db3195831a0c","a84be80a6986ad7f7b387ffa2dce2ef2d38f4cf0ec25289700d894594af2c536","c1c7d8e99994e3cc3629519b9ce5a5feb3379830cbf730f10f1f90f245e9d808","c473d66009fc579f4bd443ed3238a310b97d74bfce00047cff8ddd8350853d69","dcb10951c982480fbffb7a64236be2e7e6f6183f0750f14a98bcbc56c9c06d95"],"directive":"T18-6b93a41c25aea51b","kind":"submit","lines":[{"doc_id":"d_a4ddf8ee6d280b8bf83b9085b69d8b452885166ab36aa6da396cd4b3b96a32e3","exact_quote":"In a rat MIRI model, it was found that erastin probably increases ERS, which further increases ferroptosis.","kind":"observe","local_id":"t18_o1","terms":["erastin, ERS and ferroptosis in rat MIRI model","Q1 Q2 mechanism"]},{"doc_id":"d_a4ddf8ee6d280b8bf83b9085b69d8b452885166ab36aa6da396cd4b3b96a32e3","exact_quote":"Inhibition of ferroptosis can reduce myocardial cell injury, and the inhibition of ERS can alleviate ferroptosis and reduce MIRI.","kind":"observe","local_id":"t18_o2","terms":["ferroptosis and ERS inhibition reduce MIRI","Q1"]},{"doc_id":"d_a4ddf8ee6d280b8bf83b9085b69d8b452885166ab36aa6da396cd4b3b96a32e3","exact_quote":"the tail vein injection of the ferroptosis inhibitor, ferrostatin-1, could attenuate ERS-induced ferroptosis in cardiomyocytes","kind":"observe","local_id":"t18_o3","terms":["ferrostatin-1 in diabetic rat MIRI model","Q1"]},{"doc_id":"d_a4ddf8ee6d280b8bf83b9085b69d8b452885166ab36aa6da396cd4b3b96a32e3","exact_quote":"the ERS inhibitor, salubrinal, could also attenuate ferroptosis in cardiomyocytes.","kind":"observe","local_id":"t18_o4","terms":["salubrinal attenuates ferroptosis in cardiomyocytes","Q1"]},{"doc_id":"d_a4ddf8ee6d280b8bf83b9085b69d8b452885166ab36aa6da396cd4b3b96a32e3","exact_quote":"the occurrence of ferroptosis can further exacerbate ERS in cardiomyocytes, which can form a vicious circle [56].","kind":"observe","local_id":"t18_o5","terms":["ferroptosis-ERS vicious circle in cardiomyocytes","Q1 Q2"]},{"doc_id":"d_a4ddf8ee6d280b8bf83b9085b69d8b452885166ab36aa6da396cd4b3b96a32e3","exact_quote":"The CHOP-mediated apoptosis in ERS plays an important role in the MIRI process in rats [49].","kind":"observe","local_id":"t18_o6","terms":["CHOP-mediated apoptosis in MIRI","Q1"]},{"doc_id":"d_a4ddf8ee6d280b8bf83b9085b69d8b452885166ab36aa6da396cd4b3b96a32e3","exact_quote":"Studies have found that ferroptosis can induce ERS activation by inhibiting the System Xc--mediated exchange of extracellular cystine for intracellular glutamate [50, 51].","kind":"observe","local_id":"t18_o7","terms":["ferroptosis induces ERS via System Xc- inhibition","mechanism"]},{"doc_id":"d_a4ddf8ee6d280b8bf83b9085b69d8b452885166ab36aa6da396cd4b3b96a32e3","exact_quote":"MIRI has also been found to be closely associated with ERS [55].","kind":"observe","local_id":"t18_o8","terms":["MIRI associated with ERS","Q1"]},{"doc_id":"d_a4ddf8ee6d280b8bf83b9085b69d8b452885166ab36aa6da396cd4b3b96a32e3","exact_quote":"Therefore, ferroptosis-induced ERS and the activation of ERS play crucial roles in apoptosis and are important apoptotic mechanisms in MIRI.","kind":"observe","local_id":"t18_o9","terms":["summary: ERS and ferroptosis drive apoptosis in MIRI","Q1"]},{"as_of":null,"based_on":["t18_o3","t18_o4"],"kind":"claim","local_id":"t18_c1","object":"diabetic rat MIRI model","predicate":"reported to attenuate ferroptosis in cardiomyocytes in","stance":"reported","subject":"ferrostatin-1; salubrinal","text":"In a diabetic rat LAD-ligation MIRI model, ferrostatin-1 given by tail vein injection is reported to attenuate ERS-induced ferroptosis in cardiomyocytes; salubrinal (an ERS inhibitor) is also reported to attenuate ferroptosis."},{"as_of":null,"based_on":["t18_o1"],"kind":"claim","local_id":"t18_c2","object":"ferroptosis in rat MIRI","predicate":"probably increases ERS, which further increases","stance":"reported","subject":"erastin","text":"In a rat MIRI model, erastin is said to probably increase ERS, which further increases ferroptosis."},{"as_of":null,"based_on":["t18_o2"],"kind":"claim","local_id":"t18_c3","object":"myocardial cell injury and MIRI","predicate":"reported to reduce","stance":"reported","subject":"ferroptosis and ERS inhibition","text":"Inhibiting ferroptosis is reported to reduce myocardial cell injury, and inhibiting ERS is reported to alleviate ferroptosis and reduce MIRI."},{"as_of":null,"based_on":["t18_o5"],"kind":"claim","local_id":"t18_c4","object":"a vicious circle exacerbating each other","predicate":"reported to form","stance":"reported","subject":"ferroptosis and ERS in cardiomyocytes","text":"Ferroptosis and ERS are reported to form a vicious circle in cardiomyocytes, each exacerbating the other."},{"as_of":null,"based_on":["t18_o6"],"kind":"claim","local_id":"t18_c5","object":"MIRI process in rats","predicate":"reported to play an important role in","stance":"reported","subject":"CHOP-mediated apoptosis in ERS","text":"CHOP-mediated apoptosis in ERS is reported to play an important role in the MIRI process in rats."},{"as_of":null,"based_on":["t18_o7"],"kind":"claim","local_id":"t18_c6","object":"System Xc--mediated cystine-glutamate exchange","predicate":"reported to induce ERS by inhibiting","stance":"reported","subject":"ferroptosis","text":"Ferroptosis is reported to induce ERS by inhibiting System Xc--mediated cystine/glutamate exchange, a link proposed as a bridge to apoptosis."}],"scope":{"docs":["d_a4ddf8ee6d280b8bf83b9085b69d8b452885166ab36aa6da396cd4b3b96a32e3"],"ranges":[["d_a4ddf8ee6d280b8bf83b9085b69d8b452885166ab36aa6da396cd4b3b96a32e3",16011,20036]],"topic":null}},"engine_root":"54573b84afb661ffa16e475bf88b9e4219081b69a7b970f1687817a12f06fe0b","outcome":{"kind":"records","result":{"accepted":["596cd28c4a1ae3ef12e283216055dec97502ab3f99426c4d13d26d73a695e4e4","1ae31b5f538c30651af987c49a36ca082fcd83d742176a91b4e0f64269f12712","a84d55033565fe37178b0c6e946aec50d984bf15cad98978664ec28271b173cf","042477e4eabc27b0f27907448e877232d54f48641196fbfdeceec2c67b66ad1a","6338843ef3991089b9c607e727e67597d0bb5cbf32c69f7efb081a49e99fba9b","13ebff9192bbcf379abcc7a7c5d08dc08aea00f6acaebab93983bfa3a36c4c60","54cf67f87b25210446bf14a8ee35f3fe479e3c0b690b1958d236783d3f654731","2f76a63715d8456808bb11f76f519ac81dd1357c56c4ea546698656df3f25a92","23941fde49cf617692c0b30c26c9c066096d58e72b366f54d9114d2a1d9acf1f","cefe8d0d1e3c52211154cfd3506059348aa8669cb5d4e79d769b248b37bcfccb","605b3439a672f03f443a512ffb9568469559eefa4eeed90ec84f973a1c67d001","e1488d93100d83101c894f6bc31167817ef484527f2337bb3bf3b39ac7e97975","c14e5dcec97ef8ff2c6c8251c67fc9a55b3facc2250146107efffd88215a3945","aa410768305277e90f5d0cffd35317f0d39d3c91423cb3485ec650ae687174c5","067f84140895bf8a3fdec888bf077a99bbb17b305d204faade55281833459905"],"error":null,"failed_index":null}},"request_hash":"4829320b43bc78f665325f1b8cf3f309920ef7c933a175e19c486ee8882d3b1f","submission_id":"T18-6b93a41c25aea51b#1"},"hash":"93390aed5726c1f6bff5ebd36bd045b64c7b8636651a2b54656214df40c3c1e5","header":{"body_hash":"c557b314e178ea24e39f2cd2e1269adcba7f34f5acb5202d0aad202eb224f1d1","format":"sbgk-session-log/3","previous":"04e34c49f30c39a4a525da07ed642e7b3455ec847b0fedd196ceff5451a7a710","records_root":"da49c1979e0f0a1637bdca6ded652f471e786f0782a485cca18e5fed7acae3a8","seq":40,"wal_op":"audit"}}
