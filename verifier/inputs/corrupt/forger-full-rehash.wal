{"body":{"actor":"w1","audit_root":"cae702257834a35e273bee448086feb1960357cb46ec5dd73a1c7ea56bfd7932","command":{"allowed_records":["365ae9fb0cc44e725fa0d2de0689fec700d542b00dcf815a3dcd3dec48fe3889","6f0ff3bf9ad296c5661b98fe021f26761a38e5bbf05983577bf7b3322e76eb77","9026b2ce369c12781d95960bd95ed7f8fe3745adfa12204c62340bd8d77344c7","a400583ce667ce35482f11198679bfb202abd3949671e75fd709db3195831a0c"],"directive":"T5-61634b1a882fdf32","kind":"submit","lines":[{"doc_id":"d_2334c21c827f6b7bc5ae2521186c76ffb10084f742cc5447f83253bc2fae9f6b","exact_quote":"Apigenin significantly increased the activities of glutathione peroxidase (GSH PX), catalase (CAT) and superoxide dismutase (SOD), in a dose-dependent manner","kind":"observe","local_id":"t5_o1","terms":["apigenin antioxidant enzyme activity in H2O2-treated PIG3V cell line, melanocyte model, not cardiac"]},{"doc_id":"d_2334c21c827f6b7bc5ae2521186c76ffb10084f742cc5447f83253bc2fae9f6b","exact_quote":"The results showed that apigenin protects melanocytes from oxidative damage dependent Nrf2 pathway (Zhang et al., 2020).","kind":"observe","local_id":"t5_o2","terms":["apigenin protection via Nrf2 pathway, melanocytes only, no ferroptosis or heart data"]},{"doc_id":"d_2334c21c827f6b7bc5ae2521186c76ffb10084f742cc5447f83253bc2fae9f6b","exact_quote":"it is reported that these effects are exerted by regulating NF - κ B, Nrf2 and cAMP/CREB signaling pathways (Yang C.-C. et al., 2020).","kind":"observe","local_id":"t5_o3","terms":["galangin general biological effects attributed to NF-kB, Nrf2, cAMP/CREB signaling, no cardiac context"]},{"doc_id":"d_2334c21c827f6b7bc5ae2521186c76ffb10084f742cc5447f83253bc2fae9f6b","exact_quote":"Apigenin's local drug delivery system transports apigenin to local skin tissue instead of penetrating into blood circulation (Li et al., 1996).","kind":"observe","local_id":"t5_o4","terms":["apigenin topical delivery limits systemic exposure, relevant to any systemic cardiac use"]},{"doc_id":"d_2334c21c827f6b7bc5ae2521186c76ffb10084f742cc5447f83253bc2fae9f6b","exact_quote":"So far, there is little evidence that apigenin promote adverse metabolic reactions in vivo when ingesting nutrition related amounts","kind":"observe","local_id":"t5_o5","terms":["apigenin in vivo safety at dietary amounts, limited evidence"]},{"as_of":null,"based_on":["t5_o1"],"kind":"claim","local_id":"t5_c1","object":"H2O2-treated PIG3V cells (melanocyte model)","predicate":"reported to increase antioxidant enzyme activity in","stance":"reported","subject":"apigenin","text":"Apigenin is reported to raise GSH-PX, CAT and SOD activities and lower MDA in H2O2-treated PIG3V melanocyte-line cells; the data are from a skin cell model and say nothing about the heart."},{"as_of":null,"based_on":["t5_o2"],"kind":"claim","local_id":"t5_c2","object":"Nrf2 pathway (melanocytes only)","predicate":"reported to protect melanocytes via","stance":"reported","subject":"apigenin","text":"Apigenin's melanocyte protection is reported to depend on the Nrf2 pathway, since no effect appears in Nrf2 knockout cells; no ferroptosis or cardiac link is drawn."},{"as_of":null,"based_on":["t5_o3"],"kind":"claim","local_id":"t5_c3","object":"NF-κB, Nrf2 and cAMP/CREB signaling (general)","predicate":"reported to exert effects via","stance":"reported","subject":"galangin","text":"Galangin's antioxidant and other activities are reported to be exerted via NF-κB, Nrf2 and cAMP/CREB regulation, as a general statement without cardiac or ischemia data."},{"as_of":null,"based_on":["t5_o4"],"kind":"claim","local_id":"t5_c4","object":"local skin tissue, not blood circulation","predicate":"reported to transport apigenin to","stance":"reported","subject":"apigenin local drug delivery system","text":"Apigenin's local drug delivery is reported to transport it to local skin tissue rather than into blood circulation, which limits systemic exposure."},{"as_of":null,"based_on":["t5_o5"],"kind":"claim","local_id":"t5_c5","object":"nutrition-related amounts","predicate":"little evidence of adverse metabolic reactions in vivo at","stance":"qualified","subject":"apigenin","text":"The section states there is little evidence that apigenin causes adverse metabolic reactions in vivo at nutrition-related amounts; this is a qualified safety statement, not cardiac efficacy."}],"scope":{"docs":["d_2334c21c827f6b7bc5ae2521186c76ffb10084f742cc5447f83253bc2fae9f6b"],"ranges":[["d_2334c21c827f6b7bc5ae2521186c76ffb10084f742cc5447f83253bc2fae9f6b",15623,21465]],"topic":null}},"engine_root":"fe1a1bac1a1ccc8d1ea3cf713b6ef898a18c82619f94583df2e8c111389c4e28","outcome":{"kind":"records","result":{"accepted":["719ed2070a2083227a65b9570653524e7642f46e0a3ddc951a264797a1576506","246b2fedc1d7fa9ffca4d3f5bab2788c3e2590419e11d2bce4d59e482b3a29d6","48b8614d82c57d174d91dcc5be0bafc29bba2e961aa383be739e31a3cb2dcca2","3595be3866f8f6d52bcd97f2514e1cb667953f5165204d35adcae43d4372ee26","6ab59f320a7b75a3b1edbe107a073de519817045f0702a8461e28faa4bca8b43","257eef540bbc169e8c7813ec3c32f23c9025dcda09386da49faa8a04371a5604","c473d66009fc579f4bd443ed3238a310b97d74bfce00047cff8ddd8350853d69","69ae6f64ae891c52f8ae1941cf20ce71cb78926c6b047390234a4a06e8c520b0","805832a858da54421c2aaa96d5daa665bbecf189579dfcfe58b3b61f1766705e","c1c7d8e99994e3cc3629519b9ce5a5feb3379830cbf730f10f1f90f245e9d808"],"error":null,"failed_index":null}},"request_hash":"21b58555a9fabd11012cb7aa692e617ca808b302cc4f657f4f28e6e01ba0691d","submission_id":"T5-61634b1a882fdf32#1"},"hash":"36fa0b9a49156f1d18a9da0ce2c500827b11bf0739457fba1fe262ff4ad3cbb2","header":{"body_hash":"cd712546f1d5eb126d5b90631c464a90a5a867e3db737e972eb11f183dc1e416","format":"sbgk-session-log/3","previous":"0719c89ae46ffc49a02b5f37f444e4f7b733075e40638b890e108e6089901f2f","records_root":"e92be8b3fa57b400df6d53961a997063948b358306c09ccbfebc981e9b03d8d5","seq":8,"wal_op":"audit"}}
