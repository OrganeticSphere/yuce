,{"doc_id":"d_2334c21c827f6b7bc5ae2521186c76ffb10084f742cc5447f83253bc2fae9f6b","exact_quote":"BBR inhibited the oxidative damage induced by H_2O_2 by down regulating the activities of CAT and SOD and reducing the accumulation of ROS in PIG1 cells","kind":"observe","local_id":"t12_o4","terms":["berberine effect on H2O2 damage in PIG1 melanocyte cells"]},{"doc_id":"d_2334c21c827f6b7bc5ae2521186c76ffb10084f742cc5447f83253bc2fae9f6b","exact_quote":"The high antioxidant activity of sesamin has been reported (Pathak et al., 2014)","kind":"observe","local_id":"t12_o5","terms":["sesamin antioxidant activity, cited without tissue context"]},{"as_of":null,"based_on":["t12_o2"],"kind":"claim","local_id":"t12_c2","object":"vasodilator activity (cited, no mechanism)","predicate":"reported to have","stance":"reported","subject":"cubebin","text":"Cubebin is reported to have vasodilator activity, citing Somani et al. 2017; the section gives no vascular mechanism, injury model or ferroptosis data."},{"as_of":null,"based_on":["t12_o5"],"kind":"claim","local_id":"t12_c5","object":"high antioxidant activity (no cardiac context)","predicate":"reported to have","stance":"reported","subject":"sesamin","text":"Sesamin's high antioxidant activity is reported, citing Pathak et al. 2014; the section gives no tissue, cardiac or ferroptosis context for it."}],"scope":{"docs":["d_2334c21c827f6b7bc5ae2521186c76ffb10084f742cc5447f83253bc2fae9f6b"],"ranges":[["d_2334c21c827f6b7bc5ae2521186c76ffb10084f742cc5447f83253bc2fae9f6b",55110,59578]],"topic":null}},"engine_root":"f1e7e16318a93281e0bba2d5f7bbd3a0a9bc638b0375793f3601d8cbdc4fdb6b","outcome":{"kind":"records","result":{"accepted":["00e3985c83f18e59eb7ca8210cd881c2cefdb5ed20ca55ee940951f870b9fdab","955a59ea61019c7a1fafbc419ab2e8906faff89f0c5b1f1c7e756f53d39da615","f498849daef96eb8f9c0fa2a79f2525f9362c250f7bd9b512b0c2f275d81ed8e","de7001f149ace2529b8e82f01a79c69332c4c2d79ddd1c10b2f6aca4a6c0ae59","1ea5c73fabda823c8e14200c7a9b0492e01812693036104970