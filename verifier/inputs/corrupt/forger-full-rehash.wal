{"body":{"actor":"w1","audit_root":"12772722b416de8c1cb76edadd88ecacf1bc6f4f3e8497dfd8c81beb3bee7289","command":{"allowed_records":["365ae9fb0cc44e725fa0d2de0689fec700d542b00dcf815a3dcd3dec48fe3889","4a7b9b4b679f4a3e457033edb67d814162543a07bbd6607182b84c552168225f","68d496f719eefdeadd68cc8fa1c507aa91d6e156b39c7b8e4266c9ceaf46c5ef","69ae6f64ae891c52f8ae1941cf20ce71cb78926c6b047390234a4a06e8c520b0","6f0ff3bf9ad296c5661b98fe021f26761a38e5bbf05983577bf7b3322e76eb77","72bb7299aeed4327bb9a52d6503efcb56be03d734738368149981ecf6912dc95","9026b2ce369c12781d95960bd95ed7f8fe3745adfa12204c62340bd8d77344c7","a400583ce667ce35482f11198679bfb202abd3949671e75fd709db3195831a0c","a84be80a6986ad7f7b387ffa2dce2ef2d38f4cf0ec25289700d894594af2c536","c1c7d8e99994e3cc3629519b9ce5a5feb3379830cbf730f10f1f90f245e9d808","c473d66009fc579f4bd443ed3238a310b97d74bfce00047cff8ddd8350853d69","dcb10951c982480fbffb7a64236be2e7e6f6183f0750f14a98bcbc56c9c06d95"],"directive":"T24-b214c4a1f2f2950d","kind":"submit","lines":[{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"baicalin 100 mg/kg (BA-100, I/R + baicalin 100 mg/kg), baicalin 200 mg/kg (BA-200, I/R + baicalin 200 mg/kg)","kind":"observe","local_id":"t24_o1","terms":["baicalin dose groups in rat I/R model"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"The suture was loosened after transient regional myocardial ischemia for 40 min, followed by a 120 min reperfusion of LAD.","kind":"observe","local_id":"t24_o2","terms":["ischemia and reperfusion timing in LAD occlusion model"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"Western blot and measurement of ROS, MDA, SOD, and Fe^2+ activities were carried out to reveal the levels of ferroptosis.","kind":"observe","local_id":"t24_o3","terms":["ferroptosis readouts: ROS, MDA, SOD, Fe2+, western blot"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"ACSL4 (Abclonal, A14439), GPX4 (Abclonal, A1933), FTH1(CST, 4393), TfR1 (Abclonal, A5865), NCOA4 (Abclonal, A5695)","kind":"observe","local_id":"t24_o4","terms":["ACSL4 and other ferroptosis-related antibodies"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"Drugs were given by oral gavage once daily (8 a.m.) for 6 days.","kind":"observe","local_id":"t24_o5","terms":["dosing schedule before I/R"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"diltiazem 20 mg/kg (DI-20, I/R + diltiazem 20 mg/kg)","kind":"observe","local_id":"t24_o6","terms":["diltiazem comparator arm"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"Infarct size determination was performed using Evans blue/2,3,5-triphenyltetrazolium chloride monohydrate (TTC) double staining","kind":"observe","local_id":"t24_o7","terms":["infarct size method"]},{"as_of":null,"based_on":["t24_o1","t24_o2","t24_o5"],"kind":"claim","local_id":"t24_c1","object":"rat myocardial I/R model","predicate":"is tested at 100 and 200 mg/kg in","stance":"open","subject":"baicalin","text":"Baicalin is administered at 100 and 200 mg/kg by daily oral gavage for 6 days before ischemia in a rat LAD I/R model; this section states the design only, not whether it protects the heart."},{"as_of":null,"based_on":["t24_o7","t24_o3"],"kind":"claim","local_id":"t24_c2","object":"baicalin outcome data (infarct size, hemodynamics, ferroptosis markers)","predicate":"does not report","stance":"open","subject":"section d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","text":"This section reports no infarct, hemodynamic, or ferroptosis outcome for baicalin; those results are not given here."},{"as_of":null,"based_on":["t24_o4","t24_o3"],"kind":"claim","local_id":"t24_c3","object":"rat myocardial I/R tissue (role unestablished)","predicate":"is measured as a ferroptosis-related protein in","stance":"open","subject":"ACSL4","text":"ACSL4 is measured by western blot as one of several ferroptosis-related proteins in the I/R hearts; its role in I/R injury is not established in this section."},{"as_of":null,"based_on":["t24_o3"],"kind":"claim","local_id":"t24_c4","object":"ROS, MDA, SOD, Fe2+ and western blot readouts","predicate":"is assessed by","stance":"open","subject":"ferroptosis","text":"Ferroptosis is to be assessed through ROS, MDA, SOD, Fe2+ and western blot readouts; the section gives no measured values."},{"as_of":null,"based_on":["t24_o6"],"kind":"claim","local_id":"t24_c5","object":"rat I/R model","predicate":"serves as comparator in","stance":"open","subject":"diltiazem","text":"Diltiazem 20 mg/kg serves as a comparator arm alongside the baicalin groups in the I/R model; its effect is not reported here."},{"based_on":["t24_o1","t24_o3","t24_o4"],"falsifier":"Results showing no significant difference in ACSL4, GPX4, MDA, Fe2+, ROS or infarct size between BA-100/BA-200 and I/R saline groups.","kind":"hypothesis","local_id":"t24_h1","text":"Baicalin at 100 or 200 mg/kg reduces ferroptosis markers (ACSL4, GPX4, MDA, Fe2+, ROS) and infarct size in rat I/R hearts relative to the I/R saline group."}],"scope":{"docs":["d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de"],"ranges":[["d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de",7031,12466]],"topic":null}},"engine_root":"b6481a02a8d8438a94e8bc3f643d53774dbc60c3bacf978bea9730063301d269","outcome":{"kind":"records","result":{"accepted":["af9db8a9444d22beef63b7d840c71142051be50b9640d59b71a5d767d60dbc2d","66fa1f8866de799bf08592c4a90048a7fb68871b2ce51a9e8125b130ccc3925e","7e2a17ee1307d66068d04b5b2dbce3490d42ceeaf677c2a4d0b3246fded6ac5a","8fbb34dd6eb55738b213dea4b235bddef397cf618d1dd9d5e2a222636d3da9dc","02cf7528eb8f52a9409931443ba6309807ecd8f8e62e6115a49ddbc2cf45bbff","596c405d1c90ce52f72e387b53efa5108fd8940b298ee29278e816a2fae04778","67ce9d