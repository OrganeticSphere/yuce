uce","stance":"reported","subject":"berberine","text":"Berberine is reported to reduce H2O2-induced oxidative damage in PIG1 cells by lowering CAT and SOD activities and ROS accumulation; the data come from a skin cell model and say nothing about the heart."}],"scope":{"docs":["d_2334c21c827f6b7bc5ae2521186c76ffb10084f742cc5447f83253bc2fae9f6b"],"ranges":[["d_2334c21c827f6b7bc5ae2521186c76ffb10084f742cc5447f83253bc2fae9f6b",55110,59578]],"topic":null}},"engine_root":"f1e7e16318a93281e0bba2d5f7bbd3a0a9bc638b0375793f3601d8cbdc4fdb6b","outcome":{"kind":"records","result":{"accepted":["a63a206de042af5d1df1da79cf2073f6105f9bac8c59556d7205d857b77e526e","315cd6a441665f50772d1dc2ad4698beeef9878270d3b0f5339f9f60132211bf","7a3ba410aed4e8a8704660fbc66296c512ae43e13fe8870b374c2f08bb0bc963"],"error":null,"failed_index":null}},"request_hash":"68c740dd5f39f8643b875a3b3de63cd7d9841991d1adc2432b4d7557b6991660","submission_id":"T12-84e685834e2e9a12#2"},"hash":"90183f0b531f3b5b82eb2f15f231a5a69a91f9ea40847df7c66d635258cbb7fe","header":{"body_hash":"8b157cf5d445e8e98b722f360ceaa599c6298bf55448fe2ba24ad0412d91d077","format":"sbgk-session-log/3","previous":"57c02d1d3ca4c646663f866b63f7ba4e547d087f80e0baef1dfda05c1ffd5ffa","records_root":"76c050824622e100d20297349a8c39609fce97e8665414e11ebc42a49d7215e3","seq":28,"wal_op":"audit"}}
