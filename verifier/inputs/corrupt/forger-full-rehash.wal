,"f1056834c8540f5cc6b9f6d56a10f39569860f0502a7d56033e48af112319a60","f1e4bce51306f4b41a477bde35157294f7f7f20b28ee013f308292a9e881043d","f20bea357cb4181107abbec9ad3824f727bc5b50a61ad44c357525cdf154c970","f26edbe912150175b145d9f3b5f6522af80efca944f720e11a71e15cd1fcfc20","f29090ed8edc069d5b136aa46d2424ef381cb80ecfae5d16acdde94f6549766e","f418f54b92afd7e09e79b66b8f68454462621e1d13d2f503152e37a643f0c10c","f4ad7883b815d9c2835b7c23b28452ced95c88dbfc9496327e3cf64582d2aa8a","f7b3d426ab07b3396f5b464435005685bcb31de55b2d815e228ac048fc923a08","fab33466d3c0cbf7b5504f5d84ce95a126feed53a1a6e9eb8648ac6415102179","fbabd6969f766c63fb51c0167befc532aef347fe38458c8753dc3fb6f9815ca2","fe3f942c9867e06faf43b6db4114e56bad32c3709618771ac51c1838cb219e61","fef3b2dfb389e7740bb2c4bba10813fc50f2e5a035af420dffa22efbd1fe96c2","ff1789db7bf20acb13d83112fc4f0d7fd5f0ecd2c2758897ab0d8aa5d99043d3","ff200d1979110442f002ae042b4987cfe7f0496c94b87944e14f4dd447efbf84","ff37fdfffc07ba04a88ef215cc70f47de4326233ac8cd81b242a6a59148a2848"],"directive":"TS30-5fe9733f9255d6f9","kind":"submit","lines":[{"as_of":null,"based_on":["@dd576f6594365598","@004b1fd5330dde2b"],"kind":"claim","local_id":"t30_c1","object":"myocardial ischemia/reperfusion injury","predicate":"reported to protect against I/R injury by inhibiting ferroptosis","stance":"reported","subject":"baicalin","text":"Baicalin is the only compound here reported to protect the heart from I/R injury by inhibiting ferroptosis, via suppressing ACSL4-controlled ferroptosis (one 2021 rat/H9c2 study)."},{"as_of":null,"based_on":["@be42f51a2af1a8e9","@e48607cc49ff61c8","@962232c8c9d2fe36","@1b62ccf67d475322"],"kind":"claim","local_id":"t30_c2","object":"rat myocardial I/R injury","predicate":"reduces infarct size and ST elevation in","stance":"reported","subject":"baicalin","text":"In rat LAD I/R, baicalin pretreatment (100/200 mg/kg, 6 days) cut infarct size to 16.13-21.80% vs 34.96% in I/R controls and lessened ST elevation; histology attenuated, dose-related."},{"as_of":null,"based_on":["@62422b673c5d20a1","@a3d89253376ea405","@1b7c253885dfa4f7","@bd4bcd73e6db302e","@314de317f33b0fdc"],"kind":"claim","local_id":"t30_c3","object":"rat myocardial I/R model","predicate":"reversed I/R-enhanced ferroptosis markers and is read as inhibiting ferroptosis in","stance":"reported","subject":"baicalin","text":"In I/R rats, baicalin reversed raised lipid peroxidation, iron accumulation, TfR1 and NCOA4 ferritinophagy, lowered ROS/MDA/ACSL4 and raised SOD/GPX4; read as ferroptosis inhibition."},{"as_of":null,"based_on":["@94c6cbd323dbec6c","@e58e01f507d50df8","@0adc4dac926a0d37","@240331d308367a2f","@3873a9a20ee26bfb","@f26edbe912150175","@0697569dd74b6ea2","@7b9428207d039830"],"kind":"claim","local_id":"t30_c4","object":"OGD/R-treated H9c2 cells","predicate":"prevented viability loss and reduced ROS/MDA, restored SOD/GPX4 in","stance":"reported","subject":"baicalin","text":"In OGD/R H9c2 cells, baicalin (25-100 uM, 24 h pre-treatment) prevented viability loss and lowered ROS and MDA while restoring SOD and GPX4 in a dose-related way; in vitro only."},{"as_of":null,"based_on":["@e0ae7e7144b53f0b","@a12159c82c8ae474","@2d6114847486a247","@4676802df183c105"],"kind":"claim","local_id":"t30_c5","object":"baicalin protective effect; myocardial I/R","predicate":"overexpression compromises baicalin-generated protection; upregulated in I/R hearts","stance":"reported","subject":"ACSL4","text":"ACSL4 overexpression compromised baicalin's protection in H9c2 cells, suggesting ACSL4 is needed for the effect; ACSL4 is upregulated in I/R hearts (4.411 vs 1.000) and lowered by baicalin."},{"as_of":null,"based_on":["@e1c059b259ecaa1f","@bd4bcd73e6db302e","@0f42c1dbaa798004"],"kind":"claim","local_id":"t30_c6","object":"ferroptosis causality in I/R and OGD/R","predicate":"not established by marker correlations; mechanism not fully understood","stance":"open","subject":"baicalin ferroptosis attribution","text":"Causal caveat: the 2021 study rests on marker correlations with no ferroptosis inhibitor control, and the mechanism of baicalin's protection is stated as not fully understood."},{"as_of":null,"based_on":["@b602d4ade9efbfd7","@e0c187e758bec438","@6e41a435d946b5ea","@800dce0abe70d859"],"kind":"claim","local_id":"t30_c7","object":"myocardial ischemia/reperfusion injury","predicate":"implicated in MIRI; blocking it is said to protect myocardial cells","stance":"reported","subject":"ferroptosis","text":"Review (2021-10-23): ferroptosis is implicated in MIRI and closely tied to oxidative stress; blocking it is said to protect myocardial cells; ferroptosis inhibitors alleviate ischemic organ injury."},{"as_of":null,"based_on":["@a202f57849d18296","@4495a54f3a0269bf","@94996c9f1ad97dac","@690cdb063c75ce35"],"kind":"claim","local_id":"t30_c8","object":"CABG patients and isolated perfused hearts","predicate":"reported to protect against reperfusion injury via reduced radical generation","stance":"reported","subject":"deferoxamine","text":"Deferoxamine (iron chelator) reportedly protects against reperfusion injury in CABG patients and isolated hearts via reduced radical generation; not stated as ferroptosis inhibition."},{"as_of":null,"based_on":["@a84d55033565fe37","@042477e4eabc27b0"],"kind":"claim","local_id":"t30_c9","object":"diabetic rat MIRI model","predicate":"reported to attenuate ferroptosis in cardiomyocytes","stance":"reported","subject":"ferrostatin-1 and salubrinal","text":"Ferrostatin-1 (tail vein) is reported to attenuate ERS-induced ferroptosis in cardiomyocytes in a diabetic rat LAD MIRI model; salubrinal (an ERS inhibitor) also attenuates ferroptosis."},{"as_of":null,"based_on":["@fbabd6969f766c63","@756d27a735214c6f"],"kind":"claim","local_id":"t30_c10","object":"MIRI","predicate":"reported to inhibit ferroptosis and alleviate MIRI via GPX-4 increase and ROS reduction","stance":"reported","subject":"liproxstatin-1","text":"Liproxstatin-1 reportedly inhibits ferroptosis and alleviates MIRI by raising GPX-4 and reducing lipid-peroxidation ROS; cited studies, with no sample size or model given in the section."},{"as_of":null,"based_on":["@1ae31b5f538c3065","@6338843ef3991089"],"kind":"claim","local_id":"t30_c11","object":"cardiomyocytes in rat MIRI models","predicate":"reported to alleviate ferroptosis and reduce MIRI; form a vicious circle","stance":"reported","subject":"ERS inhibition and ferroptosis","text":"Inhibiting ERS is reported to alleviate ferroptosis and MIRI; ferroptosis and ERS form a reported vicious circle in cardiomyocytes; evidence is from rat and diabetic rat models."},{"as_of":null,"based_on":["@7f5c67aec04f0048","@933f8139a2eae6c6","@a26048982385d478","@204a148f6b846b8c"],"kind":"claim","local_id":"t30_c12","object":"ACSL-4, LOX, TfR-1, iron uptake","predicate":"reported to suppress ferroptosis in non-cardiac settings","stance":"reported","subject":"thiazolidinediones, zileuton, HSPB-1, IREB-2","text":"Thiazolidinediones, zileuton, HSPB-1 and IREB-2 are reported to suppress ferroptosis in non-cardiac or general settings (cancer/HT22 cells, mechanism); none shown protecting the heart from I/R."},{"as_of":null,"based_on":["@596cd28c4a1ae3ef","@8cf228b81c5a4376","@dcc640a6aeba00c7","@f20bea357cb41811"],"kind":"claim","local_id":"t30_c13","object":"rat MIRI and cell lines","predicate":"modulate ferroptosis sensitivity in","stance":"reported","subject":"erastin, SLC7A11, VDAC-2/3, ACSL-4","text":"Pro-ferroptotic or cell-line findings: erastin raises ferroptosis in rat MIRI; SLC7A11 silencing and VDAC-2/3 knockdown alter erastin sensitivity; ACSL-4 knockdown suppresses ferroptosis in breast cancer cells."},{"as_of":null,"based_on":["@0f9f7b36fcf32e77","@041a74effc9827ef","@5610f6c9b70e64ce","@de8ed09d3eca8066","@20a2568a54c07ed5","@97e440f1198df149"],"kind":"claim","local_id":"t30_c15","object":"cardioprotection or ferroptosis inhibition","predicate":"listed generally or in melanocyte models; no cardiac ferroptosis data","stance":"qualified","subject":"other natural compounds in vitiligo review","text":"Other natural compounds in the 2021-11-11 vitiligo review (kaempferol, paeoniflorin, puerarin, EGCG, paeonol, morin) are listed generally or in melanocyte models; no heart ferroptosis data."},{"as_of":null,"based_on":["@c9088c8a7d65820b"],"kind":"claim","local_id":"t30_c16","object":"vitiligo skin lesions","predicate":"reported to achieve repigmentation via anti-inflammatory effects in vitiligo","stance":"reported","subject":"baicalin","text":"Baicalin appears in the 2021-11-11 vitiligo review for repigmentation via anti-inflammatory and JAK/STAT effects; that report has no cardiac, I/R or ferroptosis data."},{"as_of":null,"based_on":["@ee97cf3916513333","@ac64a216044a9957"],"kind":"claim","local_id":"t30_c17","object":"mouse IRI model; ferroptosis","predicate":"accumulate in scar; are important regulators of iron accumulation in","stance":"reported","subject":"ferritin, TfR1, ferritinophagy","text":"Ferritin accumulates in mouse myocardial scar 30 min after LAD ligation; TfR1 and ferritinophagy are key iron-accumulation regulators in ferroptosis (background from prior sources)."}],"scope":{"docs":[],"ranges":[],"topic":null}},"engine_root":"5f66e6a376a54950e9a9b0cf87609abefd313e8613146b080f65cf1fd5943f19","outcome":{"kind":"records","result":{"accepted":["0b8b26a32a66eb985a463e15ec05afa1bad0263af81de0dff1fe0835693d3e7e","eb7e8277a836661d2c29e7b947827fbab811091129d71df393d4fc9a86f64827","6aebf5fc71efb55da980255d87be22006b6fbf32d66647af7834c4e8d907cb6f","b59323ef4d3cefeba8e3ee5ee972e4efe6551ddb21001b16f3abc1e0516f116c","a7038eab4281797c1264c3a6b0ba84704c5b134122b206d5eb4225b321f3d9a7","cb04c4a30dbac4d173bb10231a8b74615cfcca289a8a44d289cc2562ad53c425","df503cc0e92f712699e816c7fab8065a20fb8aef0ea704bbd9190f502002b027","a8b9bd71e4e65b2d44a594b31cd7856bf589f9701eeaa6794d12a73db737385e","b73d41f43443ddb2034a036e353a4a3ed9f95634e6154336c92233e166098d9e","82ec667eda1ade8a5c88a257eb108b085fabf1eff792130a8ee0bbe396b18ab2",