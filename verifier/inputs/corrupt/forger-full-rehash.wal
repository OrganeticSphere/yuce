,"f1056834c8540f5cc6b9f6d56a10f39569860f0502a7d56033e48af112319a60","f1e4bce51306f4b41a477bde35157294f7f7f20b28ee013f308292a9e881043d","f20bea357cb4181107abbec9ad3824f727bc5b50a61ad44c357525cdf154c970","f26edbe912150175b145d9f3b5f6522af80efca944f720e11a71e15cd1fcfc20","f418f54b92afd7e09e79b66b8f68454462621e1d13d2f503152e37a643f0c10c","f569e8ce84972adb635915a984eed928039b75595aff40ef4db98ea315934dc2","fab33466d3c0cbf7b5504f5d84ce95a126feed53a1a6e9eb8648ac6415102179","fe3f942c9867e06faf43b6db4114e56bad32c3709618771ac51c1838cb219e61","fef3b2dfb389e7740bb2c4bba10813fc50f2e5a035af420dffa22efbd1fe96c2","ff1789db7bf20acb13d83112fc4f0d7fd5f0ecd2c2758897ab0d8aa5d99043d3","ff200d1979110442f002ae042b4987cfe7f0496c94b87944e14f4dd447efbf84","ff2153beb830c7be3314400833ce9c3b4bc33f73a021fa1d6831c951635c67f4"],"directive":"TS32-a102eb7345fb97fb","kind":"submit","lines":[{"as_of":null,"based_on":["@dd576f6594365598"],"kind":"claim","local_id":"t32_c1","object":"myocardial I/R injury","predicate":"reported to protect against","stance":"reported","subject":"baicalin","text":"Baicalin, a natural flavonoid glycoside, is reported to protect against myocardial ischemia/reperfusion (I/R) injury."},{"as_of":null,"based_on":["@0f42c1dbaa798004"],"kind":"claim","local_id":"t32_c2","object":"mechanism of protection","predicate":"has not been fully understood","stance":"open","subject":"baicalin cardioprotective mechanism","text":"The mechanism by which baicalin protects against myocardial I/R injury is stated to be not fully understood."},{"as_of":null,"based_on":["@be42f51a2af1a8e9","@af9db8a9444d22be","@02cf7528eb8f52a9","@e48607cc49ff61c8","@962232c8c9d2fe36"],"kind":"claim","local_id":"t32_c3","object":"rat myocardial I/R (pretreatment model)","predicate":"reduces ST elevation and infarct size in","stance":"reported","subject":"baicalin","text":"In rat LAD I/R with 6-day oral pretreatment, baicalin 100 and 200 mg/kg lowered ST elevation and infarct size to 21.80% and 16.13%, vs 34.96% in I/R controls."},{"as_of":null,"based_on":["@767fd723a480ee02","@1b62ccf67d475322"],"kind":"claim","local_id":"t32_c4","object":"I/R-injured rat hearts","predicate":"partly restores flow and pressure, attenuates injury in","stance":"reported","subject":"baicalin","text":"Baicalin partly restored coronary flow and LVSP after I/R, with dose-related attenuation of myocardial morphological injury, reported qualitatively in rat hearts."},{"as_of":null,"based_on":["@3f34516e272e72cb"],"kind":"claim","local_id":"t32_c5","object":"myocardial I/R injury in rats","predicate":"is concluded to protect against","stance":"reported","subject":"baicalin","text":"The authors conclude baicalin protected rats from myocardial I/R injury; this rests on one rat model with ECG, infarct, hemodynamic and histology readouts."},{"as_of":null,"based_on":["@8134b816bfb3942d","@d284e3a9e38348bc"],"kind":"claim","local_id":"t32_c6","object":"I/R model","predicate":"improved hemodynamics, infarct and apoptosis in","stance":"reported","subject":"baicalin","text":"Earlier studies (Luan 2019) report baicalin improved LV hemodynamics, reduced infarct area and apoptosis in I/R; protection is also cited to Wang 2013 and Bai 2019."},{"as_of":null,"based_on":["@912e8266c32adeb2"],"kind":"claim","local_id":"t32_c7","object":"hypoxia-reoxygenation cardiac microvascular endothelial cells","predicate":"restored cell activity and function in","stance":"reported","subject":"baicalin","text":"In hypoxia-reoxygenation cardiac microvascular endothelial cells, baicalin reportedly restored cell activity and function (Bai et al., 2019)."},{"as_of":null,"based_on":["@94c6cbd323dbec6c","@20477ed17bc3a370","@e58e01f507d50df8"],"kind":"claim","local_id":"t32_c8","object":"OGD/R-challenged H9c2 cells","predicate":"prevents viability loss in","stance":"reported","subject":"baicalin","text":"In H9c2 cells, baicalin at 25-100 uM prevented OGD/R-triggered viability loss; the protection is framed as in vitro only."},{"as_of":null,"based_on":["@62422b673c5d20a1","@a3d89253376ea405","@5db219737d96af3f"],"kind":"claim","local_id":"t32_c9","object":"lipid peroxidation, iron, TfR1, NCOA4 ferritinophagy","predicate":"enhanced in I/R and OGD/R, reversed by baicalin","stance":"reported","subject":"ferroptosis-related markers","text":"Lipid peroxidation, iron accumulation, TfR1 and NCOA4-mediated ferritinophagy are reported enhanced in I/R and OGD/R models, and reversed by baicalin."},{"as_of":null,"based_on":["@5db219737d96af3f","@3523283f2b11677e","@47c69e3a739e2f43"],"kind":"claim","local_id":"t32_c10","object":"iron uptake and NCOA4-mediated ferritinophagy in I/R rats","predicate":"reduces iron accumulation via","stance":"reported","subject":"baicalin","text":"Baicalin reportedly lowers Fe2+ in I/R rat hearts; the authors propose iron uptake and ferritin autophagic degradation as the mechanism."},{"as_of":null,"based_on":["@1b7c253885dfa4f7","@bd4bcd73e6db302e","@314de317f33b0fdc"],"kind":"claim","local_id":"t32_c11","object":"myocardial I/R model rats","predicate":"reported to inhibit ROS production and lipid peroxidation in","stance":"reported","subject":"baicalin","text":"In I/R rats, baicalin reportedly reduces ROS, MDA and ACSL4 and raises SOD and GPX4, read as inhibition of ROS production and lipid peroxidation."},{"as_of":null,"based_on":["@a12159c82c8ae474","@2d6114847486a247","@91d7658008da423f","@4c8d94ec2811122e","@314de317f33b0fdc"],"kind":"claim","local_id":"t32_c12","object":"myocardial I/R injury (rat model)","predicate":"reported to promote and protect against lipid peroxidation in","stance":"reported","subject":"ACSL4 and GPX4","text":"ACSL4 is upregulated in I/R hearts (4.411 vs 1.000) and makes PUFA phospholipids, lipid peroxidation substrates; GPX4 falls in I/R (0.1480 vs 0.9980) and baicalin raises it."},{"as_of":null,"based_on":["@9a59d3d135bfe10f"],"kind":"claim","local_id":"t32_c13","object":"anti-fibrotic effect","predicate":"decreases ACSL4 expression, leading to","stance":"reported","subject":"baicalin","text":"Baicalin is reported to decrease ACSL4 expression, giving an anti-fibrotic effect (Wu et al., 2018); the tissue context of this fibrosis finding is not stated."},{"as_of":null,"based_on":["@004b1fd5330dde2b","@c9c9031f9dbf0776"],"kind":"claim","local_id":"t32_c14","object":"ACSL4-controlled ferroptosis","predicate":"proposed to prevent I/R injury by suppressing","stance":"reported","subject":"baicalin","text":"The authors propose baicalin prevents myocardial I/R injury by suppressing ACSL4-controlled ferroptosis, presented as a novel prevention target."},{"as_of":null,"based_on":["@107b99828b85e137"],"kind":"claim","local_id":"t32_c15","object":"ACSL-4-mediated ferroptosis","predicate":"reported to prevent MIRI by inhibiting","stance":"reported","subject":"baicalin","text":"A 2021 MIRI review reports baicalin prevents MIRI by inhibiting ACSL-4-mediated ferroptosis (ref 82) in rat MIRI and OGD/R H9c2 cells; its only cardiac statement."},{"as_of":null,"based_on":["@b602d4ade9efbfd7","@0002b0370ce45e3f"],"kind":"claim","local_id":"t32_c16","object":"myocardial I/R injury","predicate":"implicated in; can trigger","stance":"reported","subject":"ferroptosis and PCI reperfusion","text":"Ferroptosis is implicated in myocardial I/R injury (Park 2019); reperfusion after PCI can trigger myocardial cell death and cardiac deterioration (Liang 2017)."},{"as_of":null,"based_on":["@0adc4dac926a0d37","@240331d308367a2f","@3873a9a20ee26bfb","@f26edbe912150175","@0697569dd74b6ea2","@2bf0420973a898f7"],"kind":"claim","local_id":"t32_c17","object":"OGD/R-treated H9c2 cells","predicate":"attenuates ROS, MDA and lipid peroxidation in","stance":"reported","subject":"baicalin","text":"Baicalin reportedly suppresses OGD/R-induced ROS and MDA and restores SOD and GPX4 in H9c2 cells in a dose-related way, in vitro; no in vivo data are given."},{"as_of":null,"based_on":["@e1c059b259ecaa1f","@bd4bcd73e6db302e"],"kind":"claim","local_id":"t32_c18","object":"marker changes alone","predicate":"not established by","stance":"open","subject":"ferroptosis attribution","text":"Attribution of baicalin's effects to ferroptosis rests on marker correlations; the section shows no ferroptosis-specific inhibitor control or causal test."},{"as_of":null,"based_on":["@21a1185ee5d7dfe9","@e5880998f70fdc57","@43c39470027c1f9a"],"kind":"claim","local_id":"t32_c19","object":"ferroptosis resistance","predicate":"is not known to protect against I/R via","stance":"open","subject":"baicalin","text":"Whether baicalin protects against I/R via ferroptosis resistance is stated as not understood; the study aims to test it, and the excerpt shows no ferroptosis outcome data."},{"as_of":null,"based_on":["@596c405d1c90ce52","@962232c8c9d2fe36","@1b7c253885dfa4f7","@47c69e3a739e2f43"],"kind":"claim","local_id":"t32_c20","object":"rat I/R model","predicate":"serves as comparator with similar effects in","stance":"reported","subject":"diltiazem","text":"Diltiazem 20 mg/kg was a comparator; it gave similar ST and infarct reductions and reduced ROS and iron, like baicalin, in the same I/R model."},{"as_of":null,"based_on":["@0cdcf8c964293d69","@cb0ad22fc42cb953","@a346fec8577d9ca1"],"kind":"claim","local_id":"t32_c21","object":"oxidative stress, calcium overload, inflammation; VDAC/mPTP possibly","predicate":"reported as not fully understood, mainly involving","stance":"qualified","subject":"MIRI pathogenesis","text":"The 2021 MIRI review says MIRI pathogenesis is not fully understood, mainly involving oxidative stress, calcium overload and inflammation; VDAC and mPTP may be involved."},{"as_of":null,"based_on":["@690cdb063c75ce35","@a202f57849d18296","@4495a54f3a0269bf"],"kind":"claim","local_id":"t32_c22","object":"isolated perfused hearts and CABG patients","predicate":"reported to prevent IRI; mechanism not stated as ferroptosis inhibition","stance":"qualified","subject":"deferoxamine","text":"Deferoxamine, an iron chelator, prevented IRI in isolated perfused hearts and reduced reperfusion radical generation in CABG; ferroptosis inhibition is not stated as the mechanism."},{"as_of":null,"based_on":["@596cd28c4a1ae3ef","@54cf67f87b252104"],"kind":"claim","local_id":"t32_c23","object":"ferroptosis in rat MIRI","predicate":"probably increases ER stress, which further increases ferroptosis","stance":"reported","subject":"erastin and ferroptosis","text":"In a rat MIRI model, erastin probably increases ER stress, which further increases ferroptosis; ferroptosis may induce ER stress by blocking System Xc- cystine-glutamate exchange."},{"as_of":null,"based_on":["@cebfe7117e142b43","@d607dd2d31044d4c"],"kind":"claim","local_id":"t32_c24","object":"ferroptosis; cardiac dysfunction in MIRI","predicate":"inactivation is classic induction mechanism of; overexpression attenuates","stance":"reported","subject":"GPX4","text":"GPX4 inactivation is the classic ferroptosis inducer; mitochondria-targeted GPX4 overexpression reportedly attenuates cardiac dysfunction in MIRI (one cited study)."},{"as_of":null,"based_on":["@f569e8ce84972adb","@171af636efb0b584"],"kind":"claim","local_id":"t32_c25","object":"increased Ptgs2 mRNA (mechanism unexplained)","predicate":"reported to reduce scar area via","stance":"qualified","subject":"Fer-1 and dexrazoxane","text":"Fer-1 or dexrazoxane pretreatment in MIRI mice reportedly reduced enzyme spectrum and infarct scar with a Ptgs2 mRNA rise; the mechanism of this benefit is unexplained."},{"as_of":null,"based_on":["@f20bea357cb41811","@7f5c67aec04f0048","@933f8139a2eae6c6"],"kind":"claim","local_id":"t32_c26","object":"non-cardiac cell models","predicate":"reported to suppress ferroptosis in","stance":"reported","subject":"ACSL-4, thiazolidinediones, zileuton","text":"ACSL-4 knockdown suppresses ferroptosis in breast cancer cells; thiazolidinediones and zileuton inhibit ferroptosis in non-cardiac cells; the review gives no cardiac data for these."},{"as_of":null,"based_on":["@8fe1b555aeecae19","@7b7f688f79cb87ea"],"kind":"claim","local_id":"t32_c27","object":"Nrf2 activation; anti-inflammatory, immune and lipid effects (non-cardiac)","predicate":"reported to mediate antioxidant stress via Nrf2 and have activities including","stance":"reported","subject":"baicalin","text":"Baicalin is reported to mediate antioxidant stress via Nrf2 signaling and to have anti-inflammatory and other activities; the 2021-11-11 vitiligo review gives no cardiac data."},{"as_of":null,"based_on":["@c9088c8a7d65820b"],"kind":"claim","local_id":"t32_c28","object":"anti-inflammatory effects and JAK/STAT activation in vitiligo","predicate":"reported to achieve repigmentation via","stance":"reported","subject":"baicalin","text":"Baicalin is reported to promote vitiligo repigmentation via anti-inflammatory effects and JAK/STAT activation; that review has no cardiovascular or ferroptosis data."},{"as_of":null,"based_on":["@0f9f7b36fcf32e77","@20a2568a54c07ed5","@42ccadfe1654c2c9","@97e440f1198df149","@041a74effc9827ef"],"kind":"claim","local_id":"t32_c29","object":"general list items, unspecified mechanism","predicate":"reported to have cardiovascular or cardioprotective activity","stance":"reported","subject":"kaempferol, paeonol, 6-shogaol, morin, paeoniflorin","text":"Kaempferol, paeonol, 6-shogaol, morin and paeoniflorin are listed with cardiovascular or cardioprotective activity only as general mentions, with no injury or ferroptosis data."}],"scope":{"docs":[],"ranges":[],"topic":null}},"engine_root":"5f66e6a376a54950e9a9b0cf87609abefd313e8613146b080f65cf1fd5943f19","outcome":{"kind":"records","result":{"accepted":["19c8d45a3900c09d7fc075830243bf43c60069f568610e48e039a89da24caef8","873f7c01cabc08229aa8a1c7d6d000b3e0402d60a50ee77902076d9c1dc3d690","5db26ddc047b21ced0cc7f6f4a0056837300d15295571fc3aaa7755378973d98","4e62acbf7ec88b6cf0adbbba4fe48e871757bccf308f280e38260d2a95966358","8c762ef259f7561e781c9c0963be58234656d7eb99c4070939f8bdb0804742b5","c2b74a7f93b0326722ddc8892b90531b2