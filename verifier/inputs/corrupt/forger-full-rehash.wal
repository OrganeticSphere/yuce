{"body":{"actor":"w1","audit_root":"276e32e629a9d49cfa03b213aed73a3f560ee7a905bc6c9d4cd0ff9f12c51e90","command":{"allowed_records":["365ae9fb0cc44e725fa0d2de0689fec700d542b00dcf815a3dcd3dec48fe3889","4a7b9b4b679f4a3e457033edb67d814162543a07bbd6607182b84c552168225f","68d496f719eefdeadd68cc8fa1c507aa91d6e156b39c7b8e4266c9ceaf46c5ef","69ae6f64ae891c52f8ae1941cf20ce71cb78926c6b047390234a4a06e8c520b0","6f0ff3bf9ad296c5661b98fe021f26761a38e5bbf05983577bf7b3322e76eb77","72bb7299aeed4327bb9a52d6503efcb56be03d734738368149981ecf6912dc95","9026b2ce369c12781d95960bd95ed7f8fe3745adfa12204c62340bd8d77344c7","a400583ce667ce35482f11198679bfb202abd3949671e75fd709db3195831a0c","a84be80a6986ad7f7b387ffa2dce2ef2d38f4cf0ec25289700d894594af2c536","c1c7d8e99994e3cc3629519b9ce5a5feb3379830cbf730f10f1f90f245e9d808","c473d66009fc579f4bd443ed3238a310b97d74bfce00047cff8ddd8350853d69","dcb10951c982480fbffb7a64236be2e7e6f6183f0750f14a98bcbc56c9c06d95"],"directive":"T29-2666610da5a0c57c","kind":"submit","lines":[{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"Increased ACSL4 protein expression was detected in animals subjected to myocardial I/R injury (Tang et al., 2020).","kind":"observe","local_id":"t29_o1","terms":["ACSL4 expression in myocardial I/R injury","citation Tang et al. 2020"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"myocardial I/R rats and OGD/R-treated cardiomyocytes demonstrated higher ACSL4 expression level","kind":"observe","local_id":"t29_o2","terms":["ACSL4 upregulation in rat I/R and OGD/R cardiomyocytes"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"ACSL4 overexpression hindered baicalin-induced protective effects on myocardial I/R injury in vitro","kind":"observe","local_id":"t29_o3","terms":["ACSL4 overexpression blunts baicalin protection in vitro"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"baicalin exerted cardioprotective effect via ACSL4 deactivation–induced ferroptosis resistance (Figure 7)","kind":"observe","local_id":"t29_o4","terms":["baicalin cardioprotection via ACSL4 deactivation and ferroptosis resistance","conclusion"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"Our study suggests that ACSL4-mediated ferroptosis is a promising target in the treatment of myocardial I/R injury.","kind":"observe","local_id":"t29_o5","terms":["ACSL4-mediated ferroptosis as therapeutic target"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"baicalin was administered prior to myocardial I/R damage","kind":"observe","local_id":"t29_o6","terms":["pretreatment design limitation"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"further investigation is required to illustrate whether baicalin confers protective effects after myocardial I/R injury","kind":"observe","local_id":"t29_o7","terms":["post-injury baicalin efficacy unresolved"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"the dosages and time window for baicalin treatment was chosen based on previous studies","kind":"observe","local_id":"t29_o8","terms":["dose and time window limitation"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"pharmacological or genetic inhibition of ACSL4 using rosiglitazone and siRNA–rescued mice and cells from ferroptosis damages","kind":"observe","local_id":"t29_o9","terms":["ACSL4 inhibition rescues from ferroptosis","Li Y. et al. 2019"]},{"doc_id":"d_d3012628a98d2640b2879ff1df9f2bab1168f0be34e343dfd4ccefc2574e08de","exact_quote":"Li and his colleagues discovered that the expression of ACSL4 was upregulated under ferroptosis condition","kind":"observe","local_id":"t29_o11","terms":["ACSL4 upregulation under ferroptosis"]},{"as_of":null,"based_on":["t29_o1"],"kind":"claim","local_id":"t29_c1","object":"myocardial I/R injury animals","predicate":"reported to be increased in","stance":"reported","subject":"ACSL4","text":"ACSL4 protein expression is reported to be increased in animals subjected to myocardial I/R injury, citing Tang et al. 2020."},{"as_of":null,"based_on":["t29_o2"],"kind":"claim","local_id":"t29_c2","object":"myocardial I/R rats and OGD/R cardiomyocytes","predicate":"higher in and reversed by baicalin in","stance":"reported","subject":"ACSL4 expression","text":"In this study, ACSL4 expression is higher in myocardial I/R rats and OGD/R-treated cardiomyocytes and is reversed by baicalin administration."},{"as_of":null,"based_on":["t29_o3"],"kind":"claim","local_id":"t29_c3","object":"baicalin-induced protection in vitro","predicate":"hinders","stance":"reported","subject":"ACSL4 overexpression","text":"ACSL4 overexpression is reported to hinder baicalin's protective effects on myocardial I/R injury in vitro."},{"as_of":null,"based_on":["t29_o4"],"kind":"claim","local_id":"t29_c4","object":"ACSL4 deactivation and ferroptosis resistance","predicate":"proposed to exert cardioprotection via","stance":"reported","subject":"baicalin","text":"Baicalin is proposed to be cardioprotective in myocardial I/R injury via ACSL4 deactivation-induced ferroptosis resistance."},{"as_of":null,"based_on":["t29_o5"],"kind":"claim","local_id":"t29_c5","object":"myocardial I/R injury treatment","predicate":"suggested as promising target in","stance":"open","subject":"ACSL4-mediated ferroptosis","text":"The authors suggest ACSL4-mediated ferroptosis is a promising therapeutic target for myocardial I/R injury; this is not tested beyond the reported experiments."},{"as_of":null,"based_on":["t29_o6","t29_o7"],"kind":"claim","local_id":"t29_c6","object":"myocardial I/R damage","predicate":"administered prior to, protection after injury unresolved","stance":"open","subject":"baicalin","text":"Baicalin 