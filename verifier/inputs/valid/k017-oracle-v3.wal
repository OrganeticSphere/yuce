{"body":{"actor":"w3","audit_root":"1de691ac40fc37833fe81c28cc831a35bfcb522ff808e4cac049ee47838eafb4","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"TR53-d6aeded36c150c7f","kind":"submit","lines":[{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"The client **SHOULD NOT** send requests other than\n  [pings](/specification/2025-06-18/basic/utilities/ping) before the server has responded to the\n  `initialize` request.","kind":"observe","local_id":"t53_o4","terms":["pre-initialization client requests"]},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"The server **SHOULD NOT** send requests other than\n  [pings](/specification/2025-06-18/basic/utilities/ping) and\n  [logging](/specification/2025-06-18/server/utilities/logging) before receiving the `initialized`\n  notification.","kind":"observe","local_id":"t53_o5","terms":["pre-initialization server requests"]},{"as_of":null,"based_on":["t53_o4","t53_o5"],"kind":"claim","local_id":"t53_c4","object":"client pings; server pings and logging","predicate":"SHOULD be limited to","stance":"qualified","subject":"pre-initialization requests","text":"Before initialization completes, clients SHOULD NOT send requests other than pings, and servers SHOULD NOT send requests other than pings and logging."}],"scope":{"docs":["d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d"],"ranges":[["d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d",0,5981]],"topic":null}},"engine_root":"e30624c253ee6fe8933c8e04d9095a875a7edcd282b335aee3824c68ecd864ad","outcome":{"kind":"records","result":{"accepted":["8624941b68b0ddd11b14708353d1f020a1fc448654e2f690f77b60418cf40771","7f094b3dbbe93bdd32f9af81d4839bad3b945db9d1da64fe0296374425668b92","13541653de5afedfbde6317f2ec8fc88bba465343f745c7fdd9d04eef8208353"],"error":null,"failed_index":null}},"request_hash":"649faf7955147498be9fd3afac5362276a66790fa6e5f81cf493e1d64e72e0d0","submission_id":"TR53-d6aeded36c150c7f#2"},"hash":"0a34b67b933723765a6275d5de41bcbd871b6660ea76a4804d56119a5cc1e51b","header":{"body_hash":"b9340cc08701d554b000013906f9bcb61a8836589f50589e55b41d034a37cff5","format":"sbgk-session-log/3","previous":"62f25227d920c5200204f6ae1e5a3866d5008fa4ae1c4cbc25d83d5c0703c152","records_root":"d2760b15da7d38a596ad00b7a77daed9ce37b190fd9a5c064bd457731dee5a8a","seq":260,"wal_op":"audit"}}
