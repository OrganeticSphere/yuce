 line break inside the phrase): copy the bytes exactly, line break included, or quote a part that stands on one line","rule":"byte_quote","suggested_exact_quote":"| Parameter value is `null`                | Client MUST omit the header    | Server MUST NOT expect the header        |","suggested_span":{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","end_byte":23039,"start_byte":22919}},"field":"exact_quote","message":"quote has no byte-exact occurrence","obligation":null,"status":"error"},"index":10,"local_id":"t33o11"},{"error":{"code":"NO_EVIDENCE","expected_by_kernel":{"missing_identifiers":["42.0"]},"field":"based_on","message":"a claim names only identifiers its quotes hold: add a quote of this section that holds each one listed, or leave it out of the claim","obligation":null,"status":"error"},"index":17,"local_id":"t33c7"}],"task_id":"TR33-a5c79fc8074224f2","work_key":"reread:d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530#4"},"from":0,"key":"task-repair:TR33-a5c79fc8074224f2:1","to":0},"kind":"batch","operations":[]},"engine_root":"4fec772407ef0b8a80e283d07038ffcbc5985669ee2330ed5a2b36c6348eaa0f","outcome":{"kind":"value","result":{"accepted_operations":0,"checkpointed":true,"error":null,"failed_index":null,"results":[]}},"request_hash":"c2208ef62e50e5aa6b2a2dd95bfcfdfaa066ac56106a5599e859549d5c91d731","submission_id":"TR33-a5c79fc8074224f2#repair1"},"hash":"f52b2e4849afb15d58addc13aea6ecccb986749d0f21ca22b772b39f7a13fe4a","header":{"body_hash":"9acdc9bee832b3287178d4895939575a8b10eda1aea669359409a477d8f1ff5f","format":"sbgk-session-log/3","previous":"3c3510095f6db85803a8444b9c7798279b6d42590d5800bf6885f8208ff85ee4","records_root":"fe7c90ca2214e168f5ffe6cccb15729c3b8a03c403e48c406441cd589fdd8c41","seq":147,"wal_op":"audit"}}
{"body":{"actor":"w1","audit_root":"13e698fe504af815d2a14e2b9a551cc7308fc9d310eb1370570365af9ebef9e4","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"TR33-a5c79fc8074224f2","kind":"submit","lines":[{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"Intermediate servers that do not recognize an `Mcp-Param-{Name}` header\n**MUST** forward it and otherwise ignore it, as required by the\n[HTTP Semantics RFC][http-semantics].","kind":"observe","local_id":"t33o4","terms":["intermediaries","forwarding","HTTP Semantics RFC"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"| Parameter value is `null`                | Client MUST omit the header    | Server MUST NOT expect the header        |","kind":"observe","local_id":"t33o11","terms":["null parameter","header omission table"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"header value and the body value numerically rather than as strings (e.g.,\n`42.0` and `42` are considered equal).","kind":"observe","local_id":"t33o12","terms":["integer comparison","42.0 vs 42","numeric equality"]},{"as_of":null,"based_on":["t33o4"],"kind":"claim","local_id":"t33c4","object":"intermediate servers","predicate":"MUST be forwarded and ignored by","stance":"reported","subject":"unrecognized Mcp-Param-{Name} headers","text":"Intermediaries not recognizing an Mcp-Param-{Name} header MUST forward it and otherwise ignore it, per the HTTP Semantics RFC."},{"as_of":null,"based_on":["t33o12"],"kind":"claim","local_id":"t33c7","object":"numerically, not as strings","predicate":"SHOULD compare","stance":"qualified","subject":"integer parameter header validation","text":"When validating integer parameter values, servers SHOULD compare header and body values numerically rather than as strings, so 42.0 and 42 are considered equal."},{"as_of":null,"based_on":["t33o11"],"kind":"claim","local_id":"t33c10","object":"Mcp-Param headers","predicate":"MUST be omitted and not expected","stance":"reported","subject":"null and omitted parameter headers","text":"For a null parameter value the client MUST omit the header and the server MUST NOT expect it; a client omitting a header whose value is in the body is non-conforming and the server MUST reject."}],"scope":{"docs":["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530"],"ranges":[["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530",20841,26565]],"topic":null}},"engine_root":"f4e2ad1d0f52f99c89dd07ec4fa959009abac51723f5476bc5d8acdfff4c0111","outcome":{"kind":"records","result":{"accepted":["52ee3e226e597fd522b9d8d272c18616c1dc0a26a5efa06abb1b912f94888f46","92dee83d039aa9060141f44b1ad2b7c33d699b144d63689946ee843f23c31dd3","c95823fc83c6c337af4d51cce8ceca9bee63551ee2ae499b40eba8c4736f5718","6b6e504509a22833bcf852dcd13e32069a73725d24522999b0e7b01009658017","18a747b8d8a4480a7672fcd2e4a56cbf7450bf5ac1900620c5c8c3fee1026702","e0e1a99af8eb3f8c0950cf326cb344fa5b790eda2453645e76b429735d6618ad"],"error":null,"failed_index":null}},"request_hash":"cf004adfb65496760117ff94d1155bcedd6dc2201d3577927b38ef238fda6b23","submission_id":"TR