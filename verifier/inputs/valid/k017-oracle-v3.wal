{"body":{"actor":"w2","audit_root":"f75d4ca1a1854c632d0108b467266324c10f972371cf72eafdac409c62975a42","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T35-311816536641c7d1","kind":"submit","lines":[{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Authorization is **OPTIONAL** for MCP implementations. When supported:","kind":"observe","local_id":"t35_o1","terms":["authorization is optional for MCP implementations"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Implementations using an HTTP-based transport **SHOULD** conform to this specification.","kind":"observe","local_id":"t35_o2","terms":["HTTP-based transport conformance is a SHOULD"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Implementations using alternative transports **MUST** follow established security best","kind":"observe","local_id":"t35_o5","terms":["alternative transports must follow security best practices"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"OAuth 2.1 IETF DRAFT ([draft-ietf-oauth-v2-1-13]","kind":"observe","local_id":"t35_o7","terms":["OAuth 2.1 basis is an IETF draft"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Authorization servers **MUST** implement OAuth 2.1 with appropriate security","kind":"observe","local_id":"t35_o8","terms":["authorization servers must implement OAuth 2.1"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Authorization servers and MCP clients **SHOULD** support [OAuth Client ID Metadata Documents]","kind":"observe","local_id":"t35_o9","terms":["Client ID Metadata Documents support is a SHOULD"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"OAuth Client ID Metadata Documents ([draft-ietf-oauth-client-id-metadata-document-00]","kind":"observe","local_id":"t35_o10","terms":["Client ID Metadata Documents pinned to draft-00"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Authorization servers and MCP clients **MAY** support the OAuth 2.0 Dynamic Client Registration","kind":"observe","local_id":"t35_o11","terms":["dynamic client registration is optional"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"is deprecated and retained for backwards compatibility with authorization servers that do not support Client ID Metadata Documents.","kind":"observe","local_id":"t35_o12","terms":["dynamic client registration deprecated, kept for compatibility"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"MCP servers **MUST** implement OAuth 2.0 Protected Resource Metadata","kind":"observe","local_id":"t35_o13","terms":["servers must implement RFC9728 protected resource metadata"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"MCP authorization servers **MUST** provide at least one of the following discovery mechanisms:","kind":"observe","local_id":"t35_o15","terms":["AS must provide one discovery mechanism"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"The implementation details of the authorization server are beyond the scope of this specification.","kind":"observe","local_id":"t35_o17","terms":["authorization server implementation details out of scope"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"MCP clients **MUST** obtain a client ID through","kind":"observe","local_id":"t35_o18","terms":["clients must obtain a client ID via a registration mechanism"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"specifies how an MCP server indicates the location of its corresponding authorization server to a client.","kind":"observe","local_id":"t35_o20","terms":["AS location indication defined in a separate page"]},{"as_of":null,"based_on":["t35_o1"],"kind":"claim","local_id":"t35_c1","object":"OPTIONAL for MCP implementations","predicate":"is","stance":"reported","subject":"authorization","text":"Authorization is stated as OPTIONAL for MCP implementations; the requirements below apply only when authorization is supported."},{"as_of":null,"based_on":["t35_o5"],"kind":"claim","local_id":"t35_c4","object":"established security best practices","predicate":"MUST follow","stance":"reported","subject":"alternative transport implementations","text":"Implementations using alternative transports MUST follow established security best practices for their protocol."},{"as_of":null,"based_on":["t35_o11","t35_o12"],"kind":"claim","local_id":"t35_c6","object":"backwards compatibility","predicate":"is deprecated and retained for","stance":"qualified","subject":"Dynamic Client Registration","text":"Dynamic Client Registration is optional (MAY) and deprecated, retained only for backwards compatibility with authorization servers lacking Client ID Metadata Documents support; this qualifies its earlier standing."},{"as_of":null,"based_on":["t35_o15"],"kind":"claim","local_id":"t35_c9","object":"at least one of RFC8414 or OpenID Connect Discovery","predicate":"MUST provide","stance":"reported","subject":"MCP authorization servers","text":"MCP authorization servers MUST provide at least one discovery mechanism (RFC8414 or OpenID Connect Discovery), and clients MUST support both mechanisms."},{"as_of":null,"based_on":["t35_o17","t35_o20"],"kind":"claim","local_id":"t35_c10","object":"Authorization Server Discovery page","predicate":"are out of scope and deferred to","stance":"open","subject":"authorization server implementation details and AS location","text":"Authorization server implementation details are beyond this specification, and how an MCP server indicates its authorization server is deferred to the separate Authorization Server Discovery page; this remains open here."},{"as_of":null,"based_on":["t35_o18"],"kind":"claim","local_id":"t35_c11","object":"one of three registration mechanisms","predicate":"MUST obtain a client ID through","stance":"reported","subject":"MCP clients","text":"Before initiating the authorization flow, MCP clients MUST obtain a client ID through one of three registration mechanisms: Client ID Metadata Documents, pre-registration, or Dynamic Client Registration."},{"about":["OAuth 2.1 draft status","@30b42a7ab9212b14"],"kind":"question","local_id":"t35_q1","needed":"Check the IETF datatracker entry for draft-ietf-oauth-v2-1-13 and later revisions of the authorization page.","text":"Is draft-ietf-oauth-v2-1-13 finalized, and does a later revision of this section adopt the final RFC?"},{"about":["Client ID Metadata Documents draft pin","@3a2f36073d683624"],"kind":"question","local_id":"t35_q2","needed":"Check the IETF datatracker and the client-registration page in later spec revisions.","text":"Has draft-ietf-oauth-client-id-metadata-document-00 been superseded by a later draft, and does the client-registration page change its SHOULD status?"},{"about":["authorization_servers usage","authorization server discovery","@6ca6665902277bc7"],"kind":"question","local_id":"t35_q3","needed":"Check the linked authorization-server-discovery page and the authorization_servers metadata definition.","text":"Does the Authorization Server Discovery page specify the authorization_servers usage that this section defers, so conformance tests can cover it?"}],"scope":{"docs":["d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d"],"ranges":[["d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d",0,5816]],"topic":null}},"engine_root":"aac98563716adeae8c796158d0b1c13023a5fb2d915d10f6e164edb5543fbcf0","outcome":{"kind":"records","result":{"accepted":["c007dc646299fdfd82f5a3748c997120cad5c65738f4500545c89b9dfef01cad","22e78f51553454d5ca8fe939e84218e3a5f5eb463705348869660d29172aa4b7","e7c249f74148edd2a035d365b161dc2b2b5e3f52da569c8fc730c5f1bdb98052","99ace9bf482e5674dc2cb74f261df3176596cea9b784268136757467ac566f61","4c5e9bfe1b7474a43cd2eb0f9f3dcc5284490ea6d11ea3e98f20eda87f934854","8dafb3602aa34f94590922553f92626ea7227b1ea13ff8345989de97110eeaa4","6172df84a3b2c85cf3ac99d33d42e785a57d9bfe0ad14613fc1592cb1a6078dc","31e52b50b5d519d78e67ddcc5ee684921a698120be1517472242ae2ac84ba683","81a86d5c2b83925c8d25badd7f47d8a4316483983a939ba3cbd27b892d952cb4","64bc63d9a3d6bb37892a496c5c181f446739cc441c0d050c96285489cc1a4000","4ec14a94e5a8c339e33ae51fa15410b159ffa1d1d0b96f1fc18a70054fd1e95a","48c9d0fb45ffd1941e89fcb1f9770a35ec6c0cf7f0816d532535a93fb5d411ea","b793569a8f2f2cdc44feeacd9666772421340825bcb26fb32bbbad0b1f89e0fa","35d3156048c41fb2caaa9e0fc9cad1df4f666558b93b8303063d4306163553b9","9158b8e0ce51677883713558b6d98732fcb12c23efa38bb57c1a38b45cb477b6","9dc1aaecb6168841b3eac369a9e7acaccc09c5fe8f6fad798fcb04ab8fb17c17","8e6153ae23541512cb04c7d5663094a6a2b9f30a0397fc9bb26754f2617dda1e","025da52cda1468415c82cb72fefacbb7f8418855720f1d8e9d43b64b2366598a","5dc1e67534565c15e994b6bd252f79f36b54a5