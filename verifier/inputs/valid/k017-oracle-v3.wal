{"body":{"actor":"w4","audit_root":"ab4f9ac7834a5e3789612b1120c2a0c15d8e02a3ba2147534939083797b6bc57","command":{"allowed_records":[],"directive":"T3-2abfa4fa7167ab00","kind":"submit","lines":[{"doc_id":"d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804","exact_quote":"No specific shutdown messages are defined—instead, the underlying transport\nmechanism should be used to signal connection termination:","kind":"observe","local_id":"t3_o1","terms":["shutdown protocol messages","transport termination"]},{"as_of":null,"based_on":["t3_o1"],"kind":"claim","local_id":"t3_c1","object":"underlying transport connection termination","predicate":"relies on","stance":"reported","subject":"MCP shutdown","text":"MCP specifies no dedicated protocol shutdown messages, relying entirely on underlying transport connection termination."},{"about":["MCP shutdown","protocol termination"],"kind":"question","local_id":"t3_q1","needed":"check subsequent MCP specifications for explicit shutdown signaling","text":"Were explicit protocol-level shutdown or disconnect messages introduced in later protocol versions, or does termination remain transport-only?"},{"based_on":["t3_o1"],"falsifier":"Evidence showing subsequent MCP revisions introduced an application-level shutdown message","kind":"hypothesis","local_id":"t3_h1","text":"MCP relies on transport-level teardown because application-level shutdown handshakes were deemed redundant over supported transports."},{"doc_id":"d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804","exact_quote":"The initialize request **MUST NOT** be part of a JSON-RPC\n[batch](https://www.jsonrpc.org/specification#batch), as other requests and notifications\nare not possible until initialization has completed.","kind":"observe","local_id":"t3_o2","terms":["JSON-RPC batch","initialize request restriction"]},{"as_of":null,"based_on":["t3_o2"],"kind":"claim","local_id":"t3_c2","object":"JSON-RPC batch","predicate":"prohibits inclusion in","stance":"reported","subject":"initialize request","text":"The initialize request must not be sent in a JSON-RPC batch because initialization must complete before other operations can occur."},{"doc_id":"d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804","exact_quote":"- The client **SHOULD NOT** send requests other than\n  [pings](/specification/2025-03-26/basic/utilities/ping) before the server has responded to the\n  `initialize` request.","kind":"observe","local_id":"t3_o3","terms":["client pre-initialization requests","ping request"]},{"as_of":null,"based_on":["t3_o3"],"kind":"claim","local_id":"t3_c3","object":"ping requests","predicate":"restricted to","stance":"qualified","subject":"client requests before initialize response","text":"Clients are restricted from sending requests other than ping prior to receiving the initialize response."},{"doc_id":"d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804","exact_quote":"- The server **SHOULD NOT** send requests other than\n  [pings](/specification/2025-03-26/basic/utilities/ping) and\n  [logging](/specification/2025-03-26/server/utilities/logging) before receiving the `initialized`\n  notification.","kind":"observe","local_id":"t3_o4","terms":["server pre-initialization requests","ping and logging"]},{"as_of":null,"based_on":["t3_o4"],"kind":"claim","local_id":"t3_c4","object":"ping and logging requests","predicate":"restricted to","stance":"qualified","subject":"server requests before initialized notification","text":"Servers are restricted from sending requests other than ping and logging prior to receiving the initialized notification."},{"about":["pre-initialization messaging","ping","logging"],"kind":"question","local_id":"t3_q2","needed":"check subsequent MCP specification updates for changes to allowed pre-initialization requests","text":"Were pre-initialization messaging constraints and ping/logging exceptions modified or superseded in newer protocol revisions?"},{"doc_id":"d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804","exact_quote":"| Client   | `experimental` | Describes support for non-standard experimental features                                  |","kind":"observe","local_id":"t3_o5","terms":["experimental capability","client capability negotiation"]},{"as_of":null,"based_on":["t3_o5"],"kind":"claim","local_id":"t3_c5","object":"non-standard experimental features","predicate":"describes support for","stance":"reported","subject":"client experimental capability","text":"Client capability negotiation supports an experimental capability defining support for non-standard experimental features."},{"doc_id":"d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804","exact_quote":"If the client does not support the version in the server's response, it **SHOULD**\ndisconnect.","kind":"observe","local_id":"t3_o6","terms":["version negotiation","client disconnect"]},{"as_of":null,"based_on":["t3_o6"],"kind":"claim","local_id":"t3_c6","object":"disconnect","predicate":"mandates recommendation to","stance":"reported","subject":"client version mismatch","text":"Clients should disconnect if they do not support the protocol version returned in the server's initialize response."}],"scope":{"docs":["d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804"],"ranges":[["d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804",0,5980]],"topic":null}},"engine_root":"bacb9b955191994a33235b988b50c219d0ad58b55d9198b049e91e5840528d68","outcome":{"kind":"records","result":{"accepted":["bcd61812b8e32410b5c6b8ba649f0d2998b2c68434041e438d71831bcf867ae1","b66101f3e4eb0513dd15f5fd70f11c0ff5fc120574e1a224a94652eb7539fed3","54ce5dd7aef507ea394d43553d47598c3d8cf116e1f1128da333a021a9450285","388fc430f833e291a33eab7b8ffd612a54d4fd2510b7ef35c0599632ac25fd0a","10a1dd33e6874b7fd790bd9a93660fd99844692edd88a025785af3beeca0617f","78efa91808f3890df1f708ce3e17b6a140fe9bf7604c5411124d37a266b60e6d","b2faf682b0898892cd