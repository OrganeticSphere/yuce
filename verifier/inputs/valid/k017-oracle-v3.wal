{"body":{"actor":"w1","audit_root":"f56108c1b0b110ecfd780d892b228bda2e2137091e2cb9707149d84789da92a2","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T32-f5258f08f497b736","kind":"submit","lines":[{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"When constructing a `tools/call` request via HTTP transport, the client","kind":"observe","local_id":"t32_o1","terms":["tools/call","HTTP transport","client behavior"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"`x-mcp-header` and extract the value at each annotated property's exact","kind":"observe","local_id":"t32_o2","terms":["x-mcp-header","inputSchema","schema extension"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"`Mcp-Param-*` headers are missing or do not match the body, the client","kind":"observe","local_id":"t32_o3","terms":["HeaderMismatch","retry","tools/list"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"`400 Bad Request` HTTP status and JSON-RPC error code `-32020`","kind":"observe","local_id":"t32_o5","terms":["HeaderMismatch","error code","400 Bad Request"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"are case-insensitive. Clients and servers **MUST** use case-insensitive","kind":"observe","local_id":"t32_o6","terms":["case sensitivity","header names"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"`400 Bad Request`) for validation failures but are not required to return","kind":"observe","local_id":"t32_o8","terms":["intermediaries","error response","not required"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"version is older or the header is absent, the intermediary **SHOULD** reject","kind":"observe","local_id":"t32_o10","terms":["intermediary","reject","SHOULD"]},{"as_of":null,"based_on":["t32_o1","t32_o2"],"kind":"claim","local_id":"t32_c1","object":"clients per the five enumerated steps","predicate":"MUST be performed by","stance":"reported","subject":"tools/call request construction over HTTP transport","text":"Clients constructing tools/call over HTTP MUST extract standard header values from the body, append Mcp-Method and Mcp-Name, and add Mcp-Param-* headers from x-mcp-header-annotated inputSchema properties."},{"as_of":null,"based_on":["t32_o3"],"kind":"claim","local_id":"t32_c2","object":"tools/list check then retry with appropriate headers","predicate":"SHOULD be","stance":"qualified","subject":"client response to HeaderMismatch rejection","text":"On a HeaderMismatch rejection due to missing or mismatched Mcp-Param-* headers, the client SHOULD call tools/list to check inputSchema changes, then retry with appropriate headers."},{"as_of":null,"based_on":["t32_o5"],"kind":"claim","local_id":"t32_c4","object":"HTTP 400 Bad Request with JSON-RPC error -32020 HeaderMismatch","predicate":"MUST receive","stance":"reported","subject":"header validation failure","text":"Servers processing the body MUST reject header/body mismatches with HTTP 400 Bad Request and JSON-RPC error code -32020 (HeaderMismatch)."},{"as_of":null,"based_on":["t32_o6"],"kind":"claim","local_id":"t32_c5","object":"clients and servers","predicate":"MUST be case-insensitive for","stance":"reported","subject":"header name comparison","text":"Header names are case-insensitive and clients and servers MUST compare them case-insensitively, while header values such as method names are case-sensitive."},{"as_of":null,"based_on":["t32_o8"],"kind":"claim","local_id":"t32_c7","object":"JSON-RPC error response","predicate":"MUST return HTTP error but need not return","stance":"qualified","subject":"intermediary validation failure response","text":"Intermediaries MUST return an appropriate HTTP error status for validation failures but are not required to return a JSON-RPC error response."},{"about":["t32_c2","t32_c6","t32_c8"],"kind":"question","local_id":"t32_q1","needed":"Check later spec revisions of the custom-headers section for requirement-strength changes.","text":"Does any later revision tighten the SHOULD items (numeric comparison, intermediary version rejection, client retry) into MUST requirements?"},{"about":["t32_c1","t32_c4"],"kind":"question","local_id":"t32_q2","needed":"Check later revisions and schema changelog for HeaderMismatch and x-mcp-header status.","text":"Is the -32020 HeaderMismatch error code and the x-mcp-header schema extension stable or provisional in later revisions?"}],"scope":{"docs":["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530"],"ranges":[["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530",20841,26565]],"topic":null}},"engine_root":"731320b503ee7bf899d4ba56d0e6a5899441d39c5fc3c09f04af021a1608460e","outcome":{"kind":"records","result":{"accepted":["6f03161e0401c3cdf03134f1b9205da00548dfa3e8557fcdd8d59df2119e9503","47e867a693b828a68694cc81088b9d5b25afbada32668c14ec7d3d4f777ef99e","310784a1122188fa44c2c3f45ca3f87b74e427e0687edfb08aac1d8b95d0dad2","a428b435fcd62628f499dbb86