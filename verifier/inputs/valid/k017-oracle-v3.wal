{"body":{"actor":"w2","audit_root":"5f134ae371eba94456d5c0753b64d5e10d0732c13b52b4850dd18b38dde189f6","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T44-aedafb4bbd71a2eb","kind":"submit","lines":[{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"MCP clients **SHOULD** provide the most specific URI that they can for the MCP server they intend to access","kind":"observe","local_id":"t44_o1","terms":["canonical server URI","client resource identifier specificity"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"implementations **SHOULD** accept uppercase scheme and host components for robustness and interoperability.","kind":"observe","local_id":"t44_o2","terms":["uppercase scheme and host acceptance"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"implementations **SHOULD** consistently use the form without the trailing slash for better interoperability","kind":"observe","local_id":"t44_o3","terms":["trailing slash normalisation","exception for semantically significant slash"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"MCP clients **MUST** send this parameter regardless of whether authorization servers support it.","kind":"observe","local_id":"t44_o4","terms":["resource parameter sent regardless of AS support"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Note that authorization **MUST** be included in every HTTP request from client to server.","kind":"observe","local_id":"t44_o5","terms":["authorization header on every request"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Access tokens **MUST NOT** be included in the URI query string","kind":"observe","local_id":"t44_o6","terms":["no access tokens in query string"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"MCP servers **MUST** validate that access tokens were issued specifically for them as the intended audience,","kind":"observe","local_id":"t44_o7","terms":["audience validation by resource server"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Invalid or expired tokens **MUST** receive a HTTP 401","kind":"observe","local_id":"t44_o8","terms":["401 for invalid or expired tokens"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"MCP clients **MUST NOT** send tokens to the MCP server other than ones issued by the MCP server's authorization server.","kind":"observe","local_id":"t44_o9","terms":["token issuer restriction for clients"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"**MUST NOT** assume refresh tokens will be issued; the AS retains discretion","kind":"observe","local_id":"t44_o10","terms":["refresh token issuance left to AS discretion"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"**MAY** add `offline_access` to the `scope` parameter of the authorization and token requests","kind":"observe","local_id":"t44_o11","terms":["offline_access optional, conditional on scopes_supported"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Invalid scopes or insufficient permissions","kind":"observe","local_id":"t44_o13","terms":["403 for insufficient scope"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"draft-ietf-oauth-v2-1-13#section-5.2","kind":"observe","local_id":"t44_o14","terms":["OAuth 2.1 draft-13 pinned for token handling"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"draft-ietf-oauth-v2-1-14#section-4.3","kind":"observe","local_id":"t44_o15","terms":["OAuth 2.1 draft-14 pinned for refresh token confidentiality"]},{"as_of":null,"based_on":["t44_o1"],"kind":"claim","local_id":"t44_c1","object":"most specific URI for the target MCP server","predicate":"SHOULD provide","stance":"reported","subject":"MCP clients","text":"MCP clients SHOULD provide the most specific URI they can for the MCP server they intend to access, as the canonical server URI."},{"as_of":null,"based_on":["t44_o2"],"kind":"claim","local_id":"t44_c2","object":"uppercase scheme and host components","predicate":"SHOULD accept","stance":"reported","subject":"implementations","text":"Implementations SHOULD accept uppercase scheme and host components in canonical URIs, although the canonical form is lowercase."},{"as_of":null,"based_on":["t44_o3"],"kind":"claim","local_id":"t44_c3","object":"unless semantically significant","predicate":"SHOULD be consistently omitted","stance":"qualified","subject":"trailing slash in server URI","text":"Implementations SHOULD use the form of the URI without a trailing slash, unless the trailing slash is semantically significant for the resource."},{"as_of":null,"based_on":["t44_o4"],"kind":"claim","local_id":"t44_c4","object":"resource parameter in authorization requests","predicate":"MUST send","stance":"reported","subject":"MCP clients","text":"MCP clients MUST send the resource parameter in authorization requests regardless of whether the authorization server supports it."},{"as_of":null,"based_on":["t44_o5"],"kind":"claim","local_id":"t44_c5","object":"every HTTP request from client to server","predicate":"MUST be included in","stance":"reported","subject":"authorization header","text":"The authorization header MUST be included in every HTTP request from client to server, extending the Bearer requirement across all requests."},{"as_of":null,"based_on":["t44_o6"],"kind":"claim","local_id":"t44_c6","object":"URI query string","predicate":"MUST NOT be included in","stance":"reported","subject":"access tokens","text":"Access tokens MUST NOT be included in the URI query string of requests to MCP servers."},{"as_of":null,"based_on":["t44_o9"],"kind":"claim","local_id":"t44_c9","object":"tokens not issued by the server's authorization server","predicate":"MUST NOT send tokens","stance":"reported","subject":"MCP clients","text":"MCP clients MUST NOT send tokens to an MCP server unless the token was issued by that server's authorization server."},{"as_of":null,"based_on":["t44_o10"],"kind":"claim","local_id":"t44_c10","object":"issuance guaranteed","predicate":"MUST NOT be assumed by clients","stance":"qualified","subject":"refresh token issuance","text":"Clients MUST NOT assume refresh tokens will be issued, because the authorization server retains discretion; this is qualified by AS discretion."},{"as_of":null,"based_on":["t44_o11"],"kind":"claim","local_id":"t44_c11","object":"when listed in scopes_supported","predicate":"MAY be added by clients","stance":"qualified","subject":"offline_access scope","text":"Clients MAY add offline_access to scope only when the AS metadata lists it in scopes_supported; the option is conditional rather than unconditional."},{"as_of":null,"based_on":["t44_o13"],"kind":"claim","local_id":"t44_c13","object":"HTTP 403 Forbidden","predicate":"is answered with","stance":"reported","subject":"insufficient scopes or permissions","text":"Insufficient scopes or permissions are answered with HTTP 403 Forbidden in the error table, which is a status-code usage rather than a stated MUST for that case."},{"about":["scope challenge handling","insufficient scope errors","WWW-Authenticate"],"kind":"question","local_id":"t44_q1","needed":"Check the rest of the document after this section for the scope challenge procedure and its use of RFC 9728 metadata.","text":"The Scope Challenge Handling subsection is only a heading and an introductory sentence in this section; the runtime insufficient-scope challenge procedure and its WWW-Authenticate fields are not stated here."},{"about":["OAuth 2.1 draft pinning","authorization server details"],"kind":"question","local_id":"t44_q2","needed":"Compare the OAuth 2.1 citations and any authorization server requirements in later revisions of this document.","text":"Will a later revision pin the OAuth 2.1 references to a single stable version and resolve the draft-13 and draft-14 citations? Relates to @6ca6665902277bc7 on deferred authorization details."}],"scope":{"docs":["d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d"],"ranges":[["d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d",14820,20184]],"topic":null}},"engine_root":"2ce5771610f941d3d6c711318f0419c9135733cbff615040348f847f86215c6b","outcome":{"kind":"records","result":{"accepted":["2689f46c7797005f80a33f1d767a749bd02d72c9cd40f5ae2133d8039722f5f4","14f6c77de7ebe6b86d8eb65018c0166fce64255661b8cd115c5248ceb083900b","7a12c62c0f089dffc9ddb5b21678011426d3b30908c0c0009dd8449aee9284c6","78683c4c99540ac255162ab3242ee8f41201edbc966be6b13daca9c7ebdc3452","3afb88c991dc79cdbb05de7761c74e7885b173674ceda54a12fec67e6e2ea9e8","bcc5c129f6347ea0be45592b4deb055fab361a8adf33de9a001d601c48a6c515","fa4d882a0f9e4b311a06c4582d0ef2d362ed2c20a5dc2401ac9f9e9b2818c356","f8e36fac33aae3acdff5c