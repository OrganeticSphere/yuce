{"body":{"actor":"w2","audit_root":"e255f9c0fa2729421cc3d4a7a06509b1afef4e978cacd1089a3d846e0b35762b","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","388fc430f833e291a33eab7b8ffd612a54d4fd2510b7ef35c0599632ac25fd0a","78efa91808f3890df1f708ce3e17b6a140fe9bf7604c5411124d37a266b60e6d","b66101f3e4eb0513dd15f5fd70f11c0ff5fc120574e1a224a94652eb7539fed3","b8aad0c9bc884c02e8997d480c042678fc10115174d50419ee348c40bdddacba","e081d0bb592a36e3829ee13f994ca94ba591f281a6186f4fd9b5aec786ffb024","f111d8ab28f0e51c88d7863c6ab1f2dff608c218e36d150d405bbfc4811e72b7","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd","fa57fb9a313bdb46c473b885ad58c039022aa4190b7d77e279b4d2cd1ebbec81"],"directive":"T9-f512b13bfb8d6e45","kind":"submit","lines":[{"doc_id":"d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804","exact_quote":"The server **MAY** initiate shutdown by closing its output stream to the client and\nexiting.","kind":"observe","local_id":"t9_o4","terms":["server-initiated stdio shutdown","optional"]},{"doc_id":"d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804","exact_quote":"For HTTP [transports](/specification/2025-03-26/basic/transports), shutdown is indicated by closing the\nassociated HTTP connection(s).","kind":"observe","local_id":"t9_o5","terms":["HTTP shutdown via connection close"]},{"doc_id":"d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804","exact_quote":"When the request has not received a success or error\nresponse within the timeout period, the sender **SHOULD** issue a [cancellation","kind":"observe","local_id":"t9_o7","terms":["cancellation notification on timeout"]},{"doc_id":"d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804","exact_quote":"enforce a maximum timeout, regardless of progress notifications, to limit the impact of a\nmisbehaving client or server.","kind":"observe","local_id":"t9_o9","terms":["maximum timeout cap despite progress"]},{"doc_id":"d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804","exact_quote":"SDKs and other middleware **SHOULD** allow these timeouts to be configured on a\nper-request basis.","kind":"observe","local_id":"t9_o10","terms":["per-request timeout configuration"]},{"as_of":20250326,"based_on":["t9_o4"],"kind":"claim","local_id":"t9_c2","object":"closing output stream and exiting","predicate":"MAY initiate by","stance":"reported","subject":"stdio server shutdown","text":"The server MAY initiate stdio shutdown by closing its output stream to the client and exiting."},{"as_of":20250326,"based_on":["t9_o5"],"kind":"claim","local_id":"t9_c3","object":"closing associated HTTP connections","predicate":"indicated by","stance":"reported","subject":"HTTP shutdown","text":"For HTTP transports, shutdown is indicated by closing the associated HTTP connections; the section does not use the term protocol shutdown message."},{"as_of":20250326,"based_on":["t9_o7"],"kind":"claim","local_id":"t9_c5","object":"cancellation notification","predicate":"SHOULD issue","stance":"reported","subject":"timed-out request","text":"When a request times out without success or error response, the sender SHOULD issue a cancellation notification for it and stop waiting."},{"as_of":20250326,"based_on":["t9_o8","t9_o9"],"kind":"claim","local_id":"t9_c6","object":"progress notification, capped by maximum timeout","predicate":"MAY be reset on","stance":"qualified","subject":"timeout clock reset","text":"Implementations MAY reset the timeout clock on a corresponding progress notification, but SHOULD always enforce a maximum timeout regardless of progress."},{"as_of":20250326,"based_on":["t9_o10"],"kind":"claim","local_id":"t9_c7","object":"per request","predicate":"SHOULD allow configuration","stance":"reported","subject":"SDK timeouts","text":"SDKs and middleware SHOULD allow timeouts to be configured on a per-request basis."},{"as_of":20250326,"based_on":["t9_o11"],"kind":"claim","local_id":"t9_c8","object":"version mismatch, capability negotiation failure, request timeouts","predicate":"SHOULD be prepared to handle","stance":"reported","subject":"error cases","text":"Implementations SHOULD be prepared to handle protocol version mismatch, failure to negotiate required capabilities, and request timeouts; no disconnect behaviour is stated here."},{"as_of":null,"based_on":["t9_o5"],"kind":"claim","local_id":"t9_c11","object":"closing connections","predicate":"is not described beyond","stance":"open","subject":"HTTP server-initiated shutdown","text":"The section states HTTP shutdown only as closing connections and does not describe a server-initiated HTTP shutdown procedure."}],"scope":{"docs":["d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804"],"ranges":[["d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804",5980,7942]],"topic":null}},"engine_root":"5673db5f2315b5a7eb559c02332af005ca5e418f1311d9a3b2cb1643c583594c","outcome":{"kind":"records","result":{"accepted":["5555e9d0a5749f6b3c711d7976631adb53c493b41523144abba76745477bbe99","b5a2628dff08017c521c986af82216ea39c714473577ab0db159f10db86688a1","ed7799a43c3d5b17438b9a2596101905141e2d811f9b270f9ee175cd3ff2156c","d51982a299f390fc0b0895f0e5730712acd7cae986e3b13d663ea151e33d2839","16c18c20d1fb45e7dfd09f14bddf48a1ae221698ea2f9f57982869c0d21f2a26","25e3a25d0df4994568f2bc9a0bd1970425ca630bf94e5cd9e5d648ecc70a6967","fbd0910cf7fad843ae2c7264bfbcd2674dd7b7cfc6681a771ae2e98fb8a898aa","936878d812839afc44a31fab629b5e3f692af0614f0dc915ceae4a21900bb1e4","2dd95e43b568008f06ecba47b945dc3fbaa099d339f29563fe78746a1c7aaf3a","5e6fc11a8e732bcff3d463b83268b65b57f9b53edbe35e4cd386f840becc30ef","55612bba971af87a8cf84e2fb807ff16066f8b865e59beb1f68fbd03fa31a257","c1dc5df934d7d1872ce38fe8335525b1a5318716f843c1fb82ecd37a5367c34f"],"error":null,"failed_index":null}},"request_hash":"5348652f23e35d498a077b2bff4a6ee5477e97850c96d2