{"body":{"actor":"w2","audit_root":"4cebc34d7550917c4b5114ec9f1ccdf4eaeb23ae22409c28e7a9c97eb497351a","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T48-2685fe9700651000","kind":"submit","lines":[{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"A client that supports both modern (per-request-metadata) MCP versions and a\nlegacy version that requires an `initialize` handshake **SHOULD** probe with\n[`server/discover`][server-discover] before sending any other request,\nsetting its preferred modern version in `_meta`.","kind":"observe","local_id":"t48_o1","terms":["client supporting both modern and legacy versions should probe with server/discover first"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"legacy version that requires an `initialize` handshake **SHOULD** probe with\n[`server/discover`][server-discover] before sending any other request,\nsetting its preferred modern version in `_meta`.","kind":"observe","local_id":"t48_o2","terms":["SHOULD probe with server/discover before other requests"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"The server returns a `DiscoverResult`: the server is modern. Select a\n  mutually supported version from `supportedVersions` and continue.","kind":"observe","local_id":"t48_o3","terms":["DiscoverResult means modern server; choose a mutually supported version"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"The server returns any other error, or does not respond within a\n  reasonable timeout:","kind":"observe","local_id":"t48_o5","terms":["other error or no timely response indicates legacy server"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"- The server returns any other error, or does not respond within a\n  reasonable timeout: the server is legacy. Fall back to the `initialize`","kind":"observe","local_id":"t48_o6","terms":["fallback to initialize; timeout value unspecified"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"probing is still **RECOMMENDED**: some legacy servers do not validate that a\nrequest arrives after `initialize` and would process an era-ambiguous method\n(such as `tools/call`) under legacy semantics.","kind":"observe","local_id":"t48_o9","terms":["probing recommended for modern-only clients"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"some legacy servers do not validate that a\nrequest arrives after `initialize` and would process an era-ambiguous method","kind":"observe","local_id":"t48_o10","terms":["legacy servers may process era-ambiguous methods under legacy semantics"]},{"as_of":null,"based_on":["t48_o1","t48_o2"],"kind":"claim","local_id":"t48_c1","object":"before any other request","predicate":"SHOULD probe with server/discover before other requests","stance":"reported","subject":"client supporting modern and legacy versions","text":"A client supporting both modern and legacy versions SHOULD probe with server/discover before sending any other request, setting its preferred modern version in _meta."},{"as_of":null,"based_on":["t48_o3"],"kind":"claim","local_id":"t48_c2","object":"from supportedVersions","predicate":"is identified as modern; client selects mutually supported version","stance":"reported","subject":"server returning DiscoverResult","text":"A DiscoverResult identifies a modern server; the client selects a mutually supported version from supportedVersions and continues."},{"as_of":null,"based_on":["t48_o5","t48_o6"],"kind":"claim","local_id":"t48_c4","object":"initialize handshake","predicate":"is treated as legacy; client falls back to initialize","stance":"reported","subject":"server giving other error or no timely response","text":"A response of any other error, or no response within a reasonable timeout, marks the server as legacy and the client falls back to the initialize handshake."},{"as_of":null,"based_on":["t48_o8","t48_o9","t48_o10"],"kind":"claim","local_id":"t48_c6","object":"to avoid legacy-semantics processing of era-ambiguous methods","predicate":"is RECOMMENDED","stance":"reported","subject":"modern-only client probing","text":"Probing is RECOMMENDED even for modern-only clients, because some legacy servers do not validate that a request arrives after initialize and would process tools/call under legacy semantics."},{"as_of":null,"based_on":["t48_o2","t48_o6"],"kind":"claim","local_id":"t48_c7","object":"legacy servers only","predicate":"is qualified as fallback after server/discover probe","stance":"qualified","subject":"initialize handshake","text":"The initialize handshake is qualified: it is used only as a fallback after the server/discover probe indicates a legacy server, not as the default first request."},{"based_on":["t48_o5","t48_o6","t48_o7"],"falsifier":"A later revision of this section stating a fixed timeout value or an explicit error-code list for the fallback decision.","kind":"hypothesis","local_id":"t48_h1","text":"Interoperability of the legacy fallback depends on open items left to other pages (timeout value, compatibility matrix) and on error-code-agnostic detection, so conformance may vary until these are pinned down."}],"scope":{"docs":["d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12"],"ranges":[["d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12",5317,7172]],"topic":null}},"engine_root":"751aa7240a5a7f4d4bc5c9e5e95dd1209fdccbecbd9d9f7597d5d45f86f75654","outcome":{"kind":"records","result":{"accepted":["aedb4fe4f342cc0a21bc344fb9bda7d2c0dab9b41bd1859f9a59f2ff026b489d","29b671e25ba44e0ad6b145c6773eb1b5f7ef5cd7d5262476fce0636c7eb2c4c9","5a5e7fac57e18c032e0c3dd7e4dae34e964edc6baf3a257bbd86836bb00b0916","fb49423d9d4bda64a272cdb88f0300016bd2aa7c82a1f1449811e387816f000b","4c9410ce8b862c92be7e7ed851928dbc98dd3a434743193f798df2313e30a7f4","b59ba70be82440b15939fc33e8105842d0d34049a9c82eb0fdaa14404376123c","3ca913caca7c734c32525df6befd3ac3867679bfd003a8e96a8105b1cee88111","8c0610e230af8a3d767c2eb81329ea47aa170eb4931e945bf3ff647ee4a69ae9","385213f8587eb4f8cd613607f183a4d4afdef4236bdacc482dd0f660d9ccc6ba","ca997fd57a7b5755e0acce88c71f912a10c7c36c2a86f787061a4676c931be7f","80e8fafa3352e1d9049b6eb14c091a6a1831d6611c6c9097b2d2f74ae156c498","e057306f2c0361195ff3a6a0cc307d43a2c81b4a44ba8c8c712050249aa7fa7c","46f905af2cfb26c7f82ed399bcc3d9af9a559ec7d5d263db7b16c4e83de437f0"],"error":null,"failed_index":null}},"request_hash":"7fe4304f483d7655f7d9f359236f47ed657a0c69b35de3634ea27d3f476e1fdf","submission_id":"T48-2685fe9700651000#2"},"hash":"5f5642c99a01a0e6ddefd4be0be72c49ce66d7f6e4832bf2cf5a052a24105e58","header":{"body_hash":"5b0c5c28c7ca204f18aceceeb422d262eb64cec86237985d3799544c4895b215","format":"sbgk-session-log/3","previous":"20a92e2104c8fb0e3e8295f05eefef4c7d2139de101478798dc7604cb145ef43","records_root":"a050f07ac2cceebdf1c49e11671f03818ce616fed10578f744792ae5e9aeef73","seq":247,"wal_op":"audit"}}
