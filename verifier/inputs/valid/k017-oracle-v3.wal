 validate access tokens as described in OAuth 2.1 Section 5.2."},{"as_of":null,"based_on":["t25_o14"],"kind":"claim","local_id":"t25_c8","object":"OAuth 2.1 Section 7 security best practices","predicate":"MUST follow","stance":"reported","subject":"implementations","text":"Implementations MUST follow OAuth 2.1 security best practices as laid out in OAuth 2.1 Section 7."},{"based_on":["t25_o15","t25_o1"],"falsifier":"A statement in the document pinning the draft as stable or a later revision adopting the final RFC without change.","kind":"hypothesis","local_id":"t25_h1","text":"The section's OAuth 2.1 requirements are anchored to draft-ietf-oauth-v2-1-13 rather than a final RFC, so they may be qualified once that draft is finalized."}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",24431,30038]],"topic":null}},"engine_root":"4c8252c2556dff673cc0d2debd69a1d49bdfa00777ddc1307fca0de8b7c53364","outcome":{"kind":"records","result":{"accepted":["503fc469fc1f2f6c0a6e2cf558560d8554590a9d04ac29ceab7ddd0901915afd","dc508fddae62c4a0bd80bd0b03a2b4198efa4d95c44c42363bb26994326afc46","83bef55b267658083923d691cc92c209212c746b5d4fa49ca296eafb9243eeda","bf785f29bacecc0fe23fee3cbc0160bab2e8faec36d246c51403c80716cea991","934013a99c3c473ce06e8b25272c94f2c17ef0dc0b4775bc4050b150374aa189"],"error":null,"failed_index":null}},"request_hash":"ac0b01b802883c11888541134d60df887c96994c4e4f4ae72204bb82c197f945","submission_id":"T25-5c650edee851f1b3#2"},"hash":"7de37e6518766826eb25f3716de598e7fde86297c09518ec178d44cf90fe9b6b","header":{"body_hash":"12632036591eec3103128fc6c9c32911f2e2cd729cd11e742d514f2350920969","format":"sbgk-session-log/3","previous":"e27d69fc8fb51945fa1dbbf7aeb0dd5bd22983f193fa8f36d3c542ef0c3245b9","records_root":"a2352f95b8a3379e7a9c9348b8c89a96ed79f4cc650b3cb1579d2df45035620c","seq":120,"wal_op":"audit"}}
