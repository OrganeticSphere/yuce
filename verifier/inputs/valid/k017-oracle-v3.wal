{"body":{"actor":"w2","audit_root":"917ba508cfaf904c07fa784ee11d02e4815466751b2beab0676327a704c9eaef","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T72-a29ee87f8856b46d","kind":"submit","lines":[{"doc_id":"d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e","exact_quote":"The server **MAY** initiate shutdown by closing its output stream to the client and\nexiting.","kind":"observe","local_id":"t72_o6","terms":["stdio shutdown","server initiated"]},{"doc_id":"d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e","exact_quote":"shutdown is indicated by closing the\nassociated HTTP connection(s).","kind":"observe","local_id":"t72_o7","terms":["HTTP shutdown","connection closing"]},{"doc_id":"d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e","exact_quote":"enforce a maximum timeout, regardless of progress notifications, to limit the impact of a\nmisbehaving client or server.","kind":"observe","local_id":"t72_o10","terms":["maximum timeout","progress notifications"]},{"doc_id":"d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e","exact_quote":"SDKs and other middleware **SHOULD** allow these timeouts to be configured on a\nper-request basis.","kind":"observe","local_id":"t72_o11","terms":["per-request timeout configuration"]},{"as_of":null,"based_on":["t72_o6"],"kind":"claim","local_id":"t72_c4","object":"shutdown by closing output stream (stdio)","predicate":"MAY initiate","stance":"reported","subject":"server","text":"The server MAY initiate stdio shutdown by closing its output stream to the client and exiting."},{"as_of":null,"based_on":["t72_o7"],"kind":"claim","local_id":"t72_c5","object":"closing associated HTTP connections","predicate":"is indicated by","stance":"reported","subject":"HTTP transport shutdown","text":"For HTTP transports, shutdown is signalled by closing the associated HTTP connection(s)."},{"as_of":null,"based_on":["t72_o9","t72_o10"],"kind":"claim","local_id":"t72_c7","object":"SHOULD always enforce maximum timeout","predicate":"is qualified by","stance":"qualified","subject":"request timeout reset on progress","text":"Progress notifications MAY reset the request timeout clock, but implementations SHOULD still always enforce a maximum timeout regardless of progress, qualifying the reset option."},{"as_of":null,"based_on":["t72_o11","t72_o8"],"kind":"claim","local_id":"t72_c8","object":"configurable per-request SHOULD without defaults","predicate":"are left unspecified as","stance":"open","subject":"timeout values","text":"Per-request timeouts are only SHOULD-configurable in SDKs and middleware, and the section gives no default or maximum timeout value."},{"based_on":["t72_o6","t72_o8"],"falsifier":"A later revision of this section stating timeout or shutdown behaviour as an unconditional MUST without change.","kind":"hypothesis","local_id":"t72_h1","text":"Shutdown and timeout guidance in this section is framed as SHOULD/MAY only, so implementations may diverge on timeout and shutdown behaviour in ways conformance tests must account for."}],"scope":{"docs":["d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e"],"ranges":[["d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e",4807,9442]],"topic":null}},"engine_root":"5e56cf12eaf20974935c0e3049cf163bd3f6b61939e60bc9a64daebb18f2897e","outcome":{"kind":"records","result":{"accepted":["996851c551049c7603f662753315348260128c78af4e81ecc17974f50fe0635f","96ec5907514f5a515077f4e4ae599e14fe9d3f965529f92d7c2065b7fe9fa698","f5e36e73d06f70abaf0b9284755c5449a2c5131723afce64686b782f4fc7c830","976af4b5e7e971642dd060da21c984da4a10f43da97739b25e2c7b19b4fa316a","3fb9b03f561b9dea2ee651552e7700d9d740a082cd804ed4eaef1c3eb96d56dd","3ff54e02ef8e3343168feb893537e962d2f155351c43f4292d3d7e827e2ef8b4","18867f6afc1d58ad8eb5a4fdb2322513fe504489f4427a2c9f11207398980b52","751eef71d41cb02af2e06a71689f0fe27f4512fa57d1c7ce6322dbb63bc4edfd","b4107e7eb41b0e4aa9a74d2481b21e2a20182ac8692b5aac8af1a7745e130575"],"error":null,"failed_index":null}},"request_hash":"f9407ad67ca291e04773a5b5d2569566b905288ec7e9bf4420d1ad4efe6419ab","submission_id":"T72-a29ee87f8856b46d#2"},"hash":"401077721246dd486b2b3b8925671fe206bf0a79ff0f0029dd8a6727b8308733","header":{"body_hash":"2c6cc45b4d3e7273278a0a599b3ac5d88ffee7ac4dea55f46e81e2e5e51f851a","format":"sbgk-session-log/3","previous":"5e2740d7c3aafbc6b1fa57aa7d2c478296fd97ef032430a375fdf14a4d2db61c","records_root":"ee68435986219652760bcec626b08216924ea6be2f382be75c33324169ada96c","seq":350,"wal_op":"audit"}}
{"body":{"actor":"w2","audit_root":"ca30fa27aa5a6ebff5358f7da9464a0979992f71b0bd08763e6616b8e2640eaf","command":{"checkpoint":{"context":{"abandoned":false,"agent":"w2","circle":13,"circle_phase":"READ","kind":"EXTEND","link_task":null,"offered":28,"refusals":1,"stored":28,"sync_step":25,"task_id":"T72-a29ee87f8856b46d"},"from":0,"key":"task:doc:d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e#1","to":0},"kind":"batch","operations":[]},"engine_root":"5e56cf12eaf20974935c0e3049cf163bd3f6b61939e60bc9a64daebb18f2897e","outcome":{"kind":"value","result":{"accepted_operations":0,"checkpointed":true,"error":null,"failed_index":null,"results":[]}},"request_hash":"d008cebe89e3d6b70373d61e88920e55cdc9e98942eca902e15305a21dcea5d6","submission_id":"T72-a29ee87f8856b46d#done3"},"hash":"a916b2a8aad8dd75850eefc31f081fb2aeb0d5fcd588f5571d4e6c373cec0dfb","header":{"body_hash":"30b3c1398763248fcf1dcc76e801b70b9909dad3f5a8d3ea3ef3f8d7814b4b1d","format":"sbgk-session-log/3","previous":"401077721246dd486b2b3b8925671fe206bf0a79ff0f0029dd8a6727b8308733","records_root":"fe7c90ca2214e168f5ffe6cccb15729c3b8a03c403e48c406441cd589fdd8c41","seq":351,"wal_op":"audit"}}
{"body":{"actor":"w4","audit_root":"ea3044bb5f25c0550638ba001ef7f246c9bba6fee869d2997702b8170fb4507a","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T71-1bf63185f8bbee93","kind":"submit","lines":[{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"The body of the POST request **MUST** be a single JSON-RPC _request_, _notification_, or _response_.","kind":"observe","local_id":"t71_o1","terms":["JSON-RPC body","single message requirement"]},{"as_of":null,"based_on":["t71_o1"],"kind":"claim","local_id":"t71_c1","object":"a single JSON-RPC request, notification, or response","predicate":"MUST be","stance":"reported","subject":"body of the POST request","text":"The client POST request body MUST contain exactly one single JSON-RPC request, notification, or response."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"The client **MUST** include an `Accept` header, listing both `application/json` and\n   `text/event-stream` as supported content types.","kind":"observe","local_id":"t71_o2","terms":["Accept header","supported content types"]},{"as_of":null,"based_on":["t71_o2"],"kind":"claim","local_id":"t71_c2","object":"application/json and text/event-stream","predicate":"MUST list both","stance":"reported","subject":"client Accept header","text":"Clients sending POST messages MUST include an Accept header listing both application/json and text/event-stream."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"If the server accepts the input, the server **MUST** return HTTP status code 202\n     Accepted with no body.","kind":"observe","local_id":"t71_o3","terms":["JSON-RPC response or notification","HTTP 202 Accepted"]},{"as_of":null,"based_on":["t71_o3"],"kind":"claim","local_id":"t71_c3","object":"HTTP status code 202 Accepted with no body","predicate":"MUST receive","stance":"reported","subject":"accepted JSON-RPC response or notification","text":"When accepting a JSON-RPC response or notification input, the server MUST return HTTP 202 Accepted with no body."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"To avoid message loss due to disconnection, the server **MAY** make the stream\n       [resumable](#resumability-and-redelivery).","kind":"observe","local_id":"t71_o4","terms":["stream resumability","message loss mitigation"]},{"as_of":null,"based_on":["t71_o4"],"kind":"claim","local_id":"t71_c4","object":"disconnection message loss","predicate":"is an optional mitigation (MAY) against","stance":"qualified","subject":"making stream resumable","text":"Making an SSE stream resumable to mitigate message loss from disconnection is optional (MAY), leaving resumability qualified rather than mandatory."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"The server **MAY** terminate the SSE stream if the [session](#session-management)\n     expires.","kind":"observe","local_id":"t71_o5","terms":["session expiration","SSE stream termination"]},{"as_of":null,"based_on":["t71_o5"],"kind":"claim","local_id":"t71_c5","object":"servers","predicate":"is permitted (MAY) for","stance":"qualified","subject":"SSE stream termination upon session expiration","text":"Server termination of an SSE stream upon session expiration is optional (MAY), qualifying session enforcement behavior."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"Disconnection **SHOULD NOT** be interpreted as the client cancelling its request.","kind":"observe","local_id":"t71_o6","terms":["client disconnection","request cancellation interpretation"]},{"as_of":null,"based_on":["t71_o6"],"kind":"claim","local_id":"t71_c6","object":"request cancellation","predicate":"SHOULD NOT be interpreted by servers as","stance":"qualified","subject":"client disconnection","text":"Servers are advised (SHOULD NOT) not to interpret client disconnection as request cancellation."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"To cancel, the client **SHOULD** explicitly send an MCP `CancelledNotification`.","kind":"observe","local_id":"t71_o7","terms":["client cancellation","CancelledNotification"]},{"as_of":null,"based_on":["t71_o7"],"kind":"claim","local_id":"t71_c7","object":"request cancellation","predicate":"SHOULD be used by clients for","stance":"qualified","subject":"explicit MCP CancelledNotification","text":"Explicitly sending an MCP CancelledNotification is a recommendation (SHOULD) for client cancellation rather than an absolute mandate."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"The server **MUST** send each of its JSON-RPC messages on only one of the connected\n   streams; that is, it **MUST NOT** broadcast the same message across multiple streams.","kind":"observe","local_id":"t71_o8","terms":["multiple connections","broadcast prohibition"]},{"as_of":null,"based_on":["t71_o8"],"kind":"claim","local_id":"t71_c8","object":"servers","predicate":"MUST NOT be performed by","stance":"reported","subject":"JSON-RPC message broadcasting across streams","text":"Servers MUST NOT broadcast the same JSON-RPC message across multiple connected streams."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"The client **MUST** respect the `retry` field,\n     waiting the given number of milliseconds before attempting to reconnect.","kind":"observe","local_id":"t71_o9","terms":["retry field","reconnection backoff"]},{"as_of":null,"based_on":["t71_o9"],"kind":"claim","local_id":"t71_c9","object":"clients before reconnecting","predicate":"MUST be respected by","stance":"reported","subject":"SSE retry field","text":"Clients MUST respect the SSE retry field duration before attempting reconnection when a connection closes."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"The server **MUST NOT** send a JSON-RPC _response_ on the stream **unless**\n     [resuming](#resumability-and-redelivery) a stream associated with a previous client\n     request.","kind":"observe","local_id":"t71_o10","terms":["GET SSE stream","JSON-RPC response restriction"]},{"as_of":null,"based_on":["t71_o10"],"kind":"claim","local_id":"t71_c10","object":"resuming a stream for a prior client request","predicate":"MUST NOT occur unless","stance":"reported","subject":"sending JSON-RPC response on GET stream","text":"Servers MUST NOT send a JSON-RPC response on a GET-initiated SSE stream unless resuming a stream associated with a prior client request."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"server **MAY** close the _connection_ (without terminating the _SSE stream_)\n     at any time in order to avoid holding a long-lived connection. The client\n     **SHOULD** then \"poll\" the SSE stream by attempting to reconnect.","kind":"observe","local_id":"t71_o11","terms":["polling SSE stream","connection close"]},{"as_of":null,"based_on":["t71_o11"],"kind":"claim","local_id":"t71_c11","object":"SSE stream transport","predicate":"is qualified as optional (MAY/SHOULD) for","stance":"qualified","subject":"short-lived connection polling","text":"Servers MAY close connections to avoid holding long-lived connections, prompting clients to poll by reconnecting (SHOULD)."},{"about":["t71_o4"],"kind":"question","local_id":"t71_q1","needed":"Check resumability requirements in later revisions of the Streamable HTTP transport spec.","text":"Does a later revision mandate stream resumability (MUST) rather than treating it as an optional (MAY) mitigation for disconnection?"}],"scope":{"docs":["d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e"],"ranges":[["d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e",3422,8193]],"topic":null}},"engine_root":"5d095b6701bf4cf23d3f7c393d1dd6e0955f6fd770d34e12cb8b1d0c840cbbd7","outcome":{"kind":"records","result":{"accepted":["44d49c171de18dc34088a867001ab985161a7472313de5068e70dfaef790b32f","7d535ddec40eff39659b046d1f78aec84c46caf0a9b2831bd7b9a01b9c6f12ef","0d5bc7b72eaf443aa9bb785ffe78d7c8e9fe5e0758c148f54b858f38535307c3","54536595a4ca8c7074652919e0bcf9fdce7812b9a6129a46c46c033ebe7cf55e","1c4989761401c5ae33c6acfe61330e750fcfdc4a26ab80f9468ce18acf6e2bf4","a6cdaa5199f3ec55bf2ecabb570723109ffc056ecc75a9bfb027ec71dcf3c34f","0b666e21018ad8741fa1552f8940eec5f578a6ecb612de210fb52824bddd8632","2b69da0515e0d3f1ca105f29947813ed89ac48dc89f48179cf85540d29684acc","82404f8b56f69f68cef692fa2f08d2b0b199a2ba870319450d1ffe7fd6234102","63955cedd710a7e31b8003379289de7811c00450c10c2f6683b7c81002b52d12","73492a6f225bfc50ee87742b52b7745d729e4245c040c20fc96b2b4d41d69b59","efa85a2c291cde372d3f2a4153b29003f3ca0baa5d15b4600f96f55a53787826","dd2615076fc38e34088edc7cde83d5166ee7d3ec1263da870fc7b17b2d38ab54","58976bc6013d64871c50f86feeff53cc51a9c98bd7380c206fbbb69ea3bb91a6","dcbe721ce8da8b6ed3d341f2b1d5bce96c777c847a9955b766f9741451f3c468","138541af78f2bdabbf3767a7a62631300bc5011e4c67b10cea4bafc5157ed8c7","c3b37b2a7