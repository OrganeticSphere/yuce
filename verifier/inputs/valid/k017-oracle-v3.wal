{"body":{"actor":"w2","audit_root":"b5f10817400ba3c6ba95b7f916a7da4344369839e95873e91d1cb2e21875ba8f","command":{"allowed_records":[],"directive":"T2-6a111f0d3f47d141","kind":"submit","lines":[{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"For servers that do not implement OAuth 2.0 Authorization Server Metadata, clients","kind":"observe","local_id":"t2_o1","terms":["fallback default endpoint paths when metadata discovery is absent"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"Clients **MUST** first attempt to discover endpoints via the metadata document before","kind":"observe","local_id":"t2_o2","terms":["discovery must be attempted before using default paths"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"When using default paths, all other protocol requirements","kind":"observe","local_id":"t2_o3","terms":["default paths do not alter other protocol requirements"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"to allow MCP clients to obtain OAuth client IDs without user interaction.","kind":"observe","local_id":"t2_o4","terms":["dynamic client registration is a SHOULD and enables registration without user interaction"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"Any MCP servers that _do not_ support Dynamic Client Registration need to provide","kind":"observe","local_id":"t2_o5","terms":["servers without dynamic registration must offer an alternative client ID route"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"Hardcode a client ID (and, if applicable, client secret) specifically for that MCP","kind":"observe","local_id":"t2_o6","terms":["first alternative registration option: hardcoded client credentials"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"Servers **SHOULD** enforce token expiration and rotation","kind":"observe","local_id":"t2_o7","terms":["token expiration and rotation are recommended, not mandated"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"Redirect URIs **MUST** be either localhost URLs or HTTPS URLs","kind":"observe","local_id":"t2_o8","terms":["redirect URI restriction to localhost or HTTPS"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"[OAuth 2.1 Section 5](https://datatracker.ietf.org/doc/html/draft-ietf-oauth-v2-1-12#section-5)","kind":"observe","local_id":"t2_o9","terms":["token requirements anchored to an OAuth 2.1 draft version"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"Invalid or expired tokens **MUST** receive a HTTP 401","kind":"observe","local_id":"t2_o10","terms":["invalid or expired tokens must yield HTTP 401"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"Invalid scopes or insufficient permissions","kind":"observe","local_id":"t2_o11","terms":["403 status used for scope and permission failures"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"Clients cannot know all possible servers in advance","kind":"observe","local_id":"t2_o12","terms":["rationale for dynamic client registration"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"All authorization endpoints **MUST** be served over HTTPS","kind":"observe","local_id":"t2_o13","terms":["authorization endpoints must use HTTPS"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"Authorization: Bearer <access-token>","kind":"observe","local_id":"t2_o14","terms":["bearer token sent in the Authorization header"]},{"as_of":null,"based_on":["t2_o1","t2_o2","t2_o3"],"kind":"claim","local_id":"t2_c1","object":"servers without Authorization Server Metadata","predicate":"apply when","stance":"qualified","subject":"default endpoint paths","text":"Default endpoint paths (/authorize, /token, /register) apply only to servers without metadata discovery, and discovery must be tried first."},{"as_of":null,"based_on":["t2_o4","t2_o12"],"kind":"claim","local_id":"t2_c2","object":"SHOULD support","predicate":"requirement level","stance":"qualified","subject":"Dynamic Client Registration","text":"Dynamic Client Registration is a SHOULD requirement for MCP clients and servers, not a MUST."},{"as_of":null,"based_on":["t2_o5","t2_o6"],"kind":"claim","local_id":"t2_c3","object":"hardcoded client ID or user-entry UI","predicate":"must provide","stance":"open","subject":"servers without Dynamic Client Registration","text":"Servers without Dynamic Client Registration must provide a client ID by hardcoding it or via a user-entry UI; no other mechanism is specified."},{"as_of":null,"based_on":["t2_o7"],"kind":"claim","local_id":"t2_c4","object":"token expiration and rotation","predicate":"should enforce","stance":"open","subject":"servers","text":"Servers SHOULD enforce token expiration and rotation, which is recommended rather than mandatory."},{"as_of":null,"based_on":["t2_o8"],"kind":"claim","local_id":"t2_c5","object":"localhost or HTTPS URLs","predicate":"must be","stance":"reported","subject":"redirect URIs","text":"Redirect URIs must be localhost URLs or HTTPS URLs, and servers must validate them."},{"as_of":null,"based_on":["t2_o9"],"kind":"claim","local_id":"t2_c6","object":"draft-ietf-oauth-v2-1-12 Section 5","predicate":"conform to","stance":"qualified","subject":"access token requirements","text":"Token requirements are tied to a draft version of OAuth 2.1 (draft-ietf-oauth-v2-1-12), not a final RFC."},{"as_of":null,"based_on":["t2_o10"],"kind":"claim","local_id":"t2_c7","object":"HTTP 401","predicate":"must receive","stance":"reported","subject":"invalid or expired access tokens","text":"Invalid or expired access tokens must receive an HTTP 401 response."},{"as_of":null,"based_on":["t2_o11"],"kind":"claim","local_id":"t2_c8","object":"invalid scopes or insufficient permissions","predicate":"used for","stance":"reported","subject":"HTTP 403","text":"HTTP 403 is used for invalid scopes or insufficient permissions."},{"as_of":null,"based_on":["t2_o14"],"kind":"claim","local_id":"t2_c9","object":"Authorization Bearer header","predicate":"must be sent in","stance":"reported","subject":"access tokens","text":"Access tokens must be sent in the Authorization: Bearer header and never in the URI query string."},{"as_of":null,"based_on":["t2_o13"],"kind":"claim","local_id":"t2_c10","object":"HTTPS","predicate":"must be served over","stance":"reported","subject":"authorization endpoints","text":"All authorization endpoints must be served over HTTPS."},{"about":["alternative client registration","servers without DCR"],"kind":"question","local_id":"t2_q1","needed":"Search the rest of the corpus for elaboration of the two alternative registration options beyond this section.","text":"Whether the hardcoded or UI-entry alternatives to Dynamic Client Registration are defined further anywhere in the report."},{"about":["OAuth 2.1 draft version","access token requirements"],"kind":"question","local_id":"t2_q2","needed":"Check the report's other sections or cited sources for a final OAuth 2.1 RFC and its section 5 wording.","text":"Whether the cited OAuth 2.1 draft-12 has been superseded by a final RFC, which would change the token requirements."}],"scope":{"docs":["d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d"],"ranges":[["d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d",5880,11692]],"topic":null}},"engine_root":"282f2f974a9935f9ad1597a08aab5eb526ddcf9704b6616adf515042d347f902","outcome":{"kind":"records","result":{"accepted":["d5f785c1c337f3ca46ee208356076a241d1288acda1ebeebd043f872145