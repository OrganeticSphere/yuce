 page (/extensions/tasks/overview) label the extension as experimental or stable, and with what exact wording?"}],"scope":{"docs":["d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa"],"ranges":[["d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa",0,5784]],"topic":null}},"engine_root":"0738a800d5863a71b6944541e19195b32477347c28ba5ada240cfdcfa9f746d6","outcome":{"kind":"records","result":{"accepted":["63c86004a35f953a3653cc2d69ed47ff7da82f578107c52a9617240910b9d25e","d1d84dcc28199c5ff3a71ab6a51ccc5c1c6f9b2acd3f7bfe9fcae5138c631c56","36053203c370d29830904b28f9ef54211a0cea7caad12308087794bf78c4cd71","94bb68f93c9510ebf961c2828c3eec81060575e70db75938b60906cee2cdf5fb","38af1b80406b6ab4932138d7e0a8dba23c0b80e5a111b2e5713180cffc269e91"],"error":null,"failed_index":null}},"request_hash":"1988d155870394b8b214b5118be22f4ec864e0228157230bd7573cf682793c27","submission_id":"TQ141-46d8d0127e4d6a15#1"},"hash":"2f811db4812fe35bbf30c01f74015c84ac48d37edd027a658fa0e7ff53d3f545","header":{"body_hash":"93535e2992fb59407a328d046f86b27d2446d75b6d6e3fb049b3ae9047daa48b","format":"sbgk-session-log/3","previous":"a66cfd7c0d05bc1a45fd93b7cc997a11a12f97636bbaf19c138f2e2acc420d18","records_root":"e1eb2d9c5afa89e4c3a1d2c6e3cdf3387882ca70bae5b6ba7ce5a266192886c8","seq":636,"wal_op":"audit"}}
