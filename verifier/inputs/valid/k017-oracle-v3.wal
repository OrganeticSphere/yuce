,"terms":["session management","Streamable HTTP","session ID assignment"]},{"as_of":null,"based_on":["t58_o8"],"kind":"claim","local_id":"t58_c8","object":"the server at initialization","predicate":"MAY be assigned by","stance":"open","subject":"Streamable HTTP session ID","text":"Session IDs are optional for Streamable HTTP servers, so stateful session establishment remains an implementation choice."}],"scope":{"docs":["d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b"],"ranges":[["d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b",5820,11806]],"topic":null}},"engine_root":"0ade222bf7242424057dc4718d4d4ab535b7a27159159ca6803a612acbecd0dd","outcome":{"kind":"records","result":{"accepted":["9ad6ca87ff0cea4faf3777b82efa58c7f3bdf8e98f18e5dc58101c2af86d57b4","9b4e968da73e3a5bf18424c572e40d8bb160c4a551999c6e33f70fbaac57b522","4e0ff86d4db4524a96c9d2165e0166b09b73557f4af111e0361d254752293c35","b894cbe29c8b85ff70a918bbc693a97519e0d0c470898763902d20665041c17e"],"error":null,"failed_index":null}},"request_hash":"d0f712f22ce1c9b4d551227cc1d032d313dba44dd6ba590b29d328e56b4cbfed","submission_id":"T58-e284ecf0d880404f#2"},"hash":"ee9fffb873f5f7058543ed0aff43f140950d5ffbd4070fe981daade8803cba10","header":{"body_hash":"dce568778371033111082e9858c2080a01f679ae8a0c7c4250792ba3d107360a","format":"sbgk-session-log/3","previous":"5497cbbb8c09528b8773c061333f5fb72b139522ed1029b78df1fd2e15ee1b8a","records_root":"bf174cf3dfe2636cf0521ac8bac9bdb2efb3f18054494afe527949af48cee3a8","seq":288,"wal_op":"audit"}}
