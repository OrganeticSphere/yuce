":["metadata fetch","SHOULD","authorization server"]},{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","exact_quote":"**SHOULD** cache metadata respecting HTTP cache headers","kind":"observe","local_id":"t73_o7","terms":["metadata caching","SHOULD"]},{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","exact_quote":"4. Prompt the user to enter the client information if no other option is available","kind":"observe","local_id":"t73_o10","terms":["fallback","manual client entry"]},{"as_of":null,"based_on":["t73_o2"],"kind":"claim","local_id":"t73_c3","object":"clients supporting all options","predicate":"SHOULD be followed by","stance":"qualified","subject":"client registration priority order","text":"Clients supporting all registration options SHOULD follow a stated priority order, so the ordering is a recommendation, not a requirement."},{"as_of":null,"based_on":["t73_o5"],"kind":"claim","local_id":"t73_c4","object":"clients","predicate":"MAY be used by","stance":"reported","subject":"private_key_jwt client authentication","text":"Clients MAY use private_key_jwt for client authentication, leaving this authentication method optional."},{"as_of":null,"based_on":["t73_o6","t73_o7"],"kind":"claim","local_id":"t73_c5","object":"authorization servers","predicate":"SHOULD be done by","stance":"qualified","subject":"metadata document fetching and caching","text":"Authorization servers SHOULD fetch metadata documents for URL-formatted client_ids and SHOULD cache them respecting HTTP cache headers, both recommendations rather than mandates."},{"as_of":null,"based_on":["t73_o10"],"kind":"claim","local_id":"t73_c7","object":"no other registration option is available","predicate":"is prompted from the user when","stance":"reported","subject":"client information entry","text":"If no registration option is available, the client prompts the user to enter client information, an unqualified fallback step."},{"about":["Client ID Metadata Documents","IETF draft dependency"],"kind":"question","local_id":"t73_q1","needed":"Check later specification revisions of the Client Registration section for changed requirement strength or updated draft/RFC citations.","text":"Does any later revision of the Client Registration section change the SHOULD support for Client ID Metadata Documents or the draft reference to a final RFC?"},{"about":["authorization server SHOULD items","private_key_jwt MAY"],"kind":"question","local_id":"t73_q2","needed":"Compare later revisions of this section for MUST upgrades or removal of these optional items.","text":"Are the SHOULD-level authorization server behaviors (fetch, cache, security considerations) and MAY private_key_jwt still optional in later revisions?"}],"scope":{"docs":["d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f"],"ranges":[["d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f",0,5793]],"topic":null}},"engine_root":"bcf70f3c29443a86ebb2692a357e9cc38d8a1d7a6af8da2f28a57682518ab965","outcome":{"kind":"records","result":{"accepted":["2eecf4b122fe062912bc0f183054525548ca716113ca29180b5a360ddbd3a298","d70982b138d0225e6183b0879878f65fa0b253d2e66d887aad5e6a72a5808e40","a576f23186596a6728dc999fdb36e5b2d9a5e9cbdb155b50aaaec9cc5f27091e","286bc8ee5f7e1cd0d377f8d840f5e5a55f6658a40914eecc71860a42b00c0da3","7f6463f615a0fd3472430dac11755bd5e43b9ef142f5084b9ec2a4be72650ad8","bde972fd43e243f18bd0dfba384ce3a0a9e9236a84cd9866dade253319534128","63ec3678f9ca04afdad07745e44b3306d5f3bec45c57b0c86ea8e05d619dcc38","54852b4569594e8f12ce14ba050fed50d8dfcc6a5315fb8e9eac55718f2e8e99","b68c74bee2bad8bc3ddf47ffadb9d1013bbfd38f6ce4a765a6ee93216c757eb1","e6ffcd8502699fa1d76f09d6c3f0f081eaacc7c01338feedbfb002b92a49c49a","01f665178394f168107149aa7c7083f82f5409f5467e850a22758b6382c0c1f1","5d678b48c8ebfb722d49281f16aa6595c93213e5044fe570e15e6f644860e39e"],"error":null,"failed_index":null}},"request_hash":"a00790fb9b74cca7ccab1920e149a4849800f2a918736401ab