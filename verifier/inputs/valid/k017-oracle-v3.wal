{"body":{"actor":"w4","audit_root":"4c8a88640d9988f6d1a93a65044afe9e35469cc215a359d886a4644a1a05e710","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T79-62d707cb46ae3766","kind":"submit","lines":[{"doc_id":"d_dea45e788499e203ea780f1415fc56f0b91296938a6a6313d3dc9e198beab04c","exact_quote":"[see GitHub](https://github.com/modelcontextprotocol/specification/compare/2024-11-05...2025-03-26).","kind":"observe","local_id":"t79_o1","terms":["protocol revision","2024-11-05","2025-03-26"]},{"doc_id":"d_dea45e788499e203ea780f1415fc56f0b91296938a6a6313d3dc9e198beab04c","exact_quote":"1. Added a comprehensive **[authorization framework](/specification/2025-03-26/basic/authorization)**\n   based on OAuth 2.1","kind":"observe","local_id":"t79_o2","terms":["authorization framework","OAuth 2.1"]},{"doc_id":"d_dea45e788499e203ea780f1415fc56f0b91296938a6a6313d3dc9e198beab04c","exact_quote":"1. Added support for JSON-RPC **[batching](https://www.jsonrpc.org/specification#batch)**","kind":"observe","local_id":"t79_o3","terms":["JSON-RPC batching"]},{"doc_id":"d_dea45e788499e203ea780f1415fc56f0b91296938a6a6313d3dc9e198beab04c","exact_quote":"1. Added comprehensive **tool annotations** for better describing tool behavior, like\n   whether it is read-only or destructive","kind":"observe","local_id":"t79_o4","terms":["tool annotations","read-only","destructive"]},{"doc_id":"d_dea45e788499e203ea780f1415fc56f0b91296938a6a6313d3dc9e198beab04c","exact_quote":"- Added `message` field to `ProgressNotification` to provide descriptive status updates","kind":"observe","local_id":"t79_o5","terms":["ProgressNotification","message field"]},{"doc_id":"d_dea45e788499e203ea780f1415fc56f0b91296938a6a6313d3dc9e198beab04c","exact_quote":"- Added support for audio data, joining the existing text and image content types","kind":"observe","local_id":"t79_o6","terms":["audio data","content types"]},{"doc_id":"d_dea45e788499e203ea780f1415fc56f0b91296938a6a6313d3dc9e198beab04c","exact_quote":"- Added `completions` capability to explicitly indicate support for argument\n  autocompletion suggestions","kind":"observe","local_id":"t79_o7","terms":["completions capability","autocompletion suggestions"]},{"as_of":20250326,"based_on":["t79_o1","t79_o2"],"kind":"claim","local_id":"t79_c1","object":"MCP specification in revision 2025-03-26","predicate":"was added to","stance":"reported","subject":"authorization framework","text":"A comprehensive authorization framework based on OAuth 2.1 was added in the 2025-03-26 revision of the MCP specification."},{"as_of":20250326,"based_on":["t79_o1","t79_o3"],"kind":"claim","local_id":"t79_c2","object":"MCP specification in revision 2025-03-26","predicate":"was added to","stance":"reported","subject":"JSON-RPC batching","text":"Support for JSON-RPC batching was added to the MCP specification in the 2025-03-26 revision."},{"as_of":20250326,"based_on":["t79_o1","t79_o4"],"kind":"claim","local_id":"t79_c3","object":"tool behavior including read-only or destructive status","predicate":"were added for describing","stance":"reported","subject":"tool annotations","text":"Tool annotations were added in the 2025-03-26 revision for describing tool behavior, including whether a tool is read-only or destructive."},{"as_of":20250326,"based_on":["t79_o1","t79_o5"],"kind":"claim","local_id":"t79_c4","object":"descriptive status updates","predicate":"was added to provide","stance":"reported","subject":"ProgressNotification message field","text":"A message field was added to ProgressNotification in the 2025-03-26 revision to provide descriptive status updates."},{"as_of":20250326,"based_on":["t79_o1","t79_o6"],"kind":"claim","local_id":"t79_c5","object":"existing text and image content types","predicate":"was added to join","stance":"reported","subject":"audio data","text":"Support for audio data was added in the 2025-03-26 revision, joining existing text and image content types."},{"as_of":20250326,"based_on":["t79_o1","t79_o7"],"kind":"claim","local_id":"t79_c6","object":"argument autocompletion suggestions","predicate":"was added to indicate support for","stance":"reported","subject":"completions capability","text":"The completions capability was added in the 2025-03-26 revision to explicitly indicate support for argument autocompletion suggestions."},{"about":["@8599201b97088cc4","JSON-RPC batching"],"kind":"question","local_id":"t79_q1","needed":"Check subsequent specification revisions changelog and schema for removal of JSON-RPC batching","text":"Was JSON-RPC batching support added in revision 2025-03-26 later removed in a subsequent specification revision as reported in claim @8599201b97088cc4?"}],"scope":{"docs":["d_dea45e788499e203ea780f1415fc56f0b91296938a6a6313d3dc9e198beab04c"],"ranges":[["d_dea45e788499e203ea780f1415fc56f0b91296938a6a6313d3dc9e198beab04c",0,1666]],"topic":null}},"engine_root":"5457cb04c82d285f05d2e2e696d35438d5bbe7cef85aefea9a41520542c1a738","outcome":{"kind":"records","result":{"accepted":["ca23acc6d28c2305465fc327becf1e9a27ea14af24a0a3ad5ad6762c580973d0","f1ada86e113b82fd3e1dbf1b48729594edbb04bfbdabeb5c803ae0a98ddc3383","d830f1d883d42e16c7dcf1d14eb69a04ad5d8500dd9b8468a401bb702e316f1f","50be929e16e8ec7