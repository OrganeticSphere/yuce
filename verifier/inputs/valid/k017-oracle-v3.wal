{"body":{"actor":"w3","audit_root":"e6aadf25681b1bc4a5ceee9107c6bac3346bcaecf0960379fff131ea461f9a69","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T70-f4f6b4206e823fae","kind":"submit","lines":[{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"JSON-RPC messages **MUST** be UTF-8 encoded.","kind":"observe","local_id":"t70_o1","terms":["JSON-RPC encoding"]},{"as_of":null,"based_on":["t70_o1"],"kind":"claim","local_id":"t70_c1","object":"UTF-8","predicate":"MUST be encoded as","stance":"reported","subject":"JSON-RPC messages","text":"JSON-RPC messages are required to use UTF-8 encoding."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"The protocol currently defines two standard transport mechanisms for client-server","kind":"observe","local_id":"t70_o2","terms":["standard transports"]},{"as_of":null,"based_on":["t70_o2"],"kind":"claim","local_id":"t70_c2","object":"stdio and Streamable HTTP as standard transports","predicate":"currently defines","stance":"reported","subject":"MCP protocol","text":"The protocol currently defines two standard client-server transport mechanisms: stdio and Streamable HTTP."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"It is also possible for clients and servers to implement","kind":"observe","local_id":"t70_o3","terms":["custom transports"]},{"as_of":null,"based_on":["t70_o3"],"kind":"claim","local_id":"t70_c3","object":"custom transports in a pluggable fashion","predicate":"MAY implement","stance":"reported","subject":"clients and servers","text":"Clients and servers may implement custom transports through a pluggable mechanism."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"Messages are delimited by newlines, and **MUST NOT** contain embedded newlines.","kind":"observe","local_id":"t70_o4","terms":["stdio message delimiting"]},{"as_of":null,"based_on":["t70_o4"],"kind":"claim","local_id":"t70_c4","object":"newline-delimited without embedded newlines","predicate":"MUST be","stance":"reported","subject":"stdio messages","text":"In stdio transport, JSON-RPC messages are newline-delimited and must not contain embedded newlines."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"Servers **MUST** validate the `Origin` header on all incoming connections to prevent DNS rebinding attacks","kind":"observe","local_id":"t70_o6","terms":["Origin validation","DNS rebinding"]},{"as_of":null,"based_on":["t70_o6"],"kind":"claim","local_id":"t70_c6","object":"Origin on all incoming connections","predicate":"MUST validate","stance":"reported","subject":"Streamable HTTP servers","text":"Streamable HTTP servers must validate the Origin header on every incoming connection to prevent DNS rebinding attacks."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"If the `Origin` header is present and invalid, servers **MUST** respond with HTTP 403 Forbidden.","kind":"observe","local_id":"t70_o7","terms":["invalid Origin response"]},{"as_of":null,"based_on":["t70_o7"],"kind":"claim","local_id":"t70_c7","object":"HTTP 403 Forbidden","predicate":"MUST receive","stance":"reported","subject":"invalid Origin header","text":"When an Origin header is present but invalid, the server must return HTTP 403 Forbidden; a JSON-RPC error body without an id is optional."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"Servers **SHOULD** implement proper authentication for all connections","kind":"observe","local_id":"t70_o8","terms":["server authentication"]},{"as_of":null,"based_on":["t70_o8"],"kind":"claim","local_id":"t70_c8","object":"proper authentication for all connections","predicate":"SHOULD implement","stance":"qualified","subject":"servers","text":"Proper authentication for all connections is recommended for servers, leaving authentication implementation as a qualified rather than absolute requirement."}],"scope":{"docs":["d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e"],"ranges":[["d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e",0,3422]],"topic":null}},"engine_root":"80c897c8ef8b378ffffd854174e998353d147f7c7283fbe95665b959f48c334d","outcome":{"kind":"records","result":{"accepted":["397a4b47fc3534c45aaede035eb4f17a3030c404599d3a8b79ff3be976af9ef0","43f0fa95b57f2f7ee41456ee4f1b65b80d74d5024a2ed247ff357dc18553e09e","e4e52bdba19f06323db3f3cf5153ee7746132c3f10e07536847f21d506ca0627","579f2852a610d481423f9c1cf088bbda43e12695f2dfe44924433700e13f9191","c51328ac7d9aff83abeade7a6e181467a1939cd0534d6c794e7a7fe4bfb25d1d","be89adaeb0bd0182247cd8c3ec5bbc7fc353cff73349c07d2067c664b434e314","09e86d6256cc326940ca6105e98689405ec1670143acbe6fbf46c0c91c094b66","b845dec61b1324e5067b53b434c546351b6307275a26eadb1f1b07fd388e7a8f","027f7d4ebde23ff397bd6716634d4e60f753761f5834ef935e8f190af00cd292","868d62b9d063c5c1869c61b2c7f1047a5baad89db45823d525587e367857cde8","10a25f95bbf7a8982aeff380a93927a8753682e97795f59473bccec2c76450ee","a6194081a72c1a9e5d1f087362954efe5a320743e8