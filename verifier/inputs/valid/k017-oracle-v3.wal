{"body":{"actor":"w1","audit_root":"9e8dba40cb781e8c792f3e4957264d78d1de9f853143a4d562d729c8c3cd11f6","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"TR34-1196e86d0de711de","kind":"submit","lines":[{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"Every POST request to the MCP endpoint **MUST** include an\n`MCP-Protocol-Version` header.","kind":"observe","local_id":"t34_o1","terms":["MCP-Protocol-Version header","POST requests","mandatory header"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"If the values do not match, the server **MUST** reject the request\nwith `400 Bad Request` and a `HeaderMismatch` JSON-RPC error","kind":"observe","local_id":"t34_o3","terms":["HeaderMismatch error","version mismatch rejection"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"If the server does not implement the requested protocol version (whether the\nversion is unknown to the server, or is a known version the server has chosen\nnot to support), it **MUST** respond with `400 Bad Request` and an\n[`UnsupportedProtocolVersionError`][unsupported-version]","kind":"observe","local_id":"t34_o4","terms":["UnsupportedProtocolVersionError","unimplemented protocol version"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"A server that supports clients implementing protocol versions earlier than\n`2025-06-18` (which did not define the `MCP-Protocol-Version` header) **MAY**\ntreat a request that omits the header as protocol version `2025-03-26`","kind":"observe","local_id":"t34_o6","terms":["header omission fallback","legacy client compatibility","MAY"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"If the `Mcp-Name` source value cannot be safely represented as a plain ASCII\nheader value, clients **MUST** encode it using the Base64 sentinel format","kind":"observe","local_id":"t34_o8","terms":["Base64 sentinel encoding","non-ASCII header values"]},{"as_of":null,"based_on":["t34_o1"],"kind":"claim","local_id":"t34_c1","object":"MCP-Protocol-Version header","predicate":"MUST include","stance":"reported","subject":"POST requests to the MCP endpoint","text":"Every POST request to the MCP endpoint MUST include an MCP-Protocol-Version header."},{"as_of":null,"based_on":["t34_o3"],"kind":"claim","local_id":"t34_c3","object":"400 Bad Request and HeaderMismatch JSON-RPC error","predicate":"MUST be rejected with","stance":"reported","subject":"header/body protocol version mismatch","text":"On header/body version mismatch the server MUST reject with 400 Bad Request and a HeaderMismatch JSON-RPC error."},{"as_of":null,"based_on":["t34_o4"],"kind":"claim","local_id":"t34_c4","object":"400 Bad Request with UnsupportedProtocolVersionError listing supported versions","predicate":"MUST receive","stance":"reported","subject":"unimplemented requested protocol version","text":"If the server does not implement the requested protocol version it MUST respond 400 Bad Request with an UnsupportedProtocolVersionError listing its supported versions."},{"as_of":null,"based_on":["t34_o6"],"kind":"claim","local_id":"t34_c6","object":"servers supporting pre-2025-06-18 clients","predicate":"MAY be treated as version 2025-03-26 by","stance":"qualified","subject":"requests omitting MCP-Protocol-Version","text":"A server supporting clients on protocol versions earlier than 2025-06-18 MAY treat a request omitting MCP-Protocol-Version as version 2025-03-26; otherwise it MUST reject the headerless request."},{"as_of":null,"based_on":["t34_o8"],"kind":"claim","local_id":"t34_c8","object":"Base64 sentinel format","predicate":"MUST be encoded by clients using","stance":"reported","subject":"non-ASCII-safe Mcp-Name source values","text":"Clients MUST encode an Mcp-Name source value that cannot be safely represented as plain ASCII using the Base64 sentinel format."},{"based_on":["t34_o6"],"falsifier":"A later revision retaining the MAY fallback unchanged or removing legacy client support without changing this clause.","kind":"hypothesis","local_id":"t34_h1","text":"The headerless-request fallback to 2025-03-26 is a compatibility MAY that later revisions could tighten to a MUST-reject rule once pre-2025-06-18 clients are dropped."}],"scope":{"docs":["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530"],"ranges":[["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530",10358,14905]],"topic":null}},"engine_root":"e475a5a641df6911305538450ca3f8b84317317928c8a8b63c0e5055c2292eb7","outcome":{"kind":"records","result":{"accepted":["43c0d9ae006ca9982124e00cec99eaa7adc11a1d7212c2197cbb9009d9c57dac","81c9221b60babba443f91ceece85a90c23ad72b772fb0bd5c9bbadf05e937d66","b2954a03f5e5ab56ecdb66e716a58ada6f0675ac38525f60507e86eb3154a741","dbc9388b11888a76e525568dd90aeacb2856cbe670276e3f6c85b70138eec8d6","ea7fba579c7bbc865154ecb8ec5dabb51ce852436b304686586e5556d291bb99","d3b898274974262a864da709bee1d01e0b2051e56669d39808d56bd8b96a1af2","b3c2a57fd85c9074a86a3156877f58679781803a63f9cca12135248510877d41","5aeb237f56bea32d29c4afba