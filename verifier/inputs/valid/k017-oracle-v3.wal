{"body":{"actor":"w3","audit_root":"78f34ecf87ecace11d8ff2f4e3c155d2424ea024ebd4cc24c5407cebbdc121d0","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"TR53-d6aeded36c150c7f","kind":"submit","lines":[{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"The initialization phase **MUST** be the first interaction between client and server.","kind":"observe","local_id":"t53_o1","terms":["initialization ordering"]},{"as_of":null,"based_on":["t53_o1"],"kind":"claim","local_id":"t53_c1","object":"the first client-server interaction","predicate":"MUST be","stance":"reported","subject":"initialization phase","text":"The initialization phase MUST be the first client-server interaction."},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"The client **MUST** initiate this phase by sending an `initialize` request containing:","kind":"observe","local_id":"t53_o2","terms":["client initialization request"]},{"as_of":null,"based_on":["t53_o2"],"kind":"claim","local_id":"t53_c2","object":"an initialize request","predicate":"MUST initiate initialization by sending","stance":"reported","subject":"client","text":"The client MUST initiate initialization by sending an initialize request."},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"After successful initialization, the client **MUST** send an `initialized` notification","kind":"observe","local_id":"t53_o3","terms":["initialized notification"]},{"as_of":null,"based_on":["t53_o3"],"kind":"claim","local_id":"t53_c3","object":"an initialized notification after successful initialization","predicate":"MUST send","stance":"reported","subject":"client","text":"After successful initialization, the client MUST send an initialized notification before normal operations."},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"If the server supports the requested protocol version, it **MUST** respond with the same\nversion.","kind":"observe","local_id":"t53_o6","terms":["version negotiation"]},{"as_of":null,"based_on":["t53_o6"],"kind":"claim","local_id":"t53_c5","object":"the requested protocol version when supported","predicate":"MUST respond with","stance":"reported","subject":"server","text":"If the server supports the client's requested protocol version, it MUST respond with that same version."},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"Otherwise, the server **MUST** respond with another protocol version it\nsupports.","kind":"observe","local_id":"t53_o7","terms":["version fallback"]},{"as_of":null,"based_on":["t53_o7"],"kind":"claim","local_id":"t53_c6","object":"another supported protocol version when the requested version is unsupported","predicate":"MUST respond with","stance":"reported","subject":"server","text":"If the server does not support the requested version, it MUST respond with another protocol version it supports."},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"If the client does not support the version in the server's response, it **SHOULD**\ndisconnect.","kind":"observe","local_id":"t53_o8","terms":["version incompatibility"]},{"as_of":null,"based_on":["t53_o8"],"kind":"claim","local_id":"t53_c7","object":"the server's returned version is unsupported","predicate":"SHOULD disconnect when","stance":"qualified","subject":"client","text":"A client that does not support the version returned by the server SHOULD disconnect."},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"If using HTTP, the client **MUST** include the `MCP-Protocol-Version:\n<protocol-version>` HTTP header on all subsequent requests to the MCP","kind":"observe","local_id":"t53_o9","terms":["HTTP protocol version header"]},{"as_of":null,"based_on":["t53_o9"],"kind":"claim","local_id":"t53_c8","object":"the MCP-Protocol-Version header on all subsequent requests","predicate":"MUST include","stance":"reported","subject":"HTTP clients","text":"When using HTTP, the client MUST include the MCP-Protocol-Version header on all subsequent MCP server requests."},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"Both parties **MUST**:","kind":"observe","local_id":"t53_o10","terms":["operation phase requirements"]},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"Respect the negotiated protocol version","kind":"observe","local_id":"t53_o11","terms":["negotiated version compliance"]},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"Only use capabilities that were successfully negotiated","kind":"observe","local_id":"t53_o12","terms":["capability compliance"]},{"as_of":null,"based_on":["t53_o10","t53_o11","t53_o12"],"kind":"claim","local_id":"t53_c9","object":"respect the negotiated version and use only successfully negotiated capabilities","predicate":"MUST","stance":"reported","subject":"client and server during operation","text":"During operation, both parties MUST respect the negotiated protocol version and use only successfully negotiated capabilities."}],"scope":{"docs":["d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d"],"ranges":[["d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d",0,5981]],"topic":null}},"engine_root":"4ba4785bbb0073368b6dcff04cd8bb9800b90191ede02957f7f68d7390323c69","outcome":{"kind":"records","result":{"accepted":["0f630c0ae466b1ac46f26260b98705ad551c6a2dfeaaa26f156d40b45c367197","f12b04a730ee5e2b286d06833c37ee2b9a1563b2c2c2ca67401e53cff9aa9b2c","b310a446c1e2c561934b0ca72753e627882ce870f8b3162766e1c5fdfdbbc4d4","22f43ce535aacb330514460f216ff839011ff50449f01808972c85b4d57aa2e9","ddc3fdde09f6e617f246e16eb47cb83b0e2bccfbeeadd4f90e8f878df9ceeb6b","be3cdf4dd117ddbf4307952f4ac329d747c378e756835809369f8f147f6b8a49","3d88782d2e259d128a8b7f4749a29193353fb89680090b948b78fa09e15bdd11","0c9c790c4b75b759bb3f730cc27fd189752e0d6b5cb5acf00a029854352ebff6","9c759983ab81ffba69b979e89734c036c8fbb3e9549944ca3530cb89e0e75aba","2587f9734e656d2b2cf6b16dbe5e7fe57f9d55e5334f665d91799e0d64f96dc5","46cdedfaec4ea5e3c77e775b07362385f00e13d6f7416069bcf616f4a3d37ac5","499058cf58348a112de8734b9c5c79c5085f6e0ab53671c6c472fdd47357ac0b","11dcb6b70260009aaf0e83063a2ba194de8744e297a68ba1c716167ea9a9084f","6c51bb3fc749c16e3fe5c6757353603baa4e4a4ecee87f1209d569979d390694","b369c6a714e6afcc4268e7e5988b14ed5a69d4032a483ee30f063ce8a0747f1c","9436e7ad0c4aa20681e74282273f789341da98f6f63bd6e291da86b8b6cc3c37","4e70a59ac432d961f4dc92d5c8bb23b3df2c5bcef79edaf943500a04f6b7d21b","524853f1b1413c301b6d41919f56754a8c733b2b55891a87dd38634f901f9e82"],"error":null,"failed_index":null}},"request_hash":"2b5f0c7b8a96d6f3293f051a009f9c5564dc497634d34303b02fab5ed3de8217","submission_id":"TR53-d6aeded36c150c7f#1"},"hash":"e17e2c70710771edf9b11fae33a7c9a4455acf98ab87540275a3dba8ad25fc3d","header":{"body_hash":"bc1d09108324e1538fce914ac75deb8153b90d3b8f06c88d3b70b20e6d2a2134","format":"sbgk-session-log/3","previous":"5dce166a6fe09b60be094