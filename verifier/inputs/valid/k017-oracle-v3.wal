{"body":{"actor":"w1","audit_root":"7c480766ce11e6e6f449342f1ec892497b9f38bdf7aeccc2a8b57a4560fc99a7","command":{"allowed_records":["055c3b232f4d91ca3898c658c421637b3ec6181635f6eec74ea53ca4449c86b5","0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","c8433f8a1df56a4154b6dd2ad7ffe98151da3db1f9ef0f33bcb40ad5bcf420ac","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T23-607810cd1bbdf665","kind":"submit","lines":[{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP clients and authorization servers **SHOULD** support OAuth Client ID Metadata Documents as specified in\n[OAuth Client ID Metadata Document](https://datatracker.ietf.org/doc/html/draft-ietf-oauth-client-id-metadata-document-00).","kind":"observe","local_id":"t23_o3","terms":["Client ID Metadata Documents","SHOULD support","IETF draft"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP implementations supporting Client ID Metadata Documents **MUST** follow the requirements specified in\n[OAuth Client ID Metadata Document](https://datatracker.ietf.org/doc/html/draft-ietf-oauth-client-id-metadata-document-00).","kind":"observe","local_id":"t23_o4","terms":["Client ID Metadata Documents","MUST follow requirements","IETF draft"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Clients **MAY** use `private_key_jwt` for client authentication (e.g., for requests to the token endpoint) with appropriate JWKS configuration as described in [Section 6.2 of Client ID Metadata Document](https://www.ietf.org/archive/id/draft-ietf-oauth-client-id-metadata-document-00.html#section-6.2)","kind":"observe","local_id":"t23_o5","terms":["private_key_jwt","MAY","client authentication"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Note over C,A: Try OAuth 2.0 and OpenID Connect<br/>discovery endpoints in priority order\n    A-->>C: Authorization server metadata\n\n    Note","kind":"observe","local_id":"t23_o10","terms":["AS metadata discovery","OAuth 2.0","OpenID Connect","priority order"]},{"as_of":null,"based_on":["t23_o3"],"kind":"claim","local_id":"t23_c1","object":"MCP clients and authorization servers","predicate":"SHOULD be supported by","stance":"reported","subject":"OAuth Client ID Metadata Documents support","text":"Client ID Metadata Documents support is a SHOULD for MCP clients and authorization servers, not a mandate."},{"as_of":null,"based_on":["t23_o4"],"kind":"claim","local_id":"t23_c2","object":"OAuth Client ID Metadata Document draft","predicate":"MUST follow requirements of","stance":"reported","subject":"Client ID Metadata Documents implementations","text":"Implementations that do support Client ID Metadata Documents MUST follow the referenced IETF draft's requirements."},{"as_of":null,"based_on":["t23_o5"],"kind":"claim","local_id":"t23_c4","object":"clients","predicate":"MAY be used by","stance":"reported","subject":"private_key_jwt client authentication","text":"Use of private_key_jwt for client authentication is optional (MAY) for clients."},{"based_on":["t23_o3","t23_o4"],"falsifier":"A later revision stating Client ID Metadata Documents support as an unconditional MUST without change.","kind":"hypothesis","local_id":"t23_h1","text":"Client ID Metadata Documents registration is a main open item: it is only SHOULD-level and depends on an IETF draft (-00), so later revisions may tighten or qualify it."},{"based_on":["t23_o5","t23_o6","t23_o7","t23_o2"],"falsifier":"A later revision stating these MAY/SHOULD items as unconditional MUST requirements without change.","kind":"hypothesis","local_id":"t23_h2","text":"The MAY/SHOULD optionality in this section (private_key_jwt, metadata fetching/caching, registration priority order) could be tightened to MUST in later revisions."}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",9360,14801]],"topic":null}},"engine_root":"4fb427abea468a9416b97d1b169684710dfe35333f295ea622ef1536f8af1f58","outcome":{"kind":"records","result":{"accepted":["667eb3b3c3fa5d49cf431eb047a72d2635be5d146d57135e238c91a358416c48","6d88e6aa550686e52464ed6d388c64d3d23f4f4cef1906919162429f08dc9497","d097ea8038e268b8fb62c81ec262f20b0dfb42f239b527185223a7f427a289d2","9a96355f5d9aad425496f2beca615d479765e0b21f230753f69045f05b088bfe","f49f098c0e4f65d1bcbb122043e6da469646698c2570bf98a7be8ed689d002f0","4492951e53304ea4802bd9b91b27a922e7bc694d2f026b8e2fc4f8cdbd10a6e5","ddb8a1cb36b4d5209d6630c4623b5762f6ecf32133eb37966312181d837abf9a","3aaa5fd9a872087a36b48ab0cb8d17dd5e8b4e317050c006eb76a20f76969573","0663dc55a89b54872bd70423d4bc441ff65b8d35353a650c6c8c7a8c9147c5fb"],"error":null,"failed_index":null}},"request_hash":"cb8c31a4a4c16125a1f6fa95a51ec4699d628a6c214862c4501bb58a55e6251b","submission_id":"T23-607810cd1bbdf665#2"},"hash":"961d851d96611bcbc9bc60e1bd630bed0997a024cbc6c45c22efd37ce2ec3efd","header":{"body_hash":"40ea32035a81c62521e0787cbc2694f6e3346ad36d09fceec561d03a734a3e92","format":"sbgk-session-log/3","previous":"457c53c2ac8f492f21d21b41970cf761df163d2cdd4a45f85619232aa5c986af","records_root":"50b753ccc7cfcd69b1d6739bb14b6a4b647af85d5fe500aea8fd9651fc074a1f","seq":94,"wal_op":"audit"}}
