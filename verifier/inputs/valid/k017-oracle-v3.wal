s **MUST** treat the scopes provided in the\nchallenge as authoritative for the current operation.","kind":"observe","local_id":"t42_o4","terms":["challenged scopes","authoritative","clients"]},{"as_of":null,"based_on":["t42_o4"],"kind":"claim","local_id":"t42_c3","object":"clients","predicate":"MUST be treated as authoritative for current operation by","stance":"reported","subject":"scopes provided in WWW-Authenticate challenge","text":"Clients MUST treat challenged scopes as authoritative for satisfying the current request."}],"scope":{"docs":["d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d"],"ranges":[["d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d",5816,10530]],"topic":null}},"engine_root":"c85e3b9f31211a78a2b16c606f3428fca1952478b5b2c93b1aa269c90f758b1d","outcome":{"kind":"records","result":{"accepted":["78ad99eb5150f0a91f98be3681ad992aaef3c054b8cc4669476a309e5686c65e","62817f6f9077002fd9aed3905f0beebacc24733cd1ed0b1a9c6000db44fa8ae2","ddb28dcfe0d58e57455313cbfbeebb3834501b55c0a5fc6a2e546befd7b2c98c","8f5fbb6a6a0b4c4c62be75d396021d3455d82596f6a2f3cc79b819778fa3dcb7"],"error":null,"failed_index":null}},"request_hash":"49940b8859a578156a4549ad0b589f52adc381474cbddbc6f3f58a51c3606e01","submission_id":"T42-696ec9d7434c1344#2"},"hash":"c80c9a555288ceef921b5dba940eabb5544f559e5d0863d75cb5415cabfd6421","header":{"body_hash":"a1535330695a08cac4231b41cd7e72aab2a981a92274fce458d03b49ae9ea972","format":"sbgk-session-log/3","previous":"22586ae7abc6679a654eb6bb2c6c71fddde4899c37be2ba3513b19b0a825912a","records_root":"dedaeaa4dacebb6c24e2d0f1e1cf5bdc073a81d0335908fe231a16c8ead4e472","seq":229,"wal_op":"audit"}}
