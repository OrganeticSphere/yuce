{"body":{"actor":"w4","audit_root":"572c9de5df66e949352043677f8e1a9f2f2f99ab919ff0eaffafd09cda2c5188","command":{"allowed_records":["055c3b232f4d91ca3898c658c421637b3ec6181635f6eec74ea53ca4449c86b5","0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","c8433f8a1df56a4154b6dd2ad7ffe98151da3db1f9ef0f33bcb40ad5bcf420ac","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T22-075e69133a5a150f","kind":"submit","lines":[{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP servers **SHOULD** include a `scope` parameter in the `WWW-Authenticate` header as defined in\n[RFC 6750 Section 3](https://datatracker.ietf.org/doc/html/rfc6750#section-3)\nto indicate the scopes required for accessing the resource.","kind":"observe","local_id":"t22_o4","terms":["MCP servers","scope parameter","WWW-Authenticate header"]},{"as_of":null,"based_on":["t22_o4"],"kind":"claim","local_id":"t22_c3","object":"a SHOULD recommendation","predicate":"is qualified as","stance":"qualified","subject":"MCP servers scope parameter inclusion in WWW-Authenticate header","text":"MCP servers are recommended (SHOULD) rather than strictly mandated to include a scope parameter in WWW-Authenticate headers."},{"as_of":null,"based_on":["t22_o10","t22_o11"],"kind":"claim","local_id":"t22_c8","object":"the following priority order","predicate":"MUST try endpoints in","stance":"reported","subject":"clients discovering authorization server metadata for issuer URLs with path components","text":"For issuer URLs with path components, clients MUST try endpoints in the following priority order."},{"as_of":null,"based_on":["t22_o10","t22_o12"],"kind":"claim","local_id":"t22_c9","object":"multiple well-known endpoints","predicate":"MUST try","stance":"reported","subject":"clients discovering authorization server metadata for issuer URLs without path components","text":"For issuer URLs without path components, clients MUST try multiple well-known endpoints when discovering authorization server metadata."}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",5106,9360]],"topic":null}},"engine_root":"080372b3167ffee74103670ff06dedbf3ab825f2ea3cbba76ee14bec2f3350fb","outcome":{"kind":"records","result":{"accepted":["34043f018ab214a9dfe51d7304268ea6bbcea73e09da1031ea2eb39bc897185c","8de83d3e5a6a6aec4542330955ff90488219e0496b40603b82670c844948e922","93415f9c86ba838807cb5324ec63630ecb20faf57c4ee5610950d3540b2533ce","169b2f5960756b8d1d17afc93fd9c16b36946a3c366d9579fcae8cf94466e321"],"error":null,"failed_index":null}},"request_hash":"7582f95cfe4a4b849a1bcd0da4f2ca081ea01b4d697c9b11871b103db9fd9d8c","submission_id":"T22-075e69133a5a150f#2"},"hash":"8b012920a44f68f344ebc3ed2fc787de6a4df46da6a3ae040ddf144b47beb9c6","header":{"body_hash":"8b7364978cf85ab057a8ab279954a27c3dae1b5bf9b004dc8e0795821fa6aa79","format":"sbgk-session-log/3","previous":"aaf7012913d16d3ea8e1580b15d1a34c5b29e7be1fccd93299b2c6de8d716b56","records_root":"d3493fa8b53830987d90be913d0184ebe7b930c6b541116e6d94577b1e52afa0","seq":110,"wal_op":"audit"}}
