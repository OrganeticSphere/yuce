{"body":{"actor":"w3","audit_root":"3d8ad6e28888831d3622353142832886101d7447b0aeb39ecfde48f12ec17073","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T30-50553a505204a44a","kind":"submit","lines":[{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"A server that supports clients implementing protocol versions earlier than\n`2025-06-18` (which did not define the `MCP-Protocol-Version` header) **MAY**\ntreat a request that omits the header as protocol version `2025-03-26`.","kind":"observe","local_id":"t30_o4","terms":["legacy clients","omitted protocol header","backward compatibility"]},{"as_of":null,"based_on":["t30_o4"],"kind":"claim","local_id":"t30_c4","object":"protocol version 2025-03-26 for clients earlier than 2025-06-18","predicate":"MAY be treated as","stance":"qualified","subject":"omitted MCP-Protocol-Version header","text":"For clients implementing protocol versions earlier than 2025-06-18, a server may treat an omitted protocol-version header as version 2025-03-26."}],"scope":{"docs":["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530"],"ranges":[["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a