{"body":{"actor":"w3","audit_root":"45618a8fb2029a0e1fbb44e2cbd89e85a978f17e14c19ed0fa6e594ea587e19a","command":{"allowed_records":["055c3b232f4d91ca3898c658c421637b3ec6181635f6eec74ea53ca4449c86b5","0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","c8433f8a1df56a4154b6dd2ad7ffe98151da3db1f9ef0f33bcb40ad5bcf420ac","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T28-7ba0efea01c8b4a0","kind":"submit","lines":[{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Client ID Metadata Documents cannot prevent `localhost` URL impersonation by themselves.","kind":"observe","local_id":"t28_o1","terms":["localhost redirect URI risks","client metadata","impersonation"]},{"as_of":null,"based_on":["t28_o1"],"kind":"claim","local_id":"t28_c1","object":"localhost URL impersonation by themselves","predicate":"cannot prevent","stance":"open","subject":"Client ID Metadata Documents","text":"Client ID Metadata Documents alone cannot prevent localhost URL impersonation, leaving this security limitation open."},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Authorization servers:","kind":"observe","local_id":"t28_o2","terms":["authorization servers","localhost redirect URIs","security guidance"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"- **SHOULD** display additional warnings for `localhost`-only redirect URIs","kind":"observe","local_id":"t28_o3","terms":["localhost-only redirect URIs","additional warnings","SHOULD"]},{"as_of":null,"based_on":["t28_o3"],"kind":"claim","local_id":"t28_c2","object":"authorization servers","predicate":"SHOULD be displayed by","stance":"qualified","subject":"additional warnings for localhost-only redirect URIs","text":"Additional warnings for localhost-only redirect URIs are recommended for authorization servers, qualifying the security guidance rather than making it mandatory."},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"- **MAY** require additional attestation mechanisms for enhanced security","kind":"observe","local_id":"t28_o4","terms":["attestation mechanisms","enhanced security","authorization servers","MAY"]},{"as_of":null,"based_on":["t28_o4"],"kind":"claim","local_id":"t28_c3","object":"authorization servers for enhanced security","predicate":"MAY be required by","stance":"qualified","subject":"additional attestation mechanisms","text":"Additional attestation mechanisms for enhanced security remain optional for authorization servers."},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Authorization servers **MAY** implement domain-based trust policies:","kind":"observe","local_id":"t28_o5","terms":["domain-based trust policies","authorization servers","MAY"]},{"as_of":null,"based_on":["t28_o5"],"kind":"claim","local_id":"t28_c4","object":"authorization servers","predicate":"MAY be implemented by","stance":"open","subject":"domain-based trust policies","text":"Domain-based trust policies remain optional for authorization servers, leaving their adoption open."},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP proxy servers using static client IDs **MUST** obtain user consent for each dynamically\nregistered client before forwarding to third-party authorization servers","kind":"observe","local_id":"t28_o6","terms":["MCP proxy servers","static client IDs","user consent","dynamic registration"]},{"as_of":null,"based_on":["t28_o6"],"kind":"claim","local_id":"t28_c5","object":"user consent for each dynamically registered client before forwarding","predicate":"MUST obtain","stance":"reported","subject":"MCP proxy servers using static client IDs","text":"MCP proxy servers using static client IDs must obtain user consent for every dynamically registered client before forwarding requests to third-party authorization servers."},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP servers **MUST** validate access tokens before processing the request, ensuring the access token is issued specifically for the MCP server","kind":"observe","local_id":"t28_o7","terms":["access token validation","MCP servers","intended resource"]},{"as_of":null,"based_on":["t28_o7"],"kind":"claim","local_id":"t28_c6","object":"access tokens before processing requests and ensure issuance for the MCP server","predicate":"MUST validate","stance":"reported","subject":"MCP servers","text":"MCP servers must validate access tokens before processing requests and ensure tokens were issued specifically for the MCP server."},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP servers **MUST** only accept tokens specifically intended for themselves","kind":"observe","local_id":"t28_o8","terms":["token audience","MCP servers","token acceptance"]},{"as_of":null,"based_on":["t28_o8"],"kind":"claim","local_id":"t28_c7","object":"tokens specifically intended for themselves","predicate":"MUST only accept","stance":"reported","subject":"MCP servers","text":"MCP servers must accept only tokens specifically intended for themselves and reject tokens that do not identify them as the intended recipient."},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"The MCP server **MUST NOT** pass through the token it received from the MCP client.","kind":"observe","local_id":"t28_o9","terms":["token passthrough","MCP server","upstream APIs"]},{"as_of":null,"based_on":["t28_o9"],"kind":"claim","local_id":"t28_c8","object":"the token received from the MCP client","predicate":"MUST NOT pass through","stance":"reported","subject":"MCP server","text":"When calling upstream APIs, an MCP server must not pass through the token received from the MCP client."},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP clients **MUST** implement and use the `resource` parameter as defined in [RFC 8707 - Resource Indicators for OAuth 2.0]","kind":"observe","local_id":"t28_o10","terms":["MCP clients","resource parameter","RFC 8707","resource binding"]},{"as_of":null,"based_on":["t28_o10"],"kind":"claim","local_id":"t28_c9","object":"the RFC 8707 resource parameter","predicate":"MUST implement and use","stance":"reported","subject":"MCP clients","text":"MCP clients must implement and use the OAuth resource parameter to specify the target resource for requested tokens."},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"- **Optional** - Implementations can choose to adopt these extensions","kind":"observe","local_id":"t28_o11","terms":["MCP Authorization Extensions","optional adoption","implementations"]},{"as_of":null,"based_on":["t28_o11"],"kind":"claim","local_id":"t28_c10","object":"optional for implementations to adopt","predicate":"are","stance":"open","subject":"MCP Authorization Extensions","text":"MCP Authorization Extensions remain optional, so implementation adoption is left open."},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"- **Versioned independently** - Extensions follow the core MCP versioning cycle but may adopt independent versioning as needed","kind":"observe","local_id":"t28_o12","terms":["MCP Authorization Extensions","independent versioning","versioning policy"]},{"as_of":null,"based_on":["t28_o12"],"kind":"claim","local_id":"t28_c11","object":"independent versioning as needed","predicate":"may adopt","stance":"open","subject":"MCP Authorization Extensions","text":"Authorization extensions may adopt independent versioning as needed, leaving their versioning cadence open relative to the core protocol."}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",35989,41363]],"topic":null}},"engine_root":"caf589cdc5373dd64de366ab6394ee78f7d3440d49b5335f20da8b8b1ba485bc","outcome":{"kind":"records","result":{"accepted":["2ccff0397cedb584e6a02e1b8ab5d0e07c2914662291c806c3194ce6260e04be","06006fbdd25f9f10cafe4e75be54d4c2016e80bcb41a1256988e07a731c03852","e89022813e77f5621a69dc5cc44e20233b4fc6f54f70dae64f807350499c885f","b5f2a890bbdc3e6f513c64646d7996de47da99af230bc8f94aed3775e8aa0c2c","fb5b57aac007875f39ac0b120f8b5a2438e179e0123ddac5de69589f049e2a24","aded6a0208d5ac5676f5225c0e3bccc0b048947883a781842830c7e626e1f822","c5e17ce202dc8908a891cc00d0dd6ef0c1d599ce1470bf1b9bdd43e0d3d4abad","01793c89a26697ee20a177567105f9aade9b45025659f2b133fd4121df8cb2cd","8a0165f039478aa3cbde7b4efe53c7654f2bc3420c713bb58e5ae4719ca0201f","8283c81da47bdaf942dea437c0e067e6ffbbcfd5631fd6620ee55dcd86388d9c","9af7e496678fae0cacaee79f98631b436e8f510a2e62b8f424cdab0267049a80","1188ab82af56114325ea84a67fea9d1fc218608d0df4cef2d766ebe59a5003f2","a763cbee5a7f392d52ba8d7f01309cc8daf93190198e10c291b01393129725cb","3fd2e0bc2443d1c46468f5d3e87f21c932bde556e0caac2aa35b633b63d37cb0","d314c946bc3e1b1370410271e1f880c9fd20d44091b874c8f2150c5470d46b75","e55c0c4cd1afef6be9a321918aeefd98775d46edf37de017ffc9cc118af7a1ff","d9dd7ecefefa9a89c3ae215137c49ee3fddbc962e1bf5b2e5bc6c2bf8697df2b","0b62ffd086f306f12a297beda92a2bfdde942d6d67dbcdaea554c53989709185","4731611b2f8302b06de82c5afd5e0