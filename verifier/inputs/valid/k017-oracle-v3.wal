to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":9,"local_id":"t63_o10"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"Servers **SHOULD** include the following `io.modelcontextprotocol/*` field in\nevery result's `_meta`, unless specifically configured not to do so, to\nidentify themselves without relying on any prior connection state:","rule":"ends_mid_clause","suggested_exact_quote":"Servers **SHOULD** include the following `io.modelcontextprotocol/*` field in\nevery result's `_meta`, unless specifically configured not to do so, to\nidentify themselves without relying on any prior connection state:","suggested_span":{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","end_byte":19818,"start_byte":19602},"trailing_word":"in"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":10,"local_id":"t63_o11"},{"error":{"code":"NO_EVIDENCE","expected_by_kernel":{"missing_identifiers":["MissingRequiredClientCapabilityError"]},"field":"based_on","message":"a claim names only identifiers its quotes hold: add a quote of this section that holds each one listed, or leave it out of the claim","obligation":null,"status":"error"},"index":19,"local_id":"t63_c8"}],"task_id":"T63-b1f58f9d3d4cab46","work_key":"doc:d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb#3"},"from":0,"key":"task-repair:T63-b1f58f9d3d4cab46:1","to":0},"kind":"batch","operations":[]},"engine_root":"3d359761d732517760a0434b73184fdf865d3dcbbff150460a85ac38b668c6c9","outcome":{"kind":"value","result":{"accepted_operations":0,"checkpointed":true,"error":null,"failed_index":null,"results":