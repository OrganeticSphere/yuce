,"d684710039e0c7f6c22a03bf5b3d776762a61f3340850b17b5e7143d0b91114c","d70982b138d0225e6183b0879878f65fa0b253d2e66d887aad5e6a72a5808e40","d799a1322f6fbf1cc2caf671ce99518bb4d0b488ed8607e1f8ab377d50d98371","da3db42b0eaba107fa9bf7b922002daacc151fdad448f5e65fe9e64823afadee","da8b00fc87e2db5fa865d58d73e8f23d5aef7085ef3b70effd5c576e04d4dd7d","db6c6a6d37cc817ed14d93535100e6177b6a9d2a285e2647199ee1c97818355e","dc3aa4fd8eefe8aecd73f870347e3555c825a35b075b645cf5f47ff13e231652","dccf58b1b38f1bd6f51385316f861c9fba7c0d987bf71f21b012999369db7efc","dd2615076fc38e34088edc7cde83d5166ee7d3ec1263da870fc7b17b2d38ab54","dd4eb1169a6aaeecabfdb23f7c11544ccd8dabeec326b529077a412761d39709","de11429f411dcb936127c511c304b65379a9cb1a4c96fe2c62cd14554edafe87","df9db11ade03a3f23b2905eac02f47e5262d536f94d535e10417eb87e8f7ec1d","dfbfb4af7a45e541154ad723dcf9920bd15080cf5ebe39818040df4cad537d9c","e046e7d2652356b4ab7779b8feafe2dbb7f656294ef15e747dfeded4869cfeba","e0c755749ba2119388c5acd2323cbabc74c421ba1a39c6282032ebdd6f946638","e0e0743c9ea551f37037ae8c1f8cedf1197e4fa929dd8e4984c8004bdd19a3be","e1e1d45f68ec61b3c1697710156d0af19bb4b12fea4844e150be32a2a05dc17e","e6ffcd8502699fa1d76f09d6c3f0f081eaacc7c01338feedbfb002b92a49c49a","e864a96fc03691c7102e8520bbbbe6025b269a7118e8ed8528487b68f66af6b6","ea7773bfea6a14c332c554f5c264534ca0d394a446d69bbe49fb409d4bbd187e","ec5e86c97fa84855f485575817ab0b53afa5956c06eda9a912d91b499f82b039","ede270bd8b92a4ab59e3cd2fc3af4ce50d10719003cb3e5ecd085e3923322383","ef9b9b873d6b8eec340633e3fa30165e29cfbeb423c6285c5b60f4edce80731f","ef9f8368c524fd4967fa563f5092022febc23f9a79f8458a1c6dbc18fea47db3","efa85a2c291cde372d3f2a4153b29003f3ca0baa5d15b4600f96f55a53787826","f0a46c341ce6b94525471e9a9bbb2519787e18bc74c0b89242d511fe022ac39c","f111d8ab28f0e51c88d7863c6ab1f2dff608c218e36d150d405bbfc4811e72b7","f28767d2143a120734aa746162a937ed2d83ff09a2ebc7d4ffcc2faf63f64daf","f3de9ab80acff6b09ff3da3f81780be68f7c7b9ad68c32dc7a252819b8c2992c","f5e36e73d06f70abaf0b9284755c5449a2c5131723afce64686b782f4fc7c830","f89ede050a917c55b95ddc99dbe7d866355c98df26ee207bba890c724919ec60","fa57fb9a313bdb46c473b885ad58c039022aa4190b7d77e279b4d2cd1ebbec81","fae618111a8f215bfef771de00b315dd7343298168ed70f296f88d29534385c8","fc4674d6e47bda61464630ff9eabe1fb4c5adfd5505896144d785b7b656a5664","fc4e883c12a70ba566a83fbce0cc1d0ba912e1c64ed3f3039c46f6fab712b72f","fe0ed5f0f11504786600de654358410d40bce69c1ba1d2d56481c15b46130ea8","fea55a38ef80d3bb012cb24bdc71aae20b271d629d0327a7201acda107845c8b"],"directive":"TS150-b1e006e29e3b0a95","kind":"submit","lines":[{"as_of":20241105,"based_on":["@c82c5d903a34e0fe","@fc4674d6e47bda61","@dccf58b1b38f1bd6","@bf7362149c825bd3"],"kind":"claim","local_id":"t150_c1","object":"proper authentication","predicate":"SHOULD implement","stance":"qualified","subject":"server authentication for all connections","text":"Proper authentication for all connections is only a SHOULD for servers across 2024-11-05, 2025-03-26, 2025-11-25 and 2026-07-28; never a MUST."},{"as_of":20241105,"based_on":["@7f593b60d83d197c","@23688d5ed96e34a0","@11cbb3c480e82954"],"kind":"claim","local_id":"t150_c2","object":"clients","predicate":"MAY be written and MAY be handled by","stance":"qualified","subject":"stdio stderr logging","text":"Stdio stderr logging is optional (MAY); clients MAY capture, forward or ignore it and SHOULD NOT assume stderr indicates errors."},{"as_of":20241105,"based_on":["@c1a6e670f9f297d6","@547849a610263f79"],"kind":"claim","local_id":"t150_c3","object":"connection patterns; stdio framing","predicate":"SHOULD document and SHOULD reuse","stance":"qualified","subject":"custom transports","text":"Custom transports SHOULD document connection establishment and message exchange patterns; those on byte streams SHOULD reuse stdio framing and message rules."},{"as_of":20241105,"based_on":["@73a92f9dc8bb36c5","@715f7599e1bf5c79","@a0b7ed936d4d0981","@594d1187236053e4","@9c759983ab81ffba"],"kind":"claim","local_id":"t150_c4","object":"client and server version exchange","predicate":"is qualified by SHOULD-level guidance and a server MUST","stance":"qualified","subject":"protocol version negotiation","text":"Version negotiation is SHOULD-level: client sends its latest supported version and disconnects if it cannot support the server's version; server MUST answer with another supported version."},{"as_of":20241105,"based_on":["@b2013687d6517ed9","@370d62fd77991679","@fe0ed5f0f1150478","@958fb0553530e511","@43e55fd61202998c","@8bb92fd8a3658f4e"],"kind":"claim","local_id":"t150_c5","object":"listed error cases","predicate":"SHOULD be prepared for","stance":"qualified","subject":"error-case handling","text":"Handling version mismatch, capability failure, initialize and shutdown timeouts is SHOULD, not MUST; the example unsupported-version error uses code -32602."},{"as_of":20241105,"based_on":["@0690d460ca97cfb0","@87f41d349ae96688","@2f592e247fb6ddf0"],"kind":"claim","local_id":"t150_c6","object":"implementations, all requests","predicate":"SHOULD be implemented by","stance":"qualified","subject":"request timeouts","text":"Implementations SHOULD set timeouts for all requests to prevent hung connections and resource exhaustion; no timeout values are specified."},{"as_of":20250326,"based_on":["@2c2f7ab19148dab5","@d51982a299f390fc","@738fdbf084cff9eb","@724df72b34ee5688","@f5e36e73d06f70ab"],"kind":"claim","local_id":"t150_c7","object":"timeout duration","predicate":"MAY reset but SHOULD cap","stance":"qualified","subject":"timeout clock reset on progress","text":"Progress notifications MAY reset the timeout clock, but implementations SHOULD always enforce a maximum timeout regardless of progress."},{"as_of":20250326,"based_on":["@99d46f7dd90ec6d6","@c5e3c894151494d4","@6bebbd977b75200c"],"kind":"claim","local_id":"t150_c8","object":"server-as-AS, optional refresh, SHOULD rotation","predicate":"assumes and qualifies","stance":"qualified","subject":"authorization example assumptions","text":"The authorization code example assumes the MCP server also acts as authorization server; refresh tokens are optional and token rotation is only a SHOULD."},{"as_of":20250326,"based_on":["@2494cfc1af8606a5","@d5f785c1c337f3ca","@b8e7154f745a60a2","@66565f02c22bb1f2"],"kind":"claim","local_id":"t150_c9","object":"servers without Authorization Server Metadata","predicate":"MAY be supported; apply only when","stance":"qualified","subject":"delegated authorization and default endpoints","text":"Third-party delegated authorization is optional (MAY); default endpoint paths apply only to servers without metadata discovery, and discovery MUST be tried first."},{"as_of":20260728,"based_on":["@40026c0f19b54786","@971c62c5a57fb281","@72a9be72605afe2d","@7fcc29d81b58eecb","@31e52b50b5d519d7","@81a86d5c2b83925c","@81a98d97043ce86a"],"kind":"claim","local_id":"t150_c10","object":"Client ID Metadata Documents","predicate":"requirement strength changed and is deprecated in favor of","stance":"superseded","subject":"OAuth 2.0 Dynamic Client Registration","text":"Dynamic Client Registration was a SHOULD in 2025-03-26 and 2025-06-18, became MAY in 2025-11-25, and is deprecated in 2026-07-28 in favor of Client ID Metadata Documents."},{"as_of":20251125,"based_on":["@80c08d273f737132","@1508ff11ce465f8b","@199e45de86608b71"],"kind":"claim","local_id":"t150_c11","object":"MCP clients and authorization servers","predicate":"SHOULD be supported by","stance":"qualified","subject":"OAuth Client ID Metadata Documents","text":"Client ID Metadata Documents were added in 2025-11-25 only as a recommended (SHOULD) registration mechanism; 2026-07-28 keeps SHOULD support for clients and authorization servers."},{"as_of":20250326,"based_on":["@b2faf682b0898892","@dc3aa4fd8eefe8ae","@351a9f1fb36e39aa","@8964373675873bd0"],"kind":"claim","local_id":"t150_c12","object":"pings (client); pings and logging (server)","predicate":"SHOULD NOT include requests other than","stance":"qualified","subject":"pre-initialization messaging constraints","text":"Before the initialize response clients SHOULD NOT send requests other than pings; before initialized servers SHOULD NOT send requests other than pings and logging."},{"as_of":20250326,"based_on":["@4b288f446491a2f5","@dd2615076fc38e34","@1bfa89fd02ff5b33"],"kind":"claim","local_id":"t150_c13","object":"MCP CancelledNotification","predicate":"SHOULD be signalled and MUST NOT continue","stance":"qualified","subject":"request cancellation","text":"Cancellation is SHOULD-level: clients SHOULD send CancelledNotification; servers SHOULD stop work promptly and MUST NOT send further messages for the cancelled request."},{"as_of":20260728,"based_on":["@7da05ca2c6110f14","@6c174ddd6b534a45","@0b666e21018ad874","@4cae11dc48160c9c"],"kind":"claim","local_id":"t150_c14","object":"Streamable HTTP transport","predicate":"was MAY, then removed from","stance":"superseded","subject":"SSE stream resumability and redelivery","text":"Stream resumability to avoid message loss was optional (MAY) in 2025-03-26 and 2025-11-25; 2026-07-28 removes SSE resumability, Last-Event-ID and event IDs from Streamable HTTP."},{"as_of":20260728,"based_on":["@6ddf879cb98a727f","@00836a0223c5cd21","@4cae11dc48160c9c"],"kind":"claim","local_id":"t150_c15","object":"streams in session or client scope","predicate":"MAY be attached but if present MUST be unique; later removed","stance":"superseded","subject":"SSE event id","text":"SSE event ids were optional (MAY) but if present MUST be globally unique across streams in the session or client scope; 2026-07-28 removes event IDs."},{"as_of":20260728,"based_on":["@63226817ee96341f","@0542f099aad7b917","@fea55a38ef80d3bb"],"kind":"claim","local_id":"t150_c16","object":"HTTP 405 Method Not Allowed; sessions","predicate":"SHOULD be attempted but MAY be refused; later removed","stance":"superseded","subject":"explicit session termination","text":"Explicit session termination was best-effort: clients SHOULD send HTTP DELETE with Mcp-Session-Id, but servers MAY refuse with HTTP 405; 2026-07-28 removes protocol-level sessions."},{"as_of":20260728,"based_on":["@7b22b3e91846b39c","@b09b4c77560ef0d8","@29631d8ff713a590","@fae618111a8f215b","@ede270bd8b92a4ab"],"kind":"claim","local_id":"t150_c17","object":"single MCP endpoint; Streamable HTTP","predicate":"were superseded by and later removed from","stance":"superseded","subject":"HTTP+SSE transport and GET stream endpoint","text":"Streamable HTTP replaced the 2024-11-05 HTTP+SSE transport with a single MCP endpoint serving POST and GET; the GET stream endpoint was later removed in 2026-07-28."},{"as_of":20260728,"based_on":["@4ab5b62d3fe77c3a","@553dece070d34f10","@31d2d03d511ca48c"],"kind":"claim","local_id":"t150_c18","object":"concurrent client requests; subscriptions/listen","predicate":"MAY be sent and SHOULD be unrelated; later replaced","stance":"superseded","subject":"server-initiated messages on SSE stream","text":"Server-initiated SSE messages were MAY, and SHOULD be unrelated to any concurrently-running client request; 2026-07-28 replaces GET streams with subscriptions/listen."},{"as_of":20250618,"based_on":["@0d2b0ea49d97339a"],"kind":"claim","local_id":"t150_c19","object":"2025-06-18 revision","predicate":"is no longer supported in","stance":"superseded","subject":"JSON-RPC batching","text":"JSON-RPC batching support was removed in the 2025-06-18 revision, superseding the prior support."},{"as_of":20250618,"based_on":["@ea7773bfea6a14c3"],"kind":"claim","local_id":"t150_c20","object":"SHOULD to MUST","predicate":"requirement strength changed from","stance":"superseded","subject":"Lifecycle Operation","text":"The Lifecycle Operation requirement was strengthened from SHOULD to MUST in the 2025-06-18 revision, superseding the weaker earlier guidance."},{"as_of":20250618,"based_on":["@4c8f59a845bd114a","@8ffba189fdc302f7","@2aae2a62abe17c5d"],"kind":"claim","local_id":"t150_c21","object":"clients and implementations","predicate":"SHOULD be followed by","stance":"qualified","subject":"canonical server URI handling","text":"Canonical server URIs are SHOULD-level: clients provide the most specific URI, implementations accept uppercase scheme/host and omit trailing slashes for interoperability."},{"as_of":20250618,"based_on":["@273691ebece27e36"],"kind":"claim","local_id":"t150_c22","object":"authorization servers","predicate":"SHOULD be issued by","stance":"qualified","subject":"short-lived access tokens","text":"Authorization servers SHOULD issue short-lived access tokens to reduce the impact of leaked tokens; this is a recommendation, not a MUST."},{"as_of":20251125,"based_on":["@d63e792a3db96854","@68e08663d8988040"],"kind":"claim","local_id":"t150_c23","object":"stdio transport implementations","predicate":"is OPTIONAL and SHOULD NOT apply to","stance":"qualified","subject":"authorization applicability","text":"Authorization is OPTIONAL and conditional on support; stdio implementations SHOULD NOT follow the authorization spec and instead take credentials from the environment."},{"as_of":20251125,"based_on":["@2192dfa852a184f2"],"kind":"claim","local_id":"t150_c24","object":"authorization specification","predicate":"SHOULD conform to","stance":"qualified","subject":"HTTP-based transport implementations","text":"HTTP-based transport implementations SHOULD conform to the authorization specification, a recommendation rather than a mandate."},{"as_of":20251125,"based_on":["@78e126022bef49f4"],"kind":"claim","local_id":"t150_c25","object":"optional with .well-known fallback","predicate":"is made","stance":"qualified","subject":"WWW-Authenticate header","text":"The WWW-Authenticate header was made optional in 2025-11-25 with fallback to the .well-known endpoint; later revisions' status is not shown here."},{"as_of":20260728,"based_on":["@b414b8202260b750","@4cae11dc48160c9c"],"kind":"claim","local_id":"t150_c26","object":"Streamable HTTP transport","predicate":"was SHOULD-level guidance, then removed","stance":"superseded","subject":"event IDs encoding stream identity","text":"Event IDs should encode stream identity (2025-11-25 guidance), but 2026-07-28 removes SSE event IDs and resumability from Streamable HTTP."},{"as_of":20260728,"based_on":["@82404f8b56f69f68","@73492a6f225bfc50","@fea55a38ef80d3bb"],"kind":"claim","local_id":"t150_c27","object":"session expiry; request cancellation","predicate":"MAY terminate; SHOULD NOT interpret; later sessions removed","stance":"superseded","subject":"SSE stream termination and disconnection","text":"Server termination of an SSE stream on session expiry was MAY, and disconnection SHOULD NOT be read as cancellation; 2026-07-28 removes protocol-level sessions."},{"as_of":20260728,"based_on":["@7cdc4eb4b52297f3","@b16dcfb4a3de85f2"],"kind":"claim","local_id":"t150_c28","object":"tool parameters, resource URIs, or server configuration","predicate":"is deprecated and superseded by","stance":"superseded","subject":"Roots feature","text":"Roots is deprecated in 2026-07-28, superseded by passing directories or files via tool parameters, resource URIs, or server configuration."},{"as_of":20260728,"based_on":["@afcc79474c857503","@661ad8d361c2bb25"],"kind":"claim","local_id":"t150_c29","object":"direct LLM provider API integration","predicate":"is deprecated and superseded by","stance":"superseded","subject":"Sampling feature","text":"Sampling is deprecated in 2026-07-28, superseded by integrating directly with LLM provider APIs."},{"as_of":20260728,"based_on":["@a4ab4e2a7be67220","@0b8a97b3d45138d3"],"kind":"claim","local_id":"t150_c30","object":"stderr logging or OpenTelemetry","predicate":"is deprecated and superseded by","stance":"superseded","subject":"Logging feature","text":"Logging is deprecated in 2026-07-28, superseded by logging to stderr for stdio transports or using OpenTelemetry for observability."},{"as_of":20251125,"based_on":["@37520a73d0b0a979","@cdd21802112d3706"],"kind":"claim","local_id":"t150_c31","object":"omitting the field or 'none'","predicate":"are deprecated and superseded by","stance":"superseded","subject":"includeContext values","text":"The includeContext values 'thisServer' and 'allServers' are deprecated in 2025-11-25, superseded by omitting the field or using 'none'."},{"as_of":20260728,"based_on":["@80a0121fdad5232c","@fea55a38ef80d3bb"],"kind":"claim","local_id":"t150_c32","object":"Streamable HTTP transport","predicate":"are removed from","stance":"superseded","subject":"protocol-level sessions and Mcp-Session-Id","text":"Protocol-level sessions and the Mcp-Session-Id header are removed from Streamable HTTP in 2026-07-28, superseding earlier session behavior."},{"as_of":20260728,"based_on":["@65e9b6944bd0600c","@a12fbe12b88f1ba0","@034bab40f0677c0f","@61ce66f4280ee856"],"kind":"claim","local_id":"t150_c33","object":"stateless per-request metadata","predicate":"is removed in favor of","stance":"superseded","subject":"initialize/notifications/initialized handshake","text":"MCP is made stateless in 2026-07-28: the initialize/notifications/initialized handshake is removed in favor of per-request metadata."},{"as_of":20260728,"based_on":["@31d2d03d511ca48c"],"kind":"claim","local_id":"t150_c34","object":"subscriptions/listen stream","predicate":"are replaced by","stance":"superseded","subject":"HTTP GET endpoint and resources/subscribe/unsubscribe","text":"The HTTP GET endpoint and resources/subscribe/unsubscribe are replaced in 2026-07-28 by a single subscriptions/listen stream."},{"as_of":20260728,"based_on":["@9fd8a666412b7126","@e1e1d45f68ec61b3"],"kind":"claim","local_id":"t150_c35","object":"io.modelcontextprotocol/logLevel in _meta","predicate":"are removed; log level moves to per-request","stance":"superseded","subject":"ping, logging/setLevel, notifications/roots/list_changed","text":"ping, logging/setLevel and notifications/roots/list_changed are removed in 2026-07-28; log level moves to per-request _meta and servers MUST NOT emit notifications/message without it."},{"as_of":20260728,"based_on":["@d5225309e5143215","@e0c755749ba21193","@ef9b9b873d6b8eec"],"kind":"claim","local_id":"t150_c36","object":"clientInfo and serverInfo in _meta","predicate":"SHOULD be provided via","stance":"qualified","subject":"client and server self-identification","text":"Client and server self-identification per request/result (clientInfo, serverInfo) is only a SHOULD in 2026-07-28, not a mandate."},{"as_of":20260728,"based_on":["@8e9d6696c4326a6f"],"kind":"claim","local_id":"t150_c37","object":"Streamable HTTP transport","predicate":"is not expected on","stance":"qualified","subject":"notifications/cancelled message","text":"On Streamable HTTP in 2026-07-28, closing the SSE response stream is itself the cancellation signal; no notifications/cancelled message is expected."},{"as_of":20260728,"based_on":["@dd4eb1169a6aaeec","@3f03535ad76eb33c"],"kind":"claim","local_id":"t150_c38","object":"server/discover; both eras","predicate":"SHOULD send first; MAY serve concurrently","stance":"qualified","subject":"stdio legacy-server handling","text":"On stdio, clients SHOULD send server/discover first to fail deterministically against legacy servers; a dual-era server MAY serve both eras concurrently."},{"as_of":20260728,"based_on":["@b9236e6543692c21"],"kind":"claim","local_id":"t150_c39","object":"-32602","predicate":"was replaced by","stance":"superseded","subject":"resource-not-found error code","text":"The earlier resource-not-found code -32002 was replaced by -32602, though clients should still accept -32002 from earlier-version servers."},{"as_of":20260728,"based_on":["@a2475eb8c5b05f71","@7f6f6b0f2aa14921","@8fbd969503819db0"],"kind":"claim","local_id":"t150_c40","object":"closing input stream and waiting for exit","predicate":"SHOULD be initiated by","stance":"qualified","subject":"stdio shutdown","text":"Stdio shutdown is SHOULD-level: client closes server stdin and waits; servers SHOULD exit promptly on stdin close and MAY initiate shutdown by closing stdout."}],"scope