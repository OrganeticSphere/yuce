{"body":{"actor":"w2","audit_root":"5734d152a3469cec50caf5557d96d72983ea58421f4647b84320c1e53523a274","command":{"checkpoint":{"context":{"abandoned":false,"agent":"w2","circle":2,"circle_phase":"READ","kind":"EXTEND","link_task":null,"offered":27,"refusals":1,"stored":27,"sync_step":3,"task_id":"T9-f512b13bfb8d6e45"},"from":0,"key":"task:doc:d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804#1","to":0},"kind":"batch","operations":[]},"engine_root":"5673db5f2315b5a7eb559c02332af005ca5e418f1311d9a3b2cb1643c583594c","outcome":{"kind":"value","result":{"accepted_operations":0,"checkpointed":true,"error":null,"failed_index":null,"results":[]}},"request_hash":"6e5687e14ac40b2306e4f5bc8405d955be6bf2d958d8d83d83caa80b46872248","submission_id":"T9-f512b13bfb8d6e45#done3"},"hash":"87abce689577b59e602d0265381dae387afaea0477bb434e61a148c676335261","header":{"body_hash":"f0fde52eb65fdd13bb26664bca4fa061415ba6cff7d94af5713aecfe7b092f54","format":"sbgk-session-log/3","previous":"3364c4fc68663dc77925353f1cc84d7f25dd868bf57c4791a5a11cf2a17c49d9","records_root":"fe7c90ca2214e168f5ffe6cccb15729c3b8a03c403e48c406441cd589fdd8c41","seq":45,"wal_op":"audit"}}
{"body":{"actor":"w4","audit_root":"1aec0e2f6d5ee5546d773d87a5ad3e678601d5403015ce1e2025e36b9d50cb28","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T8-032ecefce40f2540","kind":"submit","lines":[{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"This replaces the [HTTP+SSE\ntransport](/specification/2024-11-05/basic/transports#http-with-sse) from\nprotocol version 2024-11-05.","kind":"observe","local_id":"t8_o1","terms":["Streamable HTTP","HTTP+SSE transport","supersession"]},{"as_of":null,"based_on":["t8_o1"],"kind":"claim","local_id":"t8_c1","object":"Streamable HTTP transport","predicate":"is replaced by","stance":"superseded","subject":"HTTP+SSE transport from protocol version 2024-11-05","text":"The HTTP+SSE transport from protocol version 2024-11-05 is superseded and replaced by the Streamable HTTP transport."},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"Clients **SHOULD** support stdio whenever possible.","kind":"observe","local_id":"t8_o2","terms":["stdio","client support","recommendation"]},{"as_of":null,"based_on":["t8_o2"],"kind":"claim","local_id":"t8_c2","object":"clients","predicate":"SHOULD be supported whenever possible by","stance":"qualified","subject":"stdio transport support","text":"Client support for the stdio transport is qualified as a recommendation (SHOULD) whenever possible rather than an unconditional mandate."},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"3. Servers **SHOULD** implement proper authentication for all connections","kind":"observe","local_id":"t8_o3","terms":["authentication","Streamable HTTP","security recommendation"]},{"as_of":null,"based_on":["t8_o3"],"kind":"claim","local_id":"t8_c3","object":"servers using Streamable HTTP transport","predicate":"SHOULD be implemented by","stance":"qualified","subject":"proper authentication for all connections","text":"For Streamable HTTP, implementing proper authentication for connections is recommended (SHOULD) rather than unconditionally required."},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"2. When running locally, servers **SHOULD** bind only to localhost (127.0.0.1) rather than all network interfaces (0.0.0.0)","kind":"observe","local_id":"t8_o4","terms":["localhost binding","DNS rebinding mitigation"]},{"as_of":null,"based_on":["t8_o4"],"kind":"claim","local_id":"t8_c4","object":"servers","predicate":"SHOULD be done by","stance":"qualified","subject":"binding only to localhost when running locally","text":"Binding only to localhost when running locally is qualified as a recommendation (SHOULD) rather than a strict requirement."},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"Disconnection **MAY** occur at any time (e.g., due to network conditions).","kind":"observe","local_id":"t8_o5","terms":["disconnection","network conditions"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"To avoid message loss due to disconnection, the server **MAY** make the stream\n       [resumable](#resumability-and-redelivery).","kind":"observe","local_id":"t8_o6","terms":["resumable stream","message loss prevention"]},{"as_of":null,"based_on":["t8_o5","t8_o6"],"kind":"claim","local_id":"t8_c5","object":"servers","predicate":"MAY be implemented to avoid message loss by","stance":"open","subject":"resumable stream implementation","text":"Making SSE streams resumable to prevent message loss on disconnection remains an optional feature (MAY), leaving stream resilience open."},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"It is also possible for clients and servers to implement\n[custom transports](#custom-transports) in a pluggable fashion.","kind":"observe","local_id":"t8_o7","terms":["custom transports","pluggable architecture"]},{"as_of":null,"based_on":["t8_o7"],"kind":"claim","local_id":"t8_c6","object":"clients and servers","predicate":"may be implemented in a pluggable fashion by","stance":"open","subject":"custom transports","text":"The specification leaves custom transports open for pluggable implementation by clients and servers beyond the standard transports."},{"about":["HTTP+SSE transport","backwards compatibility"],"kind":"question","local_id":"t8_q1","needed":"check section backwards-compatibility in d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","text":"How does the backwards compatibility guide handle legacy HTTP+SSE clients connecting to Streamable HTTP endpoints?"}],"scope":{"docs":["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b"],"ranges":[["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b",0,5241]],"topic":null}},"engine_root":"06a293fde64bc2666428258327df95d1b2fd2f0f5df36889cec65f4f2eb7a212","outcome":{"kind":"records","result":{"accepted":["f31e7056283981e6a1736ece98f9ce5da7bc4b068fd0545189ed3c90c465465f","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","4cfda948990200e2071dbeedcbd6e3438ac84016c894a9488b3d3b1ca6cb2e2a","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","547ff2aeddacee8ab82cb06ceaf7806221918c4e57b1c51804a7ce0103582ab4","b72098723000200784c0466158907cdad8ab8c27c953ad8e014b4a65aee49dad","c9ccba1d597f6f63ceff751b1f2bf536de3a38242fad2f288507568a253cf942","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","ee0234541bcc2c145974ec5161c1bc12e9fb35821255e0acaf84dc7f36d0e11f","0f689fe243b545c4c8da260265408b1ecc9a304c12110a4dcd42fcead3e7a261","f3931a4ac10e7d17e366811fb7aeab037ac07597c4e86fb0ab8eb32c593ac243","dcd8e80409fed3d6f4f315abd08ffca86cf18ee14404396ba1c90773f0