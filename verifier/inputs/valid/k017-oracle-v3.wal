arget server identification"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"3. **MUST** use the canonical URI of the MCP server as defined in [RFC 8707 Section 2](https://www.rfc-editor.org/rfc/rfc8707.html#name-access-token-request).","kind":"observe","local_id":"t127_o5","terms":["canonical server URI"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP clients **MUST** send this parameter regardless of whether authorization servers support it.","kind":"observe","local_id":"t127_o6","terms":["authorization server support independence"]},{"as_of":null,"based_on":["t127_o1","t127_o2","t127_o3"],"kind":"claim","local_id":"t127_c1","object":"MCP clients implement RFC 8707 Resource Indicators and include the resource parameter in authorization and token requests","predicate":"requires","stance":"confirmed","subject":"Resource Parameter Implementation section","text":"The document defines a Resource Parameter Implementation section requiring MCP clients to implement RFC 8707 Resource Indicators and use the resource parameter in authorization and token requests."},{"as_of":null,"based_on":["t127_o4","t127_o5","t127_o6"],"kind":"claim","local_id":"t127_c2","object":"the intended MCP server's canonical URI and be sent regardless of authorization-server support","predicate":"MUST identify and use","stance":"confirmed","subject":"resource parameter","text":"The resource parameter must identify the intended MCP server, use its canonical URI, and be sent regardless of authorization-server support."}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",19354,24431],["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",30038,35989]],"topic":null}},"engine_root":"bfb6106fac21c01be9c6ddfb875b5b22f789027060eb8bfb0680f8233989433d","outcome":{"kind":"records",