"subject":"STDIO transport implementations","text":"Implementations using an STDIO transport SHOULD NOT follow this authorization specification and instead retrieve credentials from the environment."},{"as_of":null,"based_on":["t17_o12"],"kind":"claim","local_id":"t17_c11","object":"the MCP client","predicate":"is the responsibility of","stance":"reported","subject":"authorization server selection","text":"Selecting which authorization server to use is the MCP client's responsibility, per RFC9728 Section 7.6 guidelines."}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",0,5106]],"topic":null}},"engine_root":"7dcefd34405fcdba8e52b684f879dd145d016268aa9921819e5c2aaf2b755ffe","outcome":{"kind":"records","result":{"accepted":["368c24ccb77a8877c6841914b6a10b2efcc87276aa5a06c14f198e03f33572e0","764422c95af48dd214a08c771ddc48dea61dae645898779ee3c8185c50ba9591","0c5f6f0e9f800dd68a50e87bc91655935c46c46a14efb5ce219ee6f33296295c","6b446e77e343cd46015a0d17add3b33a19f3def3a37591d457d060cc78264db4"],"error":null,"failed_index":null}},"request_hash":"45827e60fd142f04472ab9e94ba37c3ebd13c1b78c04083175792d51e34a7ba9","submission_id":"TR17-ad23bd9d0e509ad6#2"},"hash":"c472ab51b5b26409344e4a43df7a901cad30c23a553bd05507a7b9cd335b6e7c","header":{"body_hash":"ec36a716bf4251cf227fa95f9fbb5f3bfaa4abe6d314081aee23902028b3dbac","format":"sbgk-session-log/3","previous":"08193e5efc7d6b393e3054db2e9e74ba0ced235c984070aa168e44b81b6e0fa0","records_root":"ffb62b37b18d7b45587f83683d4f19fb18ae273372d89ee11aa037692dc65a76","seq":70,"wal_op":"audit"}}
