{"body":{"actor":"w3","audit_root":"92f38a93f402c77371e978718038a1ed80de2a0dd7311fa9703176a9b327fb18","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T62-08ac27c14f0c2a6c","kind":"submit","lines":[{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Codes defined by earlier protocol versions remain reserved and will not be\nreused.","kind":"observe","local_id":"t62_o1","terms":["error-code compatibility","earlier protocol versions"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"`-32002` — resource not found (2025-11-25 and earlier; replaced by `-32602`).","kind":"observe","local_id":"t62_o2","terms":["resource-not-found error code","supersession"]},{"as_of":null,"based_on":["t62_o2"],"kind":"claim","local_id":"t62_c1","object":"-32602","predicate":"was replaced by","stance":"superseded","subject":"resource-not-found error code","text":"The earlier resource-not-found code -32002 was superseded by -32602, although clients should still accept -32002 from earlier-version servers."},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Future versions of the specification may define standard codes for\ncommon local error conditions in the reserved sub-range.","kind":"observe","local_id":"t62_o3","terms":["local implementation errors","future standardization"]},{"as_of":null,"based_on":["t62_o3"],"kind":"claim","local_id":"t62_c2","object":"future specification versions","predicate":"may receive standard codes in","stance":"open","subject":"common local error conditions","text":"Standard JSON-RPC error codes for common local implementation error conditions remain open for possible definition in future specification versions."},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"The receiver **MUST NOT** send a response.","kind":"observe","local_id":"t62_o4","terms":["notifications","response behavior"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Notifications **MUST NOT** include an ID.","kind":"observe","local_id":"t62_o5","terms":["notifications","JSON-RPC identifiers"]},{"as_of":null,"based_on":["t62_o4","t62_o5"],"kind":"claim","local_id":"t62_c3","object":"one-way message semantics","predicate":"must be sent without response or ID","stance":"reported","subject":"notifications","text":"Notifications are one-way messages: the receiver must not respond, and notifications must not include an ID."},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"The Model Context Protocol (MCP) is a **stateless protocol**: all the\ninformation needed to process a request is contained in the request itself.","kind":"observe","local_id":"t62_o6","terms":["protocol statelessness","request context"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Servers **MUST NOT** rely on prior requests over the same connection to\n  establish context","kind":"observe","local_id":"t62_o7","terms":["server state","connection reuse","request context"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"State that needs to span multiple requests (e.g., long-running tasks,\n  application-level handles) **MUST** be referenced by an explicit identifier\n  the client passes on each request.","kind":"observe","local_id":"t62_o8","terms":["cross-request state","explicit identifiers"]},{"as_of":null,"based_on":["t62_o6","t62_o7","t62_o8"],"kind":"claim","local_id":"t62_c4","object":"self-contained requests and explicit state identifiers","predicate":"must use","stance":"reported","subject":"MCP request processing","text":"The protocol requires per-request context: servers must not infer context from prior requests or connection identity, and cross-request state must use an explicit client-supplied identifier."},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Servers **SHOULD** be prepared to handle requests associated with multiple\n  tasks, threads, or conversations.","kind":"observe","local_id":"t62_o9","terms":["multiple tasks","threads","conversations","server handling"]},{"as_of":null,"based_on":["t62_o9"],"kind":"claim","local_id":"t62_c5","object":"requests associated with multiple tasks, threads, or conversations","predicate":"SHOULD handle","stance":"qualified","subject":"servers","text":"Servers are advised, but not unconditionally required, to handle requests associated with multiple tasks, threads, or conversations."},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Their state is scoped to the request itself, not to the connection underneath.","kind":"observe","local_id":"t62_o10","terms":["long-lived requests","state scope","connection state"]},{"as_of":null,"based_on":["t62_o10"],"kind":"claim","local_id":"t62_c6","object":"the request itself","predicate":"scope state to","stance":"reported","subject":"long-lived requests","text":"Long-lived subscription requests remain request/response interactions, with their state scoped to the request rather than the underlying connection."}],"scope":{"docs":["d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb"],"ranges":[["d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb",4563,10274]],"topic":null}},"engine_root":"24b3c7a7af2d24bba1b1bcb8c5d0d871811e2efa678473f46beee0e225bfdf46","outcome":{"kind":"records","result":{"accepted":["eac055e430341494226540c569e58ec8953ab4ad2abe3551abc29ad77f367399","b9236e6543692c21df340641ae15177396cb8f6043f6a1059b91a2fb11a40d0b","046c7d6d3eb84c5307ccd7678758a3bcce3c29aa61d269f9ab7eee3d1cfae28f","3618493755714b6ea0a7e07be3bd224a03ca3ab74a2c9a8cbda9ff8b655b7863","7d7b795666a46ce09be7c087fd18e44ad01d03033fcef60addae1df1ec1ae67c","08412a0fcd8ff8c353e4c7f505e4c58b112aaa4d7c0fe9ab7db183e2cf09d990","6019a066b5b34ece0a9d124b57c03e927449684a7086891babd5530621d8639a","92861fb271608eb018b482b9076ea68ca09082c7525afd78ae4c99e535ac46d4","9e7ad772b19f53fbb764bb8cfabdff527d830784cd055893a904355ddc0ba72a","e6264821b4a9fb58a6f2b340b85aea79add2abc963232682f840c289a62a61cb","95949d73276768f0cc558e5c20dca01973ebe73c890674fcac502e6593555fb3","0175aba466cc6e6050ef9de08893ffe506ac73d502d43c4721c001c5b43e18a5","5bc0ab8fca0ac302aae3419aacd40546394fbf619e6dd4c88870e888d361cfb3","13be04efa1e8825cae69399b9e16d785d92b8c7b534932e8d02d37e47e0b8b11","0c28ff1aba685fc8349a6521829e3ca3c0a7299870d8d2958705914c5361bc31","1958c732d289a55ebc3427b8fefae2683a5c99a3d7e20e28202851322fc27fa5"],"error":null,"failed_index":null}},"request_hash":"301221fe8d7415ce5f0fbbb4b377deba3b54026ee002280d8245182bbdafa5e9","submission_id":"T62-08ac27c14f0c2a6c#1"},"hash":"6d61d42e145fb0f9d83b52c2b70967385db5fb44fc96ac5fddae2fa1fb627102","header":{"body_hash":"14ebc7bd7060e8dddbc1bb841c7efcdccc214a2c59c739cbe7a606cfb92713d5","format":"sbgk-session-log/3","previous":"2c38892189eeb1e80d56f332a04ce00333e7a830d65aedb3642ff42dcc008ab1","records_root":"bae637da80d3b1e09dabd6ee287652925d02de00acfc83e27ffa668fa56c90a9","seq":308,"wal_op":"audit"}}
