{"body":{"actor":"w1","audit_root":"02a1310ff1ab81781b04a7bbc730e369d67e7d7010ea0ed7ea0d9b3fb5c3e4b1","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T73-ba35f63b1c6b4b4a","kind":"submit","lines":[{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","exact_quote":"MCP clients and authorization servers **SHOULD** support OAuth Client ID Metadata Documents as specified in\n[OAuth Client ID Metadata Document](https://datatracker.ietf.org/doc/html/draft-ietf-oauth-client-id-metadata-document-00)\nfor client registration.","kind":"observe","local_id":"t73_o3","terms":["Client ID Metadata Documents","SHOULD","OAuth"]},{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","exact_quote":"MCP implementations supporting Client ID Metadata Documents **MUST** follow the requirements specified in\n[OAuth Client ID Metadata Document](https://datatracker.ietf.org/doc/html/draft-ietf-oauth-client-id-metadata-document-00).","kind":"observe","local_id":"t73_o4","terms":["Client ID Metadata Documents","MUST","implementation requirements"]},{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","exact_quote":"**SHOULD** follow the security considerations in [Section 6 of Client ID Metadata Document](https://www.ietf.org/archive/id/draft-ietf-oauth-client-id-metadata-document-00.html#section-6) and in [Client ID Metadata Document Security](/specification/2026-07-28/basic/authorization/security-considerations#client-id-metadata-document-security)","kind":"observe","local_id":"t73_o8","terms":["security considerations","SHOULD"]},{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","exact_quote":"MCP clients and authorization servers **SHOULD** support OAuth Client ID Metadata Documents as specified in\n[OAuth Client ID Metadata Document](https://datatracker.ietf.org/doc/html/draft-ietf-oauth-client-id-metadata-document-00)","kind":"observe","local_id":"t73_o9","terms":["IETF draft","Client ID Metadata Document","external dependency"]},{"as_of":null,"based_on":["t73_o3"],"kind":"claim","local_id":"t73_c1","object":"MCP clients and authorization servers","predicate":"SHOULD be provided by","stance":"qualified","subject":"OAuth Client ID Metadata Documents support","text":"MCP clients and authorization servers SHOULD support OAuth Client ID Metadata Documents per the IETF draft, so support is recommended rather than mandated."},{"as_of":null,"based_on":["t73_o4","t73_o9"],"kind":"claim","local_id":"t73_c2","object":"OAuth Client ID Metadata Document IETF draft","predicate":"MUST follow requirements of","stance":"reported","subject":"Client ID Metadata Documents implementations","text":"Implementations that do support Client ID Metadata Documents MUST follow the requirements of the IETF draft, making the draft's content a normative dependency."},{"as_of":null,"based_on":["t73_o8"],"kind":"claim","local_id":"t73_c6","object":"authorization servers","predicate":"SHOULD be followed by","stance":"qualified","subject":"Client ID Metadata Document security considerations","text":"Authorization servers SHOULD follow the security considerations of the Client ID Metadata Document draft and the MCP security-considerations page, leaving compliance advisory."},{"based_on":["t73_o3","t73_o4","t73_o9"],"falsifier":"A later revision stating Client ID Metadata Documents support as an unconditional MUST or citing a finalized RFC without change.","kind":"hypothesis","local_id":"t73_h1","text":"Because Client ID Metadata Documents support is only SHOULD and its normative content is an IETF -00 draft, this registration mechanism is a likely open item to be tightened or qualified in later revisions."},{"based_on":["t73_o2","t73_o5","t73_o6","t73_o7","t73_o8"],"falsifier":"A later revision of this section stating these SHOULD/MAY items as unconditional MUST requirements without change.","kind":"hypothesis","local_id":"t73_h2","text":"The SHOULD-level items (priority order, metadata fetch, caching, security considerations) and the MAY private_key_jwt option are optionality that later revisions could tighten."}],"scope":{"docs":["d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f"],"ranges":[["d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f",0,5793]],"topic":null}},"engine_root":"2fa18b48f5a672461e3f364621c03efd3b4c5b9a473b4b13c806c624d9016538","outcome":{"kind":"records","result":{"accepted":["199e45de86608b713c175ad8b4d33101d5bb88ded4388e4ae3d7e1ff8a4e0832","4eefa3179f0be54745174118a2912d61bfd51f66a9f1c2291d400f2827a61c90","20613c1c5f293a93629c90d06b0bb7bc9473a8f6f0460ebc442dff34203bd449","67f791ebd0529faab5adc3117076204caa9266b663e7bf3f1c5bc6cc049be190","41370d399303790497f1a6b6a43c19d02d41fc98415b6f0f495777fd94efba62","7cf61de105fc6d465c0576bb13677bb5281bff8d3e89658bfbe131a456488767","4c3586863c163d0c7b626eefbd8fab89e51be95a788fc470867ab6211ab900e7","3d32329fd69d258ea7602e6747057a63e89209b15464bd7dc4c9525e6dd5ae42","d9250d45ef6aecbee3ceec3202f1cd25e31b023cacb00ba4bdf8fe94009b972f"],"error":null,"failed_index":null}},"request_hash":"33895784d241853f079e685a31050c603aeb07232e9c627cd2208697b617e9cc","submission_id":"T