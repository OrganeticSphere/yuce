{"body":{"actor":"w3","audit_root":"67c099995b64c7f16431996123fd3b6cf94f13e13eed11c960a4e4dbf28e404a","command":{"allowed_records":["055c3b232f4d91ca3898c658c421637b3ec6181635f6eec74ea53ca4449c86b5","0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","c8433f8a1df56a4154b6dd2ad7ffe98151da3db1f9ef0f33bcb40ad5bcf420ac","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T21-eedeffd323234662","kind":"submit","lines":[{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP clients **MUST** implement Resource Indicators for OAuth 2.0 as defined in [RFC 8707](https://www.rfc-editor.org/rfc/rfc8707.html)","kind":"observe","local_id":"t21_o1","terms":["Resource Indicators","OAuth 2.0","MCP clients"]},{"as_of":null,"based_on":["t21_o1"],"kind":"claim","local_id":"t21_c1","object":"MCP clients","predicate":"MUST be implemented by","stance":"reported","subject":"OAuth 2.0 Resource Indicators","text":"MCP clients are required to implement OAuth 2.0 Resource Indicators as defined by RFC 8707."},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"1. **MUST** be included in both authorization requests and token requests.","kind":"observe","local_id":"t21_o2","terms":["resource parameter","authorization requests","token requests"]},{"as_of":null,"based_on":["t21_o2"],"kind":"claim","local_id":"t21_c2","object":"authorization requests and token requests","predicate":"MUST be included in","stance":"reported","subject":"resource parameter","text":"The resource parameter must be included in both authorization and token requests."},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"implementations **SHOULD** accept uppercase scheme and host components for robustness and interoperability.","kind":"observe","local_id":"t21_o4","terms":["URI parsing","uppercase scheme","uppercase host components"]},{"as_of":null,"based_on":["t21_o4"],"kind":"claim","local_id":"t21_c4","object":"implementations","predicate":"SHOULD be accepted by","stance":"qualified","subject":"uppercase URI scheme and host components","text":"Acceptance of uppercase URI scheme and host components is recommended for robustness and interoperability, not mandated."},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"implementations **SHOULD** consistently use the form without the trailing slash for better interoperability unless the trailing slash is semantically significant for the specific resource.","kind":"observe","local_id":"t21_o5","terms":["trailing slash","URI form","interoperability"]},{"as_of":null,"based_on":["t21_o5"],"kind":"claim","local_id":"t21_c5","object":"implementations, with a semantic-significance exception","predicate":"SHOULD be omitted by","stance":"qualified","subject":"trailing slash in canonical URI","text":"Implementations should consistently omit a trailing slash for interoperability, except when it is semantically significant."},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP clients **MUST** send this parameter regardless of whether authorization servers support it.","kind":"observe","local_id":"t21_o6","terms":["resource parameter","authorization server support","MCP clients"]},{"as_of":null,"based_on":["t21_o6"],"kind":"claim","local_id":"t21_c6","object":"MCP clients regardless of authorization server support","predicate":"MUST be sent by","stance":"reported","subject":"resource parameter","text":"Clients must send the resource parameter even when the authorization server does not support it."},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Note that authorization **MUST** be included in every HTTP request from client to server,","kind":"observe","local_id":"t21_o8","terms":["Authorization header","every HTTP request","client to server"]},{"as_of":null,"based_on":["t21_o8"],"kind":"claim","local_id":"t21_c8","object":"every client-to-server HTTP request","predicate":"MUST be included in","stance":"reported","subject":"authorization","text":"Authorization must be included in every HTTP request from client to server, including requests in the same logical session."},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"2. Access tokens **MUST NOT** be included in the URI query string","kind":"observe","local_id":"t21_o9","terms":["access tokens","URI query string","token handling"]},{"as_of":null,"based_on":["t21_o9"],"kind":"claim","local_id":"t21_c9","object":"URI query string","predicate":"MUST NOT be included in","stance":"reported","subject":"access tokens","text":"Access tokens must not be placed in the URI query string."}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",19354,24431]],"topic":null}},"engine_root":"1a437b71f027a5e9d5d35fa3c62ecbfe3cb2e8c20ed6d2321122e571a01c0e3d","outcome":{"kind":"records","result":{"accepted":["dcbb7d52577962e4e5b8c4fecaf24eefc4d6038d2e43a118fe9fe5874c626ac7","5f25e58ac611fdb5d16dc7e6657017beb0ec592e2b0f997fd9911eea0e9ffc55","6da359c8c007ec311de7ad95b7cb3a1f80108c3ef2217e06f752d1434b719626","aa18c5f4e7028acff56b8eff017067b49b497ff76b89a392653390f719047702","8cfbc83733e71d6aeb37fe324d0181