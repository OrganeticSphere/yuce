{"body":{"actor":"w2","audit_root":"c9f00a10adb7c83bf511252906994c162d6a41362c757b163256e3998ea93d08","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T13-6cd7143bbd3eabb3","kind":"submit","lines":[{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Implementations using an STDIO transport **SHOULD NOT** follow this specification, and\n  instead retrieve credentials from the environment.","kind":"observe","local_id":"t13_o2","terms":["stdio transport exclusion","credentials from environment"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"The implementation details of the authorization server are beyond the scope of this specification. It may be hosted with the\nresource server or a separate entity.","kind":"observe","local_id":"t13_o10","terms":["authorization server implementation out of scope"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"The responsibility for selecting which authorization server to use lies with the MCP client, following the guidelines specified in\n[RFC9728 Section 7.6 \"Authorization Servers\"](https://datatracker.ietf.org/doc/html/rfc9728#name-authorization-servers).","kind":"observe","local_id":"t13_o11","terms":["client selects among multiple authorization servers"]},{"as_of":null,"based_on":["t13_o2"],"kind":"claim","local_id":"t13_c2","object":"this specification","predicate":"SHOULD NOT follow","stance":"qualified","subject":"STDIO transport implementations","text":"Stdio implementations SHOULD NOT follow this specification and instead retrieve credentials from the environment, which limits the scope of the HTTP-oriented requirements."},{"as_of":null,"based_on":["t13_o10"],"kind":"claim","local_id":"t13_c5","object":"beyond scope of this specification","predicate":"is","stance":"open","subject":"authorization server implementation details","text":"Implementation details of the authorization server are declared beyond the scope of this specification."},{"as_of":null,"based_on":["t13_o11"],"kind":"claim","local_id":"t13_c7","object":"the MCP client","predicate":"lies with","stance":"open","subject":"selection of authorization server","text":"Selection among multiple authorization servers is left to the MCP client, following RFC9728 guidelines."},{"based_on":["t13_o9","t13_o10"],"falsifier":"A later revision of this section specifying the authorization server implementation details and authorization_servers usage within this document.","kind":"hypothesis","local_id":"t13_h1","text":"Because this section defers authorization server implementation details and authorization_servers usage to other specifications, conformance testing of MCP servers and clients will depend on those open items."}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",0,5106]],"topic":null}},"engine_root":"7de20d28b99d314466221ea25ac9bf57f259a66be1628140ccd635c6f4226a83","outcome":{"kind":"records","result":{"accepted":["68e08663d8988040a46c6bf1326bdc57782d9d4eb969e88b6e2ca4313908765f","6e4186e032caba92a5aa02195063fce1565247d01a8ba3ad650e8a2b2952c371","00f8b96ca6fc07a667598d5fe11a6ee8efc9aa5ce80dbcd2505cf5c65823c84f","af6ac74833467fdc47e5d31769a8afc3c956fa3048c49a50ef3cbc9f0bc63adc","032d99