{"body":{"actor":"w3","audit_root":"13acc9f1fbda2e3f8ee9e50a12a0defc810fbd68f2e492a86fb132a89d5d2878","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T77-5f49dfe0d00ab7fd","kind":"submit","lines":[{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","exact_quote":"MCP clients **SHOULD** support an option for static client credentials such as those supplied by a pre-registration flow.","kind":"observe","local_id":"t77_o2","terms":["pre-registration","static client credentials"]},{"as_of":null,"based_on":["t77_o2"],"kind":"claim","local_id":"t77_c2","object":"an option for static pre-registered credentials","predicate":"SHOULD support","stance":"qualified","subject":"MCP clients","text":"Support for static credentials from pre-registration remains recommended, not mandatory."},{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","exact_quote":"Dynamic Client Registration is deprecated. New implementations should use","kind":"observe","local_id":"t77_o3","terms":["Dynamic Client Registration","CIMD","backwards compatibility"]},{"as_of":null,"based_on":["t77_o3"],"kind":"claim","local_id":"t77_c3","object":"Client ID Metadata Documents","predicate":"is deprecated and should be replaced by","stance":"superseded","subject":"Dynamic Client Registration","text":"Dynamic Client Registration is deprecated and new implementations should use Client ID Metadata Documents instead, while legacy support remains for compatibility."},{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","exact_quote":"MCP clients **MUST** specify an appropriate `application_type`\nduring Dynamic Client Registration.","kind":"observe","local_id":"t77_o5","terms":["Dynamic Client Registration","application_type"]},{"as_of":null,"based_on":["t77_o5"],"kind":"claim","local_id":"t77_c5","object":"an appropriate application_type during Dynamic Client Registration","predicate":"MUST specify","stance":"reported","subject":"MCP clients","text":"Clients must specify an appropriate application_type during Dynamic Client Registration; omission can default to web under OIDC and conflict with native redirects."},{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","exact_quote":"MCP clients **MUST** be prepared to handle registration\nfailures due to redirect URI constraints when authorization\nservers implement OIDC.","kind":"observe","local_id":"t77_o6","terms":["OIDC registration failures","redirect URI constraints"]},{"as_of":null,"based_on":["t77_o6"],"kind":"claim","local_id":"t77_c6","object":"registration failures due to OIDC redirect URI constraints","predicate":"MUST be prepared to handle","stance":"reported","subject":"MCP clients","text":"Clients must handle OIDC registration failures caused by redirect URI constraints."},{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","exact_quote":"**MUST** associate those\ncredentials with the specific authorization server that issued them,\nkeyed by the authorization server's `issuer` identifier.","kind":"observe","local_id":"t77_o9","terms":["authorization server binding","credential issuer association"]},{"as_of":null,"based_on":["t77_o9"],"kind":"claim","local_id":"t77_c9","object":"credentials with the issuing authorization server's issuer","predicate":"MUST associate","stance":"reported","subject":"MCP clients","text":"Pre-registered or dynamically obtained credentials must be bound to the issuing authorization server using its issuer identifier."},{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","exact_quote":"clients **MUST NOT** reuse client credentials\nfrom a different authorization server and **MUST** re-register\nwith the new authorization server.","kind":"observe","local_id":"t77_o10","terms":["authorization server changes","credential reuse","re-registration"]},{"as_of":null,"based_on":["t77_o10"],"kind":"claim","local_id":"t77_c10","object":"credentials across authorization servers","predicate":"MUST NOT reuse and MUST re-register","stance":"reported","subject":"MCP clients","text":"After an authorization-server change, clients must not reuse credentials from the former server and must re-register with the new server."},{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","exact_quote":"Client IDs based on Client ID Metadata Documents are portable\nacross authorization servers","kind":"observe","local_id":"t77_o12","terms":["CIMD client ID portability","authorization server changes"]},{"as_of":null,"based_on":["t77_o12"],"kind":"claim","local_id":"t77_c12","object":"re-registration across authorization servers","predicate":"are portable and do not require","stance":"reported","subject":"CIMD-based client IDs","text":"Client IDs based on Client ID Metadata Documents remain portable across authorization servers and do not require re-registration when the server changes."}],"scope":{"docs":["d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f"],"ranges":[["d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f",5793,10016]],"topic":null}},"engine_root":"cc7493ece10de198b96269ca