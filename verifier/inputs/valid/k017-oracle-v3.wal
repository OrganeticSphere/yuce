{"body":{"actor":"w1","audit_root":"4e86e4b453dd0acb95f849028fdcebfc38c6aec66c9b7d27ac47b740de27c07c","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T57-2572f1565e895a92","kind":"submit","lines":[{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"All implementations **MUST** support the base protocol, versioning,","kind":"observe","local_id":"t57_o1","terms":["mandatory components","base protocol","versioning","message patterns"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"- Unlike base JSON-RPC, the ID **MUST NOT** be `null`.","kind":"observe","local_id":"t57_o4","terms":["request ID","null prohibition","deviation from JSON-RPC"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"- The `result` **MUST** include a `resultType` field to indicate the type of the result.","kind":"observe","local_id":"t57_o6","terms":["resultType","result field requirement"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"- Extensions **MAY** add additional `ResultType` values. The set of supported `ResultType` values **MUST** be created from the set defined in the core protocol and include any additional values of supported extensions that are advertised via capabilities.","kind":"observe","local_id":"t57_o7","terms":["extension ResultType","capabilities","supported result types"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"- A `resultType` of any value unrecognized by the client **MUST** be considered invalid.","kind":"observe","local_id":"t57_o8","terms":["unrecognized resultType","invalid result"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"- For backward compatibility with servers implementing earlier protocol versions, which do not include `resultType`, clients **MUST** treat an absent `resultType` as `\"complete\"`.","kind":"observe","local_id":"t57_o9","terms":["backward compatibility","absent resultType","earlier protocol versions"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"- Error responses **MUST** include the same ID as the request they correspond to (except in error cases where the ID could not be read due a malformed request).","kind":"observe","local_id":"t57_o10","terms":["error response ID","malformed request exception"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"- Error responses **MAY** include a `data` member with additional information of any type, such","kind":"observe","local_id":"t57_o11","terms":["error data member","optional error detail"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"- A `resultType` of `\"input_required\"` indicates the request is incomplete and more information is needed to process the request.","kind":"observe","local_id":"t57_o12","terms":["input_required","multi round-trip requests","incomplete request"]},{"as_of":null,"based_on":["t57_o6","t57_o7","t57_o8"],"kind":"claim","local_id":"t57_c3","object":"result responses","predicate":"MUST be included in","stance":"reported","subject":"resultType field","text":"Result responses MUST include a resultType field; extensions MAY add ResultType values, and unrecognized resultType values MUST be treated as invalid by clients."},{"as_of":null,"based_on":["t57_o9"],"kind":"claim","local_id":"t57_c4","object":"\"complete\" by clients","predicate":"MUST be treated as","stance":"reported","subject":"absent resultType","text":"For backward compatibility, clients MUST treat an absent resultType as \"complete\" for servers implementing earlier protocol versions."},{"as_of":null,"based_on":["t57_o10","t57_o11"],"kind":"claim","local_id":"t57_c5","object":"data member","predicate":"MUST include matching request ID and MAY include","stance":"reported","subject":"error responses","text":"Error responses MUST include the matching request ID except where the ID could not be read due to a malformed request, and MAY include a data member."},{"as_of":null,"based_on":["t57_o12"],"kind":"claim","local_id":"t57_c6","object":"request incomplete, more information needed","predicate":"indicates","stance":"reported","subject":"resultType \"input_required\"","text":"A resultType of \"input_required\" signals the request is incomplete and more information is needed, linking results to the MRTR pattern."},{"based_on":["t57_o9"],"falsifier":"A later revision stating the absent-resultType-as-complete rule as permanent or unconditional without version scoping.","kind":"hypothesis","local_id":"t57_h1","text":"The backward-compatibility rule treating absent resultType as \"complete\" is a transitional accommodation for earlier protocol versions that later revisions could tighten or remove."},{"about":["t57_c1"],"kind":"question","local_id":"t57_q1","needed":"Check later protocol revision overview sections for changes to the MUST/MAY component split.","text":"Does any later revision change the MUST support set for base protocol, versioning and message patterns, or promote optional components to mandatory?"},{"about":["t57_c4","t57_h1"],"kind":"question","local_id":"t57_q2","needed":"Compare later revision result-response sections for the absent resultType clause.","text":"Is the absent-resultType backward-compatibility rule retained, qualified or removed in later revisions?"}],"scope":{"docs":["d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb"],"ranges":[["d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb",0,4563]],"topic":null}},"engine_root":"59b73d194ade6b7bcad7cf51cc6872ea5b606458fad5ad421e999ef2aa7af6f0","outcome":{"kind":"records","result":{"accepted":["2d6b0f816f693d3783a9c1813160df6e13229f968081efcbee306c1952d5aeaf","0ae3e26c95025f3c9bdd273c816d9daca91e5745dc3c366e1417896faa7d50fe","2fb5fa259e155d5f81110b5a017cda60f208593ade4937c70236e9f2e9c41fa7","3c5e2b050666fa3d7e6564fa7c0db3d362aa2d3192ed2f04c767c482b1b4c513","de7fdb77e19751da1b9dc21aa8a43152153d17760089917d339a9ca59b9b3c03","393135455afb6efc311af823cdac4abf3c1b2928eac0baf8291d30e15211b58c","3e3c01e70be4c2c95fa9a80c706fbdf6ec6971c569283ba433802502fbc19504","4a8e302f0bfd796f2b95b82f0626eb6abfcb79d37afe4eea4644fdc754b1b466","f5656fcf50b662ea594f3a1395f054edec95a01143915ca6386bb52daea0a5e2","67e34e79543ea78a9214b8f1df2dfa01008c9547620788d44239f06bb3704d2b","f7546fd44ab02b6391c503e434b9a541e3bf527fe333da56847e9598397184e9","a267a9547d44f1f95fd88ad641f7db4ac3e6d10a47764abeea75b6a11463b5fb","a561f5b764d2c447e94631f1b34cb5e0bd7485b1a6f79188a5d7aa954b70a498","6bc4d327a5c20c4b1e073dd803a559e368474a5202878e98e932d12cfa1d0cac","f614762f944f848c3158c7645b35e53842f59ac3096e1a4b260e96c687099995","ba961dc37bc77665f5601ed7f2a29fd00c28405ac2832327bcf06e156fa8f464"],"error":null,"failed_index":null}},"request_hash":"06069a7bfd53336bf03bc975cf8aeeac0425b2d8cbac3705fb8556de25a6e02f","submission_id":"T57-2572f1565e895a92#1"},"hash":"efbe146f1dd102681f3a91d9cd5cfeb4c21a458370728acd68da0da51d8273d7","header":{"body_hash