{"body":{"actor":"w1","audit_root":"1a87e2904c8b72b44aef284e90a8a488074b7d807c14cd88a22b6134bb2fdd0b","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T78-ac50ccf0a3983571","kind":"submit","lines":[{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Remove protocol-level sessions and the `Mcp-Session-Id` header from the Streamable HTTP transport.","kind":"observe","local_id":"t78_o1","terms":["sessions","Mcp-Session-Id","Streamable HTTP","removal"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Make MCP stateless: remove the `initialize`/`notifications/initialized` handshake.","kind":"observe","local_id":"t78_o2","terms":["stateless","initialize handshake","removal"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Clients SHOULD identify themselves on each request (`io.modelcontextprotocol/clientInfo`), and servers SHOULD identify themselves in each result's `_meta`","kind":"observe","local_id":"t78_o3","terms":["clientInfo","serverInfo","SHOULD","identification"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Version mismatches return `UnsupportedProtocolVersionError`","kind":"observe","local_id":"t78_o4","terms":["version mismatch","UnsupportedProtocolVersionError"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"servers MUST implement this RPC to advertise their supported protocol versions, capabilities, and identity.","kind":"observe","local_id":"t78_o5","terms":["server/discover","MUST","capabilities","identity"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Clients MAY call it before any other request for up-front version selection, or use it as a backward-compatibility probe on STDIO","kind":"observe","local_id":"t78_o6","terms":["server/discover","MAY","version selection","STDIO"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Replace the HTTP GET endpoint and `resources/subscribe`/`resources/unsubscribe` with `subscriptions/listen`","kind":"observe","local_id":"t78_o7","terms":["HTTP GET endpoint","resources/subscribe","subscriptions/listen","replacement"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Remove `ping`, `logging/setLevel`, and `notifications/roots/list_changed`.","kind":"observe","local_id":"t78_o8","terms":["ping","logging/setLevel","roots/list_changed","removal"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"servers MUST NOT emit `notifications/message` for requests that did not include this field","kind":"observe","local_id":"t78_o9","terms":["logLevel","notifications/message","MUST NOT"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Move experimental tasks out of the core protocol and into an official extension (`io.modelcontextprotocol/tasks`).","kind":"observe","local_id":"t78_o10","terms":["tasks","experimental","extension"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"allows servers to return task handles unsolicited without per-request opt-in","kind":"observe","local_id":"t78_o11","terms":["tasks","unsolicited handles","opt-in"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Multi Round-Trip Requests (MRTR) pattern introduced which replaces the previous approach of sending server-initiated requests","kind":"observe","local_id":"t78_o12","terms":["MRTR","server-initiated requests","replacement"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Clients **MUST** treat results from earlier-protocol servers that omit the field as `\"complete\"`","kind":"observe","local_id":"t78_o13","terms":["resultType","backward compatibility","MUST"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Remove SSE stream resumability and message redelivery (the `Last-Event-ID` header and SSE event IDs) from the Streamable HTTP transport.","kind":"observe","local_id":"t78_o14","terms":["SSE resumability","Last-Event-ID","redelivery","removal"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"A broken response stream loses the in-flight request; clients **MUST** re-issue it as a new request with a new request ID","kind":"observe","local_id":"t78_o15","terms":["broken stream","re-issue","request ID","MUST"]},{"as_of":null,"based_on":["t78_o1"],"kind":"claim","local_id":"t78_c1","object":"Streamable HTTP transport","predicate":"are removed from","stance":"superseded","subject":"protocol-level sessions and Mcp-Session-Id header","text":"Protocol-level sessions and the Mcp-Session-Id header are removed from the Streamable HTTP transport; list endpoints no longer vary per-connection."},{"as_of":null,"based_on":["t78_o2"],"kind":"claim","local_id":"t78_c2","object":"protocol version and client capabilities","predicate":"is removed in favor of stateless per-request _meta","stance":"superseded","subject":"initialize/notifications/initialized handshake","text":"MCP is made stateless: the initialize/notifications/initialized handshake is removed and each request carries protocol version and client capabilities in _meta."},{"as_of":null,"based_on":["t78_o3"],"kind":"claim","local_id":"t78_c3","object":"clientInfo and serverInfo in _meta","predicate":"SHOULD be provided via","stance":"qualified","subject":"client and server self-identification","text":"Client and server self-identification per request/result is only a SHOULD (clientInfo, serverInfo), not a mandate."},{"as_of":null,"based_on":["t78_o5","t78_o6"],"kind":"claim","local_id":"t78_c4","object":"for version/capability/identity advertisement","predicate":"MUST be implemented by servers; MAY be called by clients","stance":"reported","subject":"server/discover RPC","text":"Servers MUST implement server/discover to advertise supported protocol versions, capabilities and identity; clients MAY call it for version selection or as a STDIO compatibility probe."},{"as_of":null,"based_on":["t78_o7"],"kind":"claim","local_id":"t78_c5","object":"subscriptions/listen stream","predicate":"are replaced by","stance":"superseded","subject":"HTTP GET endpoint and resources/subscribe/unsubscribe","text":"The HTTP GET endpoint and resources/subscribe/unsubscribe are replaced by a single subscriptions/listen stream with opt-in notification types."},{"as_of":null,"based_on":["t78_o8","t78_o9"],"kind":"claim","local_id":"t78_c6","object":"io.modelcontextprotocol/logLevel in _meta","predicate":"are removed; log level moves to per-request","stance":"superseded","subject":"ping, logging/setLevel, notifications/roots/list_changed","text":"ping, logging/setLevel and notifications/roots/list_changed are removed; log level is set per-request via _meta logLevel and servers MUST NOT emit notifications/message without it."},{"as_of":null,"based_on":["t78_o10"],"kind":"claim","local_id":"t78_c7","object":"io.modelcontextprotocol/tasks extension","predicate":"are moved out of core into","stance":"superseded","subject":"experimental tasks","text":"Experimental tasks move out of the core protocol into the io.modelcontextprotocol/tasks extension, redesigned around tasks/get and tasks/update polling."},{"as_of":null,"based_on":["t78_o11"],"kind":"claim","local_id":"t78_c8","object":"per-request opt-in","predicate":"may be returned unsolicited without","stance":"reported","subject":"task handles","text":"Servers may return task handles unsolicited without per-request opt-in under the redesigned tasks extension."},{"as_of":null,"based_on":["t78_o13"],"kind":"claim","local_id":"t78_c10","object":"\"complete\"","predicate":"is required; omission MUST be treated as","stance":"reported","subject":"resultType field","text":"All results now carry a required resultType; clients MUST treat results from earlier-protocol servers that omit it as \"complete\"."},{"as_of":null,"based_on":["t78_o14","t78_o15"],"kind":"claim","local_id":"t78_c11","object":"re-issue with new request ID","predicate":"are removed; broken streams require","stance":"superseded","subject":"SSE stream resumability and message redelivery","text":"SSE stream resumability and message redelivery (Last-Event-ID, SSE event IDs) are removed; a broken stream loses the in-flight request and clients MUST re-issue with a new request ID."},{"based_on":["t78_o1","t78_o2","t78_o14"],"falsifier":"A later revision reinstating protocol-level sessions or the initialize handshake, or stating the removed session items remain normative.","kind":"hypothesis","local_id":"t78_h1","text":"The removal of protocol-level sessions and the initialize handshake makes prior session/resumability guidance stale, so earlier MAY/SHOULD session items are superseded rather than merely qualified."},{"based_on":["t78_o10","t78_o11"],"falsifier":"A later revision stating tasks support as stable/normative core protocol without change.","kind":"hypothesis","local_id":"t78_h2","text":"The tasks extension remains the main open item: it is an official extension but still described as experimental, so its polling design may be tightened or qualified later."},{"about":["tasks extension","stability"],"kind":"question","local_id":"t78_q1","needed":"Check the tasks extension specification page for status wording.","text":"Does the section state whether the tasks extension is stable or still experimental after the move?"},{"about":["clientInfo","serverInfo","SHOULD"],"kind":"question","local_id":"t78_q2","needed":"Compare later revision of this Key Changes section or the base protocol page.","text":"Are the SHOULD items (clientInfo/serverInfo identification) tightened to MUST in later revisions?"}],"scope":{"docs":["d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936"],"ranges":[["d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936",0,4413]],"topic":null}},"engine_root":"9e07e279cc3bd448b7d410c006fda445e88344cda6d79be7d6878be55c0778a9","outcome":{"kind":"records","result":{"accepted":["80a0121fdad5232c6319e19ccd7167b60a12c9856dd29c47b727fd5e9043ecac","65e9b6944bd0600c1c1e77858d8fd867e916def1742de5a7259bad0939a418f0","d5225309e51432152e8f2faf0c3c7b91af88c6ed3396c3f440a865b72b87cf6d","89d74d1427937a5521ca36064b0000937a3839addc1dbd0f5e4cf993d2badbab","17a258df76d65d5b0af3d3baa0fdc2370ead5ab8a61ba4cc39417111802e2c11","94a769cb61ca59b42d3d5dd3ad5f4bb1bcc9c2c3e2069a941f0f532a932e965a","31d2d03d511ca48c6087e1126f674f658cd902b23b65d2f59ea0cb79066d913d","9fd8a666412b71263ca2389ff44c7f92e43903ed6134d318c3dd7b4a137f222f","e1e1d45f68ec61b3c1697710156d0af19bb4b12fea4844e150be32a2a05dc17e","ea2de6bf3ccaa0125d94ff5871876f686ffe20e7b8df4557975be01d4ea64a86","bed221a18e860a964d57412d0a8dcd38878da13a36f30e12bdf5947a92ffb368","1f55d855b633d74f5db28e38b9776f97591b281f71c91a3dbca06a73d44e7ab6","74b338900c4fd9dc32c8f51171ea8047681f4aabaaa05167a41436a4bac523a