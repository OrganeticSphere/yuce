{"body":{"actor":"w2","audit_root":"4c3d57204593634245bded859356f691d8c6dc3767fd575e6f6fdbc32e701809","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T61-8b1e19cdba6a71a3","kind":"submit","lines":[{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Implementations **SHOULD NOT**\n  use them to change the behavior of the client or server","kind":"observe","local_id":"t61_o2","terms":["clientInfo/serverInfo must not drive behaviour (SHOULD NOT)"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Implementations **SHOULD NOT**\n  use them to change the behavior of the client or server, and **SHOULD NOT**\n  rely on them for security decisions.","kind":"observe","local_id":"t61_o3","terms":["clientInfo/serverInfo must not be used for security (SHOULD NOT)"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"the server **MUST** include `io.modelcontextprotocol/subscriptionId` in `_meta` so the\nclient can correlate the notification with the originating subscription request.","kind":"observe","local_id":"t61_o4","terms":["subscriptionId required on notifications from subscriptions/listen"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"This exception exists to maintain compatibility with existing implementations and\n[OpenTelemetry semantic conventions for MCP](https://opentelemetry.io/docs/specs/semconv/gen-ai/mcp/).","kind":"observe","local_id":"t61_o7","terms":["rationale for trace context exemption"]},{"as_of":null,"based_on":["t61_o1","t61_o2","t61_o3"],"kind":"claim","local_id":"t61_c1","object":"display, logging, debugging only","predicate":"are self-reported and SHOULD NOT drive behaviour or security decisions","stance":"reported","subject":"io.modelcontextprotocol/clientInfo and serverInfo","text":"Self-reported clientInfo and serverInfo metadata is not verified by the protocol and is intended only for display, logging and debugging; implementations SHOULD NOT change behaviour or make security decisions based on it."},{"as_of":null,"based_on":["t61_o4"],"kind":"claim","local_id":"t61_c2","object":"io.modelcontextprotocol/subscriptionId in _meta","predicate":"MUST include","stance":"reported","subject":"notifications on subscriptions/listen streams","text":"The server MUST include io.modelcontextprotocol/subscriptionId in _meta on notifications delivered via a subscriptions/listen stream, so the client can correlate them with the originating subscription request."},{"as_of":null,"based_on":["t61_o5","t61_o6","t61_o7"],"kind":"claim","local_id":"t61_c3","object":"OpenTelemetry trace context propagation","predicate":"are exempt from prefix requirement and MUST follow W3C formats","stance":"qualified","subject":"traceparent, tracestate, baggage keys in _meta","text":"The _meta prefix requirement is qualified: traceparent, tracestate and baggage are reserved for OpenTelemetry trace context and are exempt from it, with values that MUST follow W3C formats when present."}],"scope":{"docs":["d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb"],"ranges":[["d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb",20112,25134]],"topic":null}},"engine_root":"193e36173802ab3e4604d55c91dfc5359e6d59fc80f83681074d44d0b2b6d79b","outcome":{"kind":"records","result":{"accepted":["f823d04433e251deea6b162294a07f665e558b38156b54c4e39e8b37ff2698ea","5c3facde0ca545d62f62fa953d12e68de902a76ca419263ca7506ed8556149de","f5dff55c5b763da33316551f5413a83b222d1196181b22689c1fc99fb8f2d89c","17f55da05e2e9135334fb9ea20e2160a63027f18c1b6e679861d6d8e150f7937","fd0d09990d0baf94fa0a880f6943d4f527abda0adab9c560af110b03b329bc62","40c863c5a968479aea81e89c198d4391f263c0ed8c8bb728413ceb8e2e823dbb","ceceba68a999a3775770f6ab122a94181578673e998d5b6011cc13a3defd4f4d"],"error":null,"failed_index":null}},"request_hash":"f2d1433fbd7a141c648b5a3157767d70f39ab8bbf7013c53fe40b3017e7bc548","submission_id":"T61-8b1e19cdba6a71a3#2"},"hash":"af1805965d28b2ee8e9cb865145919fecac743ad9c8128a4de553d981c6fa627","header":{"body_hash":"5cbd9fea76952e30e74f56609125daef04cb77e6bee42b3f8c294ef3ac1e2e6d","format":"sbgk-session-log/3","previous":"0e01328d2a39edaf57459de21dd7fd48d2aab0c00399e8dc73ed4be684355ac4","records_root":"10fe427976f98480f11506795f188e0482151a6adb7c268fd937ad285e5f57af","seq":310,"wal_op":"audit"}}
