_word":"and"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":9,"local_id":"t1_o10"}],"task_id":"T1-1e5dd5448a7c0d38","work_key":"doc:d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d#0"},"from":0,"key":"task-repair:T1-1e5dd5448a7c0d38:1","to":0},"kind":"batch","operations":[]},"engine_root":"a59970ed3403c61b4ea0fd10b65faa0e5acba5e6f11da4444624ab59c03e4533","outcome":{"kind":"value","result":{"accepted_operations":0,"checkpointed":true,"error":null,"failed_index":null,"results":[]}},"request_hash":"dcd83c7460ec61632fed30a83d97912fe75f69efd91bdb42ecb898c335146978","submission_id":"T1-1e5dd5448a7c0d38#repair1"},"hash":"79f913ccd64c699c85a335e604513934d83d4f251cbd58103b9554245fcabd8c","header":{"body_hash":"85107a5749a2b16aae6dab9e72dc4ba4b1dc73420bf71bd1d6e417065ac43c00","format":"sbgk-session-log/3","previous":"4d1f8634b2c32e5fa6970db985b803b6e97dfd67295daa3a2555b91bd0e7d4b6","records_root":"fe7c90ca2214e168f5ffe6cccb15729c3b8a03c403e48c406441cd589fdd8c41","seq":6,"wal_op":"audit"}}
{"body":{"actor":"w1","audit_root":"b4d1ae8011f64b647c39f14fd12f06cb324035708fd0798d95ca78a91d3b3698","command":{"allowed_records":[],"directive":"T1-1e5dd5448a7c0d38","kind":"submit","lines":[{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"**NOTE**: The following example assumes the MCP server is also functioning as the\nauthorization server.","kind":"observe","local_id":"t1_o6","terms":["example assumption","server as authorization server"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"Implementations using an STDIO transport **SHOULD NOT** follow this specification, and\n  instead retrieve credentials from the environment.","kind":"observe","local_id":"t1_o10","terms":["STDIO excluded from spec"]},{"as_of":null,"based_on":["t1_o1","t1_o10"],"kind":"claim","local_id":"t1_c1","object":"HTTP conform, STDIO excluded, alternatives follow best practices","predicate":"is optional and transport-scoped","stance":"reported","subject":"MCP authorization applicability","text":"Authorization is optional for MCP implementations; when supported, HTTP-based transports SHOULD conform to this spec, STDIO SHOULD NOT, and other transports MUST follow security best practices."},{"as_of":null,"based_on":["t1_o6"],"kind":"claim","local_id":"t1_c5","object":"MCP server doubles as authorization server (not required)","predicate":"assumes","stance":"qualified","subject":"authorization code example","text":"The authorization code example assumes the MCP server also acts as the authorization server, though the authorization server may be a distinct service."}],"scope":{"docs":["d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d"],"ranges":[["d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d",0,5880]],"topic":null}},"engine_root":"13c6319539cadaeb72519ee402bb896ceb4dff49cc7e82b1ce037e4462c32cc4","outcome":{"kind":"records","result":{"accepted":["99d46f7dd90ec6d6af3f