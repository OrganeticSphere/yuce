d":"t23_o7","terms":["metadata caching","SHOULD","HTTP cache headers"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Note over C: Abort or use pre-configured values","kind":"observe","local_id":"t23_o8","terms":["discovery fallback","abort","pre-configured values"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"M-->>C: HTTP 401 Unauthorized (may include WWW-Authenticate header)","kind":"observe","local_id":"t23_o9","terms":["401 Unauthorized","WWW-Authenticate","may include"]},{"as_of":null,"based_on":["t23_o2"],"kind":"claim","local_id":"t23_c3","object":"clients supporting all options","predicate":"SHOULD be followed by","stance":"reported","subject":"client registration priority order","text":"Clients supporting all registration options SHOULD follow a stated priority order: pre-registration, then Client ID Metadata Documents, then Dynamic Client Registration, then user prompt."},{"as_of":null,"based_on":["t23_o6","t23_o7"],"kind":"claim","local_id":"t23_c5","object":"Client ID Metadata Documents","predicate":"SHOULD fetch and cache","stance":"reported","subject":"authorization server metadata document handling","text":"Authorization servers SHOULD fetch metadata documents for URL-formatted client_ids and SHOULD cache metadata respecting HTTP cache headers."},{"as_of":null,"based_on":["t23_o8"],"kind":"claim","local_id":"t23_c6","object":"abort or pre-configured values","predicate":"may be","stance":"open","subject":"discovery failure fallback","text":"When discovery metadata is not found, the client may abort or use pre-configured values, leaving the fallback behavior open."},{"as_of":null,"based_on":["t23_o9"],"kind":"claim","local_id":"t23_c7","object":"resource_metadata discovery hint","predicate":"may include","stance":"qualified","subject":"WWW-Authenticate header on 401","text":"The 401 response may include a WWW-Authenticate header, so header-based resource_metadata discovery is optional rather than guaranteed."},{"about":["Client ID Metadata Documents","registration priority order","requirement strength"],"kind":"question","local_id":"t23_q1","needed":"Check later revisions of the authorization section for SHOULD->MUST changes on client registration.","text":"Does a later revision of this section promote Client ID Metadata Documents support or the registration priority order from SHOULD to MUST?"},{"about":["IETF draft status","Client ID Metadata Documents"],"kind":"question","local_id":"t23_q2","needed":"Check the datatracker draft-ietf-oauth-client-id-metadata-document version referenced in later revisions.","text":"Has the referenced OAuth Client ID Metadata Document draft advanced beyond -00, and does the spec pin a stable version?"}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",9360,14801]],"topic":null}},"engine_root":"6dc09e04d7898df20d676ef30b232b830e2adb0a15df94cc6b15a7c1b3ae7b97","outcome":{"kind":"records","result":{"accepted":["6e45b3672ba36d3fab95fca308bababfb0e0d987d48bd00997a5120c6b8e6d01","cd2978cced4c0ed9f15be10ecddc4ccda21f8cffac66af71a7949abc87c1f325","df66e1a1d0de4a86fefb5f410323d9abb9608db09752605350ec3be8326d93fb","7fbe58856522db27616b2b75fb5a77561654bb70785a322866c51670bfc82b15","747f427c2b171cb00be483a5fc9f4854d8c1eedd59aeff3c62d840245854b14f","7fcb37a4c2d96aabe2a0e9126ac08f9d05a86b79c39d8abef0ef369a1e79df79","f123fb29b71fae3dfb850351a09a79f5d70c93dd41f1c285856f055f8526e6a0","5be71641d8eb244cc4e2db200fd900cd7620f1ed91417128698f33788410ce31","57ad04c5a1f9579b999fa0939b6ee10a36108317cc9503fdd0a42a6d48ef90a9","a72b23a258e37fe511bd959147436b5966db19fffa0852e21a0506d868414d47","7a4dcda72d5f1a1208b1f202ab4a4297fb00445683c5d0c984b6524f2f4f8b1f","fba2dd441bfb21a87db6d2bea3436d97b05755f28afca432a849e303e5bb8ae7"],"error":null,"failed_index":null}},"request_hash":"097a90fd60e197e3b550ae