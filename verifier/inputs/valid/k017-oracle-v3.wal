{"body":{"actor":"w1","audit_root":"1b2132c0a841e55d378f590ab16ceeda87a5942e23188e5431f0add15a373830","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","931a61a051ec316ffbe720982ea9d05243d14af58d333910026e7d46ea12de5e","b397efe27e1ba0b3ddc96d0747b439a4fecc819c2ed2e231a98376466b66ac60","b7a5eb5e2373eea5ed723c57c6f9a195eed001f7ab1b346a0c70eb65c3692d9b","bd8ca52f7fecf3cec5bfb7fa53eeae7bcfc1b0496f6c2eef31a8f0043e0a1ab2","d686aac174d904fa6d1ad232ef834c3677c20312dd90bc4cf6dde0d2b49c457d","dbf5279a837ea8753bd40b6b10151ca3c406fc35274d7c6c62956ceae960e69c","e2ee9a90754d400ec44e3df92d921f1f2cb06dc0649cfa6d5257ae2f09a302a4","e38ed2520ced46d2f428362c62b287e94ffd1b32591fd4f777ab694d03ab4029","ee0d6b8cf2a71b56c4634c7f2157c016e6b75ef5c16f4b0d8c5ee5a46e0e0f4d","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"TR11-4290c5c2b145bf6a","kind":"submit","lines":[{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The client **MUST** include an `Accept` header, listing `text/event-stream` as a\n   supported content type.","kind":"observe","local_id":"t11_o1","terms":["SSE GET request","Accept header","client obligation"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"Servers **MAY** attach an `id` field to their SSE events, as described in the\n   [SSE standard](https://html.spec.whatwg.org/multipage/server-sent-events.html#event-stream-interpretation).","kind":"observe","local_id":"t11_o8","terms":["event IDs","optional"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"If present, the ID **MUST** be globally unique across all streams within that\n     [session](#session-management)—or all streams with that specific client, if session\n     management is not in use.","kind":"observe","local_id":"t11_o9","terms":["event ID uniqueness","session scope"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"these event IDs should be assigned by servers on a _per-stream_ basis, to\nact as a cursor within that particular stream.","kind":"observe","local_id":"t11_o12","terms":["event IDs","per-stream cursor"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"A server using the Streamable HTTP transport **MAY** assign a session ID at\n   initialization time, by including it in an `Mcp-Session-Id` header on the HTTP\n   response containing the `InitializeResult`.","kind":"observe","local_id":"t11_o13","terms":["session ID assignment","optional","initialization"]},{"as_of":null,"based_on":["t11_o1"],"kind":"claim","local_id":"t11_c1","object":"Accept header listing text/event-stream","predicate":"MUST include","stance":"reported","subject":"SSE GET request","text":"Clients opening an SSE stream via HTTP GET MUST send an Accept header listing text/event-stream as a supported content type."},{"as_of":null,"based_on":["t11_o8","t11_o9"],"kind":"claim","local_id":"t11_c5","object":"globally unique across streams in session or client scope","predicate":"MAY be attached but if present MUST be","stance":"qualified","subject":"SSE event id","text":"Attaching SSE event ids is optional (MAY); if present, an id MUST be globally unique across all streams within the session, or across all streams of that client if sessions are unused."},{"as_of":null,"based_on":["t11_o12"],"kind":"claim","local_id":"t11_c7","object":"per-stream cursors","predicate":"act as","stance":"reported","subject":"event IDs","text":"Event IDs function as per-stream cursors and are assigned by servers on a per-stream basis, not as a session-wide sequence."},{"as_of":null,"based_on":["t11_o13","t11_o14","t11_o16"],"kind":"claim","local_id":"t11_c8","object":"all subsequent client HTTP requests","predicate":"MAY be assigned and if returned MUST be echoed on","stance":"qualified","subject":"session ID","text":"Session IDs are optional: a server MAY assign one at initialization via Mcp-Session-Id on the InitializeResult response; if returned, clients MUST echo it on all subsequent HTTP requests."}],"scope":{"docs":["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b"],"ranges":[["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b",5241,11113]],"topic":null}},"engine_root":"ccdca4d61f5c27a295749c8b68efddcf12daed57f8089b2ac14521bcb726a795","outcome":{"kind":"records","result":{"accepted":["9f5673fd5ac32f3224aebbd2d4666d0ef435b0bec02d3485e2861a597728667f","6ddf879cb98a727ff632a90bac39291bb84340fef0305c95c822143424615ca2","00836a0223c5cd219e8097a9a160c9c094163fdece1cdc4a593cb5f31fa5486f","2e940a8b048b68a0d98aa3c639fe10ca7080091f01a03285f4814a4f6d8d10de","8702fcc44788eaa1238dcc8e989c1f7e8470e81d6cffae73815076a1a565495e","e8a3064b59819e405a0ee0e7dd41a31a0bf730dcafad31651198b7ff7f133fbb","1a6e1f314dffc611a68da20bcd86fca8adae790d383de4ca73914dd012abd6c8","dfeb6cc588e4b8f3809fe45ecb756736fe7cee7ee63136d8e490a2e57ce3b358","1a015d45d7e187cf5a980aba40b2ab609bcda5ee0f680652d80dc0ecb34be355"],"error":null,"failed_index":null}},"request_hash":"94aed83d875292db8ae6cd806c307cb861cacfbba0a822d1d97bfe59e85d97bc","submission_id":"TR11-4290c5c2b145bf6a#2"},"hash":"960dc935519d06a18492f4543b06730e1b4975d142753c6491f7cc3d069ab71c","header":{"body_hash":"1cf68b49b988962be924e3229df3dfe37540bd09e72d6bfae25abf8a4c48fc26","format":"sbgk-session-log/3","previous":"05aea9c6ed35fc88ac0c93eb0b4ea469b50faa6429beee1f2c2eb8c22e071507","records_root":"d62f9a3ccb17765d3a7397f6abeaf3d783c77d4167e1a37d327792a712e05ce6","seq":40,"wal_op":"audit"}}
