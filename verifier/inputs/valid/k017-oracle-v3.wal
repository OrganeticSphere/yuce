y messages that would have been delivered on a\n     different stream.","rule":"ends_mid_clause","suggested_exact_quote":"The server **MUST NOT** replay messages that would have been delivered on a\n     different stream.","suggested_span":{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","end_byte":9551,"start_byte":9453},"trailing_word":"a"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":2,"local_id":"t74_o3"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"The session ID **SHOULD** be globally unique and cryptographically secure (e.g., a\n     securely generated UUID, a JWT, or a cryptographic hash).","rule":"ends_mid_clause","suggested_exact_quote":"The session ID **SHOULD** be globally unique and cryptographically secure (e.g., a\n     securely generated UUID, a JWT, or a cryptographic hash).","suggested_span":{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","end_byte":10473,"start_byte":10328},"trailing_word":"a"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":5,"local_id":"t74_o6"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"The session ID **MUST** only contain visible ASCII characters (ranging from 0x21 to\n     0x7E).","rule":"ends_mid_clause","suggested_exact_quote":"The session ID **MUST** only contain visible ASCII characters (ranging from 0x21 to\n     0x7E).","suggested_span":{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","end_byte":10574,"start_byte":10479},"trailing_word":"to"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":6,"local_id":"t74_o7"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"Servers that require a session ID **SHOULD** respond to requests without an\n     `MCP-Session-Id` header (other than initialization) with HTTP 400 Bad Request.","rule":"ends_mid_clause","suggested_exact_quote":"Servers that require a session ID **SHOULD** respond to requests without an\n     `MCP-Session-Id` header (other than initialization) with HTTP 400 Bad Request.","suggested_span":{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","end_byte":11153,"start_byte":10994},"trailing_word":"an"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":7,"local_id":"t74_o8"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"For backwards compatibility, if the server does _not_ receive an `MCP-Protocol-Version`\nheader, and has no other way to identify the version - for example, by relying on the\nprotocol version negotiated during initialization - the server **SHOULD** assume protocol\nversion `2025-03-26`.","negation_before":"For backwards compatibility, if the server does _not_ receive an `MCP-Protocol-Version` header, and has no other way to identify the version - for example, by relying on the protocol version negotiated during initialization -","rule":"negation_before","suggested_exact_quote":"For backwards compatibility, if the server does _not_ receive an `MCP-Protocol-Version`\nheader, and has no other way to identify the version - for example, by relying on the\nprotocol version negotiated during initialization - the server **SHOULD** assume protocol\nversion `2025-03-26`.","suggested_span":{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","end_byte":13864,"start_byte":13579}},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":11,"local_id":"t74_o12"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"When a client receives HTTP 404 in response to a request containing an\n   `MCP-Session-Id`, it **MUST** start a new session by sending a new `InitializeRequest`\n   without a session ID attached.","rule":"ends_mid_clause","suggested_exact_quote":"When a client receives HTTP 404 in response to a request containing an\n   `MCP-Session-Id`, it **MUST** start a new session by sending a new `InitializeRequest`\n   without a session ID attached.","suggested_span":{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","end_byte":11507,"start_byte":11313},"trailing_word":"an"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":14,"local_id":"t74_o22"}],"task_id":"T74-bfb7dd4d245baac7","work_key":"doc:d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e#2"},"from":0,"key":"task-repair:T74-bfb7dd4d245baac7:1","to":0},"kind":"batch","operations":[]},"engine_root":"e68be66b0f33e55e5d05a5e6581dbe6ad1319b1893edc0a7be3d55e5112f0ec7","outcome":{"kind":"value","result":{"accepted_operations":0,"checkpointed":true,"error":null,"failed_index":null,"results":[]}},"request_hash":"972e1fec3becf29b6cc5280