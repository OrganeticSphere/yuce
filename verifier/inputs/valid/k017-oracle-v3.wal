{"body":{"actor":"w4","audit_root":"ddc3b86204715ddeaae0497b3ca7a8ad7a1f15bb9def659bca43611c85d16b0b","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T64-421572710db3e522","kind":"submit","lines":[{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Implementations using an HTTP-based transport **SHOULD** conform to this specification,","kind":"observe","local_id":"t64_o1","terms":["HTTP transport","authorization","conformance"]},{"as_of":null,"based_on":["t64_o1"],"kind":"claim","local_id":"t64_c1","object":"authorization specification","predicate":"SHOULD conform to","stance":"qualified","subject":"HTTP-based transport implementations","text":"Implementations using an HTTP-based transport SHOULD conform to the authorization specification, qualifying compliance as a recommendation rather than a mandate."},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"whereas implementations using STDIO transport **SHOULD NOT** follow this specification,","kind":"observe","local_id":"t64_o2","terms":["STDIO transport","authorization","credentials"]},{"as_of":null,"based_on":["t64_o2"],"kind":"claim","local_id":"t64_c2","object":"authorization specification","predicate":"SHOULD NOT follow","stance":"qualified","subject":"STDIO transport implementations","text":"Implementations using STDIO transport SHOULD NOT follow the authorization specification and instead retrieve credentials from the environment."},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Additionally, clients and servers **MAY** negotiate their own custom authentication and\nauthorization strategies.","kind":"observe","local_id":"t64_o3","terms":["custom authentication","authorization negotiation","optionality"]},{"as_of":null,"based_on":["t64_o3"],"kind":"claim","local_id":"t64_c3","object":"custom authentication and authorization strategies","predicate":"MAY negotiate","stance":"qualified","subject":"clients and servers","text":"Clients and servers MAY negotiate custom authentication and authorization strategies, leaving alternative auth mechanisms open."},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"For further discussions and contributions to the evolution of MCP's auth mechanisms, join\nus in\n[GitHub Discussions](https://github.com/modelcontextprotocol/specification/discussions)","kind":"observe","local_id":"t64_o4","terms":["GitHub Discussions","auth mechanisms evolution","future work"]},{"as_of":null,"based_on":["t64_o4"],"kind":"claim","local_id":"t64_c4","object":"GitHub Discussions","predicate":"remains open in","stance":"open","subject":"evolution of MCP's auth mechanisms","text":"The evolution of MCP's auth mechanisms remains open for community contributions and discussions on GitHub Discussions."},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"[TypeScript schema](https://github.com/modelcontextprotocol/specification/blob/main/schema/draft/schema.ts).\nThis is the source of truth for all protocol messages and structures.","kind":"observe","local_id":"t64_o5","terms":["TypeScript schema","source of truth","protocol specification"]},{"as_of":null,"based_on":["t64_o5"],"kind":"claim","local_id":"t64_c5","object":"all protocol messages and structures","predicate":"is the source of truth for","stance":"reported","subject":"TypeScript schema","text":"The TypeScript schema is established as the source of truth for all protocol messages and structures."},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"- Clients and servers **MUST** support JSON Schema 2020-12 for schemas without an explicit `$schema` field","kind":"observe","local_id":"t64_o6","terms":["JSON Schema 2020-12","default dialect","mandatory support"]},{"as_of":null,"based_on":["t64_o6"],"kind":"claim","local_id":"t64_c6","object":"JSON Schema 2020-12 for schemas without an explicit $schema field","predicate":"MUST support","stance":"reported","subject":"clients and servers","text":"Clients and servers MUST support JSON Schema 2020-12 for schemas without an explicit $schema field."},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"They **MUST** handle unsupported dialects gracefully by returning an appropriate error indicating the dialect is not supported.","kind":"observe","local_id":"t64_o7","terms":["unsupported dialects","graceful error handling","schema validation"]},{"as_of":null,"based_on":["t64_o7"],"kind":"claim","local_id":"t64_c7","object":"an appropriate error indicating the dialect is not supported","predicate":"MUST handle unsupported dialects by returning","stance":"reported","subject":"clients and servers","text":"Clients and servers MUST handle unsupported schema dialects gracefully by returning an appropriate error indicating the dialect is not supported."},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"- Clients and servers **SHOULD** document which schema dialects they support","kind":"observe","local_id":"t64_o8","terms":["schema dialects","documentation recommendation","interoperability"]},{"as_of":null,"based_on":["t64_o8"],"kind":"claim","local_id":"t64_c8","object":"which schema dialects they support","predicate":"SHOULD document","stance":"qualified","subject":"clients and servers","text":"Clients and servers SHOULD document which schema dialects they support, qualifying dialect documentation as a recommendation."},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Implementations **MUST NOT**\nautomatically dereference `$ref` values that resolve to a network URI.","kind":"observe","local_id":"t64_o9","terms":["$ref resolution","network URI","security restriction"]},{"as_of":null,"based_on":["t64_o9"],"kind":"claim","local_id":"t64_c9","object":"$ref values that resolve to a network URI","predicate":"MUST NOT automatically dereference","stance":"reported","subject":"implementations","text":"Implementations MUST NOT automatically dereference $ref values that resolve to a network URI."},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Implementations **MAY** offer an opt-in mode that fetches non-local `$ref`s but it\n**MUST** be disabled by default","kind":"observe","local_id":"t64_o10","terms":["opt-in non-local $ref","disabled by default","security mitigation"]},{"as_of":null,"based_on":["t64_o10"],"kind":"claim","local_id":"t64_c10","object":"disabled by default","predicate":"MAY be offered but MUST be","stance":"qualified","subject":"opt-in non-local $ref fetching","text":"Implementations MAY offer an opt-in mode fetching non-local $ref values, but it MUST be disabled by default."},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Schemas that fail to validate due to an unresolved external `$ref` **SHOULD** be rejected\nrather than silently treated as permissive.","kind":"observe","local_id":"t64_o11","terms":["unresolved external $ref","rejection recommendation","validation behavior"]},{"as_of":null,"based_on":["t64_o11"],"kind":"claim","local_id":"t64_c11","object":"rejected rather than silently treated as permissive","predicate":"SHOULD be","stance":"qualified","subject":"schemas failing validation due to unresolved external $ref","text":"Schemas that fail to validate due to an unresolved external $ref SHOULD be rejected rather than silently treated as permissive."},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Implementations **SHOULD** apply\nreasonable bounds, such as a maximum schema depth, a cap on the total number of subschemas,","kind":"observe","local_id":"t64_o12","terms":["composition keywords","Denial-of-Service mitigation","resource bounds"]},{"as_of":null,"based_on":["t64_o12"],"kind":"claim","local_id":"t64_c12","object":"implementations","predicate":"SHOULD be applied by","stance":"qualified","subject":"reasonable bounds against schema DoS","text":"Implementations SHOULD apply reasonable bounds on composition keywords to prevent malicious schemas from acting as a Denial-of-Service vector."}],"scope":{"docs":["d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb"],"ranges":[["d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb",10274,14242]],"topic":null}},"engine_root":"99f449b239f2e10f56091e5a273cfa68783c3a1008554fc5999eb1bfe262f0b5","outcome":{"kind":"records","result":{"accepted":["a6a0ce2caed985b3b3849c46a183b852b4c24a27ae4bf355c9bd6e180953b622","7735ba73ee562a2bb5b681acf4df9473a29520b6eec9f520117e4fcc65c1ee7b","e8247617320002bfc2061a5f2fe8a0e865137ea8940e190931114c4a9c721fcd","749a5ca0f1970c1eec2be98918f582b5b34b5316948a65548311580b8b166979","57eaae9791d1fc057c4e952a559812114cbe56a45cf91f1a9973f0c9e2aabeb0","cb3d80c7f753201ffc66b272dfe2518dbfffb970de3b2131c58fabab70e2a95f","b472099772a9eb42d3d0f9ec711e37128ac0fe73faf85b386dc112ac54526270","130b42eb3662f5b19f04d1b77554af50e3ed16b607bec9d025cc278c26