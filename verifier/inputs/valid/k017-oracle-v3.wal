operation phase","negotiated capabilities","SHOULD"]},{"doc_id":"d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b","exact_quote":"No specific shutdown messages are defined—instead, the underlying transport","kind":"observe","local_id":"t82_o6","terms":["shutdown","no defined messages","transport"]},{"as_of":null,"based_on":["t82_o1"],"kind":"claim","local_id":"t82_c1","object":"the first interaction between client and server","predicate":"MUST be","stance":"reported","subject":"initialization phase","text":"Initialization MUST be the first client-server interaction, with the client MUST sending initialize and the server MUST responding with capabilities and info."},{"as_of":null,"based_on":["t82_o3","t82_o4"],"kind":"claim","local_id":"t82_c3","object":"client and server version exchange","predicate":"is qualified by SHOULD-level latest-version and disconnect guidance","stance":"qualified","subject":"protocol version negotiation","text":"Version negotiation is qualified: the client MUST send a supported version, SHOULD send its latest, and SHOULD disconnect if it does not support the server's returned version."},{"as_of":null,"based_on":["t82_o5"],"kind":"claim","local_id":"t82_c4","object":"negotiated version and capabilities","predicate":"SHOULD respect and only use","stance":"reported","subject":"operation phase","text":"During operation both parties SHOULD respect the negotiated protocol version and only use successfully negotiated capabilities."},{"about":["version negotiation","pre-initialization requests"],"kind":"question","local_id":"t82_q1","needed":"Check later protocol revisions' Lifecycle sections for MUST wording on these items.","text":"Does any later revision of the Lifecycle section strengthen the SHOULD-level version negotiation and pre-initialize restrictions to MUST?"},{"about":["experimental capability","shutdown"],"kind":"question","local_id":"t82_q2","needed":"Check later revisions for experimental feature definitions and shutdown message specifications.","text":"Is the experimental capability's scope or the absence of defined shutdown messages addressed in later revisions?"}],"scope":{"docs":["d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b"],"ranges":[["d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b",0,5932]],"topic":null}},"engine_root":"67547c3d05e6e07e7e7ec5d0bfbdacce2e3299e2ecb4cb427c51fa39f25fa16d","outcome":{"kind":"records","result":{"accepted":["2fa17fb171a5afde737d27c3bac2b1625bfb4287ea954ef4db6d15662d116a20","73a92f9dc8bb36c5ab9abaeaee1244707b1043ffb3ae50363f97ddc9f1f499ae","715f7599e1bf5c7940c33d478521c249c97dbda9b589cd4ee87967d8e8c2f264","8600439a9f7453abc6d108af13457120710831777a607a6fe3929685053a3631","5248d4d8fcccff12db186365708ca8699a1d18cd21a44b92b02aef5c44fa8125","beed0c0aac8e73be44c65234962513f52b7b7eed75dd6c15eb9abf5d1abd62db","f28767d2143a120734aa746162a937ed2d83ff09a2ebc7d4ffcc2faf63f64daf","410ed1a6b70b05ef7758947c3e59f46f262dca7325ebc51586b869589e2d9866","f9fe59f46dc3fc789e651db6db387451a0903860ecf7a094df63bd24832b89ce","54fc3dab65fff9cae8c7ee110f7bd93ed4b08c0966fb35bfc02cd64315152deb"],"error":null,"failed_index":null}},"request_hash":"cb1775973c8d9759282ef035d2dc3ec386936b86fb084c963942ab2fbd66b0db","submission_id":"T82-0227ccd72aba18f6#1"},"hash":"e7c44e81d7147f6988a6a52227cd828f2bab996ba7438af75e739e18cf4379ed","header":{"body_hash":"c01c93a588bd4274d258552fcea18748cef7cd0286bd2c99338c2cc1000a5722","format":"sbgk-session-log/3","previous":"dca5ee0e61fa90f3c04c4d30c880126fe2fc47edacb6af64052ec37cac2e0703","records_root":"9f16d3a42f6d6ee97dfa984b6e0fcd7cf52ce618ced29dfa7095b521c912a6a8","seq":405,"wal_op":"audit"}}
