{"body":{"actor":"w3","audit_root":"30d6dc0bbb7a399206edf65a923ee85c5705c76c55db9060fad3aa7d5f14e17b","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","931a61a051ec316ffbe720982ea9d05243d14af58d333910026e7d46ea12de5e","b397efe27e1ba0b3ddc96d0747b439a4fecc819c2ed2e231a98376466b66ac60","b7a5eb5e2373eea5ed723c57c6f9a195eed001f7ab1b346a0c70eb65c3692d9b","bd8ca52f7fecf3cec5bfb7fa53eeae7bcfc1b0496f6c2eef31a8f0043e0a1ab2","d686aac174d904fa6d1ad232ef834c3677c20312dd90bc4cf6dde0d2b49c457d","dbf5279a837ea8753bd40b6b10151ca3c406fc35274d7c6c62956ceae960e69c","e2ee9a90754d400ec44e3df92d921f1f2cb06dc0649cfa6d5257ae2f09a302a4","e38ed2520ced46d2f428362c62b287e94ffd1b32591fd4f777ab694d03ab4029","ee0d6b8cf2a71b56c4634c7f2157c016e6b75ef5c16f4b0d8c5ee5a46e0e0f4d","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T15-7287a8da68451a82","kind":"submit","lines":[{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"If using HTTP, the client **MUST** include the `MCP-Protocol-Version:","kind":"observe","local_id":"t15_o1","terms":["HTTP protocol version header","client requests"]},{"as_of":null,"based_on":["t15_o1"],"kind":"claim","local_id":"t15_c1","object":"all subsequent HTTP requests","predicate":"MUST be included by clients on","stance":"reported","subject":"MCP-Protocol-Version header","text":"For HTTP, clients must include the MCP-Protocol-Version header on all subsequent requests to the MCP server."},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"If the server receives a request with an invalid or unsupported","kind":"observe","local_id":"t15_o2","terms":["invalid protocol version","server response"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"it **MUST** respond with `400 Bad Request`.","kind":"observe","local_id":"t15_o3","terms":["invalid protocol version","HTTP 400"]},{"as_of":null,"based_on":["t15_o2","t15_o3"],"kind":"claim","local_id":"t15_c2","object":"HTTP 400 Bad Request","predicate":"MUST receive","stance":"reported","subject":"invalid or unsupported MCP-Protocol-Version","text":"A server receiving an invalid or unsupported MCP-Protocol-Version must respond with HTTP 400 Bad Request."},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"Clients and servers can maintain backwards compatibility with the deprecated [HTTP+SSE","kind":"observe","local_id":"t15_o4","terms":["deprecated HTTP+SSE transport","backwards compatibility"]},{"as_of":null,"based_on":["t15_o4"],"kind":"claim","local_id":"t15_c3","object":"backwards compatibility","predicate":"is deprecated yet may be supported for","stance":"qualified","subject":"HTTP+SSE transport","text":"The HTTP+SSE transport from protocol version 2024-11-05 is deprecated, but clients and servers can retain backwards compatibility with it."},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"Clients and servers **MAY** implement additional custom transport mechanisms to suit","kind":"observe","local_id":"t15_o5","terms":["custom transports","transport extensibility"]},{"as_of":null,"based_on":["t15_o5"],"kind":"claim","local_id":"t15_c4","object":"any bidirectional communication channel","predicate":"MAY be implemented over","stance":"reported","subject":"custom transport mechanisms","text":"Implementers may add custom transport mechanisms because the protocol is transport-agnostic, provided the channel supports bidirectional message exchange."},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"Custom transports\n**SHOULD** document their specific connection establishment and message exchange patterns","kind":"observe","local_id":"t15_o7","terms":["custom transports","interoperability documentation"]},{"about":["HTTP+SSE transport","backwards compatibility"],"kind":"question","local_id":"t15_q1","needed":"Check later protocol revisions for removal, replacement, or continued compatibility guidance.","text":"Whether the deprecated HTTP+SSE transport will eventually be removed or replaced remains open."}],"scope":{"docs":["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b"],"ranges":[["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b",11113,13956]],"topic":null}},"engine_root":"d041beddf7fadab57ebac6d00dcbee2c51609cf72e810ab19045b72819c7c5c1","outcome":{"kind":"records","result":{"accepted":["c8e18efb8199dd80e2376440d4ad4b93e746905ab5e87a1d9e5b57bfdb0b7e60","4a145076744cac6a62bf53bc6a68b5c9933c62d762d3c4e3452b8fc7ffb9457e","75c4830c43adfd0d8b113ad514ec61179133c5bf3f4b12d4d77001c7efb5e795","be07022f54e0605295746ec788c70b27429d6b3c7d7ed4185ab57b75d21c8265","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","eb0ae3fc2dc2b4b03d7c495cc71b2dfd54a3df07f9d04ab4089704a47b99bf5d","ec28afc0f3fb9dc99e136dbc4c74942103c85bd3e16be6d524997b178d9e12c6","0e94529b8813330f876736b0b86d5f47783933fedd1dc176e5d8ccbedbfaa41f","1533aa1719679044a64bb49a41571ae69cf0a3b1468052b1cb4445782cbbbdf9","a8c5ce2fa1b0250cff0d62717056db114ff300b22e70e83266138d089e3edadc","cc4c97d2a39c8491330a63f3824ca1beb61ffb084345a54561c172112455a491"],"error":null,"failed_index":null}},"request_hash":"296d435e154f0a4af87839e8f71f2246796ced9f61e457d8dbbddf47cf20ce4f","submission_id":"T15-7287a8da68451a82#1"},"hash":"8e02f1b04dc1fc8cda84e5ca79f73dd3e8f112e546a3a1bf3f6231ad713bf6b3","header":{"body_hash":"63875aaad0436e66bd10dd95db9e902817b1930af6efe99d41bccaf3676b7f6a","format":"sbgk-session-log/3","previous":"9e60be1d719f5e337c6a256c551749e7a4cb0d36b9791ca0c24b798e1afc6e6a","records_root":"ab3be2438500912a5c3b8361198f9c0e79605e201959416a6e2333ba1a9a3c3b","seq":62,"wal_op":"audit"}}
