{"body":{"actor":"w2","audit_root":"92ab88e1d0f344c6b52f89fda35df9b699a98e31a37ca67dcdcc1c1bce693c05","command":{"allowed_records":["747b9eeb9d729d8e6bf673d815818e0fe72728749b8d644ab9b2b4dc731ce224","ca4aec9353152fc5c7db2cd7f9f784d4b4ba95594ccda2162eb26b5a4305fbfb","f28767d2143a120734aa746162a937ed2d83ff09a2ebc7d4ffcc2faf63f64daf"],"directive":"TQ131-bc3330f619679c37","kind":"submit","lines":[{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"Every POST request to the MCP endpoint **MUST** include an\n`MCP-Protocol-Version` header.","kind":"observe","local_id":"t131_o2","terms":["2026-07-28 requires MCP-Protocol-Version header on every POST"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"not to support), it **MUST** respond with `400 Bad Request` and an\n[`UnsupportedProtocolVersionError`][unsupported-version]\nlisting its supported versions.","kind":"observe","local_id":"t131_o4","terms":["unsupported protocol version answered with 400 and UnsupportedProtocolVersionError"]},{"doc_id":"d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804","exact_quote":"The client **SHOULD NOT** send requests other than\n  [pings](/specification/2025-03-26/basic/utilities/ping) before the server has responded to the\n  `initialize` request.","kind":"observe","local_id":"t131_o6","terms":["client pre-initialization request restriction is SHOULD NOT"]},{"doc_id":"d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804","exact_quote":"The server **SHOULD NOT** send requests other than\n  [pings](/specification/2025-03-26/basic/utilities/ping) and\n  [logging](/specification/2025-03-26/server/utilities/logging) before receiving the `initialized`\n  notification.","kind":"observe","local_id":"t131_o8","terms":["server pre-initialization request restriction is SHOULD NOT"]},{"as_of":20260728,"based_on":["t131_o2","t131_o3"],"kind":"claim","local_id":"t131_c1","object":"POST requests to the MCP endpoint","predicate":"MUST include the header and MUST reject on mismatch","stance":"confirmed","subject":"per-request protocol version validation in 2026-07-28","text":"In the 2026-07-28 request metadata, every POST must carry MCP-Protocol-Version matching the body _meta version; a mismatch must be rejected."},{"as_of":20260728,"based_on":["t131_o4"],"kind":"claim","local_id":"t131_c2","object":"requests for unimplemented protocol versions","predicate":"MUST respond with 400 and UnsupportedProtocolVersionError","stance":"confirmed","subject":"server response to unsupported protocol version in 2026-07-28","text":"In 2026-07-28, a server that does not implement the requested version must answer 400 Bad Request with UnsupportedProtocolVersionError listing its supported versions."},{"as_of":20250326,"based_on":["t131_o6","t131_o8"],"kind":"claim","local_id":"t131_c4","object":"client and server requests before initialization completes","predicate":"SHOULD NOT (not MUST)","stance":"reported","subject":"pre-initialization request restrictions in 2025-03-26","text":"In 2025-03-26 the client and server SHOULD NOT send requests other than pings (and logging for the server) before the initialize response or initialized notification."},{"as_of":20260728,"based_on":["t131_o2","t131_o3","t131_o4","t131_o7"],"kind":"claim","local_id":"t131_c5","object":"version negotiation and pre-initialization restrictions","predicate":"partially tightened: per-request checks are MUST; initialize SHOULDs unaddressed here","stance":"qualified","subject":"tightening of 2025-03-26 SHOULDs in later revisions","text":"The 2026-07-28 request metadata section makes per-request version checks MUST-level, but the version-negotiation and pre-initialization SHOULDs are not shown in these sections."}],"scope":{"docs":["d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804","d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530"],"ranges":[["d_0d6aa094546300c