les","no responses to server"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"The server **MUST NOT** write JSON-RPC _requests_ to `stdout`.","kind":"observe","local_id":"t50_o7","terms":["server sending rules","no server requests"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"Servers **SHOULD** exit promptly when their standard input is closed or reads","kind":"observe","local_id":"t50_o11","terms":["server graceful shutdown","SHOULD exit"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"If the server process exits unexpectedly, the client **SHOULD** restart it.","kind":"observe","local_id":"t50_o13","terms":["unexpected termination","restart SHOULD"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"Active\n[`subscriptions/listen`][subscriptions-listen] streams must also be\nre-established after restart.","kind":"observe","local_id":"t50_o15","terms":["subscriptions resumption","restart re-establishment"]},{"as_of":null,"based_on":["t50_o1","t50_o4"],"kind":"claim","local_id":"t50_c1","object":"newline-delimited JSON-RPC messages","predicate":"MUST NOT contain embedded newlines and MUST NOT carry non-MCP data on stdout/stdin","stance":"reported","subject":"stdio message framing","text":"stdio messages are newline-delimited and MUST NOT contain embedded newlines; servers MUST NOT write non-MCP data to stdout and clients MUST NOT write non-MCP data to stdin."},{"about":["t50_c2","t50_c3","t50_c7","t50_c8"],"kind":"question","local_id":"t50_q1","needed":"Compare later specification revisions of the stdio transport page for requirement-strength changes.","text":"Does any later revision tighten stdio stderr, shutdown, restart or custom-transport framing from MAY/SHOULD to MUST?"},{"about":["t50_c8"],"kind":"question","local_id":"t50_q2","needed":"Check the transports and lifecycle sections for session resumability statements that may qualify this.","text":"Is the statelessness claim (in-flight requests simply lost on restart) consistent with session/resumability rules elsewhere in the spec?"}],"scope":{"docs":["d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12"],"ranges":[["d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12",0,5317]],"topic":null}},"engine_root":"f5cbedb849bfd15c38d2a944119537054f56efde0f0dfaefcfdbcbd37f536d59","outcome":{"kind":"records","result":{"accepted":["5a387a41daf2befaea4612a507d6b20e04099ae0159cffa0d226b15b20d3171d","23688d5ed96e34a04aa9ca81aeff6337f6c4faf7557f09f345243b29f9c1bba4","6534aca9db54a6093b88b807c3e39ca9672d6e31f5901f0c45b5e979d1ffd822","280978979c08ae0f73686b21cadc9a20a36b10e23ca2768d6bafdb824448c9c0","bbfc6c3ce4c5a9ddfeb0c6b6dd59be09c1430111d58b86abafdc56ba9ed2f4a5","7f6f6b0f2aa14921d6d16f7c07b20de2241730b7966783bf9e72173f0f6f86c1","4ba59eed22bebc0adcd79986d8ca6893fde1896e6640fcc2a45627e5567d0b57","b0dcf3e3d306fdcf4fe7dd14c87afd307774de45a96a9e6c4275ea8dedff63a4","5bbb642e5eec8792759735874a21cb8e50fdb03761bbb4cdab8af30dde20ce43","e34da4c25195b419a9812670f075852d489c483c1eb44664edcb36ed1e717418","79e9b642602c76b1811c7886c7bc7bf816d8fc0c1e6bfb69285a6ee41e7e8c96"],"error":null,"failed_index":null}},"request_hash":"f3bc994e36fb6eb8a0764f29b1d0c1d877df8534d426c2212f145fbb6a79cd3d","submission_id":"T50-a6bdb90b627068ec#1"},"hash":"49bf4613e5cf6b5f820bab89f2a1e63b1cb5b4bb7672053bf6c56ca68ed59f63","header":{"body_hash":"a0c8a1fc8223535728a3f5fd749c48f9883efd70c98fa43e175ce2bb2a23f950","format":"sbgk-session-log/3","previous":"168d476e1d93fe4a27d50e28072c77cb5905784065c3b8a8c3a7330fc2ca4e7f","records_root":"90a7bf540586bff92931b4d8eb55f6a18c55f284cef091ea5df69d9d0a767ce5","seq":237,"wal_op":"audit"}}
