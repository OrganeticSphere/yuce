{"body":{"actor":"w3","audit_root":"b675e0b9824b7e6b1aa760044f2ca6c09cb4e4cbfc7885a9c3559dc762e449b5","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T10-a803048616f6c8a8","kind":"submit","lines":[{"doc_id":"d_1a394cb9daa9fa54e34c5288eafbe9c4fda4e3be1b765bb42851eb816fb6610e","exact_quote":"Remove support for JSON-RPC **[batching](https://www.jsonrpc.org/specification#batch)**","kind":"observe","local_id":"t10_o1","terms":["JSON-RPC batching","protocol change"]},{"as_of":null,"based_on":["t10_o1"],"kind":"claim","local_id":"t10_c1","object":"in this revision","predicate":"is no longer supported","stance":"superseded","subject":"JSON-RPC batching","text":"Support for JSON-RPC batching was removed in this revision, superseding the prior support."},{"doc_id":"d_1a394cb9daa9fa54e34c5288eafbe9c4fda4e3be1b765bb42851eb816fb6610e","exact_quote":"Require MCP clients to implement Resource Indicators as described in [RFC 8707](https://www.rfc-editor.org/rfc/rfc8707.html) to prevent","kind":"observe","local_id":"t10_o2","terms":["MCP clients","Resource Indicators","RFC 8707","security"]},{"as_of":null,"based_on":["t10_o2"],"kind":"claim","local_id":"t10_c2","object":"Resource Indicators as described in RFC 8707","predicate":"MUST implement","stance":"reported","subject":"MCP clients","text":"MCP clients are required to implement RFC 8707 Resource Indicators to prevent malicious servers from obtaining access tokens."},{"doc_id":"d_1a394cb9daa9fa54e34c5288eafbe9c4fda4e3be1b765bb42851eb816fb6610e","exact_quote":"Classify MCP servers as [OAuth Resource Servers](/specification/2025-06-18/basic/authorization#authorization-server-discovery),","kind":"observe","local_id":"t10_o3","terms":["MCP servers","OAuth Resource Servers","authorization server discovery"]},{"as_of":null,"based_on":["t10_o3"],"kind":"claim","local_id":"t10_c3","object":"OAuth Resource Servers","predicate":"are classified as","stance":"reported","subject":"MCP servers","text":"This revision classifies MCP servers as OAuth Resource Servers and adds protected resource metadata for discovering the corresponding Authorization server."},{"doc_id":"d_1a394cb9daa9fa54e34c5288eafbe9c4fda4e3be1b765bb42851eb816fb6610e","exact_quote":"Change **SHOULD** to **MUST** in [Lifecycle Operation](/specification/2025-06-18/basic/lifecycle#operation)","kind":"observe","local_id":"t10_o4","terms":["Lifecycle Operation","normative requirement","SHOULD to MUST"]},{"as_of":null,"based_on":["t10_o4"],"kind":"claim","local_id":"t10_c4","object":"SHOULD to MUST","predicate":"has requirement strength changed from","stance":"superseded","subject":"Lifecycle Operation","text":"The Lifecycle Operation requirement was strengthened from SHOULD to MUST, qualifying or superseding the earlier weaker guidance."},{"doc_id":"d_1a394cb9daa9fa54e34c5288eafbe9c4fda4e3be1b765bb42851eb816fb6610e","exact_quote":"For a complete list of all changes that have been made since the last protocol revision,","kind":"observe","local_id":"t10_o5","terms":["changelog","protocol revisions","remaining scope"]},{"about":["complete changelog","changes since 2025-03-26"],"kind":"question","local_id":"t10_q1","needed":"Check the linked GitHub comparison.","text":"What additional changes are listed in the complete GitHub changelog since the last protocol revision?"}],"scope":{"docs":["d_1a394cb9daa9fa54e34c5288eafbe9c4fda4e3be1b765bb42851eb816fb6610e"],"ranges":[["d_1a394cb9daa9fa54e34c5288eafbe9c4fda4e3be1b765bb42851eb816fb6610e",0,3138]],"topic":null}},"engine_root":"9ee8a3c439cbe7becc9fa6e53d20bce5dc43f1192b66a78f010989459d27f249","outcome":{"kind":"records","result":{"accepted":["0d2b0ea49d97339a4c0baf024d05c3618c2c613ac195373f06b50fe1b49c2d28","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","51278fd37674ccf74e4d57a4a1c814d0