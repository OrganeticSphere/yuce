//datatracker.ietf.org/doc/html/rfc7591)\nto allow MCP clients to obtain OAuth client IDs without user interaction.","kind":"observe","local_id":"t77_o4","terms":["Dynamic Client Registration","optional support"]},{"as_of":null,"based_on":["t77_o4","t77_o3"],"kind":"claim","local_id":"t77_c4","object":"OAuth 2.0 Dynamic Client Registration","predicate":"MAY support","stance":"qualified","subject":"MCP clients and authorization servers","text":"Dynamic Client Registration remains optional and is retained for backwards compatibility with authorization servers lacking CIMD support."},{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","exact_quote":"clients **SHOULD** surface a meaningful error to the user or\ndeveloper.","kind":"observe","local_id":"t77_o7","terms":["registration failure reporting","user or developer errors"]},{"as_of":null,"based_on":["t77_o7"],"kind":"claim","local_id":"t77_c7","object":"a meaningful error after registration rejection","predicate":"SHOULD surface","stance":"qualified","subject":"MCP clients","text":"When registration is rejected for redirect URI constraints, clients should surface a meaningful error to the user or developer."},{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","exact_quote":"If the authorization server indicated by\nprotected resource metadata no longer matches the one the\ncredentials were registered with, clients **SHOULD** surface an\nerror rather than silently attempting to use mismatched credentials.","kind":"observe","local_id":"t77_o11","terms":["mismatched credentials","error handling"]},{"as_of":null,"based_on":["t77_o11"],"kind":"claim","local_id":"t77_c11","object":"when credential and authorization-server bindings mismatch","predicate":"SHOULD surface an error","stance":"qualified","subject":"MCP clients","text":"If protected-resource metadata identifies a different authorization server than the one tied to pre-registered credentials, clients should show an error instead of silently using mismatched credentials."}],"scope":{"docs":["d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f"],"ranges":[["d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f",5793,10016]],"topic":null}},"engine_root":"64a7c140f17baf4c9d03d3c18426d8c2f27459183e056fc967d04f5f90f3bc6c","outcome":{"kind":"records","result":{"accepted":["28fb9c4f380a9aaa4b5e25ec387989ffb94efd879870620527e381fa9bc81469","29ef499697a4e5d5f4502e905f3d97cd5e963fb08a38680deb24c536d8b4f357","d017effc6799c48ec6a83ecc94dcc889825e62e7a3e765bb14f187d29b74dfe2","1fe9f53fc92cd466493ae84d1199893c1b3fb4f882154a15e7efdad0a179c695","917e5af6d0cdb4a51ed4ddb006ff350010e701d0868b0c0c94f8e1974219eb34","294b3e2b31a70f897a20b880b87de484ac58dbc963d95be25ebeea558e3d1d2c","d7fdb31905272d122d1fe5520d6c4f525058423cb238c2fe58611351cbae4fd0","13538557d6104a703a80c148ca9004bb3b0eb542907520cd526d351557642311"],"error":null,"failed_index":null}},"request_hash":"9c6cd86e1eb4ba0dee3c1b7b4aabd86994b59102d53941911b66dc0e4f3d0073","submission_id":"T77-5f49dfe0d00ab7fd#2"},"hash":"fb24b4841d7ef94861e090cc1dc03008aad0b0a6ca90c274f6bee46ac1eff841","header":{"body_hash":"dc55405df1e8d4f306f94ceb29db33910ac3a1ea27781c12ce4df14cd8b06ff5","format":"sbgk-session-log/3","previous":"e1062c07c5201f9b1ae183b83912a8b65705bb60769a4061952d4cd49f9b8cc1","records_root":"038e93e3675610917ecc5aebd6105623545648f375fe1a982f02c468aaf0a145","seq":393,"wal_op":"audit"}}
