{"body":{"actor":"w1","audit_root":"5fd41dd7501ad0b32595ab317c9e4412e070247decb05b07b80309b9c40610c9","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T7-9768547ba0a139e0","kind":"submit","lines":[{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The server **MUST NOT** send a JSON-RPC _response_ on the stream **unless**","kind":"observe","local_id":"t7_o1","terms":["SSE stream","JSON-RPC response","resumability exception"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The server **MAY** terminate the session at any time, after which it **MUST** respond","kind":"observe","local_id":"t7_o6","terms":["session termination","HTTP 404 Not Found"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"it **MUST** start a new session by sending a new `InitializeRequest`","kind":"observe","local_id":"t7_o7","terms":["session recovery","re-initialization"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The server **MAY** respond to this request with HTTP 405 Method Not Allowed,","kind":"observe","local_id":"t7_o8","terms":["session termination","HTTP 405 optional"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The risk of message loss **MAY** be mitigated by making the stream","kind":"observe","local_id":"t7_o9","terms":["message loss","resumable stream mitigation"]},{"as_of":null,"based_on":["t7_o1"],"kind":"claim","local_id":"t7_c1","object":"resuming a stream from a previous client request","predicate":"MUST NOT be sent unless","stance":"reported","subject":"JSON-RPC responses on SSE stream","text":"Servers MUST NOT send JSON-RPC responses on an SSE stream unless resuming a stream tied to a previous client request."},{"as_of":null,"based_on":["t7_o6"],"kind":"claim","local_id":"t7_c5","object":"HTTP 404 Not Found","predicate":"MUST respond with","stance":"reported","subject":"terminated session","text":"A server MAY terminate a session at any time, after which it MUST respond to requests carrying that session ID with HTTP 404 Not Found."},{"as_of":null,"based_on":["t7_o7"],"kind":"claim","local_id":"t7_c6","object":"new session via InitializeRequest","predicate":"MUST start","stance":"reported","subject":"client receiving HTTP 404","text":"On receiving HTTP 404 for a request with Mcp-Session-Id, the client MUST start a new session via a new InitializeRequest without a session ID."},{"as_of":null,"based_on":["t7_o8"],"kind":"claim","local_id":"t7_c7","object":"HTTP 405 Method Not Allowed","predicate":"SHOULD be attempted but MAY be refused with","stance":"qualified","subject":"explicit session termination","text":"Clients SHOULD send HTTP DELETE with Mcp-Session-Id to terminate a session, but the server MAY reply HTTP 405, so explicit termination is optional."},{"as_of":null,"based_on":["t7_o9"],"kind":"claim","local_id":"t7_c8","object":"resumable streams","predicate":"MAY be achieved by","stance":"qualified","subject":"message loss mitigation","text":"Message loss across multiple streams MAY be mitigated by making the stream resumable; this mitigation is optional, not required."},{"about":["resumability","session management"],"kind":"question","local_id":"t7_q1","needed":"Check later specification revisions of this transport section for changes to replay and 404 handling.","text":"Does any later revision of the Streamable HTTP transport change the per-stream replay restriction or the 404-triggered re-initialization rule?"},{"about":["message loss","resumability"],"kind":"question","local_id":"t7_q2","needed":"Compare later revisions' wording on resumable streams and message-loss mitigation.","text":"Is the optional resumability mitigation (MAY) ever made mandatory, and does that supersede this guidance?"}],"scope":{"docs":["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b"],"ranges":[["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b",5241,11113]],"topic":null}},"engine_root":"f27e4b5bba590bf168c3ceb28623b23ededbd4c7f3c8b324c947ec42f7c20da6","outcome":{"kind":"records","result":{"accepted":["34af7a4284b5a1c818009773f438f5e1f060feaf0dc5e92727ec8b437524758e","b1c4fd0a827b5b8f2abf2e6623f996d99537c1e09ae4462e892cb4acba7f91c5","68537c58e6d6e7cd539906bc63d144655dabda4ae8df0f2f15c189560f33e653","63226817ee96341f953914b34337b4daa0464d6545abc2ff7895ea9778c368d7","6c174ddd6b534a457a77d3965bf1a07d673f02cf48ca3dc7a2cbe119928df9f6","e38ed2520ced46d2f428362c62b287e94ffd1b32591fd4f777ab694d03ab4029","b7a5eb5e2373eea5ed723c57c6f9a195eed001f7ab1b346a0c70eb65c3692d9b","d686aac174d904fa6d1ad232ef834c3677c20312dd90bc4cf6dde0d2b49c457d","b397efe27e1ba0b3ddc96d0747b439a4fecc819c2ed2e231a98376466b66ac60","931a61a051ec316ffbe720982ea9d05243d14af58d333910026e7d46ea12de5e","bb63c26e2c378f7ae3f4a660169001cc7a6c799e04f30ad35955126405f343f5","6b45e5b9b770fc89cdf2d1025ff8762476c75118b1e05841fe5e0667e2083415"],"error":null,"failed_index":null}},"request_hash":"777ed0632fa4404216d8ad8a926dc4b8bc59e6212543ebd7b788cdac8cae1cdc","submission_id":"T7-9768547ba0a139e0#1"},"hash":"3d86183869966a0696f35a752687f6c0f9a8beb5a4c75b2f38c2e02edd3a61e4","header":{"body_hash":"bd6a1b8cfc96bd595f66c0648baf947164d891b98e1f7c05bd826f95355e99fe","format":"sbgk-session-log/3","previous":"e5fc2f097d4cbcc739cf6dc9a29e99ab9b634c74babafbf261f8facebb2c70df","records_root":"d1de76e4b9cc0d7136f642d30c26c1b403b3f2411d1c255ad4fd5170da642c50","seq":32,"wal_op":"audit"}}
