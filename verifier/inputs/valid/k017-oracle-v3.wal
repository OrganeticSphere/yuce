{"body":{"actor":"w1","audit_root":"31e24d1709ba3a868b13c7bd64683ffc1b14631dca74d68f0626f038a331b74c","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T57-2572f1565e895a92","kind":"submit","lines":[{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Other components **MAY** be implemented based on the specific needs of the\napplication.","kind":"observe","local_id":"t57_o2","terms":["optional components","MAY","implementation scope"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"All messages between MCP clients and servers **MUST** follow the\n[JSON-RPC 2.0](https://www.jsonrpc.org/specification) specification.","kind":"observe","local_id":"t57_o3","terms":["JSON-RPC 2.0","message format requirement"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"- The request ID **MUST NOT** match the ID of any other request the sender has issued and\n  not yet received a response for.","kind":"observe","local_id":"t57_o5","terms":["request ID uniqueness","outstanding requests"]},{"as_of":null,"based_on":["t57_o1","t57_o2"],"kind":"claim","local_id":"t57_c1","object":"all implementations","predicate":"MUST be supported by","stance":"reported","subject":"base protocol, versioning and message patterns","text":"Implementations MUST support the base protocol, versioning and message patterns; other components MAY be implemented per application needs."},{"as_of":null,"based_on":["t57_o3","t57_o4","t57_o5"],"kind":"claim","local_id":"t57_c2","object":"JSON-RPC 2.0","predicate":"MUST follow","stance":"reported","subject":"messages between MCP clients and servers","text":"All messages between MCP clients and servers MUST follow JSON-RPC 2.0, with request IDs required to be non-null and unique among outstanding requests."},{"based_on":["t57_o2","t57_o11"],"falsifier":"A later revision of this section stating these MAY items as unconditional MUST requirements without change.","kind":"hypothesis","local_id":"t57_h2","text":"The MAY-level optionality of non-core components and of the error data member leaves room for later revisions to tighten these into MUST requirements."}],"scope":{"docs":["d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb"],"ranges":[["d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb",0,4563]],"topic":null}},"engine_root":"83d3fbbf02e3c7c05f11cecec5d5eb121bf139f618538b9b6247f2b554221732","outcome":{"kind":"records","result":{"accepted":["7503c08a11b49ca60ee654837ac9bebadc9765fd268f92721bb2b51022ac071f","fbf503dc3be20664e2e8c0c4a0d9775b10c36e57c40c6ed4a7fe17cb3fe8eb54","0f388714a67e1278a45913abd2997a2a295250ee164d60af02316f3598b13260","7938b39390faf9fe30613bfa68989055007063d836a78784ccdf0aa3c282e01f","71bf83532d9b62358282c0272bf9115d088d93682a44db54f83b16d8ba144fb1","08a5f78f70c8a6018420bf4fc285124d4e686729e9c7c9cd68503ab17d783d85"],"error":null,"failed_index":null}},"request_hash":"9523a2bcd1b81a8d3b31d01799e72ebaa9f341d60ff0967d957d0d3bf4a7a9b4","submission_id":"T57-2572f1565e895a92#2"},"hash":"181025ad7f2135f767147ade0facbe92e4fcf505d31c08eb2c2468f18e54151e","header":{"body_has