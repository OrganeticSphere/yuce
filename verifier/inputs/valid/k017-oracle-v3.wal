{"body":{"actor":"w4","audit_root":"cbdc045c3d5a62e25c60fb40e65237f7a4d2c26cf1bbd6e7a5ac82086d5a8538","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T49-255bda62c7d7a90c","kind":"submit","lines":[{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"No specific shutdown messages are defined—instead, the underlying transport\nmechanism should be used to signal connection termination:","kind":"observe","local_id":"t49_o1","terms":["shutdown messages","transport termination"]},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"The server **MAY** initiate shutdown by closing its output stream to the client and\nexiting.","kind":"observe","local_id":"t49_o3","terms":["stdio server shutdown","optionality"]},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"For HTTP [transports](/specification/2025-06-18/basic/transports), shutdown is indicated by closing the\nassociated HTTP connection(s).","kind":"observe","local_id":"t49_o4","terms":["HTTP transport shutdown","connection closure"]},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"Implementations **SHOULD** establish timeouts for all sent requests, to prevent hung\nconnections and resource exhaustion.","kind":"observe","local_id":"t49_o5","terms":["request timeouts","recommendation"]},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"SDKs and other middleware **SHOULD** allow these timeouts to be configured on a\nper-request basis.","kind":"observe","local_id":"t49_o7","terms":["timeout configuration","SDK recommendation"]},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"Implementations **MAY** choose to reset the timeout clock when receiving a [progress\nnotification](/specification/2025-06-18/basic/utilities/progress)","kind":"observe","local_id":"t49_o8","terms":["progress notification","timeout reset"]},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"However, implementations **SHOULD** always\nenforce a maximum timeout, regardless of progress notifications, to limit the impact of a\nmisbehaving client or server.","kind":"observe","local_id":"t49_o9","terms":["maximum timeout","safety limit"]},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"Implementations **SHOULD** be prepared to handle these error cases:","kind":"observe","local_id":"t49_o10","terms":["error handling","recommendation"]},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"- Protocol version mismatch\n- Failure to negotiate required capabilities\n- Request [timeouts](#timeouts)","kind":"observe","local_id":"t49_o11","terms":["error cases","protocol mismatch"]},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"    \"code\": -32602,\n    \"message\": \"Unsupported protocol version\",","kind":"observe","local_id":"t49_o12","terms":["initialization error","protocol version error code"]},{"as_of":null,"based_on":["t49_o1"],"kind":"claim","local_id":"t49_c1","object":"none (deferred to underlying transport mechanism)","predicate":"are defined as","stance":"open","subject":"shutdown messages","text":"No specific shutdown messages are defined in the protocol; implementations rely on underlying transport mechanisms to signal connection termination, leaving protocol-level shutdown messaging open."},{"as_of":null,"based_on":["t49_o3"],"kind":"claim","local_id":"t49_c3","object":"closing output stream to client and exiting","predicate":"MAY be initiated by","stance":"qualified","subject":"stdio server shutdown","text":"Server initiation of shutdown for the stdio transport is optional (MAY) rather than required."},{"as_of":null,"based_on":["t49_o4"],"kind":"claim","local_id":"t49_c4","object":"closing associated HTTP connection(s)","predicate":"is indicated by","stance":"reported","subject":"HTTP transport shutdown","text":"For HTTP transports, shutdown is indicated by closing the associated HTTP connection(s)."},{"as_of":null,"based_on":["t49_o5"],"kind":"claim","local_id":"t49_c5","object":"all sent requests to prevent hung connections and resource exhaustion","predicate":"SHOULD be established for","stance":"qualified","subject":"request timeouts","text":"Establishing timeouts for all sent requests is qualified as a recommendation (SHOULD) rather than an unconditional requirement."},{"as_of":null,"based_on":["t49_o7"],"kind":"claim","local_id":"t49_c7","object":"SDKs and other middleware","predicate":"SHOULD be allowed by","stance":"qualified","subject":"per-request timeout configuration","text":"Allowing per-request timeout configuration in SDKs and middleware is qualified as a recommendation (SHOULD)."},{"as_of":null,"based_on":["t49_o8"],"kind":"claim","local_id":"t49_c8","object":"implementations when receiving a corresponding progress notification","predicate":"MAY be chosen by","stance":"qualified","subject":"timeout clock reset on progress notification","text":"Resetting the timeout clock upon receiving a progress notification is optional (MAY) for implementations."},{"as_of":null,"based_on":["t49_o9"],"kind":"claim","local_id":"t49_c9","object":"implementations regardless of progress notifications","predicate":"SHOULD always be enforced by","stance":"qualified","subject":"maximum timeout enforcement","text":"Enforcing a maximum timeout regardless of progress notifications is qualified as a recommendation (SHOULD) rather than a strict mandate."},{"as_of":null,"based_on":["t49_o10","t49_o11"],"kind":"claim","local_id":"t49_c10","object":"implementations for protocol mismatch, capability negotiation failure, and timeouts","predicate":"SHOULD be prepared for by","stance":"qualified","subject":"error case handling","text":"Preparing to handle error cases such as protocol version mismatch, capability negotiation failure, and timeouts is qualified as a recommendation (SHOULD)."},{"as_of":null,"based_on":["t49_o12"],"kind":"claim","local_id":"t49_c11","object":"JSON-RPC error code -32602 with message Unsupported protocol version","predicate":"is exemplified by","stance":"reported","subject":"unsupported protocol version error","text":"Protocol version mismatch during initialization is exemplified using JSON-RPC error code -32602 with message 'Unsupported protocol version'."},{"about":["request timeouts","maximum timeout enforcement"],"kind":"question","local_id":"t49_q1","needed":"Check later revisions of the basic lifecycle and utilities specification.","text":"Were the SHOULD recommendations for request timeouts and maximum timeout enforcement tightened to MUST requirements in later revisions?"},{"about":["shutdown messages","stdio transport shutdown"],"kind":"question","local_id":"t49_q2","needed":"Check later revisions of the transports and basic lifecycle specification.","text":"Were explicit protocol-level shutdown messages introduced in later revisions to replace transport-level connection closure?"}],"scope":{"docs":["d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d"],"ranges":[["d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d",5981,8196]],"topic":null}},"engine_root":"e30624c253ee6fe8933c8e04d9095a875a7edcd282b335aee3824c68ecd864ad","outcome":{"kind":"records","result":{"accepted":["000d7874bf562ec42a355982c107661a1849d83a146bc26e9581c4583292da96","ae120dba87948de129b3e92a8393c82f15f84cd728efd08582434a08d9d766b9","bd3df7a179f9099b5df19525f263ad7e1b4622dcc299061fffe0ba80a8fc22cf","3df5bbf4a856a22183f65f6c5e11ed203eeb1f01b10af778473bbf5adf5c18dd","38fd7bf244b2e1f592eac8c1a20ab62428b00ecaa2e6159bdd20fff9e7a4cbde","2c2e347c4126dbb17ad7135fa71ecf31e64f46116f161f46090297483f15e6b0","0ad1245457650dde9eaf0cad1fab30af0be827bcb2adb397409b06d9d331ba76","44fefc79129746837991602f2224f80d12fb649dae938f16835d66895a408227","dd37ff6f8ce776372a847741fa2eb5f8d4edf8808a444b5b18134d8228e907ca","e9755be750c95af50b65f033d07b3bb44d1d32c50f825de4268d314ad131807b","536342f82bb0d3dc3eadcf1f9c0be7bbc7f5545700cdae2a7c7f8fd21b567c93","217e7fd8e31e2189bd192de97de769bdbc77ff28c4673c16a40c8f1a99cc7393","1e2daae10ac6e3ccc4b0dcc78abadc5d7d6a496a47619ef0cdf83b52329318a7","b47ebdca4d32120a4b8769c37b53870f1205e9018bbd6de5965ee4895e15c8ad","73e994e8dbd1bf53abd74e5ed3971fba5c564bc92ffa0ea51473437f43f32595","c5dc68a40722dd67a9583580cde8a83b4df1e49c30e833292bcb9bf23f40f3a6","932c8d619d40a4e74f5c2319b112e15e3158cdb0c7ed7e7b8c5e3801bca24cfb","a47fd19bd79a42c0da0ce13574b531eff36f1ce95b92f2939dba1e1b1cfdefd0","6c94dc3ded7008ba53363c8b11ce12514ebc38d9634ae4f226e6656b15cdb207","6727ad8f35fd2b21bbf607d9b062ea9ad8173f02af9b7b05e50cf10e95659ff2","5a1734de3253ab3c38e086af95ba734db63fc55ff51cc74dff50bd582dfd6ea8"],"error":null,"failed_index":null}},"request_hash":"762fc09c3f5516fd8c04b3e3bedd1235f50ed07fbe63ca9578d4ec5dbeb357e3","submission_id":"T49-255bda62c7d7a90c#1"},"hash":"6ed81df1a4d595dea245b2e88df81bf8ee828cfa8f899e8eadcb648f50be58a6","header":{"body_hash":"dc19429871857cfbf556f4a4a98e