ndation"]},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"\"code\": -32602,","kind":"observe","local_id":"t132_o5","terms":["JSON-RPC error code","unsupported protocol version","initialization error"]},{"as_of":null,"based_on":["t132_o1","t132_o2","t132_o3"],"kind":"claim","local_id":"t132_c1","object":"an example initialization error under Error Handling, transport unspecified","predicate":"is presented as","stance":"reported","subject":"-32602 unsupported protocol version initialization error","text":"The -32602 'Unsupported protocol version' example appears under Error Handling as an initialization error, alongside a SHOULD to handle protocol version mismatch; no transport is named for it."},{"as_of":null,"based_on":["t132_o4","t132_o5"],"kind":"claim","local_id":"t132_c2","object":"the 2025-06-18 Error Handling section, transport unspecified","predicate":"recurs in","stance":"reported","subject":"-32602 unsupported protocol version initialization error","text":"The same -32602 example and SHOULD-handle error cases text recurs in the 2025-06-18 document, again without naming a transport for the error."},{"about":["MCP-Protocol-Version header","HTTP 400","stdio transport","-32602 initialization error"],"kind":"question","local_id":"t132_q1","needed":"Quote the transports section's MCP-Protocol-Version header rule and any transport scoping; the sections supplied here cover only shutdown, timeouts, and error handling.","text":"Do the transports sections of either document state the HTTP 400 rule for an invalid or unsupported MCP-Protocol-Version header, and do they scope it to HTTP only (leaving stdio to the -32602 initialization error)?"}],"scope":{"docs":["d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804","d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d"],"ranges":[["d_0d6aa094546300c922e9f888e59a2a42387e1ab9eb3a5eba2887add9eaae4804",5980,7942],["d_487ca4ef224fdb205202f2d1e490f283e