uggested_exact_quote":"MCP clients and authorization servers **MAY** support the\nOAuth 2.0 Dynamic Client Registration Protocol [RFC7591](https://datatracker.ietf.org/doc/html/rfc7591)\nto allow MCP clients to obtain OAuth client IDs without user interaction.","suggested_span":{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","end_byte":7333,"start_byte":7098},"trailing_word":"the"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":6,"local_id":"t77_o4"},{"error":{"code":"NO_EVIDENCE","expected_by_kernel":{"missing_identifiers":["2.0"]},"field":"based_on","message":"a claim names only identifiers its quotes hold: add a quote of this section that holds each one listed, or leave it out of the claim","obligation":null,"status":"error"},"index":7,"local_id":"t77_c4"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"clients **SHOULD** surface a meaningful error to the user or\ndeveloper.","rule":"ends_mid_clause","suggested_exact_quote":"clients **SHOULD** surface a meaningful error to the user or\ndeveloper.","suggested_span":{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","end_byte":8619,"start_byte":8548},"trailing_word":"or"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":12,"local_id":"t77_o7"},{"error":{"code":"QUOTE_NOT_FOUND_IN_BYTES","expected_by_kernel":{"rule":"byte_quote"},"field":"exact_quote","message":"quote has no byte-exact occurrence","obligation":null,"status":"error"},"index":14,"local_id":"t77_o8"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"If the authorization server indicated by\nprotected resource metadata no longer matches the one the\ncredentials were registered with, clients **SHOULD** surface an\nerror rather than silently attempting to use mismatched credentials.","negation_before":"If the authorization server indicated by protected resource metadata no longer matches the one the credentials were registered with,","rule":"negation_before","suggested_exact_quote":"If the authorization server indicated by\nprotected resource metadata no longer matches the one the\ncredentials were registered with, clients **SHOULD** surface an\nerror rather than silently attempting to use mismatched credentials.","suggested_span":{"doc_id":"d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f","end_byte":9768,"start_byte":9537}},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":20,"local_id":"t77_o11"}],"task_id":"T77-5f49dfe0d00ab7fd","work_key":"doc:d_a3e76c69a4453be7f16c1fc818f137349c003b5919cd1699f2b9d6599718b89f#1"},"from":0,"key":"task-repair:T77-5f49dfe0d00ab7fd:1","to":0},"kind":"batch","operations":[]},"engine_root":"cc7493ece10de198b96269ca1da398a476ed67a4a394f53c2eb9c0ce2adb4c5d","outcome":{"kind":"value","result":{"accepted_operations":0,"checkpointed":true,"error":null,"failed_index":null,"results":[]}},"request_hash":"a5673ea2135b6ad1ace99e7f868f268b399d06cfdbe270abe3a84a2c99c56ea4","submission_id":"T77-5f49dfe0d00ab7fd#repair1"},"hash":"b2d186a387b7da855bde8dbc45faf2960a1b5a7eb0a587a5218c617aa886341e","header":{"body_hash":"dbaf5cf9f60b6551508bb6952c16456d377e9b0d709e25d637f834e3eee904e0","format":"sbgk-session-log/3","previous":"88fe15151ef6e579ce03a8e8e234458800128b13152d24e0dec2d83548206b63","records_root":"fe7c90ca2214e168f5ffe6cc