{"body":{"actor":"w1","audit_root":"e2caa106f5fe058abf4afacd7158f2c762733004900ef4b2829b16f6e9bb61f2","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T14-0eef7a61d9816fb1","kind":"submit","lines":[{"doc_id":"d_2d5d1c30808cf2e9d696698905b14bfd08aaeeed481e5171fe99bdb662c1848f","exact_quote":"This document lists changes made to the Model Context Protocol (MCP) specification since","kind":"observe","local_id":"t14_o1","terms":["key changes","changelog","previous revision"]},{"doc_id":"d_2d5d1c30808cf2e9d696698905b14bfd08aaeeed481e5171fe99bdb662c1848f","exact_quote":"Add experimental support for [tasks](/specification/2025-11-25/basic/utilities/tasks) to enable tracking durable requests with polling and deferred result retrieval","kind":"observe","local_id":"t14_o2","terms":["tasks","experimental","durable requests"]},{"doc_id":"d_2d5d1c30808cf2e9d696698905b14bfd08aaeeed481e5171fe99bdb662c1848f","exact_quote":"Add support for OAuth Client ID Metadata Documents as a recommended client registration mechanism","kind":"observe","local_id":"t14_o3","terms":["OAuth client registration","recommended","Client ID Metadata Documents"]},{"doc_id":"d_2d5d1c30808cf2e9d696698905b14bfd08aaeeed481e5171fe99bdb662c1848f","exact_quote":"making `WWW-Authenticate` header optional with fallback to `.well-known` endpoint","kind":"observe","local_id":"t14_o4","terms":["WWW-Authenticate","optional","OAuth protected resource metadata"]},{"doc_id":"d_2d5d1c30808cf2e9d696698905b14bfd08aaeeed481e5171fe99bdb662c1848f","exact_quote":"Clarify that servers must respond with HTTP 403 Forbidden for invalid Origin headers in Streamable HTTP transport.","kind":"observe","local_id":"t14_o5","terms":["Origin header","HTTP 403 Forbidden","Streamable HTTP"]},{"doc_id":"d_2d5d1c30808cf2e9d696698905b14bfd08aaeeed481e5171fe99bdb662c1848f","exact_quote":"Support polling SSE streams by allowing servers to disconnect at will","kind":"observe","local_id":"t14_o6","terms":["SSE polling","server disconnect","resumability"]},{"doc_id":"d_2d5d1c30808cf2e9d696698905b14bfd08aaeeed481e5171fe99bdb662c1848f","exact_quote":"GET streams support polling, resumption always via GET regardless of stream origin, event IDs should encode stream identity","kind":"observe","local_id":"t14_o7","terms":["GET streams","resumption","event IDs"]},{"doc_id":"d_2d5d1c30808cf2e9d696698905b14bfd08aaeeed481e5171fe99bdb662c1848f","exact_quote":"Establish JSON Schema 2020-12 as the default dialect for MCP schema definitions","kind":"observe","local_id":"t14_o8","terms":["JSON Schema 2020-12","default dialect"]},{"doc_id":"d_2d5d1c30808cf2e9d696698905b14bfd08aaeeed481e5171fe99bdb662c1848f","exact_quote":"Decouple request payloads from RPC method definitions into standalone parameter schemas.","kind":"observe","local_id":"t14_o9","terms":["schema change","request payloads","RPC method definitions"]},{"doc_id":"d_2d5d1c30808cf2e9d696698905b14bfd08aaeeed481e5171fe99bdb662c1848f","exact_quote":"Enhance authorization flows with incremental scope consent via `WWW-Authenticate`","kind":"observe","local_id":"t14_o10","terms":["incremental scope consent","authorization","WWW-Authenticate"]},{"doc_id":"d_2d5d1c30808cf2e9d696698905b14bfd08aaeeed481e5171fe99bdb662c1848f","exact_quote":"Enhance authorization server discovery with support for [OpenID Connect Discovery 1.0]","kind":"observe","local_id":"t14_o11","terms":["authorization server discovery","OpenID Connect Discovery"]},{"as_of":null,"based_on":["t14_o2"],"kind":"claim","local_id":"t14_c1","object":"experimental","predicate":"is introduced as","stance":"open","subject":"tasks support","text":"Tasks support is introduced as experimental, so its durability/polling behavior is provisional and may change in later revisions."},{"as_of":null,"based_on":["t14_o3"],"kind":"claim","local_id":"t14_c2","object":"a recommended client registration mechanism","predicate":"are added as","stance":"qualified","subject":"OAuth Client ID Metadata Documents","text":"OAuth Client ID Metadata Documents are added only as a recommended client registration mechanism, not a mandated one."},{"as_of":null,"based_on":["t14_o4"],"kind":"claim","local_id":"t14_c3","object":"optional with fallback to .well-known endpoint","predicate":"is made","stance":"qualified","subject":"WWW-Authenticate header","text":"The WWW-Authenticate header is made optional for OAuth Protected Resource Metadata discovery, with fallback to the .well-known endpoint."},{"as_of":null,"based_on":["t14_o5"],"kind":"claim","local_id":"t14_c4","object":"HTTP 403 Forbidden","predicate":"must receive","stance":"reported","subject":"invalid Origin headers in Streamable HTTP transport","text":"Servers must respond with HTTP 403 Forbidden for invalid Origin headers in Streamable HTTP transport."},{"as_of":null,"based_on":["t14_o6","t14_o7"],"kind":"claim","local_id":"t14_c5","object":"server-initiated disconnection and GET-based resumption","predicate":"is supported by","stance":"reported","subject":"SSE stream polling and resumption","text":"Servers may disconnect SSE streams at will to support polling, and resumption is always via GET regardless of stream origin."},{"as_of":null,"based_on":["t14_o7"],"kind":"claim","local_id":"t14_c6","object":"stream identity","predicate":"should encode","stance":"qualified","subject":"event IDs","text":"Event IDs should encode stream identity, a SHOULD-level guidance that later revisions could tighten."},{"as_of":null,"based_on":["t14_o8"],"kind":"claim","local_id":"t14_c7","object":"default dialect for MCP schema definitions","predicate":"is established as","stance":"reported","subject":"JSON Schema 2020-12","text":"JSON Schema 2020-12 is established as the default dialect for MCP schema definitions."},{"as_of":null,"based_on":["t14_o9"],"kind":"claim","local_id":"t14_c8","object":"RPC method definitions into standalone parameter schemas","predicate":"are decoupled from","stance":"reported","subject":"request payloads","text":"Request payloads are decoupled from RPC method definitions into standalone parameter schemas, a schema-level change."},{"as_of":null,"based_on":["t14_o10","t14_o11"],"kind":"claim","local_id":"t14_c9","object":"incremental scope consent and OpenID Connect Discovery 1.0","predicate":"are enhanced with","stance":"reported","subject":"authorization flows and server discovery","text":"Authorization flows gain incremental scope consent via WWW-Authenticate, and authorization server discovery gains OpenID Connect Discovery 1.0 support."},{"based_on":["t14_o2","t14_o3"],"falsifier":"A later revision stating tasks support as stable/normative or client registration as a MUST without change.","kind":"hypothesis","local_id":"t14_h1","text":"The experimental tasks feature and the recommended (not mandated) OAuth Client ID Metadata Documents registration are the section's main open items likely to be tightened or qualified in later revisions."},{"about":["tasks experimental status","OAuth client registration recommendation"],"kind":"question","local_id":"t14_q1","needed":"Check the GitHub compare 2025-06-18...2025-11-25 and any subsequent revision's Key Changes for tasks and client registration status.","text":"Does the full changelog or later revision promote experimental tasks support to stable, or tighten the recommended client registration mechanism to a requirement?"},{"about":["WWW-Authenticate optionality","OAuth protected resource metadata discovery"],"kind":"question","local_id":"t14_q2","needed":"Check the OAuth protected resource metadata section of later revisions for MUST/SHOULD wording on WWW-Authenticate.","text":"Does the optional WWW-Authenticate header with .well-known fallback remain optional in later revisions, or become mandatory?"}],"scope":{"docs":["d_2d5d1c30808cf2e9d696698905b14bfd08aaeeed481e5171fe99bdb662c1848f"],"ranges":[["d_2d5d1c30808cf2e9d696698905b14bfd08aaeeed481e5171fe99bdb662c1848f",0,5262]],"topic":null}},"engine_root":"1312732590dc80c86c165ab4535698402b9046d7a8b98c2f34d8f69e8d8e1e08","outcome":{"kind":"records","result":{"accepted":["95bd23eccfa025cfb65f01cfb5f12d7b93068ac5d24e3ed99b881468764a9826","525a61bb5af801a42103dbd2292e5fc034e8684603b38a352b1f76dc5ad42989","80c08d273f7371329f4cf214143864a966e7be7bb7cc522be7e7d51d63c24e3d","78e126022bef49f470e0bf984121a61dc970fb91e675928ea33b9a9fc169afcb","c7b4107837b964abef171f0a7e11b85604178aab3d6e37363bd2e59307eaebe7","16c15849854aba6767853c1865e0e5a72f23a747b0fb6c04e22eaa783fc56a10","b414b8202260b750988b01019623e0f853725f3a78403bfb0355d01002786ab2","ef35dc265604cfd39005ba7b5420368f97e11f55caa7d07c41f401ec999b3ba9","bc5866bb4ba73cff818174abe08ffccfe0523f3d7722300e272a00ec2a6c4213","41b8491f64dee2d2ffca89d87cc0e65bc703712cb8ae6213dfbe78f5942d144a","dbd5287d1727a4c2ccd7bcba5a2500c645fd262c9c326a3cd33df1c6fcdd82e0","a619218baef4caa6bb789f6001681df315fd4b7421bd553501f606acb8e014cf","63024774377091aaed22d9b9f5af8c37c1ee85546bc23d34c5fe6f58cee344c4","8c464cda8f20065e5b48cd4fb0511afe8b426279992b50e431048dbc62cb05a0","af0faccc5daeb8f8ff71d005318d39f2bcc842b79a6eb91e691fa94cbe877160","d9e7bc76b8282fff60a682312987c44bc6ff680bd62e5bf7bf0dbd319c77dd5d","f89ede050a917c55b95ddc99dbe7d866355c98df26ee207bba890c724919ec60","b2d8236e669ddfbf13fa59f686d263044b8e8376bdcf87d9662337481fbaa20b","a567369f3a8f74df35dd0032822cf02a63771f8979eb220d551b52dfdec7e75d","68ceb288fbf119de5468d1392a3e40c616ed89cd06ea3998a2b5d806a2d