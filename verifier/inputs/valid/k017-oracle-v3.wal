{"body":{"actor":"w4","audit_root":"e39ac6174e529bf82286eafe0f8a7088c08258f89c7edfffc26492abad674ee6","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T31-8c7d0b6aefba1256","kind":"submit","lines":[{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"Clients using other transports (e.g., stdio) **MAY** ignore `x-mcp-header`\nannotations entirely.","kind":"observe","local_id":"t31_o1","terms":["stdio transport","x-mcp-header","transport qualification"]},{"as_of":null,"based_on":["t31_o1"],"kind":"claim","local_id":"t31_c1","object":"clients using non-Streamable-HTTP transports","predicate":"MAY be ignored by","stance":"qualified","subject":"x-mcp-header annotations","text":"Support for x-mcp-header annotations is transport-qualified: clients using other transports like stdio MAY ignore them entirely."},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"Clients **SHOULD** log a warning when rejecting a tool definition, including\nthe tool name and the reason for rejection.","kind":"observe","local_id":"t31_o3","terms":["warning logging","tool rejection","client requirement"]},{"as_of":null,"based_on":["t31_o3"],"kind":"claim","local_id":"t31_c3","object":"SHOULD recommendation","predicate":"is qualified as","stance":"qualified","subject":"logging a warning on tool rejection","text":"Logging a warning when rejecting a malformed tool definition is qualified as a SHOULD recommendation rather than a mandatory requirement."},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"- **MUST** only be applied to parameters with primitive types (integer,\n  string, boolean). Parameters with type `number` are not permitted.","kind":"observe","local_id":"t31_o4","terms":["primitive types","number type exclusion","x-mcp-header"]},{"as_of":null,"based_on":["t31_o4"],"kind":"claim","local_id":"t31_c4","object":"x-mcp-header eligibility","predicate":"are excluded from","stance":"qualified","subject":"parameters with type number","text":"The primitive types eligible for x-mcp-header are qualified to integer, string, and boolean, explicitly excluding parameters with type number."},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"If no value is present at that path in the call arguments,\nthe header is omitted.","kind":"observe","local_id":"t31_o5","terms":["header extraction","omitted header","argument path"]},{"as_of":null,"based_on":["t31_o5"],"kind":"claim","local_id":"t31_c5","object":"no value is present at property path","predicate":"is omitted when","stance":"qualified","subject":"Mcp-Param header emission","text":"Header generation during extraction is qualified: if no value is present at the annotated property path in the call arguments, the header is omitted."},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"To avoid ambiguity, clients **MUST** also Base64-encode any plain-ASCII\nvalue that matches the sentinel pattern (i.e., starts with `=?base64?`\nand ends with `?=`).","kind":"observe","local_id":"t31_o6","terms":["sentinel pattern","Base64 encoding","plain-ASCII collision"]},{"as_of":null,"based_on":["t31_o6"],"kind":"claim","local_id":"t31_c6","object":"Base64","predicate":"MUST be encoded with","stance":"reported","subject":"plain-ASCII values matching sentinel pattern","text":"Plain-ASCII values that match the sentinel pattern must be Base64-encoded to prevent decoding ambiguity."},{"about":["resource URI header encoding","Streamable HTTP transport"],"kind":"question","local_id":"t31_q1","needed":"Examine sections defining resource read and subscribe operations in Streamable HTTP.","text":"How are resource URIs transported in headers when accessed via Streamable HTTP, given the parenthetical mention '(or resource URI)' in Mcp-Name encoding rules?"},{"about":["Server Validation","Mcp-Param header decoding"],"kind":"question","local_id":"t31_q2","needed":"Examine the Server Validation section referenced by the text.","text":"What exact validation and error behavior must intermediaries and servers apply when decoding or inspecting Mcp-Param headers?"}],"scope":{"docs":["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530"],"ranges":[["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530",14905,20841]],"topic":null}},"engine_root":"74ff03dae8b1ffe44073429ceec3ef51d0272061d32852618ad146d4b9b899f2","outcome":{"kind":"records","result":{"accepted":["2ed7cf1d473b311aff0d30b3da2b65292a9b0be68f26220bee96a3f35241e101","521b5c6495e7ba242b2533505113c055d771e45a315199e0332d81c7fe482f3f","c74b1ed728d3615165473cdb1d2a5ea803bc8da994147200fc43d264573def33","9112d72f4750cb9b5c43fd0620efba2e4b44fabddcce0b2cdce38b76571f9ae1","b0069112f455b0ec8e04220359bd05fcae4ec2f545c7c6003a454be18f17f7dc","23ebbcb8bec80ebeebcc1b44192ec0a4df1be9014633f293192a7bdfb55e1212","d9edc20697fdf4efb1b063a863369ee580df59c5647004e322eb7f8548586137","4cf30d2f0cd083428da404413e99242971c40aad489c6e66ac79b35c62c2a54d","8ff0b77b371a22cc539e4a404f811ec11f666c876c79342afecb68f7a2eaad3b","002c720d809168362770b9677f45f75747c