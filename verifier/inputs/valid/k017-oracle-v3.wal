{"body":{"actor":"w2","audit_root":"6ddcb4c40a184dc467ffee83b667e1a4fb0893c8a94ebadb988748a145d569d4","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T74-bfb7dd4d245baac7","kind":"submit","lines":[{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"If present, the ID **MUST** be globally unique across all streams within that\n     [session](#session-management)—or all streams with that specific client, if session\n     management is not in use.","kind":"observe","local_id":"t74_o1","terms":["event ID uniqueness scope","session"]},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"The server **MUST NOT** replay messages that would have been delivered on a\n     different stream.","kind":"observe","local_id":"t74_o3","terms":["replay restricted to originating stream"]},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"The session ID **SHOULD** be globally unique and cryptographically secure (e.g., a\n     securely generated UUID, a JWT, or a cryptographic hash).","kind":"observe","local_id":"t74_o6","terms":["session ID strength","examples given"]},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"The session ID **MUST** only contain visible ASCII characters (ranging from 0x21 to\n     0x7E).","kind":"observe","local_id":"t74_o7","terms":["session ID character set"]},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"Servers that require a session ID **SHOULD** respond to requests without an\n     `MCP-Session-Id` header (other than initialization) with HTTP 400 Bad Request.","kind":"observe","local_id":"t74_o8","terms":["missing session ID handling","HTTP 400"]},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"For backwards compatibility, if the server does _not_ receive an `MCP-Protocol-Version`\nheader, and has no other way to identify the version - for example, by relying on the\nprotocol version negotiated during initialization - the server **SHOULD** assume protocol\nversion `2025-03-26`.","kind":"observe","local_id":"t74_o12","terms":["fallback to 2025-03-26 when no header and no other version identification"]},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"When a client receives HTTP 404 in response to a request containing an\n   `MCP-Session-Id`, it **MUST** start a new session by sending a new `InitializeRequest`\n   without a session ID attached.","kind":"observe","local_id":"t74_o22","terms":["client reaction to session 404"]},{"as_of":null,"based_on":["t74_o1","t74_o2"],"kind":"claim","local_id":"t74_c1","object":"all streams within a session, or all streams with a specific client without session management","predicate":"MUST be globally unique across","stance":"reported","subject":"SSE event IDs","text":"Event IDs, if attached, MUST be globally unique across all streams in a session, or across all streams with a given client when session management is not used."},{"as_of":null,"based_on":["t74_o3"],"kind":"claim","local_id":"t74_c2","object":"a different stream","predicate":"MUST NOT replay messages delivered on","stance":"reported","subject":"Last-Event-ID replay","text":"The server must not replay on Last-Event-ID resumption messages that would have been delivered on a different stream."},{"as_of":null,"based_on":["t74_o6"],"kind":"claim","local_id":"t74_c5","object":"e.g., UUID, JWT, or cryptographic hash","predicate":"SHOULD be globally unique and cryptographically secure","stance":"qualified","subject":"session ID generation","text":"Session IDs SHOULD be globally unique and cryptographically secure, with UUID, JWT or hash given as examples, so strength is a recommendation rather than a mandated mechanism."},{"as_of":null,"based_on":["t74_o7"],"kind":"claim","local_id":"t74_c6","object":"visible ASCII characters 0x21 to 0x7E","predicate":"MUST only contain","stance":"reported","subject":"session ID character set","text":"Session IDs MUST contain only visible ASCII characters (0x21 to 0x7E)."},{"as_of":null,"based_on":["t74_o9","t74_o22","t74_o23"],"kind":"claim","local_id":"t74_c7","object":"HTTP 404 Not Found","predicate":"MAY terminate, then MUST respond with 404","stance":"qualified","subject":"server-initiated session termination","text":"Servers may terminate a session at any time; afterwards requests with that session ID must receive HTTP 404, and clients receiving 404 must start a new session without a session ID."},{"as_of":null,"based_on":["t74_o11","t74_o12"],"kind":"claim","local_id":"t74_c9","object":"protocol version 2025-03-26","predicate":"SHOULD assume","stance":"open","subject":"protocol version fallback","text":"When neither a header nor another version source exists, servers SHOULD assume protocol version 2025-03-26; this fallback is conditional and its applicability to later versions is not stated."},{"based_on":["t74_o11","t74_o12"],"falsifier":"A later revision keeps the same 2025-03-26 fallback unchanged or restates it without a version-specific condition.","kind":"hypothesis","local_id":"t74_h1","text":"The 2025-03-26 fallback for missing MCP-Protocol-Version headers is tied to the historic transition and will become stale as newer protocol versions are added."}],"scope":{"docs":["d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e"],"ranges":[["d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e",8193,13999]],"topic":null}},"engine_root":"5e7d0ffdf3decd91b59aa5014eceb86b2fdc3887fb61e4eb9f6d7f1f145b44a9","outcome":{"kind":"records","result":{"accepted":["5b5454d1b6ac814286904634ad4b5fdc70c1b029a0f74f07d7a3bdc4059c6716","26adc07589433dfd1eee26dc9f831674a3f17e307000def3378fcf51b22d12b4","e99c94daeba1a91cd533b4610e5adc3ab44a719981df36444dd95298c67dc05a","59bc0042e8c670463dcbccb1845e852bd13e14191e34e77e28db01acdbfa5cc6","eb5de1ee591056b261525091070c09913e8b3f44f8a227e0b9ee84b021b0bc01","115ce08a759e81c6fc29c2f22bee30c811c3fd7354757b660f072d16f5dbe6e6","a130101032de599f4d3afdc2d915a2b9eb4a7e216e2c4f17881a048d603d0aa1","c4a5775b849c294715264b3590b1bbc855d9f67c3ddb03ee04b54c5dc1262b30","4c76f03926a4106bf0873ee0543761f636cbf17df0ca6fcbb370c4928d9ad895","75c2682985bb8d6793229ee0f17c568a8e6d2ae273589ada584ce0c2f60fc715","e10b822b0f69fc638a1f0fc774dacde54c8aa65571a66fd94bcfcc8e6a0cebc2","2807bbd42a8e513553a0865e10c194ba48e594c6c4c7dbd9c57505f9f5437f7e","12401ef592579f9576829745e216d13572c0f8ecedc4c8f4f4329fe340d49251","cddcd0b3f6fdc6f0ed37f8526b7ff1febb52651857b30a9f2caa4aaa62f171f4"],"error":null,"failed_index":null}},"request_hash":"6c59494d955e0923e72bcdba7383bb7d1e0c1bbb25f25a77ef5d8c5f22164129","submission_id":"T74-bfb7dd4d245baac7#2"},"hash":"d268bbab6104cef4dfb4475c6e76f08e3269008044f5a57b9c72c231424a5d5a","header":{"body_hash":"4ad7ef65f7cb185fb5f2cfe3b383aa396b911554d92ddf2d27fea76920f72b01","format":"sbgk-session-log/3","previous":"99030719a340205995264465177e24190f4971e02bc48bc30e38d7359b7f265f","records_root":"7910211299b2bad814c769e75a21e8bb228717fc98c046d328cad9f591ce6eba","seq":370,"wal_op":"audit"}}
