{"body":{"actor":"w1","audit_root":"463318529c60db92a071d8bc4d34387fbfe5342f41f4448611c10a0b96edfde1","command":{"allowed_records":["055c3b232f4d91ca3898c658c421637b3ec6181635f6eec74ea53ca4449c86b5","0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","c8433f8a1df56a4154b6dd2ad7ffe98151da3db1f9ef0f33bcb40ad5bcf420ac","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"TR17-ad23bd9d0e509ad6","kind":"submit","lines":[{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Authorization is **OPTIONAL** for MCP implementations. When supported:","kind":"observe","local_id":"t17_o1","terms":["authorization optionality","conditional scope"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Implementations using an HTTP-based transport **SHOULD** conform to this specification.","kind":"observe","local_id":"t17_o2","terms":["HTTP transport conformance","SHOULD"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"OAuth 2.1 IETF DRAFT ([draft-ietf-oauth-v2-1-13](https://datatracker.ietf.org/doc/html/draft-ietf-oauth-v2-1-13))","kind":"observe","local_id":"t17_o4","terms":["OAuth 2.1 draft dependency","standards compliance"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"implements a selected subset of their features to ensure security and interoperability","kind":"observe","local_id":"t17_o5","terms":["subset of OAuth features","simplicity rationale"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Authorization servers **MUST** implement OAuth 2.1 with appropriate security","kind":"observe","local_id":"t17_o6","terms":["authorization server MUST","OAuth 2.1"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"2. Authorization servers and MCP clients **SHOULD** support OAuth Client ID Metadata Documents","kind":"observe","local_id":"t17_o7","terms":["Client ID Metadata Documents","SHOULD"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"3. Authorization servers and MCP clients **MAY** support the OAuth 2.0 Dynamic Client Registration","kind":"observe","local_id":"t17_o8","terms":["Dynamic Client Registration","MAY"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP clients **MUST** use OAuth 2.0 Protected Resource Metadata for authorization server discovery.","kind":"observe","local_id":"t17_o9","terms":["client discovery MUST","Protected Resource Metadata"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP clients **MUST** support both discovery mechanisms to obtain the information required to interact with the authorization server.","kind":"observe","local_id":"t17_o10","terms":["dual discovery support","client MUST"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"The specific use of `authorization_servers` is beyond the scope of this specification; implementers should consult","kind":"observe","local_id":"t17_o11","terms":["out of scope","authorization_servers field"]},{"as_of":null,"based_on":["t17_o2"],"kind":"claim","local_id":"t17_c1","object":"this authorization specification","predicate":"SHOULD conform to","stance":"qualified","subject":"HTTP-based transport implementations","text":"Implementations using an HTTP-based transport SHOULD conform to this authorization specification, a recommendation rather than a mandate."},{"as_of":null,"based_on":["t17_o4"],"kind":"claim","local_id":"t17_c3","object":"OAuth 2.1 IETF DRAFT draft-ietf-oauth-v2-1-13","predicate":"is based on","stance":"reported","subject":"authorization mechanism basis","text":"The authorization mechanism is based on OAuth 2.1 IETF DRAFT draft-ietf-oauth-v2-1-13, not a finalized RFC."},{"as_of":null,"based_on":["t17_o5"],"kind":"claim","local_id":"t17_c4","object":"referenced OAuth standards","predicate":"implements a selected subset of features of","stance":"reported","subject":"this specification","text":"The specification implements only a selected subset of the referenced standards' features, for security, interoperability and simplicity."},{"as_of":null,"based_on":["t17_o6"],"kind":"claim","local_id":"t17_c5","object":"OAuth 2.1 with appropriate security measures","predicate":"MUST implement","stance":"reported","subject":"authorization servers","text":"Authorization servers MUST implement OAuth 2.1 with appropriate security measures for both confidential and public clients."},{"as_of":null,"based_on":["t17_o7"],"kind":"claim","local_id":"t17_c6","object":"OAuth Client ID Metadata Documents","predicate":"SHOULD support","stance":"qualified","subject":"authorization servers and MCP clients","text":"Authorization servers and MCP clients SHOULD support OAuth Client ID Metadata Documents (draft-ietf-oauth-client-id-metadata-document-00)."},{"as_of":null,"based_on":["t17_o8"],"kind":"claim","local_id":"t17_c7","object":"OAuth 2.0 Dynamic Client Registration (RFC7591)","predicate":"MAY support","stance":"qualified","subject":"authorization servers and MCP clients","text":"Authorization servers and MCP clients MAY support OAuth 2.0 Dynamic Client Registration (RFC7591), i.e. it is optional."},{"as_of":null,"based_on":["t17_o9"],"kind":"claim","local_id":"t17_c8","object":"OAuth 2.0 Protected Resource Metadata","predicate":"MUST use for authorization server discovery","stance":"reported","subject":"MCP clients","text":"MCP clients MUST use OAuth 2.0 Protected Resource Metadata for authorization server discovery."},{"as_of":null,"based_on":["t17_o11"],"kind":"claim","local_id":"t17_c10","object":"this specification","predicate":"is beyond the scope of","stance":"open","subject":"authorization_servers field usage","text":"The specific use of the authorization_servers field is declared beyond the scope of this specification, leaving implementation detail to RFC9728."},{"based_on":["t17_o4"],"falsifier":"A statement in the document pinning draft-ietf-oauth-v2-1-13 as stable, or a later revision adopting the final OAuth 2.1 RFC without change.","kind":"hypothesis","local_id":"t17_h1","text":"The OAuth 2.1 requirements here are provisional because they build on IETF draft-ietf-oauth-v2-1-13 rather than a final RFC, and may be qualified once finalized."},{"based_on":["t17_o7","t17_o8"],"falsifier":"A later revision stating Client ID Metadata Documents support as MUST or Dynamic Client Registration as MUST without change.","kind":"hypothesis","local_id":"t17_h2","text":"Client ID Metadata Documents support (SHOULD) and Dynamic Client Registration (MAY) are the section's main optional items likely to be tightened or qualified in later revisions."},{"about":["t17_o2","t17_o7","t17_o8"],"kind":"question","local_id":"t17_q1","needed":"Check later revisions of the Authorization section for requirement-strength changes on these items.","text":"Does a later revision of this authorization section change the SHOULD/MAY items (Client ID Metadata Documents, Dynamic Client Registration, HTTP conformance) to MUST?"},{"about":["t17_o4"],"kind":"question","local_id":"t17_q2","needed":"Check IETF datatracker status of draft-ietf-oauth-v2-1-13 and any later revision of this section citing a final RFC.","text":"Has draft-ietf-oauth-v2-1-13 been superseded by a final OAuth 2.1 RFC, and does this spec pin or update to it?"}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",0,5106]],"topic":null}},"engine_root":"7dcefd34405fcdba8e52b684f879dd145d016268aa9921819e5c2aaf2b755ffe","outcome":{"kind":"records","result":{"accepted":["25a355540e9af77cead31d571fef5f98e567aa39aa04468f671e578b83b90577","2192dfa852a184f2d5d091e5b38fe5bd9fb81ae2f5c387a56e1434e5ac54e339","ae89f57e0bc2eab0d2ecf64e190aa6e5505f1e9d32f2d0f349a3f5145c2d065f","6b736b237633477b19abfbd0749fe667189a852ea13d5cb1d500227335baa46e","f710d9eb1e0cda4387490102c46b0370a111806abfc92a44a2daf5d7ffd188ef","3676c9acdc50cce1dcace08d94f8cd978e84916750c44c07dc787aaadbf11bfe","bd5b62c171b79aa984b06c182e75b5457cd7a23ae9d4f34b304505091f910f44","1de914e51f53bfe702fe64391a341aaa6525c5c182f57fb8c431bfb76429e78c","3449731439dc0248acf0dbf4a1e017e1ee70056376363ea9d56cd76c79969e92","0e1e7cf17ea3c11664c1c5889fbe85f0b0a342674f0824f5b3f6aae3ae6cc046","6c4abd0718b69826b8fd2e0c0c35dd29ed2b790821d5646be52f1b9478cf4205","f4b42d3c4a2eff7c67a32efe6afbeda05119e96a9b816b327e46f72a54d4eb63","8e5da89fc3d3aa798b31eacfa6a5ec6e5360eb0420ed09dc8f83a9c1219b9921","dba3d557a76506bdab30063a23e9133d5ae48feb5c5685b8e4228e4b4e0fe277","9161c5c985d2180150c744e92cd919cd818ce2ce193ed2e2cd7e4723c5d21dd3","49a0ac2405ce42fda41686907c7ecee1f27c341081a673a8b505c88f92d84ff3","ff9f9ca52544d608b22f4de55f93fff1b6f418596b11e377766413b6d30f1504","67185d8e33bc1e321a5e536f5a173eb9a1a78388b9d5cb8ffd0006812f9ae062","f12bdc624bb0582c501b08d4c35c7c28156c95699c49b41066e1091aa8ac1c1e","f37990b4db100e60a0da8832aa666d42d2c77914032987e141d7dd305bf0ee27","c96199f2301d8f13d588afadb53649096060c93c20bd56a7d2af054216cb9816","010872838e39e100f3d909af3123de87bbd18b956721a65675ee2dd62da8038e"],"error":null,"failed_index":null}},"request_hash":"5842a5d9a6851119e2f01524