89a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","end_byte":11015,"start_byte":10888}},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":2,"local_id":"t34_o3"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"negation_before":"If the server does not implement the requested protocol version (whether the version is unknown to the server, or is a known version the server has chosen not to support), it **MUST** respond with `400 Bad Request` and an [`UnsupportedProtocolVersionError`][unsupported-version]","rule":"negation_before"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":3,"local_id":"t34_o4"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"A server that supports clients implementing protocol versions earlier than\n`2025-06-18` (which did not define the `MCP-Protocol-Version` header) **MAY**\ntreat a request that omits the header as protocol version `2025-03-26`","negation_before":"A server that supports clients implementing protocol versions earlier than `2025-06-18` (which did not define the `MCP-Protocol-Version` header) **MAY**","rule":"negation_before","suggested_exact_quote":"A server that supports clients implementing protocol versions earlier than\n`2025-06-18` (which did not define the `MCP-Protocol-Version` header) **MAY**\ntreat a request that omits the header as protocol version `2025-03-26`","suggested_span":{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","end_byte":12064,"start_byte":11841}},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":5,"local_id":"t34_o6"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"If the `Mcp-Name` source value cannot be safely represented as a plain ASCII\nheader value, clients **MUST** encode it using the Base64 sentinel format","negation_before":"If the `Mcp-Name` source value cannot be safely represented as a plain ASCII","rule":"negation_before","suggested_exact_quote":"If the `Mcp-Name` source value cannot be safely represented as a plain ASCII\nheader value, clients **MUST** encode it using the Base64 sentinel format","suggested_span":{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","end_byte":13036,"start_byte":12886}},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":7,"local_id":"t34_o8"},{"error":{"code":"NO_EVIDENCE","expected_by_kernel":{"missing_identifiers":["UnsupportedProtocolVersionError"]},"field":"based_on","message":"a claim names only identifiers its quotes hold: add a quote of this section that holds each one listed, or leave it out of the claim","obligation":null,"status":"error"},"index":13,"local_id":"t34_c4"}],"task_id":"TR34-1196e86d0de711de","work_key":"reread:d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530#2"},"from":0,"key":"task-repair:TR34-1196e86d0de711de:1","to":0},"kind":"batch","operations":[]},"engine_root":"83854f52d67a32d58dbb45532848edc4078d23c1158a807b38ef64b52ef8a565","outcome":{"kind":"value","result":{"accepted_operations":0,"checkpointed":true,"error":null,"failed_index":null,"results":[]}},"request_hash":"c85fa2d48b4dcd404b2ecd9291c53dc38