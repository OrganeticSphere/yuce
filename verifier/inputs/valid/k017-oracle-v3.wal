{"body":{"actor":"w1","audit_root":"2d9839de0188631031ce1fb1b472a95f83c7b262a3fee0559c0725954676ba6e","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","931a61a051ec316ffbe720982ea9d05243d14af58d333910026e7d46ea12de5e","b397efe27e1ba0b3ddc96d0747b439a4fecc819c2ed2e231a98376466b66ac60","b7a5eb5e2373eea5ed723c57c6f9a195eed001f7ab1b346a0c70eb65c3692d9b","bd8ca52f7fecf3cec5bfb7fa53eeae7bcfc1b0496f6c2eef31a8f0043e0a1ab2","d686aac174d904fa6d1ad232ef834c3677c20312dd90bc4cf6dde0d2b49c457d","dbf5279a837ea8753bd40b6b10151ca3c406fc35274d7c6c62956ceae960e69c","e2ee9a90754d400ec44e3df92d921f1f2cb06dc0649cfa6d5257ae2f09a302a4","e38ed2520ced46d2f428362c62b287e94ffd1b32591fd4f777ab694d03ab4029","ee0d6b8cf2a71b56c4634c7f2157c016e6b75ef5c16f4b0d8c5ee5a46e0e0f4d","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"TR11-4290c5c2b145bf6a","kind":"submit","lines":[{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The server **MAY** send JSON-RPC _requests_ and _notifications_ on the stream.","kind":"observe","local_id":"t11_o2","terms":["server-initiated messages","SSE stream"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"These messages **SHOULD** be unrelated to any concurrently-running JSON-RPC","kind":"observe","local_id":"t11_o3","terms":["server-initiated messages","concurrent requests","SHOULD"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The server **MAY** close the SSE stream at any time.","kind":"observe","local_id":"t11_o4","terms":["stream closure","server discretion"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The client **MAY** close the SSE stream at any time.","kind":"observe","local_id":"t11_o5","terms":["stream closure","client discretion"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The client **MAY** remain connected to multiple SSE streams simultaneously.","kind":"observe","local_id":"t11_o6","terms":["multiple connections","client discretion"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The server **MUST** send each of its JSON-RPC messages on only one of the connected","kind":"observe","local_id":"t11_o7","terms":["message routing","single stream delivery"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"If the client wishes to resume after a broken connection, it **SHOULD** issue an HTTP","kind":"observe","local_id":"t11_o10","terms":["resumption","Last-Event-ID","client SHOULD"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The server **MAY** use this header to replay messages that would have been sent","kind":"observe","local_id":"t11_o11","terms":["replay","server discretion","Last-Event-ID"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"If an `Mcp-Session-Id` is returned by the server during initialization, clients using","kind":"observe","local_id":"t11_o14","terms":["session ID echo","client obligation"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The server **MAY** respond to this request with HTTP 405 Method Not Allowed,","kind":"observe","local_id":"t11_o15","terms":["session termination","HTTP 405","server discretion"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"Server->>-Client: InitializeResponse<br>Mcp-Session-Id: 1868a90c...","kind":"observe","local_id":"t11_o16","terms":["sequence diagram","session ID in InitializeResult"]},{"as_of":null,"based_on":["t11_o2","t11_o3"],"kind":"claim","local_id":"t11_c2","object":"unrelated to concurrent client requests","predicate":"MAY be sent and SHOULD be","stance":"qualified","subject":"server-initiated messages on SSE stream","text":"A server that initiates an SSE stream MAY send JSON-RPC requests and notifications on it, and these SHOULD be unrelated to any concurrently-running client request."},{"as_of":null,"based_on":["t11_o4","t11_o5"],"kind":"claim","local_id":"t11_c3","object":"server or client","predicate":"MAY be closed at any time by","stance":"reported","subject":"SSE stream","text":"Either party may close an SSE stream at any time; stream lifetime is not guaranteed by the transport."},{"as_of":null,"based_on":["t11_o6","t11_o7"],"kind":"claim","local_id":"t11_c4","object":"the connected streams","predicate":"MUST deliver each message on only one of","stance":"reported","subject":"multiple simultaneous SSE streams","text":"A client MAY hold multiple SSE streams simultaneously, but the server MUST deliver each JSON-RPC message on exactly one stream and MUST NOT broadcast it across streams."},{"as_of":null,"based_on":["t11_o10","t11_o11"],"kind":"claim","local_id":"t11_c6","object":"the disconnected stream only","predicate":"SHOULD be requested with Last-Event-ID and MAY be honored by replay on","stance":"qualified","subject":"stream resumption","text":"A client wishing to resume after a broken connection SHOULD GET the MCP endpoint with Last-Event-ID; the server MAY then replay messages after that id on the disconnected stream only."},{"as_of":null,"based_on":["t11_o15"],"kind":"claim","local_id":"t11_c9","object":"HTTP 405 Method Not Allowed","predicate":"MAY be refused with","stance":"qualified","subject":"explicit session termination","text":"A server MAY refuse a client's HTTP DELETE session-termination request with HTTP 405, so explicit termination is best-effort and cannot be relied upon."},{"about":["resumability","session management"],"kind":"question","local_id":"t11_q1","needed":"Check the resumability and session-management sections for any statement tying Last-Event-ID replay to session presence; not stated in this section.","text":"Does the spec state whether a server that never assigns a session ID must still honor Last-Event-ID resumption across reconnects, or is resumption undefined without sessions?"},{"about":["resumability","multiple connections"],"kind":"question","local_id":"t11_q2","needed":"Search the full document for retention windows, limits, or timeouts; this section states none.","text":"Is there any bound on how long a server retains event IDs for replay, or on how many streams a client may hold open?"}],"scope":{"docs":["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b"],"ranges":[["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b",5241,11113]],"topic":null}},"engine_root":"0fc498ade2ff504c1255ee39e0aa47c3242270e35d861ccdb5513dd67ef18c71","outcome":{"kind":"records","result":{"accepted":["4ab5b62d3fe77c3a015e1b734f57648faa925677947a56390856c8fafb481112","553dece070d34f10139f71dbc87e8cb94f4577bf17ce1f8f07d7d48d7a657586","a7d543612d56d8e4a894577f361e34256de5600e8644367f76b7b35136afc2e4","9d04b66872d0704e8e31153daf89cd65d278372eb82686b7df0508814a410136","94765e21ac8429d9477801771457aacc770896d0f3f43f996d9cde763df523c0","de13f66e0a60a0fd1b07b81f29f03d63df9216dbf799d47f40abac2b765ffb21","58d117a1b2b1652c357a98c69e495258cea80f6986ce95745608153c9ba568bd","d47ef7e08d73c504f538b040e5935b3e396ca27374e56d0d8a0cfaefc74dd5ef","27e4fc62b3ad8207e06f8d990c62404d96b8dea99d68ccf655e1ad0b54f2801c","0542f099aad7b91778832f3ea84007c168902413d7ea4318b206416e204b9064","841baefaff990cd333527a892cda1f5b800e1748fe2b686f2ed3f3228088568c","2dba567d661015db7e09923b600dba98c880ea16f89deb12f91b43b4e7a62fe2","21b075f7ee389b2ab406c2372c518f85f34fa62425c6d48c3b3ce1b854c2d545","303e098c28ff9145c115f1c9b8472781cc409613be773771552ee368f0fa8932","6b788fb63f91df83cb59fec6cf92ce8bf7702787a95952816f140db0f34f026c","803e14ea58fc57a99f638e369b1160f97b9a11c36d3e6adc5796915b8cf907c5","1b0a6