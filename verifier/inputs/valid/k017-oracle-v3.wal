{"body":{"actor":"w4","audit_root":"c35dbf04f298fcf11efa238344962ee05d671837a50acb3f005c82e3a56dab67","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T37-f85172c98e5f07e6","kind":"submit","lines":[{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"There is no negotiation handshake. Every request carries its protocol\nversion, and the server accepts or rejects each request independently:","kind":"observe","local_id":"t37_o1","terms":["negotiation handshake","protocol version","per-request evaluation"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"- **Modern**: protocol versions that convey version, identity, and\n  capabilities as per-request metadata (revision `2026-07-28` and later).","kind":"observe","local_id":"t37_o2","terms":["modern protocol versions","per-request metadata","revision 2026-07-28"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"- **Legacy**: protocol versions that establish a session with an\n  `initialize` handshake (`2025-11-25` and earlier).","kind":"observe","local_id":"t37_o3","terms":["legacy protocol versions","initialize handshake","revision 2025-11-25"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"The client **SHOULD** select a mutually supported version from the `supported`\nlist and retry the request, or surface an error to the user if no compatible\nversion exists.","kind":"observe","local_id":"t37_o5","terms":["client retry","UnsupportedProtocolVersionError","supported version list"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"Servers **MUST** implement\n[`server/discover`](/specification/2026-07-28/server/discover).","kind":"observe","local_id":"t37_o6","terms":["server/discover","server requirement","version discovery"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"If one party supports an extension but the other does not, the supporting\nparty **MUST** either revert to core protocol behavior or reject the request\nwith an appropriate error.","kind":"observe","local_id":"t37_o8","terms":["extension negotiation","fallback behavior","unsupported extension"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"Extensions **SHOULD** document their expected\nfallback behavior.","kind":"observe","local_id":"t37_o9","terms":["extension documentation","fallback behavior"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"expect an `initialize` handshake) and [modern](#terminology) clients (which\nuse per-request metadata) **MAY** implement both behaviors.","kind":"observe","local_id":"t37_o10","terms":["dual-era server","backward compatibility","initialize handshake"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"In both cases, a recognized modern JSON-RPC error (such as\n[`UnsupportedProtocolVersionError`](/specification/2026-07-28/schema#unsupportedprotocolversionerror))\nidentifies a modern server:","kind":"observe","local_id":"t37_o11","terms":["modern server identification","UnsupportedProtocolVersionError","transport backward compatibility"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"Clients **SHOULD** cache the result for the lifetime of the server\nprocess (stdio) or origin (HTTP), and **MAY** persist it across restarts of\nthe same server configuration","kind":"observe","local_id":"t37_o12","terms":["era determination","caching","persistence"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"A server that supports only [modern](#terminology) versions **SHOULD** name\nthe protocol versions it supports in any error it returns to an `initialize`\nrequest, on any transport:","kind":"observe","local_id":"t37_o13","terms":["modern server","initialize error diagnostic","supported versions"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"legacy clients have no fall-forward mechanism, and\nthis message may be the only diagnostic they can surface to users.","kind":"observe","local_id":"t37_o14","terms":["legacy clients","fall-forward limitation","error diagnostic"]},{"as_of":20260728,"based_on":["t37_o1","t37_o2","t37_o3"],"kind":"claim","local_id":"t37_c1","object":"per-request metadata version declaration","predicate":"is superseded by","stance":"superseded","subject":"handshake-based session initialization","text":"Handshake-based session initialization (revision 2025-11-25 and earlier) is superseded in modern revisions (2026-07-28+) by per-request metadata version declaration with no negotiation handshake."},{"as_of":20260728,"based_on":["t37_o8"],"kind":"claim","local_id":"t37_c5","object":"reject request with appropriate error","predicate":"MUST either revert to core protocol behavior or","stance":"reported","subject":"unsupported extension handling","text":"When an extension is not mutually supported, the supporting party MUST either revert to core protocol behavior or reject the request with an appropriate error."},{"as_of":20260728,"based_on":["t37_o9"],"kind":"claim","local_id":"t37_c6","object":"extensions","predicate":"SHOULD be documented by","stance":"qualified","subject":"extension fallback behavior documentation","text":"Documenting expected fallback behavior for extensions is qualified as a recommendation (SHOULD) rather than an unconditional mandate."},{"as_of":20260728,"based_on":["t37_o10"],"kind":"claim","local_id":"t37_c7","object":"legacy initialize and modern metadata behaviors","predicate":"MAY implement","stance":"qualified","subject":"dual-era server support","text":"Server dual-era support for both legacy initialize clients and modern per-request metadata clients is optional (MAY)."},{"as_of":20260728,"based_on":["t37_o11"],"kind":"claim","local_id":"t37_c8","object":"recognized modern JSON-RPC error","predicate":"is identified by","stance":"reported","subject":"modern server detection","text":"Identification of modern servers across transports relies on recognized modern JSON-RPC errors such as UnsupportedProtocolVersionError rather than fallback."},{"as_of":20260728,"based_on":["t37_o12"],"kind":"claim","local_id":"t37_c9","object":"MAY be persisted across restarts","predicate":"SHOULD be cached for process or origin lifetime and","stance":"qualified","subject":"server era determination caching","text":"Caching server era determination is recommended (SHOULD) for the process or origin lifetime and optional (MAY) across restarts."},{"as_of":20260728,"based_on":["t37_o13","t37_o14"],"kind":"claim","local_id":"t37_c10","object":"supported protocol versions in error","predicate":"SHOULD name","stance":"qualified","subject":"modern-only server response to initialize","text":"Modern-only servers are recommended (SHOULD) to name supported versions in initialize errors because legacy clients have no fall-forward mechanism."},{"as_of":20260728,"based_on":["t37_o14"],"kind":"claim","local_id":"t37_c11","object":"rely solely on error diagnostics from modern servers","predicate":"lack fall-forward mechanism and","stance":"open","subject":"legacy clients","text":"Legacy clients have no fall-forward mechanism when interacting with modern-only servers, leaving error diagnostics as their only surfaceable information."}],"scope":{"docs":["d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa"],"ranges":[["d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa",0,5784]],"topic":null}},"engine_root":"59eca0d903f0157424218b94bfa7e1589229b24396001511d7cf96a367c59436","outcome":{"kind":"records","result":{"accepted":["a12fbe12b88f1ba09108123c58b4b00e2a3925f90d1cb43b77ffcd2703ff6666","034bab40f0677c0fa36fbcf2a7b94f99896d07ec88afd4a1eba1991775ae5467","61ce66f4280ee856baed49937d74c9146d6a4f92b693f2ff550b324d783fb0df","7e9bd3009e34b4969b6fed9d603c9d335b1ab61a924741dec9918e9845cab848","e9aa3d13604c1a126ac68d636aca439529b734a63e68a3f849202829c92e8f5f","540482ec83e58a4a443d634b22d8595fd9e30589d07c89cfd2409ed48270bd62","542fb44522bd9a7e2938808c23cab1f6d556a9f5d98d105350056b4625b84e95","3b0960a0704886353907f92608a9e9c42efe81c5a5095e64e3e6a6865397d9b8","174d0fe543a372815b9465cd18f8ee45015c240ac59d601018c0d4252130d5fc","264803670099ba42201bdb2ee54f007699870ea90154b3e91a309d58dff407d1","ec5529dd4e4b3176639f5ded32c9c79cc56ffae9b0e395e09219d63a3acee275","cde6e928940e5217c7c781a5b6e4ecb06473a017b23b14798fb83da0eefce397","ccf451a1a72712c710aa44c24e6e9741cc9109a40047597f260655beba054ac6","6f370a8dde59d5dd81f3f2191c0f6370d1829b7bbe45ceff56d50dd10a80b97b","7fe3a32401898faae4d7b79af868bdd93a1203e4ec9a4cfa4daf71586981a7f3","1c6afc53c4cff316cab7e22909b83807108c89a90f68fad7a51b041a085f2793","60cd22f62222e5b1c4099149c6483806bf7750ac6993f75bbf2208c687f4e1f6","0f5d80bd1100a666393a2c6e72ebe3f9b6b1ae0839bfb365544b1cede75ccd8e","64438ff0d63ab1a966728b35d3478981220a7584d251a9a7e96e51d1d2c040f0","b8b0e5e1943136f426a38d8e25b97ba853f11c65ed5835db9c0b90db2826d29f"],"error":null,"failed_index":null}},"request_hash":"c511f91bb5dd8af31885d19dc65e3a7b69c248140850220dce5260cf7e8102e6","submission_id":"T37-f85172c98e5f07e6#1"},"hash":"4ec7635d98118ee9be2186669e3668f17b204d6f74cf83528e8b70f1ca621005","header":{"body_hash":"5b9f5f8e8d3398fe0ccbc6811e0f901bae2e53b34c0f4bc452e1c39e97050888","format":"sbgk-session-log/3","previous":"e3e1c6ed53d7516c28d54e5ef5c68b05778dba585099956546fb553950a72697","records_root":"050856c40207034347230d73e22b8ec9cb1495e678a8120b8336ed703e9d3557","seq":193,"wal_op":"audit"}}
{"body":{"actor":"kernel","audit_root":"756928791d1a30d06476d8ff21045b75adac0c2a314fb0bfea2b6afd81cebbaf","command":{"checkpoint":{"context":{"accepted":["@a12fbe12b88f1ba0","@034bab40f0677c0f","@61ce66f4280ee856","@7e9bd3009e34b496","@e9aa3d13604c1a12","@540482ec83e58a4a","@542fb44522bd9a7e","@3b0960a070488635","@174d0fe543a37281","@264803670099ba42","@ec5529dd4e4b3176","@cde6e928940e5217","@ccf451a1a72712c7","@6f370a8dde59d5dd","@7fe3a32401898faa","@1c6afc53c4cff316","@60cd22f62222e5b1","@0f5d80bd1100a666","@64438ff0d63ab1a9","@b8b0e5e1943136f4"],"attempt":1,"excluded":[{"index":15,"local_id":"t37_c2","rests_on":"t37_o4"},{"index":17,"local_id":"t37_c4","rests_on":"t37_o7"}],"kind":"EXTEND","refused":[{"error":{"code":"BAD_FIELD","expected_by_kernel":{"negation_before":"If the server does not implement the requested version (whether the version is unknown to the server, or is a known version the server has chosen not to support),","rule":"negation_before"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":3,"local_id":"t37_o4"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"Clients\n**MAY** call it before sending any other requests to learn the server's\nsupported versions up front, but are not required to: a client is free to\ninvoke any RPC inline and handle `UnsupportedProtocolVersionError` if its\npreferred version is not supported.","rule":"ends_mid_clause","suggested_exact_quote":"Clients\n**MAY** call it before sending any other requests to learn the server's\nsupported versions up front, but are not required to: a client is free to\ninvoke any RPC inline and handle `UnsupportedProtocolVersionError` if its\npreferred version is not supported.","suggested_span":{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","end_byte":2696,"start_byte":2433},"trailing_word":"to:"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":6,"local_id":"t37_o7"},{"error":{"code":"NO_EVIDENCE","expected_by_kernel":{"missing_identifiers":["UnsupportedProtocolVersionError"]},"field":"based_on","message":"a claim names only identifiers its quotes hold: add a quote of this section that holds each one listed, or leave it out of the claim","obligation":null,"status":"error"},"index":16,"local_id":"t37_c3"}],"task_id":"T37-f85172c98e5f07e6","work_key":"doc:d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa#0"},"from":0,"key":"task-repair:T37-f85172c98e5f07e6:1","to":0},"kind":"batch","operations":[]},"engine_root":"59eca0d903f0157424218b94bfa7e1589229b24396001511d7cf96a367c59436","outcome":{"kind":"value","result":{"accepted_operations":0,"checkpointed":true,"error":null,"failed_index":null,"results":[]}},"request_hash":"08f5d67d0eafa31b9ecc4f75f8929c94b7af51a5c915ef655e5dcec69efec107","submission_id":"T37-f85172c98e5f07e6#repair1"},"hash":"55f789dfe0d302eee751de517b3d56461d97e954f3ca78b47301565eaa79e8d6","header":{"body_hash":"a6c2258e6fe432a058378bd64dc7791f663de918f0f1fc9db6f64d59465d1945","format":"sbgk-session-log/3","previous":"4ec7635d98118ee9be2186669e3668f17b204d6f74cf83528e8b70f1ca621005","records_root":"fe7c90ca2214e168f5ffe6cccb15729c3b8a03c403e48c406441cd589fdd8c41","seq":194,"wal_op":"audit"}}
{"body":{"actor":"w4","audit_root":"d348e2f97df5e723ea2884c0cf47a2abf395fd54da07eb7833df08f64c1ff0bf","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T37-f85172c98e5f07e6","kind":"submit","lines":[{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"If the server does not implement the requested version (whether the version\nis unknown to the server, or is a known version the server has chosen not to\nsupport), it **MUST** respond with an\n[`UnsupportedProtocolVersionError`](/specification/2026-07-28/schema#unsupportedprotocolversionerror)\nlisting the versions it does support:","kind":"observe","local_id":"t37_o4","terms":["UnsupportedProtocolVersionError","server requirement","unsupported version"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"Clients\n**MAY** call it before sending any other requests to learn the server's\nsupported versions up front, but are not required to: a client is free to\ninvoke any RPC inline and handle `UnsupportedProtocolVersionError` if its\npreferred version is not supported.","kind":"observe","local_id":"t37_o7","terms":["client discovery","server/discover","optional discovery"]},{"as_of":20260728,"based_on":["t37_o4"],"kind":"claim","local_id":"t37_c2","object":"UnsupportedProtocolVersionError listing supported versions","predicate":"MUST be","stance":"reported","subject":"server response to unsupported protocol version","text":"When a server does not implement a requested protocol version, it MUST respond with UnsupportedProtocolVersionError listing supported versions."},{"as_of":20260728,"based_on":["t37_o4","t37_o5"],"kind":"claim","local_id":"t37_c3","object":"surface an error to user","predicate":"SHOULD select mutually supported version or","stance":"qualified","subject":"client retry on unsupported protocol version","text":"On receiving UnsupportedProtocolVersionError, client selection of a mutually supported version to retry is qualified as a recommendation (SHOULD) or surfacing an error to the user."},{"as_of":20260728,"based_on":["t37_o6","t37_o7"],"kind":"claim","local_id":"t37_c4","object":"MAY for clients","predicate":"is MUST for servers and","stance":"qualified","subject":"server/discover implementation and invocation","text":"Servers MUST implement server/discover, but client invocation of it before sending other requests is optional (MAY)."}],"scope":{"docs":["d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa"],"ranges":[["d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa",0,5784]],"topic":null}},"engine_root":"f60d4ccd939fba97706e990a47a93a678b11784d9f0b1b20df739e5bb216a354","outcome":{"kind":"records","result":{"accepted":["3e058ce1def0f3aba6f53b45363ccff1f51e8424277904c122ced213aca033a7","e188c4b2eeb2040e754c9df7123786a59af93305d09c038dc8b14cb55d86a98a","1ffbebee8397c859ed667e7c6b48e9a6028eae431ddb3d2e8223458fa0241e54","27f3826937206c12b43e30738012e61204a27564acea1827fad8aa3cdb8d6586","c8c4de28def444ba0af89d4743d7284d4c85913c5ab2d4e40fdc80e3089065cf"],"error":null,"failed_index":null}},"request_hash":"5ce62e88f95d58450211c313ddab731eb451793ddd224b49520d3d795009b5d1",