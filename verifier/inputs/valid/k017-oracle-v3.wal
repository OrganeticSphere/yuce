{"body":{"actor":"w1","audit_root":"1e9e604c42665f1c6384cdef4dc2a7794babb72816440be2c2f08e961a682b2a","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T63-b1f58f9d3d4cab46","kind":"submit","lines":[{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"A request missing any required field is malformed; the server **MUST** reject it with\nJSON-RPC error code `-32602` (Invalid params).","kind":"observe","local_id":"t63_o7","terms":["malformed request","rejection","-32602"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"If\nprocessing a request requires a capability the client did not include in\n`io.modelcontextprotocol/clientCapabilities`, the server **MUST** return a\n[`MissingRequiredClientCapabilityError`](/specification/2026-07-28/schema#missingrequiredclientcapabilityerror)","kind":"observe","local_id":"t63_o10","terms":["MissingRequiredClientCapabilityError","undeclared capability","MUST return"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Servers **SHOULD** include the following `io.modelcontextprotocol/*` field in\nevery result's `_meta`, unless specifically configured not to do so, to\nidentify themselves without relying on any prior connection state:","kind":"observe","local_id":"t63_o11","terms":["serverInfo","SHOULD","per-response fields"]},{"as_of":null,"based_on":["t63_o7"],"kind":"claim","local_id":"t63_c6","object":"JSON-RPC error -32602","predicate":"MUST be rejected with","stance":"reported","subject":"request missing a required field","text":"A request missing any required field is malformed and the server MUST reject it with JSON-RPC -32602 (Invalid params)."},{"as_of":null,"based_on":["t63_o9","t63_o10"],"kind":"claim","local_id":"t63_c8","object":"by servers","predicate":"MUST NOT be relied on; MissingRequiredClientCapabilityError MUST be returned","stance":"reported","subject":"undeclared client capabilities","text":"A server MUST NOT rely on undeclared client capabilities and MUST return MissingRequiredClientCapabilityError listing them."},{"as_of":null,"based_on":["t63_o11"],"kind":"claim","local_id":"t63_c9","object":"servers","predicate":"SHOULD be included by","stance":"qualified","subject":"serverInfo in every result's _meta","text":"Servers SHOULD include io.modelcontextprotocol/serverInfo in every result's _meta unless specifically configured not to."},{"based_on":["t63_o8","t63_o11"],"falsifier":"A later revision stating clientInfo or serverInfo inclusion as unconditional MUST without change.","kind":"hypothesis","local_id":"t63_h1","text":"The SHOULD-level clientInfo and serverInfo inclusion rules are optionality that later revisions could tighten to MUST."}],"scope":{"docs":["d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb"],"ranges":[["d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb",14242,20112]],"topic":null}},"engine_root":"f74ce6db61478dcfd8516e5f8d2d5b38f9cb4633cf10a999fbca973987d43225","outcome":{"kind":"records","result":{"accepted":["137b16226748ff73de7c20d239a605444915eb05f6be0edd0f570c068c9d615a","bca2381ccc858ed1a0e7a3aca0dfce