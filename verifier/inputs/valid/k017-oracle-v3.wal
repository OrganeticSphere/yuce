{"body":{"actor":"w3","audit_root":"073ac25fe6152c3948207fdfde07738e9b1fded154a0dadf3d0a18b376512b4e","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T36-22af1d31aec7f7ba","kind":"submit","lines":[{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"None of these mechanisms are part of this\nrevision.","kind":"observe","local_id":"t36_o1","terms":["current Streamable HTTP revision","removed legacy mechanisms"]},{"as_of":null,"based_on":["t36_o1"],"kind":"claim","local_id":"t36_c1","object":"this revision","predicate":"are excluded from","stance":"superseded","subject":"earlier Streamable HTTP mechanisms","text":"This revision excludes session assignment via Mcp-Session-Id, standalone GET SSE streams, server JSON-RPC requests on SSE streams, and Last-Event-ID resumability."},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"An `Mcp-Session-Id` header on a request: ignore it, and do not mint or echo","kind":"observe","local_id":"t36_o3","terms":["session identifiers","current server behavior"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"streams are not resumable.","kind":"observe","local_id":"t36_o4","terms":["stream resumability","current transport limitation"]},{"as_of":null,"based_on":["t36_o4"],"kind":"claim","local_id":"t36_c3","object":"not resumable","predicate":"are","stance":"superseded","subject":"streams","text":"Streams in this revision are not resumable; servers should ignore Last-Event-ID from older clients."},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"New implementations **SHOULD NOT** adopt it; existing implementations\n  **SHOULD** migrate to [Streamable","kind":"observe","local_id":"t36_o5","terms":["HTTP+SSE lifecycle","migration guidance"]},{"as_of":null,"based_on":["t36_o5"],"kind":"claim","local_id":"t36_c4","object":"Streamable HTTP","predicate":"should be avoided by new implementations and migrated by existing ones","stance":"qualified","subject":"HTTP+SSE transport","text":"HTTP+SSE is qualified as deprecated: new implementations should not adopt it, while existing implementations should migrate to Streamable HTTP."},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"It is\n  eligible for removal in a future revision; see the [deprecated features\n  registry]","kind":"observe","local_id":"t36_o6","terms":["HTTP+SSE future status","possible removal"]},{"as_of":null,"based_on":["t36_o6"],"kind":"claim","local_id":"t36_c5","object":"removal in a future revision","predicate":"is eligible for","stance":"open","subject":"HTTP+SSE transport","text":"HTTP+SSE remains eligible for removal in a future revision, leaving its eventual removal open."},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"Continue to host both the SSE and POST endpoints of the old transport,\n  alongside the new \"MCP endpoint\"","kind":"observe","local_id":"t36_o7","terms":["server backward compatibility","legacy endpoint coexistence"]},{"as_of":null,"based_on":["t36_o7"],"kind":"claim","local_id":"t36_c6","object":"legacy SSE and POST endpoints alongside the new MCP endpoint","predicate":"SHOULD host","stance":"qualified","subject":"servers supporting older clients","text":"Servers supporting older HTTP+SSE clients should continue hosting the old SSE and POST endpoints alongside the new MCP endpoint."},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"If the body is empty or is not a recognized modern JSON-RPC error, fall","kind":"observe","local_id":"t36_o8","terms":["client fallback","legacy initialization handshake"]},{"as_of":null,"based_on":["t36_o8"],"kind":"claim","local_id":"t36_c7","object":"the 400 body is empty or not a recognized modern JSON-RPC error","predicate":"SHOULD fall back when","stance":"qualified","subject":"clients detecting legacy servers","text":"A client should fall back to initialize-based legacy communication only when a 400 response body is empty or lacks a recognized modern JSON-RPC error."},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"Servers and clients that need to interoperate with counterparts speaking","kind":"observe","local_id":"t36_o9","terms":["cross-version interoperability","corresponding revision behavior"]},{"as_of":null,"based_on":["t36_o9"],"kind":"claim","local_id":"t36_c8","object":"corresponding revision behavior and version-negotiation fallback","predicate":"need to implement","stance":"open","subject":"servers and clients interoperating across revisions","text":"Cross-version interoperability remains dependent on implementing the behavior specified by the corresponding earlier protocol revision in addition to version-negotiation fallback."}],"scope":{"docs":["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530"],"ranges":[["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530",26565,31155]],"topic":null}},"engine_root":"8e66db6361c0cf2e98d735d9dd0cd46866a19afe2efae7b743645ea