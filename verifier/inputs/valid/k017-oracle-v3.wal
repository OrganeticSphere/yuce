{"body":{"actor":"w1","audit_root":"407f7c119e3d5beeed76e4e787dda43a181253e0a91cc7e84aabb6466b1804eb","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T38-68fdc72bba666325","kind":"submit","lines":[{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"| Modern   | Legacy   | Fails. The server may reject the request with an implementation-defined error, stay silent, or even process an era-ambiguous method under legacy semantics.","kind":"observe","local_id":"t38_o1","terms":["compatibility matrix","modern client","legacy server","failure modes"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"On stdio, clients **SHOULD** send `server/discover` first to fail deterministically; the client then surfaces an actionable error to the user.","kind":"observe","local_id":"t38_o2","terms":["stdio","server/discover","SHOULD","deterministic failure"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"| Legacy   | Modern   | Fails. stdio: the server rejects `initialize` with a JSON-RPC error; the exact code is implementation-defined","kind":"observe","local_id":"t38_o3","terms":["legacy client","modern server","initialize rejection","implementation-defined error code"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"Legacy clients have no fall-forward mechanism.","kind":"observe","local_id":"t38_o4","terms":["legacy clients","no fall-forward"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"A dual-era server **MAY** serve both eras concurrently on the same endpoint","kind":"observe","local_id":"t38_o5","terms":["dual-era server","MAY","concurrent eras"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"A request carrying modern per-request `_meta` is served statelessly","kind":"observe","local_id":"t38_o6","terms":["per-request _meta","stateless serving"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"An `initialize` request selects legacy semantics, scoped to the stdio","kind":"observe","local_id":"t38_o7","terms":["initialize","legacy semantics","scope"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"| Legacy   | Legacy   | Works according to the legacy revision; out of scope for this document.","kind":"observe","local_id":"t38_o8","terms":["legacy-legacy","out of scope"]},{"as_of":null,"based_on":["t38_o1"],"kind":"claim","local_id":"t38_c1","object":"reject, silence, or legacy-semantics processing","predicate":"fails with implementation-defined or ambiguous behavior","stance":"open","subject":"modern client with legacy server","text":"Modern-client/legacy-server interop fails, but the failure mode is not pinned down: the server may reject with an implementation-defined error, stay silent, or process an era-ambiguous method under legacy semantics."},{"as_of":null,"based_on":["t38_o2"],"kind":"claim","local_id":"t38_c2","object":"server/discover","predicate":"SHOULD send first","stance":"qualified","subject":"stdio clients facing legacy servers","text":"On stdio, clients SHOULD send server/discover first to fail deterministically against a legacy server; this is a recommendation, not a mandate."},{"as_of":null,"based_on":["t38_o3"],"kind":"claim","local_id":"t38_c3","object":"initialize rejection","predicate":"fails with implementation-defined JSON-RPC error code","stance":"reported","subject":"legacy client with modern server","text":"A legacy client against a modern server fails; on stdio the server rejects initialize with a JSON-RPC error whose exact code is implementation-defined."},{"as_of":null,"based_on":["t38_o4"],"kind":"claim","local_id":"t38_c4","object":"fall-forward mechanism","predicate":"have no","stance":"reported","subject":"legacy clients","text":"Legacy clients have no fall-forward mechanism, so legacy-client/modern-server failure is unrecoverable from the client side."},{"as_of":null,"based_on":["t38_o5"],"kind":"claim","local_id":"t38_c5","object":"both eras on same endpoint or process","predicate":"MAY serve concurrently","stance":"qualified","subject":"dual-era server","text":"A dual-era server MAY serve both eras concurrently on the same endpoint or process; concurrent dual-era serving is optional."},{"as_of":null,"based_on":["t38_o6"],"kind":"claim","local_id":"t38_c6","object":"dual-era server","predicate":"is served statelessly by","stance":"reported","subject":"request with modern per-request _meta","text":"A dual-era server serves a request carrying modern per-request _meta statelessly according to this revision."},{"as_of":null,"based_on":["t38_o7"],"kind":"claim","local_id":"t38_c7","object":"legacy semantics scoped to stdio process or HTTP session","predicate":"selects","stance":"reported","subject":"initialize request","text":"An initialize request selects legacy semantics scoped to the stdio process or the HTTP session, per the negotiated legacy protocol version."},{"as_of":null,"based_on":["t38_o8"],"kind":"claim","local_id":"t38_c8","object":"this document","predicate":"is out of scope for","stance":"reported","subject":"legacy client with legacy server","text":"Legacy-client/legacy-server operation works per the legacy revision and is declared out of scope for this document."},{"based_on":["t38_o1","t38_o2"],"falsifier":"A later revision mandating a specific error or behavior for modern clients against legacy servers, or making the server/discover probe a MUST.","kind":"hypothesis","local_id":"t38_h1","text":"The compatibility matrix leaves the modern-client/legacy-server failure mode open (implementation-defined error, silence, or legacy-semantics processing), so deterministic interop there depends on the SHOULD-level server/discover probe rather than a normative guarantee."},{"based_on":["t38_o3","t38_o4"],"falsifier":"A later revision specifying a concrete JSON-RPC error code or adding a fall-forward mechanism for legacy clients.","kind":"hypothesis","local_id":"t38_h2","text":"Because legacy clients have no fall-forward mechanism and the legacy-client/modern-server error code is implementation-defined, legacy-client interop remains an open limitation of this revision."},{"about":["dual-era server","MAY","per-request _meta"],"kind":"question","local_id":"t38_q1","needed":"Check later revisions of the compatibility/transports section for MUST-level dual-era or stateless-serving language.","text":"Is concurrent dual-era serving (MAY) tightened to a MUST, or is the stateless per-request _meta path made mandatory, in later revisions?"},{"about":["implementation-defined error","initialize rejection","compatibility matrix"],"kind":"question","local_id":"t38_q2","needed":"Check later revisions and error-code registries for concrete codes replacing implementation-defined ones.","text":"Does any later revision pin the implementation-defined error codes for legacy-client/modern-server initialize rejection or the modern-client/legacy-server failure mode?"}],"scope":{"docs":["d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa"],"ranges":[["d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa",5784,11293]],"topic":null}},"engine_root":"08f455f297c03f50983235746dd5e53e8db82340ed6cb7b4805b40d5dbcf9efe","outcome":{"kind":"records","result":{"accepted":["bf26aedbdfbfa1e21de9a7d652d0df9d013d131046d6764849f408ca02673193","dd4eb1169a6aaeecabfdb23f7c11544ccd8dabeec326b529077a412761d39709","c23a9d0031839611a98be47b0e740e20dc8a2fc628f03ffd25ecb0f994650883","1939def8bad0394010a2fea8be6eee88abd5d7536fd553279b33ad2613334e5c","3f03535ad76eb33ca677bfe1d52af9e7dfc0bb04bfb6d5affd3e454a9da00b8c","3b02af5ac64abbdf8e66fee28e6dd0d607ac9dc8cf4640862502442cfcdb81a9","fba9d7758fc58f63e909006f891b698350294e80d63a61109bf11aa3e0a0bee9","c4780f031bb425a92fef3ec4636679ae216fafd18ea0193242809746ad85ea9f","1cf380e48cd508e1dc7cb923ba4cf2daefc949c84811916d38973f75a17bf781","b3c81aa72277bddeb8b908b79bc9d0154eff179f40112d41ae087bced9b0a275","2b190d76a3de585caf8d7386795ef6c465978796118b04f52b71d8927fcafe87","af8126ca096a412124ab48a2753b389f7a7c6492c4c6cfc9f310a33be58e0e42","784656b9e61e4be99bf4cd166ec85ea5a2dd5282d05b21f4b04899c8d3c5f9bf","4321e201ee6dbb4b6319517f8fac3143adb17fd9da5f7f1817bd9aa70858b592","9fc8e933132423e0e43dc9ddab7fadfd93a9d9cf1da42e07d3e7285a185698bf","b3f777fa49a99120a44ecdf5482b343c5434b66d40cc41f5a63572635b42296f"],"error":{"code":"BAD_FIELD","expected_by_kernel":{"maxLength":240,"minLength":1,"type":"string","x-maxUtf8Bytes":1024},"field":"text","message":"'text' is empty or exceeds its character/UTF-8 byte bound","obligation":null,"status":"error"},"failed_index":16}},"request_hash":"0e3e8b5ba102c9088085e4a1364081d1786b691c1a9afb4bf0f38d79fc468895","submission_id":"T38-68fdc72bba666325#1"},"hash":"17093473f6dd51c95849cf130bcd2d9378127d4551ff65dcb7286f4121da93d9","header":{"body_hash":"74393cbedcea41e84774d414fa5371679e2aa66ed178502befc5bf5b3f6d591f","format":"sbgk-session-log/3","previous":"f63303e308643eedbc634e6d9d0f6b8f3e636f5d1d07f