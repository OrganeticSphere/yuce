{"body":{"actor":"w2","audit_root":"6f41a90810d52e487bda8b5440e24cef8345fd6ab57185ab1b880557ee818565","command":{"allowed_records":["055c3b232f4d91ca3898c658c421637b3ec6181635f6eec74ea53ca4449c86b5","0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","c8433f8a1df56a4154b6dd2ad7ffe98151da3db1f9ef0f33bcb40ad5bcf420ac","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T20-95d8f5fbd544cfbb","kind":"submit","lines":[{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"**If `scope` is not available**, use all scopes defined in `scopes_supported` from the Protected Resource Metadata document, omitting the `scope` parameter if `scopes_supported` is undefined.","kind":"observe","local_id":"t20_o7","terms":["fallback scope selection when scope is unavailable, and omission of scope when scopes_supported is undefined"]},{"as_of":null,"based_on":["t20_o6","t20_o7"],"kind":"claim","local_id":"t20_c4","object":"WWW-Authenticate scope, then scopes_supported","predicate":"follows priority order","stance":"reported","subject":"initial scope selection","text":"Initial scope selection uses the WWW-Authenticate scope parameter first, then all scopes_supported from Protected Resource Metadata, omitting scope if that is undefined."}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b9