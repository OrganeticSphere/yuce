":"error"},"index":4,"local_id":"t7_o5"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"The server **MUST** either return `Content-Type: text/event-stream` in response to\n   this HTTP GET, or else return HTTP 405 Method Not Allowed, indicating that the server\n   does not offer an SSE stream at this endpoint.","rule":"ends_mid_clause","suggested_exact_quote":"The server **MUST** either return `Content-Type: text/event-stream` in response to\n   this HTTP GET, or else return HTTP 405 Method Not Allowed, indicating that the server\n   does not offer an SSE stream at this endpoint.","suggested_span":{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","end_byte":5830,"start_byte":5609},"trailing_word":"to"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":9,"local_id":"t7_o10"}],"task_id":"T7-9768547ba0a139e0","work_key":"doc:d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b#1"},"from":0,"key":"task-repair:T7-9768547ba0a139e0:1","to":0},"kind":"batch","operations":[]},"engine_root":"f27e4b5bba590bf168c3ceb28623b23ededbd4c7f3c8b324c947ec42f7c20da6","outcome":{"kind":"value","result":{"accepted_operations":0,"checkpointed":true,"error":null,"failed_index":null,"results":[]}},"request_hash":"72175d142ced4c3cde1b90e3211ab4130c6dde6d5d94e75b74795afa954ff0fc","submission_id":"T7-9768547ba0a139e0#repair1"},"hash":"bd5b973c63d67933ae13d20b6647ed7e4af4b40a22f84f1bd699da3d294ff064","header":{"body_hash":"06e3776ad28004b7fdeef9eb655aee861fd4e9eaafdb47d8f4a0a7f784bd4439","format":"sbgk-session-log/3","previous":"3d86183869966a0696f35a752687f6c0f9a8beb5a4c75b2f38c2e02edd3a61e4","records_root":"fe7c90ca2214e168f5ffe6cccb15729c3b8a03c403e48c406441cd589fdd8c41","seq":33,"wal_op":"audit"}}
{"body":{"actor":"w1","audit_root":"eb243ffc6a45aed3656fad23dc1043e48de4ace88875aba81ec795ea85814941","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T7-9768547ba0a139e0","kind":"submit","lines":[{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The server **MUST NOT** replay messages that would have been delivered on a\n     different stream.","kind":"observe","local_id":"t7_o2","terms":["redelivery","per-stream replay restriction"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"these event IDs should be assigned by servers on a _per-stream_ basis, to\nact as a cursor within that particular stream.","kind":"observe","local_id":"t7_o3","terms":["event IDs","per-stream cursor"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The session ID **SHOULD** be globally unique and cryptographically secure (e.g., a\n     securely generated UUID, a JWT, or a cryptographic hash).","kind":"observe","local_id":"t7_o4","terms":["session ID","security guidance"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"Servers that require a session ID **SHOULD** respond to requests without an\n     `Mcp-Session-Id` header (other than initialization) with HTTP 400 Bad Request.","kind":"observe","local_id":"t7_o5","terms":["session ID required","HTTP 400 Bad Request"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The server **MUST** either return `Content-Type: text/event-stream` in response to\n   this HTTP GET, or else return HTTP 405 Method Not Allowed, indicating that the server\n   does not offer an SSE stream at this endpoint.","kind":"observe","local_id":"t7_o10","terms":["SSE endpoint","HTTP 405 alternative"]},{"as_of":null,"based_on":["t7_o2","t7_o3"],"kind":"claim","local_id":"t7_c2","object":"streams other than the disconnected one","predicate":"MUST NOT cross","stance":"reported","subject":"message replay on resume","text":"Servers MUST NOT replay messages that would have been delivered on a different stream; event IDs act as per-stream cursors."},{"as_of":null,"based_on":["t7_o4"],"kind":"claim","local_id":"t7_c3","object":"globally unique and cryptographically secure","predicate":"SHOULD be","stance":"reported","subject":"session ID","text":"Session IDs SHOULD be globally unique and cryptographically secure, and MUST contain only visible ASCII characters."},{"as_of":null,"based_on":["t7_o5"],"kind":"claim","local_id":"t7_c4","object":"HTTP 400 Bad Request","predicate":"SHOULD receive","stance":"reported","subject":"requests without session ID","text":"Servers requiring a session ID SHOULD answer requests lacking Mcp-Session-Id (other than initialization) with HTTP 400 Bad Request."},{"as_of":null,"based_on":["t7_o10"],"kind":"claim","local_id":"t7_c9","object":"text/event-stream or HTTP 405","predicate":"MUST be either","stance":"reported","subject":"SSE GET response","text":"A server MUST either answer the SSE GET with Content-Type: text/event-stream or return HTTP 405 Method Not Allowed."},{"based_on":["t7_o4","t7_o8","t7_o9"],"falsifier":"A later revision of this section stating these MAY/SHOULD items as unconditional MUST requirements without change.","kind":"hypothesis","local_id":"t7_h1","text":"The section's session and resumability rules are normative but leave optionality (MAY/SHOULD) that later revisions could tighten or qualify."}],"scope":{"docs":["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b"],"ranges":[["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b",5241,11113]],"topic":null}},"engine_root":"9f91e8fb0fd74acbbeec3e1d2b63972ed1844dd5b586653fcd522b361cb14b8a","o