{"body":{"actor":"w1","audit_root":"249a455ded59d4030d05c1f91e2106dd8840c735cacf25876410d8fbf8c65995","command":{"allowed_records":["055c3b232f4d91ca3898c658c421637b3ec6181635f6eec74ea53ca4449c86b5","0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","c8433f8a1df56a4154b6dd2ad7ffe98151da3db1f9ef0f33bcb40ad5bcf420ac","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"TR24-3094d58082e7de24","kind":"submit","lines":[{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP supports three client registration mechanisms. Choose based on your scenario:","kind":"observe","local_id":"t24_o1","terms":["client registration mechanisms","three options"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Clients supporting all options **SHOULD** follow the following priority order:","kind":"observe","local_id":"t24_o2","terms":["client registration priority order","SHOULD"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"**SHOULD** fetch metadata documents when encountering URL-formatted client_ids","kind":"observe","local_id":"t24_o6","terms":["authorization server","fetch metadata documents","SHOULD"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"**SHOULD** cache metadata respecting HTTP cache headers","kind":"observe","local_id":"t24_o7","terms":["metadata caching","SHOULD"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Note over C: Abort or use pre-configured values","kind":"observe","local_id":"t24_o8","terms":["discovery fallback","abort or pre-configured values"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Note over C: Fallback to well-known URI probing","kind":"observe","local_id":"t24_o9","terms":["well-known URI probing","fallback discovery"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"M-->>C: HTTP 401 Unauthorized (may include WWW-Authenticate header)","kind":"observe","local_id":"t24_o10","terms":["401 Unauthorized","WWW-Authenticate header","may include"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"- **Dynamic Client Registration**: For backwards compatibility or specific requirements","kind":"observe","local_id":"t24_o12","terms":["Dynamic Client Registration","backwards compatibility"]},{"as_of":null,"based_on":["t24_o2"],"kind":"claim","local_id":"t24_c3","object":"clients supporting all options","predicate":"SHOULD be followed by","stance":"qualified","subject":"client registration priority order","text":"Clients supporting all registration options SHOULD follow a four-step priority order: pre-registration, Client ID Metadata Documents, Dynamic Client Registration, then user prompt."},{"as_of":null,"based_on":["t24_o6","t24_o7"],"kind":"claim","local_id":"t24_c5","object":"authorization servers","predicate":"SHOULD be done by","stance":"qualified","subject":"authorization server metadata fetching and caching","text":"Authorization servers SHOULD fetch metadata documents for URL-formatted client_ids and SHOULD cache metadata respecting HTTP cache headers; both are recommendations."},{"as_of":null,"based_on":["t24_o8","t24_o9"],"kind":"claim","local_id":"t24_c6","object":"abort or use pre-configured values","predicate":"is left open as","stance":"open","subject":"discovery failure fallback","text":"If neither sub-path nor root well-known metadata is found, the client aborts or uses pre-configured values; the spec leaves this fallback behavior open."},{"as_of":null,"based_on":["t24_o10","t24_o9"],"kind":"claim","local_id":"t24_c7","object":"resource_metadata pointer","predicate":"may include","stance":"qualified","subject":"WWW-Authenticate header on 401","text":"The 401 response may include a WWW-Authenticate header, so the resource_metadata pointer is optional and clients must fall back to well-known probing."},{"as_of":null,"based_on":["t24_o12"],"kind":"claim","local_id":"t24_c8","object":"backwards compatibility or specific requirements","predicate":"is intended for","stance":"reported","subject":"Dynamic Client Registration","text":"Dynamic Client Registration is positioned for backwards compatibility or specific requirements rather than as the primary mechanism."},{"based_on":["t24_o2","t24_o6","t24_o7"],"falsifier":"A later revision stating these SHOULD items as unconditional MUST requirements without change.","kind":"hypothesis","local_id":"t24_h2","text":"The registration priority order and metadata fetching/caching rules are SHOULD-level and could be tightened to MUST in later revisions."},{"about":["Client ID Metadata Documents","draft status"],"kind":"question","local_id":"t24_q1","needed":"Check later revisions of the authorization section for changed normative keywords and draft/RFC references.","text":"Does a later revision of this section promote Client ID Metadata Documents support from SHOULD to MUST or replace the -00 draft reference with a final RFC?"},{"about":["discovery failure fallback"],"kind":"question","local_id":"t24_q2","needed":"Search the full report for normative text on discovery failure handling.","text":"Is the abort-or-pre-configured-values fallback on discovery failure specified anywhere else, or does it remain implementation-defined?"}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",9360,14801]],"topic":null}},"engine_root":"7ad60d64fb6adbe991ac174e0108ab14e2d607259f8ce94033d875709f6c4520","outcome":{"kind":"records","result":{"accepted":["6697564a4389a736f26f7463024e2fc23064aee43b98e8865667aac8adc07870","071d2c9ccf3712d7fde8fd1169f71d4925e4679d395219009dd316427451b1e2","9a3770ef9acdfac94e34451836292ea60cb1d54901bba8bdbdbc7251f8ad9619","ccaee644d6b94d59e2f081927a97e79f01ae59bfa1823f2a849d257d18390f32","994452779cb08a1b13c85ba28a337579705c08fe2c8a6763f85a208facc635a1","e2307a07a1a94053222d79a5961353cd70068da6ea80fe1acae8b39df81dfe17","1ee3bc1d67a03aab74ebb922b3a914384f87e1cdc9eb3c7c7d35014cd62dea7f","95ba5c629be68082ef58526ac2dee4afe21d806c9d07c3a4e37d16426f068776","8ad6b29362f8966b23fc9512ce7b71164d3bec76c9be9604d93255f83a262952","b11c1307b235c9fbb21419ab1b9ddc5e8425235e0d62e02a2bed47485615581f","b7b17f23e3b75a7aa261bb70f6f2849fbf0ed961b87421855dfdfdad5d277a69","1432003a39a7c11e115fdb7660df8fc0835c114f4e5dc640aecb8a80b9bc1514","88158c6e1556685001845d73a5b5b8558acba910209d81d218940ba544e8d7ed","a191ceaddc48464c48f190a31ebb8e1a38ce523b3228437f9e464251609b654d","a264973b16f951665583905ee072e4b35cb675188e9c5c4615386147f1d0d717","a8da0f598d36c9e6d3cf0ec1ece99608a3adcc946bb4959ee3372fa5b2161ce6"],"error":null,"failed_index":null}},"request_hash":"7c897da5e97d5691454f1c9321368d641540e8b13a6995da766c6761f663cfd3","submission_id":"TR24-3094d58082e7de24#1"},"hash":"eaceb22ea6fccf7abf732ff3e382e4ffa76f8686b455e05437104500c3536775","header":{"body_hash":"171874a2f4dca2d84a295a2c97f2a58ad1dcdb7286e3d605ba30ee782d50d0af","format":"sbgk-session-log/3","previous":"cb7aaaabfa850d46aa4778a5e2be3ee58ad315c09b4ccb08899f7d0912c13593","records_root":"0ffd855dcc2595c10e1958b55268c5c0f003ad990276f7d6ffabe2ccf20312cd","seq":96,"wal_op":"audit"}}
