{"body":{"actor":"w1","audit_root":"0cd82c82509ffa25385be6b194aeb59d377a488fed9b0cb2cb451f05f1d84f03","command":{"allowed_records":["055c3b232f4d91ca3898c658c421637b3ec6181635f6eec74ea53ca4449c86b5","0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","c8433f8a1df56a4154b6dd2ad7ffe98151da3db1f9ef0f33bcb40ad5bcf420ac","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T25-5c650edee851f1b3","kind":"submit","lines":[{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP servers **MUST** validate that access tokens were issued specifically for them as the intended audience,","kind":"observe","local_id":"t25_o2","terms":["audience validation","RFC 8707","MUST"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Invalid or expired tokens **MUST** receive a HTTP 401","kind":"observe","local_id":"t25_o3","terms":["invalid tokens","expired tokens","HTTP 401"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP clients **MUST NOT** send tokens to the MCP server other than ones issued by the MCP server's authorization server.","kind":"observe","local_id":"t25_o4","terms":["token provenance","client obligation","MUST NOT"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP servers **MUST NOT** accept or transit any other tokens.","kind":"observe","local_id":"t25_o5","terms":["token passthrough","MUST NOT"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"| 403         | Forbidden    | Invalid scopes or insufficient permissions |","kind":"observe","local_id":"t25_o6","terms":["error handling","HTTP 403","scope errors"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"**SHOULD** include the scopes needed to satisfy the current request in the `scope`","kind":"observe","local_id":"t25_o8","terms":["scope parameter","server scope management","SHOULD"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"The choice depends on the server's assessment of user experience impact and authorization friction.","kind":"observe","local_id":"t25_o9","terms":["scope inclusion strategy","server discretion"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Servers **SHOULD** be consistent in their scope inclusion strategy to provide predictable behavior for clients.","kind":"observe","local_id":"t25_o10","terms":["consistency","scope inclusion strategy","SHOULD"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Clients **SHOULD** respond to these errors by requesting a new access token with an increased set of scopes via a step-up authorization flow or handle the errors in other, appropriate ways.","kind":"observe","local_id":"t25_o11","terms":["step-up authorization","client behavior","SHOULD"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"**MAY** attempt the step-up authorization flow or abort the request immediately.","kind":"observe","local_id":"t25_o12","terms":["client_credentials","step-up authorization","MAY"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Clients **SHOULD** implement retry limits and **SHOULD** track scope upgrade attempts to avoid","kind":"observe","local_id":"t25_o13","terms":["retry limits","scope upgrade tracking","SHOULD"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"[OAuth 2.1 Section 5.2](https://datatracker.ietf.org/doc/html/draft-ietf-oauth-v2-1-13#section-5.2)","kind":"observe","local_id":"t25_o15","terms":["OAuth 2.1 draft","draft-ietf-oauth-v2-1-13","normative reference"]},{"as_of":null,"based_on":["t25_o3","t25_o6"],"kind":"claim","local_id":"t25_c2","object":"HTTP 401 response","predicate":"MUST receive","stance":"reported","subject":"invalid or expired tokens","text":"Invalid or expired tokens MUST receive an HTTP 401 response, and servers MUST return appropriate HTTP status codes for authorization errors."},{"as_of":null,"based_on":["t25_o4","t25_o5"],"kind":"claim","local_id":"t25_c3","object":"tokens not issued by the server's authorization server","predicate":"MUST NOT send, accept or transit","stance":"reported","subject":"token provenance and passthrough","text":"MCP clients MUST NOT send tokens other than those issued by the MCP server's authorization server, and servers MUST NOT accept or transit any other tokens."},{"as_of":null,"based_on":["t25_o8","t25_o9","t25_o10"],"kind":"claim","local_id":"t25_c5","object":"minimum, recommended or extended scope sets","predicate":"SHOULD be consistent while choice of approach is discretionary","stance":"qualified","subject":"server scope inclusion strategy","text":"Servers SHOULD include needed scopes in the scope parameter and SHOULD be consistent in scope inclusion strategy; the choice among minimum, recommended and extended approaches is left to server discretion."},{"as_of":null,"based_on":["t25_o11","t25_o12"],"kind":"claim","local_id":"t25_c6","object":"step-up authorization flow or abort","predicate":"SHOULD (MAY for client_credentials)","stance":"qualified","subject":"client response to scope errors","text":"Clients SHOULD respond to scope errors via step-up authorization or other appropriate handling; client_credentials clients MAY attempt step-up or abort immediately."},{"as_of":null,"based_on":["t25_o13"],"kind":"claim","local_id":"t25_c7","object":"retry limits and upgrade attempt tracking","predicate":"SHOULD implement","stance":"reported","subject":"retry limits and scope upgrade tracking","text":"Clients SHOULD implement retry limits and SHOULD track scope upgrade attempts to avoid repeated failures for the same resource and operation combination."},{"about":["scope challenge handling","step-up authorization","retry limits"],"kind":"question","local_id":"t25_q1","needed":"Check later revisions of the authorization section for changed requirement strengths.","text":"Does a later revision of this section convert the SHOULD/MAY scope-challenge and step-up items into MUST requirements?"},{"about":["OAuth 2.1 draft","token validation"],"kind":"question","local_id":"t25_q2","needed":"Check later revisions for updated OAuth 2.1 references and any changed validation text.","text":"Does a later revision replace the draft-ietf-oauth-v2-1-13 references with a final OAuth 2.1 RFC, and does that change the token validation requirements?"}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",24431,30038]],"topic":null}},"engine_root":"b01f10d0da2f611af6714fed70f79edbd081c542a759b0cda3be71e5f1774544","outcome":{"kind":"records","result":{"accepted":["e7a7beebde25c6a36b88588b4ca03e0975d617dd06f6c612a9460823a135d658","2046fa8707f9df16a862ef975d9fc698264b6d799816dc907333e0defe38f860","af44e7511a950e822b5a381a566ed8c6c98854a2584b94f7e2eab96d27d1fb7b","6d114fa8270b027ae2e547d856b4dfc1a96e50538c1a2082654d675483b566ff","0f8df57371cf5285b25da9dcc02a594afd0308dd4c8a1ec8ff74a13f8b35be42","2811f0d2d5e52cc91a14f8ffed4b20ab5e502898647f77df9554950c54fb5536","11a5803126260e30ee78