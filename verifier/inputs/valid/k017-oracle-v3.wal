{"body":{"actor":"w3","audit_root":"89b6001cb9f5c2bc2ea07ce98d1d79c4cb2cddfbda92a24860424616662ec8b5","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T43-4742d69174f2d5c2","kind":"submit","lines":[{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"**Server Scope Management**: When responding with insufficient scope errors, servers","kind":"observe","local_id":"t43_o2","terms":["server scope management"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Whatever scope-inclusion strategy a server adopts, servers **SHOULD** include all","kind":"observe","local_id":"t43_o3","terms":["scope inclusion strategy"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Scope accumulation across operations is a client-side responsibility.","kind":"observe","local_id":"t43_o4","terms":["scope accumulation responsibility"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Clients acting on their own behalf (`client_credentials` clients)","kind":"observe","local_id":"t43_o5","terms":["client credentials step-up behavior"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Clients **SHOULD** implement retry limits and **SHOULD** track scope upgrade attempts","kind":"observe","local_id":"t43_o6","terms":["step-up retry limits"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Servers **MUST** account for scope hierarchies, where a broader scope implies narrower ones,","kind":"observe","local_id":"t43_o7","terms":["scope hierarchy handling"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Implementations of this specification **MUST** follow the normative security","kind":"observe","local_id":"t43_o8","terms":["security considerations conformance"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"**Optional** - Implementations can choose to adopt these extensions","kind":"observe","local_id":"t43_o9","terms":["authorization extension optionality"]},{"as_of":null,"based_on":["t43_o3"],"kind":"claim","local_id":"t43_c2","object":"servers","predicate":"SHOULD be included together by","stance":"qualified","subject":"required scopes in insufficient-scope challenges","text":"Servers are recommended to include all scopes required for the current operation in one challenge, leaving the inclusion strategy non-mandatory."},{"as_of":null,"based_on":["t43_o4"],"kind":"claim","local_id":"t43_c3","object":"clients","predicate":"is the responsibility of","stance":"reported","subject":"scope accumulation across operations","text":"Scope accumulation across operations is assigned to clients rather than servers."},{"as_of":null,"based_on":["t43_o5"],"kind":"claim","local_id":"t43_c4","object":"clients","predicate":"MAY be attempted or aborted by","stance":"qualified","subject":"step-up authorization by client-credentials clients","text":"Client-credentials clients may attempt step-up authorization or abort immediately, leaving step-up behavior optional for that client type."},{"as_of":null,"based_on":["t43_o6"],"kind":"claim","local_id":"t43_c5","object":"clients","predicate":"SHOULD be implemented by","stance":"qualified","subject":"step-up retry controls","text":"Clients are recommended to limit retries and track scope-upgrade attempts, leaving these protections as SHOULD-level guidance."},{"as_of":null,"based_on":["t43_o7"],"kind":"claim","local_id":"t43_c6","object":"servers","predicate":"MUST be accounted for by","stance":"reported","subject":"scope hierarchies","text":"Servers must account for scope hierarchies when determining whether a token is sufficient for an operation."},{"as_of":null,"based_on":["t43_o8"],"kind":"claim","local_id":"t43_c7","object":"the linked Security Considerations section","predicate":"are specified in","stance":"open","subject":"normative security requirements","text":"Security conformance depends on normative requirements in a separately linked Security Considerations section, leaving those detailed requirements outside this section."},{"as_of":null,"based_on":["t43_o9"],"kind":"claim","local_id":"t43_c8","object":"the core protocol","predicate":"are optional and additive to","stance":"qualified","subject":"authorization extensions","text":"Authorization extensions are optional and additive, so adopting them is not required for core protocol implementations."}],"scope":{"docs":["d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d"],"ranges":[["d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d",20184,25678]],"topic":null}},"engine_root":"94a2837090f7e33cbb9ed39026e6365e7285548af758f4a11e7bcbfb76295b91","outcome":{"kind":"records","result":{"accepted":["39cad725fb72a878f85409593c3dfc8643e901587e005510f7c84661388b3d1f","70163c052bc82f5c7eb1e5c4ff36755af547f8133dc1def43b51e325033e7771","5b70919c4b9598d7d0dd6c272f37bea6a0e0cce0504c334bd8d0de765470441c","fc4e883c12a70ba566a83fbce0cc1d0ba912e1c64ed3f3039c46f6fab712b72f","4ac2aa9