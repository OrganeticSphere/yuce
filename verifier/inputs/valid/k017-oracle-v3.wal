ngs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":2,"local_id":"t57_o3"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"- The request ID **MUST NOT** match the ID of any other request the sender has issued and\n  not yet received a response for.","rule":"ends_mid_clause","suggested_exact_quote":"- The request ID **MUST NOT** match the ID of any other request the sender has issued and\n  not yet received a response for.","suggested_span":{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","end_byte":1917,"start_byte":1793},"trailing_word":"and"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":4,"local_id":"t57_o5"},{"error":{"code":"NO_EVIDENCE","expected_by_kernel":{"missing_identifiers":["2.0"]},"field":"based_on","message":"a claim names only identifiers its quotes hold: add a quote of this section that holds each one listed, or leave it out of the claim","obligation":null,"status":"error"},"index":13,"local_id":"t57_c2"}],"task_id":"T57-2572f1565e895a92","work_key":"doc:d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb#0"},"from":0,"key":"task-repair:T57-2572f1565e895a92:1","to":0},"kind":"batch","operations":[]},"engine_root":"59b73d194ade6b7bcad7cf51cc6872ea5b606458fad5ad421e999ef2aa7af6f0","outcome":{"kind":"value","result":{"accepted_operations":0,"checkpointed":true,"error":null,"failed_index":null,"results":[]}},"request_hash":"0f20b28d5fc3ec7660ef9f2fa158f14467f88cd5052b66565d8b2ccbeddffe6d","submission_id":"T57-2572f1565e895a92#repair1"},"hash":"96a9c143e72e5a8dcb63100669ddf5314a25f78c6d72ac61d24e2f687b78e12f","header":{