{"body":{"actor":"w2","audit_root":"ca54c924ca4e4cbf16cdc1ec44283e5b6e623c855106eca3f4c1e1e7d00d1ff1","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T74-bfb7dd4d245baac7","kind":"submit","lines":[{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"or all streams with that specific client, if session","kind":"observe","local_id":"t74_o2","terms":["event ID uniqueness without session management"]},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"Resumption is always via HTTP GET with `Last-Event-ID`.","kind":"observe","local_id":"t74_o4","terms":["resumption mechanism"]},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"Event IDs **SHOULD** encode sufficient information to identify the originating","kind":"observe","local_id":"t74_o5","terms":["event ID encoding of stream","optional guidance"]},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"The server **MAY** terminate the session at any time, after which it **MUST** respond","kind":"observe","local_id":"t74_o9","terms":["server-initiated session termination","HTTP 404"]},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"The server **MAY** respond to this request with HTTP 405 Method Not Allowed,","kind":"observe","local_id":"t74_o10","terms":["session DELETE optional refusal"]},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"For backwards compatibility, if the server does _not_ receive an `MCP-Protocol-Version`","kind":"observe","local_id":"t74_o11","terms":["backwards compatibility fallback version"]},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"The protocol version sent by the client **SHOULD** be the one [negotiated during","kind":"observe","local_id":"t74_o13","terms":["protocol version header matches negotiated version"]},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"If using HTTP, the client **MUST** include the `MCP-Protocol-Version:","kind":"observe","local_id":"t74_o17","terms":["protocol version header on subsequent requests"]},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"`MCP-Session-Id`, it **MUST** start a new session by sending a new `InitializeRequest`","kind":"observe","local_id":"t74_o23","terms":["re-initialization after session 404"]},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"Clients that no longer need a particular session (e.g., because the user is leaving","kind":"observe","local_id":"t74_o24","terms":["client-initiated session termination"]},{"as_of":null,"based_on":["t74_o4"],"kind":"claim","local_id":"t74_c3","object":"HTTP GET with Last-Event-ID","predicate":"is always performed via","stance":"reported","subject":"stream resumption","text":"Stream resumption is always performed via HTTP GET carrying the Last-Event-ID header, regardless of whether the original stream was started by POST or GET."},{"as_of":null,"based_on":["t74_o5"],"kind":"claim","local_id":"t74_c4","object":"the originating stream","predicate":"SHOULD encode sufficient information to identify","stance":"qualified","subject":"event ID encoding","text":"Servers are only recommended (SHOULD) to encode stream identity in event IDs, and the section says IDs should act as per-stream cursors."},{"as_of":null,"based_on":["t74_o24","t74_o10"],"kind":"claim","local_id":"t74_c8","object":"HTTP 405 Method Not Allowed","predicate":"SHOULD send HTTP DELETE; server MAY respond 405","stance":"qualified","subject":"client session termination","text":"Client-initiated session termination via HTTP DELETE is only a SHOULD, and servers MAY refuse it with HTTP 405."},{"about":["event ID uniqueness scope","client identity without sessions"],"kind":"question","local_id":"t74_q1","needed":"Check the transport and lifecycle pages referenced by this section for a client identity mechanism.","text":"How is a client identified when session management is not used, so that the per-client uniqueness scope for event IDs can be enforced?"},{"about":["InitializeResult naming","sequence diagram"],"kind":"question","local_id":"t74_q2","needed":"Compare with the lifecycle specification's definition of the initialization response type.","text":"The sequence diagram names the initialization reply InitializeResponse while the prose says InitializeResult; which name is normative?"},{"about":["replay stream attribution"],"kind":"question","local_id":"t74_q3","needed":"Check the Streamable HTTP transport section and any reference implementation guidance for stream tracking.","text":"How must a server determine which stream a message was originally delivered on, so that replay never crosses streams? The section sets the rule but not the mechanism."},{"about":["protocol version fallback","version negotiation"],"kind":"question","local_id":"t74_q4","needed":"Check the versioning and lifecycle pages of later spec revisions.","text":"Will the 2025-03-26 backwards-compatibility fallback remain in later revisions, and what replaces it when a version is negotiated but no header is sent?"}],"scope":{"docs":["d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e"],"ranges":[["d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e",8193,13999]],"topic":null}},"engine_root":"e68be66b0f33e55e5d05a5e6581dbe6ad1319b1893edc0a7be3d55e5112f0ec7","outcome":{"kind":"records","result":{"accepted":["598eef6b1dfa9c367738e8e37b484d8e3f47527cfc6638acb9bb86c422a9b6df","06549dcf0b58855af768f81da5d3be04cd62b9092e64cbd80bf1772734b67361","4124a2aa7f1a25a0572d7552ef69eaf1cb11f93fe2b24bc5b52f98711c6443e4","2f82efd72fce142491912221a52d256c2971a8c6ba1c2a109707e68af5826237","19cb66543ac4bff0377f2cea92bf40c03785fa93cb6fda3ebfcaf67ff085f830","a38d549dfc7076c7750b71a79cc860ec726103c7cd9f1beff868e0d822e1c407","30359aef661c473c2ad1eb9ad3da18f128a190472fd0ab1505d2f37f2def1a84","b27d414a92d11334de08c1d9ad8c45d4a27a279294e645e3bf8099cac270c3b6","4249b0ff57682678abe86aafd5547a726e34cf123a5d2b523f77cd9c776378bf","8f02fa1c2f536f1e6db9098bca6bb30c22cf0d25bbafceced8845f67bdec594e","c19c8742523418d13e8e82cd71f5e6310f56dd380e8a74ccf89e1ababce3c8f6","cd66974ea42e97c14f13928ce51311878f8d05c740d7fe773701abbaeeb8d0ad","a0ca90a097d55df54ca3a81e5d6d3d4595909a022a633329484afae4deec4537","9406df18985b56870f9f6a3e694046420db4b959dec3f8207c10147f22e18208","2dd9bf074b283de0adcb28363fe630d3c596de4f60590d70e856ad23c02623f3","b45f92f4246713d9a47b44e5ea32283ade7f0b3319338338bbc3110f44636104","1bee3f03ac33a05e3497572c1e4f281177978c91969c48d1c577298d646b8a32"],"error":null,"failed_index":null}},"request_hash":"9531141cc18bf4fcc11100ea3c85935040852a4487b2a9552afb5df180482873","submission_id":"T74-bfb7dd4d245baac7#1"},"hash":"4eb9adcad4e28e9e12e881f21e270f2df29de3beb6689ad4531c5c0644324dee","header":{"body_hash":"b838448bc2e2fdf31f3297103407211e1559da2917f34f3daa13d1bcafbc4e9f","format":"sbgk-session-log/3","previous":"38558155b1ebe85a83749d4a9fc8611d