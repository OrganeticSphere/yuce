{"body":{"actor":"w2","audit_root":"b7fe7ef22af1cd41c4a0165b637210042425239507e5bb6351060c2b3e900c24","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T29-64933bc2769416a0","kind":"submit","lines":[{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"Resumable SSE streams via `Last-Event-ID` are not supported.","kind":"observe","local_id":"t29_o2","terms":["SSE stream resumability not supported"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"`X-Accel-Buffering: no` header in the HTTP response. This instructs reverse","kind":"observe","local_id":"t29_o3","terms":["X-Accel-Buffering header recommended on SSE responses to disable proxy buffering"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"stop work on the cancelled request as soon as practical and **MUST NOT** send","kind":"observe","local_id":"t29_o6","terms":["server behaviour after cancellation: stop work, send no further messages"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"`notifications/message` are **not** delivered on the listen stream — they","kind":"observe","local_id":"t29_o7","terms":["request-scoped notifications not delivered on subscriptions/listen stream"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"The final JSON-RPC _response_ **SHOULD** terminate the stream.","kind":"observe","local_id":"t29_o8","terms":["final response should end the SSE stream"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"The server **MUST NOT** send independent JSON-RPC _requests_ on this stream.","kind":"observe","local_id":"t29_o9","terms":["prohibition on independent server requests on SSE response streams"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"the client — sampling, elicitation, or roots — it does not send its own","kind":"observe","local_id":"t29_o11","terms":["server-to-client interactions handled via MRTR input requests instead of direct requests"]},{"as_of":null,"based_on":["t29_o2"],"kind":"claim","local_id":"t29_c3","object":"Last-Event-ID","predicate":"are not supported via","stance":"reported","subject":"resumable SSE streams","text":"Resumable SSE streams via Last-Event-ID are not supported by this revision."},{"as_of":null,"based_on":["t29_o3"],"kind":"claim","local_id":"t29_c4","object":"servers","predicate":"SHOULD be included by","stance":"qualified","subject":"SSE response header X-Accel-Buffering","text":"Servers should include the X-Accel-Buffering: no header when initiating an SSE stream, to stop reverse proxies buffering events."},{"as_of":null,"based_on":["t29_o8"],"kind":"claim","local_id":"t29_c8","object":"the stream","predicate":"SHOULD terminate","stance":"qualified","subject":"final JSON-RPC response on an SSE stream","text":"The final JSON-RPC response SHOULD terminate the SSE stream, a recommendation rather than a MUST."},{"about":["subscriptions/listen","Last-Event-ID","resumability"],"kind":"question","local_id":"t29_q1","needed":"Check the subscriptions and SSE sections of this spec and later revisions for any reconnection or replay rule.","text":"With Last-Event-ID resumption unsupported, how does a client recover a subscriptions/listen stream after disconnect, and is missed-notification handling defined?"},{"about":["keep-alive","idle timeout","subscriptions/listen"],"kind":"question","local_id":"t29_q2","needed":"Check the subscriptions pattern and transport pages for a timing value or a normative interval.","text":"The keep-alive interval for long-lived SSE streams is not specified; how often should comments be sent so intermediaries and client idle timeouts are avoided?"},{"about":["subscriptions/listen","notification filter"],"kind":"question","local_id":"t29_q3","needed":"Check the subscriptions pattern page and the schema for the filter definition and error behaviour.","text":"The section does not state which change-notification types a client may opt into on subscriptions/listen, nor how a server rejects unsupported filters."}],"scope":{"docs":["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530"],"ranges":[["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530",4380,10358]],"topic":null}},"engine_root":"39f853eb843d9f5a01044fcb73357dd86b7450436db122727880e7da86bee7ff","outcome":{"kind":"records","result":{"accepted":["eef891299d3e3ca34844751b702b5c6566557b1bfd4989c3a58d2de0c2702326","a0a552a192a09f090e2684360a22af58145bfd257b48c56b194e5e26b5876271","53db3b8771167aaee9da0b91710f255f577edf4e3e1368f143ba5f4a6d61072d","4639adadf2593803237e9bfef1fd779d821d564fa139942f43b474d2df476899","dd0bd7c119ace76085ed44885501f7e0342057745899d9c0c15f30a97a116dfb","8ecc26474503065b98f19afb6bacdab187388976e045a5ddc1764c598c8d0f44","16069ff3a179180b602c804bb29640e4d1caac2a0c17ba840f198fdc7161593d","7be0d16197f48468293842d9e5d2011f353918ec27c5171e29955e95010a505f","46fcf330206d9791441e1d6ee7a05f86d848c0e4e31931796780dd4377e4c96d","4aa522023448f68530cc208a31114b048edfc4a