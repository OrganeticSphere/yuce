{"body":{"actor":"w2","audit_root":"3e8722ebcb743ee5e63b5341131423afcd12268260f839562a713d5084bc3b56","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T65-60bf7e6b6afb2840","kind":"submit","lines":[{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"Note that authorization **MUST** be included in every HTTP request from client to server,","kind":"observe","local_id":"t65_o1","terms":["authorization header on every request"]},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"Access tokens **MUST NOT** be included in the URI query string","kind":"observe","local_id":"t65_o2","terms":["tokens in query string"]},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"MCP servers **MUST** validate that tokens presented to them were specifically issued for their use","kind":"observe","local_id":"t65_o3","terms":["server audience validation"]},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"Invalid or expired tokens **MUST** receive a HTTP 401","kind":"observe","local_id":"t65_o4","terms":["invalid or expired tokens and 401"]},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"MCP servers **MUST NOT** accept or transit any other tokens.","kind":"observe","local_id":"t65_o5","terms":["token passthrough prohibition"]},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"audiences **when the Authorization Server supports the capability**. To enable current and future adoption:","kind":"observe","local_id":"t65_o6","terms":["RFC 8707 binding conditional on AS support"]},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"Authorization servers **SHOULD** issue short-lived access tokens to reduce the impact of leaked tokens.","kind":"observe","local_id":"t65_o7","terms":["short-lived access tokens as SHOULD"]},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"All redirect URIs **MUST** be either `localhost` or use HTTPS.","kind":"observe","local_id":"t65_o10","terms":["redirect URI restrictions"]},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"All authorization server endpoints **MUST** be served over HTTPS.","kind":"observe","local_id":"t65_o11","terms":["HTTPS for authorization server endpoints"]},{"as_of":null,"based_on":["t65_o7"],"kind":"claim","local_id":"t65_c2","object":"authorization servers","predicate":"should be issued by","stance":"qualified","subject":"short-lived access tokens","text":"Authorization servers SHOULD issue short-lived access tokens to reduce the impact of leaked tokens; this is a recommendation, not a MUST."},{"as_of":null,"based_on":["t65_o6"],"kind":"claim","local_id":"t65_c3","object":"the Authorization Server supports the capability","predicate":"applies when","stance":"qualified","subject":"RFC 8707 audience binding","text":"RFC 8707 audience binding of tokens holds only when the Authorization Server supports the capability."},{"as_of":null,"based_on":["t65_o1"],"kind":"claim","local_id":"t65_c4","object":"every HTTP request from client to server","predicate":"MUST be included in","stance":"reported","subject":"authorization on HTTP requests","text":"Authorization MUST be included in every HTTP request from client to server, even within the same logical session."},{"as_of":null,"based_on":["t65_o2"],"kind":"claim","local_id":"t65_c5","object":"the URI query string","predicate":"MUST NOT be included in","stance":"reported","subject":"access tokens","text":"Access tokens MUST NOT be included in the URI query string."},{"as_of":null,"based_on":["t65_o3"],"kind":"claim","local_id":"t65_c6","object":"that tokens were issued for them","predicate":"MUST validate","stance":"reported","subject":"MCP servers token validation","text":"MCP servers MUST validate that tokens presented to them were specifically issued for their use as the intended audience."},{"as_of":null,"based_on":["t65_o4"],"kind":"claim","local_id":"t65_c7","object":"HTTP 401","predicate":"MUST receive","stance":"reported","subject":"invalid or expired access tokens","text":"Invalid or expired access tokens MUST receive an HTTP 401 response."},{"as_of":null,"based_on":["t65_o5"],"kind":"claim","local_id":"t65_c8","object":"other tokens","predicate":"MUST NOT accept or transit","stance":"reported","subject":"MCP servers","text":"MCP servers MUST NOT accept or transit any tokens other than those they are meant to accept (token passthrough is forbidden)."},{"as_of":null,"based_on":["t65_o10"],"kind":"claim","local_id":"t65_c10","object":"localhost or HTTPS","predicate":"MUST be","stance":"reported","subject":"redirect URIs","text":"All redirect URIs MUST be either localhost or use HTTPS."},{"as_of":null,"based_on":["t65_o11"],"kind":"claim","local_id":"t65_c11","object":"HTTPS","predicate":"MUST be served over","stance":"reported","subject":"authorization server endpoints","text":"All authorization server endpoints MUST be served over HTTPS."},{"based_on":["t65_o7","t65_o6"],"falsifier":"A later revision making short-lived tokens a MUST or removing the 'when the Authorization Server supports the capability' condition.","kind":"hypothesis","local_id":"t65_h2","text":"The SHOULD on short-lived tokens and the capability condition on RFC 8707 audience binding remain open items that later revisions could tighten."},{"about":["resource parameter","RFC 8707"],"kind":"question","local_id":"t65_q1","needed":"Check the 'Resource Parameter Implementation' section of the same document.","text":"The section links to #resource-parameter-implementation, but that section's content is not included in the excerpt; is it defined in this document and what does it require?"},{"about":["error handling","HTTP status codes"],"kind":"question","local_id":"t65_q2","needed":"Compare the table with OAuth 2.1 draft-ietf-oauth-v2-1-13 Section 5.3.","text":"The error table gives 403 for invalid scopes and 400 for malformed authorization requests; it is unclear whether these match OAuth 2.1 Section 5.3 error handling referenced by the section."},{"about":["token passthrough","security best practices"],"kind":"question","local_id":"t65_q3","needed":"Check the token-passthrough section of the linked Security Best Practices document.","text":"The token passthrough prohibition is delegated to an external Security Best Practices document; the excerpt does not define the forbidden behavior itself."}],"scope":{"docs":["d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546"],"ranges":[["d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546",11199,16376]],"topic":null}},"engine_root":"a18f7d6c0f0df340af30b054bcfd739387afeedfa25dccda52681613cc2f8493","outcome":{"kind":"records","result":{"accepted":["9f5aa69ad8d11bcf4592825eb26b903cdd232e154ea9e4c0f93c37dcbf196138","6f404932577bf2ca04967d174590f5afa443c1db16217aacc87462be6270326a","ec6d963a61e46e6dac78534e3e54bba74ced765453389f8a664acebb4de9027e","ba63fceea1934403b1f3442f09643