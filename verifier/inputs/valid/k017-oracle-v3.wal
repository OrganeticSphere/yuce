{"body":{"actor":"w2","audit_root":"93a006a7b849a270b70df3b9e2a2c872126227e2367bf5d184419c9259a9340a","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T72-a29ee87f8856b46d","kind":"submit","lines":[{"doc_id":"d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e","exact_quote":"Only use capabilities that were successfully negotiated","kind":"observe","local_id":"t72_o1","terms":["operation phase MUST","capability negotiation"]},{"doc_id":"d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e","exact_quote":"Respect the negotiated protocol version","kind":"observe","local_id":"t72_o2","terms":["operation phase MUST","protocol version"]},{"doc_id":"d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e","exact_quote":"Key capabilities include:","kind":"observe","local_id":"t72_o3","terms":["capability table completeness"]},{"doc_id":"d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e","exact_quote":"Support for [task-augmented](/specification/2025-11-25/basic/utilities/tasks) client requests","kind":"observe","local_id":"t72_o4","terms":["tasks capability","client side","no experimental label"]},{"doc_id":"d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e","exact_quote":"No specific shutdown messages are defined","kind":"observe","local_id":"t72_o5","terms":["shutdown phase","transport signalling"]},{"doc_id":"d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e","exact_quote":"Implementations **SHOULD** establish timeouts for all sent requests, to prevent hung","kind":"observe","local_id":"t72_o8","terms":["request timeouts","recommendation"]},{"doc_id":"d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e","exact_quote":"Implementations **MAY** choose to reset the timeout clock when receiving a [progress","kind":"observe","local_id":"t72_o9","terms":["progress notification","timeout reset optional"]},{"doc_id":"d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e","exact_quote":"Implementations **SHOULD** be prepared to handle these error cases:","kind":"observe","local_id":"t72_o12","terms":["error handling","recommendation"]},{"doc_id":"d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e","exact_quote":"Failure to negotiate required capabilities","kind":"observe","local_id":"t72_o13","terms":["capability negotiation failure"]},{"doc_id":"d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e","exact_quote":"\"message\": \"Unsupported protocol version\",","kind":"observe","local_id":"t72_o14","terms":["initialization error","protocol version mismatch","code -32602"]},{"doc_id":"d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e","exact_quote":"Example initialization error:","kind":"observe","local_id":"t72_o15","terms":["illustrative example"]},{"as_of":null,"based_on":["t72_o1","t72_o2"],"kind":"claim","local_id":"t72_c1","object":"negotiated protocol version and capabilities","predicate":"MUST respect and use only","stance":"reported","subject":"operation phase","text":"Both parties MUST respect the negotiated protocol version and use only capabilities that were successfully negotiated during operation."},{"as_of":null,"based_on":["t72_o3"],"kind":"claim","local_id":"t72_c2","object":"non-exhaustive list of key capabilities","predicate":"is described as","stance":"open","subject":"capability table","text":"The capability table is introduced as a partial list ('Key capabilities include'), so the set of capabilities is not stated as exhaustive here."},{"as_of":null,"based_on":["t72_o4"],"kind":"claim","local_id":"t72_c3","object":"client capability without experimental label","predicate":"is listed as","stance":"reported","subject":"tasks capability","text":"The tasks capability is listed among standard client capabilities with no experimental marker, which bears on the open status of tasks noted by the hypothesis on experimental tasks."},{"as_of":null,"based_on":["t72_o5"],"kind":"claim","local_id":"t72_c6","object":"specific shutdown messages","predicate":"defines no","stance":"reported","subject":"shutdown phase","text":"No protocol-level shutdown messages are defined; the transport mechanism signals connection termination."},{"as_of":null,"based_on":["t72_o12","t72_o13"],"kind":"claim","local_id":"t72_c9","object":"defined error code or response","predicate":"is listed as error case without","stance":"open","subject":"capability negotiation failure","text":"Implementations SHOULD be prepared for listed error cases, but the section defines no error code or response for capability negotiation failure."},{"as_of":null,"based_on":["t72_o14","t72_o15"],"kind":"claim","local_id":"t72_c10","object":"unsupported protocol version (-32602)","predicate":"uses code for","stance":"reported","subject":"initialization error example","text":"The example initialization error for an unsupported protocol version uses JSON-RPC error code -32602, shown as illustrative."},{"about":["protocol version mismatch","HTTP 400","-32602"],"kind":"question","local_id":"t72_q1","needed":"Compare this error example with the transports section that defines the MCP-Protocol-Version header response.","text":"Does the JSON-RPC -32602 initialization error for unsupported protocol version coexist with the HTTP 400 rule for invalid MCP-Protocol-Version headers, and which applies to which transport case?"},{"about":["request timeouts","maximum timeout"],"kind":"question","local_id":"t72_q2","needed":"Check the cancellation and progress utility pages linked from the Timeouts section for any concrete values.","text":"What default or maximum request timeout values, and what cancellation behaviour, should implementations use, since this section only states SHOULD-level guidance?"}],"scope":{"docs":["d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e"],"ranges":[["d_7a1bf6bc8d125d79e704fa29cde580d628f34c03999b80eb772748554145086e",4807,9442]],"topic":null}},"engine_root":"18e9978f785e36e4824d9eff1a87d1d1c213004e3fa7a8fe1ec67610073d94f3","outcome":{"kind":"records","result":{"accepted":["25837494c99c25a2c966b5e862a2fc232a8eaa50384cbcfc5963aa8ddfe67e9b","d6198c754e800a23d6181fffe24d75cb241002e2c51e5e8dcb3cc954fbc62af9","5e4ec6eaa1f53cd38fdc4308fa305f66c9a4045dbc3af2cccb2907a05cf922f1","e65e64f2f8d2f0ba1a62887abd6927120bcb5ec829234e9304bbeaedfacf3e8f","00419372fc5f98337507184209084fe5ec14972d3275d42b574fb44d2cf11cbd","30542d4c5ced168f73c18cbe784e6a1e4befb82b0bef94cc522fc140d4154ef5","724df72b34ee56888f7faa6e09c419f123cbad8da0bb37e54665401644c7a39c","b1d23f3189ecb3b14ce52a6563dc7e69d65fa7343ee825790b51a960443dfb9d","1981f93f944fc96644921b5467a61005ddd141b189a8e2df258bed6fc46fbbd6","43e55fd61202998c3eb08d79f79fbe3581209525a485b81b6236030ff63808bf","8bb92fd8a3658f4e8af9b1c7cbc9cbd8cefcc5eb821b04b4eb6bdb0a6e3ee5f1","cea5bfea76406390aaed78e56a21fae4f278946d048330b980d9ea7401431e58","f09a3d93b457c52c2dc483f73d1bfb86ddf1ab785058249d39eb48ef21421878","d45509feecec9720246e1d2b4eedeaa4c1f29d2818704759561a502e600385dd","f93f7086468e441b621fd8b6ed26491a1d5cef75a1b7f5d543745559c9ba66ba","61cd00e9b295f465db12a33322f867266696457f2539bdfe462109c1965352ad",