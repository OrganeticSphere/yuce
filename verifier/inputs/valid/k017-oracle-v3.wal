{"body":{"actor":"w2","audit_root":"cd8c5604074ef79e3892f985c797de5a559f7ffee4c8d86ab3e7cfacc3823a46","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T61-8b1e19cdba6a71a3","kind":"submit","lines":[{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"are self-reported by the sender and are not verified by the protocol.","kind":"observe","local_id":"t61_o1","terms":["clientInfo/serverInfo metadata is unverified"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"As an exception to the prefix requirement above, the keys","kind":"observe","local_id":"t61_o5","terms":["trace context keys exempt from _meta prefix rule"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"When present, their values MUST follow [W3C Trace Context]","kind":"observe","local_id":"t61_o6","terms":["traceparent/tracestate/baggage value formats"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Non-normative example of trace context in `_meta`:","kind":"observe","local_id":"t61_o8","terms":["trace context example is non-normative"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Clients that support rendering icons **MUST** support at least the following MIME types:","kind":"observe","local_id":"t61_o9","terms":["required icon MIME types for clients"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Clients that support rendering icons **SHOULD** also support:","kind":"observe","local_id":"t61_o10","terms":["recommended icon MIME types (SVG, WebP)"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Ensure that the icon URI is either a HTTPS or `data:` URI.","kind":"observe","local_id":"t61_o11","terms":["icon URI scheme restriction"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Fetch icons without credentials. Do not send cookies, `Authorization` headers, or client credentials.","kind":"observe","local_id":"t61_o12","terms":["icon fetch must not carry credentials"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"as the payload **MAY** contain executable content","kind":"observe","local_id":"t61_o13","terms":["SVG icons may carry executable content"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Consumers **MAY** set limits for image and content size.","kind":"observe","local_id":"t61_o14","terms":["size limits for icons are optional and unquantified"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"Detect content type via magic bytes; reject on mismatch or unknown types.","kind":"observe","local_id":"t61_o15","terms":["content sniffing for icons"]},{"as_of":null,"based_on":["t61_o8"],"kind":"claim","local_id":"t61_c4","object":"non-normative","predicate":"is","stance":"reported","subject":"trace context example in _meta","text":"The trace context _meta example is explicitly non-normative."},{"as_of":null,"based_on":["t61_o9","t61_o10"],"kind":"claim","local_id":"t61_c5","object":"icon MIME types","predicate":"MUST support png and jpeg; SHOULD support svg+xml and webp","stance":"reported","subject":"clients rendering icons","text":"Clients that render icons MUST support image/png and image/jpeg; support for image/svg+xml and image/webp is only a SHOULD."},{"as_of":null,"based_on":["t61_o11"],"kind":"claim","local_id":"t61_c6","object":"unsafe schemes and cross-origin redirects","predicate":"MUST be rejected unless HTTPS or data:","stance":"reported","subject":"icon URIs","text":"Consumers MUST reject icon URIs that are not HTTPS or data: URIs, and must restrict redirects and scheme or origin changes."},{"as_of":null,"based_on":["t61_o12","t61_o13"],"kind":"claim","local_id":"t61_c7","object":"icon consumers","predicate":"MUST fetch without credentials; SVG MAY contain executable content","stance":"qualified","subject":"icon fetching and SVG payloads","text":"Icon fetches must be made without credentials; the MUST-level security precaution is qualified because SVG payloads MAY contain executable content and consumers MAY disallow or sanitize them."},{"as_of":null,"based_on":["t61_o14"],"kind":"claim","local_id":"t61_c8","object":"icon consumers","predicate":"MAY be set by consumers; no numeric bound given","stance":"open","subject":"icon image and content size limits","text":"Size and resource limits for icons are left to consumers: they MAY set limits, and the section gives no numeric bounds."},{"about":["icon resource exhaustion limits"],"kind":"question","local_id":"t61_q1","needed":"Check the icons section and any linked security guidance for numeric bounds on size, dimensions and GIF frames.","text":"Does the section define any numeric limits on icon size, dimensions or frame count, or does it leave them entirely to implementations?"},{"about":["_meta prefix rule","OpenTelemetry trace context"],"kind":"question","local_id":"t61_q2","needed":"Compare the _meta prefix requirement text and the linked OpenTelemetry gen-ai MCP semantic conventions for any additional reserved keys.","text":"How the prefix requirement interacts with the trace context exception is not fully stated; the reserved key list may need to be confirmed against the OpenTelemetry MCP semantic conventions."},{"based_on":["t61_o10","t61_o13"],"falsifier":"A later revision making SVG sanitization or disallowance a MUST, or removing image/svg+xml from the recommended list, without change.","kind":"hypothesis","local_id":"t61_h1","text":"The icon security rules leave SVG handling optional (MAY disallow or sanitize), so a later revision may require sanitization or prohibit SVG outright."}],"scope":{"docs":["d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb"],"ranges":[["d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb",20112,25134]],"topic":null}},"engine_root":"565156788a9ed588effa4d397a8f91b9f552c380808d9cf9529ffe1fb1b55d78","outcome":{"kind":"records","result":{"accepted":["a7b8f6d586832f6d7b22e2cc8edaed4a94e7e8f1d59aa217e96cf403f4b26db0","93985ea2a8e8d0421de52ea3ec9091f823fd6ab426c34f77770a9edfd7be6ecb","d2d7daf1a5f6381409ef8672d3772f5a782094db082a701d617568bea78bc3dc","7f4abb865cb9fd1749e1ab917abb37dc596d80c0bfa9286a8e4055ba8e1efa58","5dd76ce642de7eba3e54d60d1edbb18481b9b873a3a7e7ff2e45791995bce233","eb4fbda4163b1e98d2ed9b6c5adcef608487d12741ff0b9d75e59e43e332e2ec","18b4644962acdf491298946fa2552662265742a309b65eef7c850233d0986431","2395a2329028b34456c2a4fec49410832770927ec6efb61000f0cf40fe02d36d","0fceabe48c5bdb8bfddc09ddb540a8bbbbbc35a4231535b4745ed54d296cf2b8","6888206ecd68cfac992d803d9a70dfafb0e82b2af83c3793fd6a1a8ab4f632d3","40c72cc917daf3c182cf83be7a064bc4528214d29523b55e192b476ddc857036","3540b397c258222eb0bedc5648b2abe7bd6867f57da36d2342fab04cc5c2e11b","1535f638b3a6743f848b9f1c1c507e5a3054a0c422c0d8d666b2443e0ba75eb9","bc52221fac8b60ca37be77a00449f778b478d8a234ec174ddeb19f9b523669e1","7eb4