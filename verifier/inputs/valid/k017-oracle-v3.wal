{"body":{"actor":"w3","audit_root":"fb3d20106e047f4270c7d84a35b100ff9c429bed4d5fd0272ad00ced74615600","command":{"allowed_records":[],"directive":"T4-9e8d27212b12a1d1","kind":"submit","lines":[{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"Implementations **MUST** follow OAuth 2.1 security best practices","kind":"observe","local_id":"t4_o1","terms":["implementation security requirements","OAuth 2.1"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"PKCE is **REQUIRED** for all clients","kind":"observe","local_id":"t4_o2","terms":["PKCE","client requirements"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"Token rotation **SHOULD** be implemented for enhanced security","kind":"observe","local_id":"t4_o3","terms":["token rotation","security qualification"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"MCP servers **MAY** support delegated authorization through third-party authorization\nservers.","kind":"observe","local_id":"t4_o4","terms":["third-party authorization","delegated authorization"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"MCP servers implementing third-party authorization **MUST**:","kind":"observe","local_id":"t4_o5","terms":["third-party authorization","conditional server requirements"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"We strongly recommend that all clients implement metadata discovery.","kind":"observe","local_id":"t4_o6","terms":["authorization metadata discovery","client best practices"]},{"as_of":null,"based_on":["t4_o1","t4_o2"],"kind":"claim","local_id":"t4_c1","object":"OAuth 2.1 security best practices and PKCE","predicate":"must follow","stance":"confirmed","subject":"implementations and clients","text":"The section requires OAuth 2.1 security best practices and PKCE for every client."},{"as_of":null,"based_on":["t4_o3"],"kind":"claim","local_id":"t4_c2","object":"for enhanced security","predicate":"should be implemented","stance":"qualified","subject":"token rotation","text":"Token rotation is recommended for enhanced security, so this guidance is qualified rather than an unconditional requirement."},{"as_of":null,"based_on":["t4_o4"],"kind":"claim","local_id":"t4_c3","object":"MCP servers","predicate":"may be supported by","stance":"qualified","subject":"third-party delegated authorization","text":"Third-party delegated authorization is optional; servers may support it rather than being required to provide it."},{"as_of":null,"based_on":["t4_o5"],"kind":"claim","local_id":"t4_c4","object":"secure token mapping, status validation, lifecycle management, and expiration or renewal handling","predicate":"must maintain","stance":"confirmed","subject":"third-party authorization implementations","text":"Servers that implement third-party authorization are subject to additional mandatory session-binding requirements."},{"as_of":null,"based_on":["t4_o6"],"kind":"claim","local_id":"t4_c5","object":"all clients","predicate":"is strongly recommended for","stance":"open","subject":"authorization metadata discovery","text":"Metadata discovery remains a strong recommendation for clients, not a stated mandatory requirement."}],"scope":{"docs":["d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d"],"ranges":[["d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d",11692,15070]],"topic":null}},"engine_root":"46b1baef968f76c086035f6cbdb040112735ebfff2bfb53f419e0e075a4f8f85","outcome":{"kind":"records","result":{"accepted":["5f533ae3b41a39b0d6feef07ac3e5141ff11bd4b1e1280bc2245d9b208c53ac8","ac0ea4926f46e67d58504a0dbe714a1de2f639aa69dc66e5748958ff2c96132d","6bebbd977b75200c2b31ab621b8d560f2911061ed996430f07c8aa35d0e9d4a8","2494cfc1af8606a5abeab97c2c2ad4226fd90078142a7224766d3ee39b664a12","e6d0f9a9