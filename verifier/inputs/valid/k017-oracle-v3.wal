{"body":{"actor":"w2","audit_root":"69160f85ad145aca3f9b44912b7ee7823c998c8937e45e7b2e5084d69edc0ab2","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T80-d9df528eccae31ec","kind":"submit","lines":[{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Authorization servers **SHOULD** include the `iss` parameter in authorization responses per","kind":"observe","local_id":"t80_o1","terms":["RFC 9207 iss parameter in authorization responses","SHOULD strength"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"present `iss` against the recorded issuer before redeeming the authorization code","kind":"observe","local_id":"t80_o2","terms":["client validation of iss before code redemption","MUST strength"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"clients **MUST** key persisted credentials by the issuer identifier, **MUST NOT** reuse them","kind":"observe","local_id":"t80_o3","terms":["client credentials keyed by issuer","credential reuse prohibition"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"the\n    client learns the outcome of an out-of-band interaction by retrying the original","kind":"observe","local_id":"t80_o7","terms":["Multi Round-Trip Requests replaces server-initiated completion signal"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"elicitation across retries encode their own identifier in `requestState`.","kind":"observe","local_id":"t80_o8","terms":["servers correlate elicitations via requestState"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"implementation-defined (existing SDK usage is grandfathered), `-32020` to `-32099` is","kind":"observe","local_id":"t80_o9","terms":["error code range partition","grandfathered -32000 to -32019"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"`HeaderMismatchError` to the schema, which previously existed only in transport prose.","kind":"observe","local_id":"t80_o10","terms":["HeaderMismatchError added to schema"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Change resource not found error code from `-32002` to `-32602` (Invalid Params) to align with JSON-RPC specification.","kind":"observe","local_id":"t80_o11","terms":["resource not found error code change"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Servers **SHOULD** return tools from `tools/list` in a deterministic order to enable client-side caching","kind":"observe","local_id":"t80_o12","terms":["deterministic tools/list ordering","SHOULD strength"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"`ttlMs` is a freshness hint (in milliseconds) allowing clients to cache responses and reduce polling; `cacheScope`","kind":"observe","local_id":"t80_o13","terms":["ttlMs freshness hint","cache TTL for list and read results"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Both fields complement existing `listChanged` notifications","kind":"observe","local_id":"t80_o14","terms":["relation of cache fields to listChanged notifications"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Require standard MCP request headers (`Mcp-Method`, `Mcp-Name`) on Streamable HTTP POST requests","kind":"observe","local_id":"t80_o15","terms":["required Mcp-Method and Mcp-Name headers"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Require `ttlMs` and `cacheScope` fields on results returned by `tools/list`, `prompts/list`, `resources/list`","kind":"observe","local_id":"t80_o18","terms":["required ttlMs and cacheScope on list results"]},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Add `extensions` field to `ClientCapabilities` and `ServerCapabilities` to support optional","kind":"observe","local_id":"t80_o19","terms":["extensions field in capabilities"]},{"as_of":null,"based_on":["t80_o1","t80_o2"],"kind":"claim","local_id":"t80_c1","object":"before redeeming the authorization code","predicate":"SHOULD be included by authorization servers; MUST be validated by clients","stance":"reported","subject":"iss parameter in authorization responses","text":"Authorization servers SHOULD include the iss parameter per RFC 9207; MCP clients MUST validate a present iss against the recorded issuer before redeeming the authorization code."},{"as_of":null,"based_on":["t80_o8"],"kind":"claim","local_id":"t80_c4","object":"server-defined identifier","predicate":"is done by encoding an identifier in requestState","stance":"reported","subject":"elicitation correlation across retries","text":"Servers needing to correlate an elicitation across retries should encode their own identifier in requestState, since the removed elicitationId no longer serves this purpose."},{"as_of":null,"based_on":["t80_o11"],"kind":"claim","local_id":"t80_c5","object":"-32602 (Invalid Params)","predicate":"changes from -32002 to","stance":"superseded","subject":"resource not found error code","text":"Resource not found error code changes from -32002 to -32602 (Invalid Params)."},{"as_of":null,"based_on":["t80_o9"],"kind":"claim","local_id":"t80_c6","object":"-32020 to -32099 reserved for MCP","predicate":"is partitioned into implementation-defined and MCP-reserved parts","stance":"superseded","subject":"JSON-RPC server-error range allocation","text":"The JSON-RPC server-error range is partitioned: -32000 to -32019 stays implementation-defined (existing SDK usage grandfathered); -32020 to -32099 is reserved for MCP. Draft error codes are renumbered accordingly."},{"as_of":null,"based_on":["t80_o10"],"kind":"claim","local_id":"t80_c7","object":"the schema","predicate":"is added to","stance":"reported","subject":"HeaderMismatchError","text":"HeaderMismatchError is added to the schema, having previously existed only in transport prose."},{"as_of":null,"based_on":["t80_o12"],"kind":"claim","local_id":"t80_c8","object":"to enable client caching and prompt cache hits","predicate":"SHOULD be deterministic","stance":"reported","subject":"tools/list result ordering","text":"Servers SHOULD return tools from tools/list in a deterministic order to enable client-side caching and improve LLM prompt cache hit rates."},{"as_of":null,"based_on":["t80_o13","t80_o14","t80_o18"],"kind":"claim","local_id":"t80_c9","object":"via CacheableResult, complementing listChanged","predicate":"are required","stance":"reported","subject":"ttlMs and cacheScope fields on list and read results","text":"ttlMs (freshness hint in ms) and cacheScope (public or private) are required on tools/list, prompts/list, resources/list and related results via CacheableResult; they complement listChanged notifications."},{"as_of":null,"based_on":["t80_o15"],"kind":"claim","local_id":"t80_c10","object":"Mcp-Method and Mcp-Name","predicate":"must carry headers","stance":"reported","subject":"Streamable HTTP POST requests","text":"Streamable HTTP POST requests must carry standard MCP request headers Mcp-Method and Mcp-Name."},{"about":["error code allocation","HeaderMismatch renumbering"],"kind":"question","local_id":"t80_q1","needed":"Check the error codes section of the basic index in later spec revisions and the schema for HeaderMismatchError.","text":"Are the error code partition (-32000 to -32019 grandfathered, -32020 to -32099 reserved) and renumbered draft codes (HeaderMismatch -32020, MissingRequiredClientCapability -32021, UnsupportedProtocolVersion -32022) retained in later revisions?"},{"about":["_meta trace context propagation","SEP-414"],"kind":"question","local_id":"t80_q2","needed":"Check the basic/_meta documentation and SEP-414 in later revisions.","text":"Does the OpenTelemetry trace context convention for _meta keys (traceparent, tracestate, baggage) get defined in full, or is it only referenced via SEP-414 here?"}],"scope":{"docs":["d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936"],"ranges":[["d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936",4413,8411]],"topic":null}},"engine_root":"9d6db621c8860e1c5cddb1854e87fdaecebdaca475228534fc84616a8349ebe9","outcome":{"kind":"records","result":{"accepted":["404dbc58365031456fe89a7083bd1d1da356a724e13d8a2dfef85e61a399a181","e9d291e133cfc2368f2f2bf62753eb358e9347b52adb7e1d4a00398cc2beb800","0d21e9991497576b374c80c3da5e611d4a7669f0ab9ae4b764a6bc64735a121e","1023ddd63a742d0f66b977ff10158e3d3070c59e86998be15061e7d613ae0661","a27f38153235a6050f8c2bf4d26d46dc9e30a74592529bdc04a584708ef4ff5c","5342f9d011efb7c3449131d6a4876ca2e611ae00efc173487e64e69235da1744","54a18b9a3c7c0d95854e8a41faac0ff36b4b9a9dae7c92527470128685eb3ac8","eeef3fd53aafaf4efc3dda84777dcaa8e5b983e8387b2a203e1bc467f81e5291","d7a8829afac81096e91438d4212fe2447f1c035c424f5760963343ce734cb70a","633eb52af7ac1ee89c47858f5a6323b2a3692c46a9