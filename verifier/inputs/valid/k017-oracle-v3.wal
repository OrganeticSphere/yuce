920d7c7e3","f6629f42b17f558e03098a647200dff3ca9c644b1d54989747435dab943aba45","f823d04433e251deea6b162294a07f665e558b38156b54c4e39e8b37ff2698ea","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd","fbf503dc3be20664e2e8c0c4a0d9775b10c36e57c40c6ed4a7fe17cb3fe8eb54","fd0d09990d0baf94fa0a880f6943d4f527abda0adab9c560af110b03b329bc62","fe0ed5f0f11504786600de654358410d40bce69c1ba1d2d56481c15b46130ea8"],"directive":"TS151-d1f2af3cdc2936a7","kind":"submit","lines":[{"as_of":null,"based_on":["@5248d4d8fcccff12","@f6629f42b17f558e","@000d7874bf562ec4"],"kind":"claim","local_id":"t151_c1","object":"transport-level connection termination","predicate":"defines no specific messages and leaves server-initiated stdio shutdown as MAY","stance":"open","subject":"shutdown phase","text":"Shutdown defines no specific messages; termination is signaled via the underlying transport, and for stdio the server MAY initiate shutdown by closing its output stream and exiting."},{"as_of":null,"based_on":["@b5a2628dff08017c","@000d7874bf562ec4"],"kind":"claim","local_id":"t151_c2","object":"closing connections","predicate":"is not described beyond","stance":"open","subject":"HTTP server-initiated shutdown","text":"HTTP shutdown is stated only as closing connections; no server-initiated HTTP shutdown procedure is described, and no protocol-level shutdown messages exist."},{"as_of":null,"based_on":["@6797adf1b06d096c"],"kind":"claim","local_id":"t151_c3","object":"support for non-standard experimental features","predicate":"is described only as","stance":"open","subject":"experimental capability","text":"The experimental capability is described only as support for non-standard experimental features, leaving its contents unspecified."},{"as_of":20241105,"based_on":["@73a92f9dc8bb36c5","@715f7599e1bf5c79","@a0b7ed936d4d0981","@594d1187236053e4","@9c759983ab81ffba"],"kind":"claim","local_id":"t151_c4","object":"client and server version exchange","predicate":"is qualified by SHOULD-level guidance and a server MUST","stance":"qualified","subject":"protocol version negotiation","text":"Version negotiation is SHOULD-level: client sends its latest supported version and disconnects if it cannot support the server's version; server MUST answer with another supported version."},{"as_of":20241105,"based_on":["@b2013687d6517ed9","@370d62fd77991679","@fe0ed5f0f1150478","@958fb0553530e511","@43e55fd61202998c","@8bb92fd8a3658f4e"],"kind":"claim","local_id":"t151_c5","object":"listed error cases","predicate":"SHOULD be prepared for","stance":"qualified","subject":"error-case handling","text":"Handling version mismatch, capability failure, initialize and shutdown timeouts is SHOULD, not MUST; the example unsupported-version error uses code -32602."},{"as_of":null,"based_on":["@8133a7156f985b41","@90abb710b6280fc1","@c7edca8b43235eac","@41ae8173e32a455c","@a59530f1cd8c4623"],"kind":"claim","local_id":"t151_c6","object":"Error Handling sections, transport unspecified","predicate":"recurs in","stance":"reported","subject":"-32602 unsupported protocol version initialization error","text":"The -32602 'Unsupported protocol version' example recurs under Error Handling in 2025-03-26 and 2025-06-18 without naming a transport for the error."},{"as_of":null,"based_on":["@7ac56f9a8dd0b358"],"kind":"claim","local_id":"t151_c7","object":"server choice per audience","predicate":"is left open to","stance":"open","subject":"OAuth grant type support","text":"Which OAuth grant types an MCP server supports is left to server discretion, aligned to intended audience (authorization code vs client credentials)."},{"as_of":null,"based_on":["@0b9b7322889092fb"],"kind":"claim","local_id":"t151_c8","object":"HTTP 401 Unauthorized","predicate":"MUST receive","stance":"reported","subject":"unauthenticated requests","text":"Servers MUST respond with HTTP 401 Unauthorized when authorization is required and not yet proven by the client."},{"as_of":null,"based_on":["@14bad3d661136b4a"],"kind":"claim","local_id":"t151_c9","object":"all clients","predicate":"is strongly recommended for","stance":"open","subject":"authorization metadata discovery","text":"Metadata discovery remains a strong recommendation for clients, not a stated mandatory requirement."},{"as_of":null,"based_on":["@5be99eb7686e174b","@bf5d4d0289618d4e"],"kind":"claim","local_id":"t151_c10","object":"hardcoded client ID or user-entry UI","predicate":"must provide","stance":"open","subject":"servers without Dynamic Client Registration","text":"Servers without Dynamic Client Registration must provide a client ID by hardcoding it or via a user-entry UI; no other mechanism is specified."},{"as_of":null,"based_on":["@8958cc59e2a59e59"],"kind":"claim","local_id":"t151_c11","object":"token expiration and rotation","predicate":"should enforce","stance":"open","subject":"servers","text":"Servers SHOULD enforce token expiration and rotation, which is recommended rather than mandatory."},{"as_of":null,"based_on":["@19e9c33ce54ac9a6"],"kind":"claim","local_id":"t151_c12","object":"a reasonable time","predicate":"is left unspecified as","stance":"open","subject":"stdio escalation timing","text":"The stdio escalation timing is left as 'a reasonable time' with no defined value, so the wait before SIGTERM and SIGKILL remains unspecified."},{"as_of":null,"based_on":["@c5b43e232a098f41","@dcd8e80409fed3d6","@4adf7bd89b799245"],"kind":"claim","local_id":"t151_c13","object":"clients and servers","predicate":"are possible via pluggable implementation and MAY be implemented","stance":"open","subject":"custom transports","text":"Custom transports are possible through a pluggable mechanism in 2025-03-26 and 2025-06-18, and MAY be implemented in 2025-11-25, but the sections do not specify them."},{"as_of":null,"based_on":["@90168d1d0a66763c"],"kind":"claim","local_id":"t151_c14","object":"session expiry","predicate":"is referenced as ending SSE stream obligation","stance":"open","subject":"session management","text":"Session expiry is an exception to keeping the SSE stream open, but session management is only linked here and not defined in this section."},{"as_of":null,"based_on":["@061513d49f213157"],"kind":"claim","local_id":"t151_c15","object":"the header to replay messages","predicate":"MAY use","stance":"open","subject":"server replay after Last-Event-ID","text":"Using Last-Event-ID to replay missed messages is optional for the server, leaving replay behavior open."},{"as_of":null,"based_on":["@9ad6ca87ff0cea4f"],"kind":"claim","local_id":"t151_c16","object":"servers","predicate":"MAY be attached by","stance":"open","subject":"SSE event id field","text":"SSE event identifiers are optional for servers, leaving resumability and redelivery support partly open."},{"as_of":null,"based_on":["@4e0ff86d4db4524a"],"kind":"claim","local_id":"t151_c17","object":"the server at initialization","predicate":"MAY be assigned by","stance":"open","subject":"Streamable HTTP session ID","text":"Session IDs are optional for Streamable HTTP servers, so stateful session establishment remains an implementation choice."},{"as_of":null,"based_on":["@d14523cd4d173f7a","@ee0234541bcc2c14","@0f689fe243b545c4"],"kind":"claim","local_id":"t151_c18","object":"servers","predicate":"MAY be implemented to avoid message loss by","stance":"open","subject":"resumable stream implementation","text":"Making SSE streams resumable to prevent message loss on disconnection remains an optional feature (MAY), leaving stream resilience open."},{"as_of":20250618,"based_on":["@75c4830c43adfd0d","@be07022f54e06052","@78e447a41b1070ad"],"kind":"claim","local_id":"t151_c19","object":"HTTP 400 Bad Request","predicate":"MUST receive","stance":"reported","subject":"invalid or unsupported MCP-Protocol-Version","text":"A server receiving an invalid or unsupported MCP-Protocol-Version MUST respond with HTTP 400 Bad Request (2025-06-18)."},{"as_of":null,"based_on":["@9f47c87aa2227194","@e9755be750c95af5"],"kind":"claim","local_id":"t151_c20","object":"code -32602 and supported/requested data","predicate":"is exemplified with","stance":"reported","subject":"unsupported protocol version error","text":"The example initialization error for an unsupported protocol version uses code -32602 with supported and requested versions in data."},{"as_of":null,"based_on":["@33b47bb39a1428bc"],"kind":"claim","local_id":"t151_c21","object":"authorization server support","predicate":"MUST be sent regardless of","stance":"open","subject":"resource parameter","text":"Clients MUST send the resource parameter regardless of whether authorization servers support it, leaving AS-side support open."},{"as_of":null,"based_on":["@bcfb6c2a76e50f3c"],"kind":"claim","local_id":"t151_c22","object":"unspecified external specification","predicate":"is deferred to","stance":"open","subject":"OAuth 2.1 authorization flow","text":"The OAuth 2.1 authorization flow itself is deferred in the diagram rather than specified in this section."},{"as_of":null,"based_on":["@9fa26226d8c0a638","@6e4186e032caba92","@e0dab820e8dfc199"],"kind":"claim","local_id":"t151_c23","object":"this specification","predicate":"are beyond the scope of","stance":"open","subject":"authorization server implementation details","text":"Authorization server implementation details are beyond the scope of this specification (2025-06-18, 2025-11-25, 2026-07-28); the server may be hosted with the resource server or separately."},{"as_of":null,"based_on":["@b487a8216a03d434","@257de7ce6c238dbd","@0e1e7cf17ea3c116"],"kind":"claim","local_id":"t151_c24","object":"this specification","predicate":"is beyond the scope of","stance":"open","subject":"authorization_servers field usage","text":"The specific use of authorization_servers is declared beyond scope, deferring implementers to RFC9728."},{"as_of":null,"based_on":["@62ade6e935343e18","@00f8b96ca6fc07a6"],"kind":"claim","local_id":"t151_c25","object":"the MCP client","predicate":"lies with","stance":"open","subject":"selection of authorization server","text":"The responsibility for selecting which authorization server to use lies with the MCP client, following RFC9728 Section 7.6 guidelines."},{"as_of":null,"based_on":["@e13971e5be2adb51","@e107028eb433366f","@23db7066599c048c","@4bf86750aece8545"],"kind":"claim","local_id":"t151_c26","object":"the Streamable HTTP transport sections","predicate":"is not specified by","stance":"open","subject":"resource URI transport in Streamable HTTP headers","text":"The Streamable HTTP sections name only Accept, Mcp-Session-Id, Last-Event-ID and Origin as headers; no header carries a resource URI, and POST bodies are single JSON-RPC messages."},{"as_of":null,"based_on":["@79a917ef4f4aa1c9","@7c111cc6f6a780f4"],"kind":"claim","local_id":"t151_c27","object":"InitializeResult in prose vs InitializeResponse in the sequence diagram","predicate":"is given as","stance":"open","subject":"initialization response type name","text":"The prose names the initialization response type InitializeResult while the sequence diagram labels the same reply InitializeResponse; the section does not state which is normative."},{"as_of":null,"based_on":["@525a61bb5af801a4"],"kind":"claim","local_id":"t151_c28","object":"experimental","predicate":"is introduced as","stance":"open","subject":"tasks support","text":"Tasks support is introduced as experimental, so its durability/polling behavior is provisional and may change in later revisions."},{"as_of":null,"based_on":["@31772f74beb59675"],"kind":"claim","local_id":"t151_c29","object":"a selected subset","predicate":"are implemented as","stance":"open","subject":"referenced specifications features","text":"The section states it implements only a selected subset of the referenced specifications but does not enumerate which features are omitted."},{"as_of":null,"based_on":["@747f427c2b171cb0","@994452779cb08a1b","@e2307a07a1a94053"],"kind":"claim","local_id":"t151_c30","object":"abort or use pre-configured values","predicate":"is left open as","stance":"open","subject":"discovery failure fallback","text":"When discovery metadata is not found, the client may abort or use pre-configured values, leaving the fallback behavior open."},{"as_of":null,"based_on":["@0df90ecba9980a0b"],"kind":"claim","local_id":"t151_c31","object":"optional, policy not specified","predicate":"is","stance":"open","subject":"domain trust policy check","text":"The optional domain check via trust policy is left undefined in this section."},{"as_of":null,"based_on":["@987b130a772285f9"],"kind":"claim","local_id":"t151_c32","object":"HTTP cache headers, no duration given","predicate":"respects","stance":"open","subject":"Client ID Metadata Document cache","text":"Metadata caching follows HTTP cache headers, but no cache duration or refresh rule is stated."},{"as_of":null,"based_on":["@5e4ec6eaa1f53cd3"],"kind":"claim","local_id":"t151_c33","object":"non-exhaustive list of key capabilities","predicate":"is described as","stance":"open","subject":"capability table","text":"The capability table is introduced as a partial list ('Key capabilities include'), so the set of capabilities is not stated as exhaustive here."},{"as_of":null,"based_on":["@b1d23f3189ecb3b1","@1981f93f944fc966"],"kind":"claim","local_id":"t151_c34","object":"defined error code or response","predicate":"is listed as error case without","stance":"open","subject":"capability negotiation failure","text":"Implementations SHOULD be prepared for listed error cases, but the section defines no error code or response for capability negotiation failure."},{"as_of":null,"based_on":["@976af4b5e7e97164","@30542d4c5ced168f"],"kind":"claim","local_id":"t151_c35","object":"configurable per-request SHOULD without defaults","predicate":"are left unspecified as","stance":"open","subject":"timeout values","text":"Per-request timeouts are only SHOULD-configurable in SDKs and middleware, and the section gives no default or maximum timeout value."},{"as_of":null,"based_on":["@a38d549dfc7076c7","@115ce08a759e81c6"],"kind":"claim","local_id":"t151_c36","object":"protocol version 2025-03-26","predicate":"SHOULD assume","stance":"open","subject":"protocol version fallback","text":"When neither a header nor another version source exists, servers SHOULD assume protocol version 2025-03-26; this fallback is conditional and its applicability to later versions is not stated."},{"as_of":null,"based_on":["@01e9ea905348830b","@e99fe86efa70d725","@4149d9c64bd2305b","@c4776a0c43a285ec","@14e39847ed9151b8"],"kind":"claim","local_id":"t151_c37","object":"this revision","predicate":"have not yet occurred; eligibility only","stance":"open","subject":"feature removals under the deprecation policy","text":"No features have been removed under the deprecation policy yet; earliest removal marks only eligibility, with actual removal a Core Maintainer decision during release preparation."},{"as_of":null,"based_on":["@e9caf413a01d1121"],"kind":"claim","local_id":"t151_c38","object":"three months after SEP-2596 reaches Final","predicate":"remains scheduled for","stance":"open","subject":"earliest removal of HTTP+SSE transport","text":"The earliest removal of the HTTP+SSE transport remains open, pending three months after SEP-2596 reaches Final."},{"as_of":20260728,"based_on":["@5861b79131999aec","@0ea828760fbd701b"],"kind":"claim","local_id":"t151_c39","object":"core protocol revision 2026-07-28","predicate":"are not defined by","stance":"open","subject":"header requirements for notification POSTs","text":"Header requirements for client-to-server notification POSTs are not defined in revision 2026-07-28, and no client-to-server notifications over Streamable HTTP are defined."},{"as_of":null,"based_on":["@bf26aedbdfbfa1e2","@733109d97ae006a3","@cde6e928940e5217"],"kind":"claim","local_id":"t151_c40","object":"reject, silence, or legacy-semantics processing","predicate":"fails with implementation-defined or ambiguous behavior","stance":"open","subject":"modern client with legacy server","text":"Modern-client/legacy-server interop fails with implementation-defined or ambiguous behavior (reject, silence, or legacy-semantics processing); legacy clients have no fall-forward mechanism."},{"as_of":20260728,"based_on":["@99e05174d4eb93d2","@210c8f5c3cca0a54"],"kind":"claim","local_id":"t151_c41","object":"not resumable","predicate":"are","stance":"superseded","subject":"streams","text":"Streams in revision 2026-07-28 are not resumable, superseding the earlier optional resumability; HTTP+SSE remains eligible for removal in a future revision."},{"as_of":20260728,"based_on":["@80a0121fdad5232c","@2f32f386bad564f1","@5dd3e975b8eef3c8"],"kind":"claim","local_id":"t151_c42","object":"Streamable HTTP transport","predicate":"are removed from","stance":"superseded","subject":"protocol-level sessions and Mcp-Session-Id header","text":"Protocol-level sessions and the Mcp-Session-Id header are removed from the Streamable HTTP transport; the shown text gives no client persistence or resumability mechanism."},{"as_of":null,"based_on":["@99ace9bf482e5674","@8dafb3602aa34f94","@6172df84a3b2c85c"],"kind":"claim","local_id":"t151_c43","object":"IETF drafts with SHOULD-level support","predicate":"is","stance":"open","subject":"OAuth 2.1 basis and Client ID Metadata Documents","text":"The spec's OAuth 2.1 basis is IETF draft draft-ietf-oauth-v2-1-13; Client ID Metadata Documents support is a SHOULD pinned to draft-ietf-oauth-client-id-metadata-document-00."},{"as_of":null,"based_on":["@34e4314f4745144a","@8e9a28b0a2ba19b1","@27ca2c04ba282fdb"],"kind":"claim","local_id":"t151_c44","object":"a future revision of this specification","predicate":"is expected to be upgraded from SHOULD to MUST in","stance":"open","subject":"authorization server inclusion of iss parameter","text":"Authorization server inclusion of the iss parameter is currently SHOULD, with a future revision expected to upgrade it to MUST; client rejection on iss absence stays keyed on authorization_response_iss_parameter_supported until then."},{"as_of":null,"based_on":["@efa8a3c87b35602a"],"kind":"claim","local_id":"t151_c45","object":"the expected issuer was obtained from an unvalidated source","predicate":"provides no protection if","stance":"reported","subject":"issuer validation in this section","text":"Issuer validation provides no protection if the expected issuer was obtained from an unvalidated source, a stated limitation of this section."},{"as_of":null,"based_on":["@a7b8f6d586832f6d","@f823d04433e251de","@5c3facde0ca545d6","@6888206ecd68cfac"],"kind":"claim","local_id":"t151_c46","object":"display, logging, debugging only","predicate":"are self-reported and SHOULD NOT drive behaviour or security decisions","stance":"reported","subject":"io.modelcontextprotocol/clientInfo and serverInfo","text":"Self-reported clientInfo/serverInfo is not verified by the protocol and SHOULD NOT drive behaviour or security decisions; icon size limits are left to consumers with no numeric bounds."},{"as_of":null,"based_on":["@3618493755714b6e","@5d239c56b828f3de","@3d74f54406f540cf"],"kind":"claim","local_id":"t151_c47","object":"future specification versions","predicate":"may receive standard codes in","stance":"open","subject":"common local error conditions","text":"Standard JSON-RPC error codes for common local error conditions remain open for possible definition in future specification versions; the era model and compatibility matrix are deferred to the Versioning page."}],"scope":{"docs":[],"ranges":[],"topic":null}},"engine_root":"df948d403a6ddb21b78ce782c4f236f97b4bf42e70d199a8bf4997f14d3353d3","outcome":{"kind":"records","result":{"accepted":["4a9241a7165723bdf7b86a76a035a15354a72faccd7efac253f0479ae85ed942","25feab6755ce670b1b4a7fe5703ef61a4c2e1f7c103c7866d8ed1c733e9cb2f4","819d43aeb67ec0625ebbc0c2d781e36f1baba7478d8f2f944eeaa61ffb67c47a","063f9e4aef15987c0f3d32cd3845b2f0808ad3c82b1f6f457e1fd20c7dded86c","b76ce97167dcc523f1e160a00cb14ee385993b0cb629f