{"body":{"actor":"w1","audit_root":"11cf6be26c2a22e1beffcbb69ae727ceb8eb04aba30ffbba1b56e30576f67848","command":{"allowed_records":["055c3b232f4d91ca3898c658c421637b3ec6181635f6eec74ea53ca4449c86b5","0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","c8433f8a1df56a4154b6dd2ad7ffe98151da3db1f9ef0f33bcb40ad5bcf420ac","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"TR24-3094d58082e7de24","kind":"submit","lines":[{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP clients and authorization servers **SHOULD** support OAuth Client ID Metadata Documents as specified in\n[OAuth Client ID Metadata Document](https://datatracker.ietf.org/doc/html/draft-ietf-oauth-client-id-metadata-document-00).","kind":"observe","local_id":"t24_o3","terms":["Client ID Metadata Documents","SHOULD support","IETF draft"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP implementations supporting Client ID Metadata Documents **MUST** follow the requirements specified in\n[OAuth Client ID Metadata Document](https://datatracker.ietf.org/doc/html/draft-ietf-oauth-client-id-metadata-document-00).","kind":"observe","local_id":"t24_o4","terms":["Client ID Metadata Documents","MUST follow requirements","IETF draft"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Clients **MAY** use `private_key_jwt` for client authentication (e.g., for requests to the token endpoint) with appropriate JWKS configuration as described in [Section 6.2 of Client ID Metadata Document](https://www.ietf.org/archive/id/draft-ietf-oauth-client-id-metadata-document-00.html#section-6.2)","kind":"observe","local_id":"t24_o5","terms":["private_key_jwt","client authentication","MAY","JWKS"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Note over C,A: Try OAuth 2.0 and OpenID Connect<br/>discovery endpoints in priority order\n    A-->>C: Authorization server metadata\n\n    Note","kind":"observe","local_id":"t24_o11","terms":["AS metadata discovery","OAuth 2.0 and OIDC endpoints","priority order"]},{"as_of":null,"based_on":["t24_o3"],"kind":"claim","local_id":"t24_c1","object":"MCP clients and authorization servers","predicate":"SHOULD be provided by","stance":"qualified","subject":"Client ID Metadata Documents support","text":"Client ID Metadata Documents support is recommended (SHOULD) for both MCP clients and authorization servers, not mandated."},{"as_of":null,"based_on":["t24_o4"],"kind":"claim","local_id":"t24_c2","object":"OAuth Client ID Metadata Document draft","predicate":"MUST follow requirements of","stance":"reported","subject":"Client ID Metadata Documents implementations","text":"Implementations that do support Client ID Metadata Documents MUST follow the IETF draft's requirements, so the draft is normative for adopters."},{"as_of":null,"based_on":["t24_o5"],"kind":"claim","local_id":"t24_c4","object":"clients","predicate":"MAY be used by","stance":"qualified","subject":"private_key_jwt client authentication","text":"Clients MAY use private_key_jwt for client authentication with appropriate JWKS configuration; this is optional, not required."},{"based_on":["t24_o3","t24_o4"],"falsifier":"A statement pinning the draft as stable, or a later revision adopting the final RFC without change.","kind":"hypothesis","local_id":"t24_h1","text":"The Client ID Metadata Documents mechanism rests on an IETF draft (-00), so its requirements are provisional and may be qualified once the draft is finalized."}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",9360,14801]],"topic":null}},"engine_root":"7ad60d64fb6adbe991ac174e0108ab14e2d607259f8ce94033d875709f6c4520","outcome":{"kind":"records","result":{"accepted":["b2f0cd7dcb660ee9e44f6e12a9e9893f5a2520f8949c19e0f4f14a316d663207","8aef1506233f6b990313248252e5e60eb4de5f1b10767bf1f3136d6ab8fa1dd0","3433e6c418eb9338219272720dd6394383a55c73b3efe0418bf35b1aeb9d388a","9e2fb2832b4e58c7c2bc51327d5a62a0a95cef4c8ad759111f17a6331ccb4f56","60edc32bf347a1f45370458be1b7eed628297e8b865d2c51d79bb4dabe211e0a","9b4d8d3dad1824e8eb73e884e686bcdc8fb3c99ae1891460d2a864c6def362db","d8db4db8b1b58dc00f757e3a23b123e31cf5a2c8cc9c5d3497669a1e7b621838","5262fdbaace4d6205e848eb7aad8d8313a3a93625ef8036d3862e9983bbed27d"],"error":null,"failed_index":null}},"request_hash":"4dff69f5964752eb968378f55a0bd4f221e188bc2d486fe29059a08c45168a18","submission_id":"TR24-3094d58082e7de24#2"},"hash":"713cdeebd7ef3e91d3123eddfb2cda5143f5343f3de42c5d41ea09e2ed34d8f2","header":{"body_hash":"85f7b466d69e1b7b75f4bcf9c9dbb2dad5874aa896fcec2c483f028e45c0405e","format":"sbgk-session-log/3","previous":"8b0a8ce804c2956bd88ab065d50177e29e316116c889f491693d13d1d323d6eb","records_root":"48f2f5b32965a07a0de89eeb8005b5b98ba1900236a9a54f606a6cabbe8565fa","seq":98,"wal_op":"audit"}}
