{"body":{"actor":"w2","audit_root":"32caab4c61cde842ef923b5968d221e9dcf3faa43c6479c8ad7b75c2b57f61ed","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T65-60bf7e6b6afb2840","kind":"submit","lines":[{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"For public clients, authorization servers **MUST** rotate refresh tokens as described in [OAuth 2.1 Section 4.3.1 \"Token Endpoint Extension\"](https://datatracker.ietf.org/doc/html/draft-ietf-oauth-v2-1-13#section-4.3.1).","kind":"observe","local_id":"t65_o8","terms":["refresh token rotation for public clients"]},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"To mitigate this, MCP clients **MUST** implement PKCE according to [OAuth 2.1 Section 7.5.2](https://datatracker.ietf.org/doc/html/draft-ietf-oauth-v2-1-13#section-7.5.2).","kind":"observe","local_id":"t65_o9","terms":["PKCE requirement for clients"]},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"MCP clients **MUST** include the `resource` parameter in authorization and token requests as specified in the [Resource Parameter Implementation](#resource-parameter-implementation) section\n- MCP servers **MUST** validate that tokens presented to them were specifically issued for their use","kind":"observe","local_id":"t65_o12","terms":["resource parameter in authorization and token requests"]},{"as_of":null,"based_on":["t65_o8"],"kind":"claim","local_id":"t65_c1","object":"public clients","predicate":"is required for","stance":"qualified","subject":"refresh token rotation","text":"For public clients, authorization servers MUST rotate refresh tokens; the requirement is scoped to public clients rather than stated for all clients."},{"as_of":null,"based_on":["t65_o9"],"kind":"claim","local_id":"t65_c9","object":"PKCE","predicate":"MUST implement","stance":"reported","subject":"MCP clients PKCE","text":"MCP clients MUST implement PKCE according to OAuth 2.1 Section 7.5.2 to mitigate authorization code interception."},{"as_of":null,"based_on":["t65_o12"],"kind":"claim","local_id":"t65_c12","object":"resource parameter in authorization and token requests","predicate":"MUST include","stance":"reported","subject":"MCP clients resource parameter","text":"MCP clients MUST include the resource parameter in authorization and token requests, as specified in the linked Resource Parameter Implementation section."},{"based_on":["t65_o8"],"falsifier":"A later revision stating refresh token rotation as a MUST for all clients, or removing the public-client qualifier, without other change.","kind":"hypothesis","local_id":"t65_h1","text":"The public-client scope of the refresh token rotation MUST may be broadened or restated for all clients in later revisions of this section."}],"scope":{"docs":["d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546"],"ranges":[["d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546",11199,16376]],"topic":null}},"engine_root":"2e10a4f515b00d944bbcaf8bed8754e1ba834ca68a2d7ad4752c12dad51cf433","outcome":{"kind":"records","result":{"accepted":["2690499b4d1b2ffa775def3068f49c9de3