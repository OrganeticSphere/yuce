,{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"header requirements for\nnotification POSTs are not defined by this revision.","kind":"observe","local_id":"t27_o5","terms":["notification POST header requirements","undefined"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"This revision of the core protocol defines no client-to-server\n_notifications_ over Streamable HTTP.","kind":"observe","local_id":"t27_o6","terms":["client-to-server notifications","streamable HTTP"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"Streamable HTTP, closing the SSE response stream is itself the cancellation\nsignal and no `notifications/cancelled` message is expected","kind":"observe","local_id":"t27_o7","terms":["cancellation signal","notifications/cancelled"]},{"as_of":20260728,"based_on":["t27_o1","t27_o2"],"kind":"claim","local_id":"t27_c1","object":"revision 2026-07-28","predicate":"was removed in","stance":"superseded","subject":"GET stream endpoint","text":"The GET stream endpoint for Streamable HTTP was removed in revision 2026-07-28, superseding earlier endpoint behavior."},{"as_of":20260728,"based_on":["t27_o1","t27_o3"],"kind":"claim","local_id":"t27_c2","object":"revision 2026-07-28","predicate":"were removed in","stance":"superseded","subject":"protocol-level sessions","text":"Protocol-level sessions were removed from Streamable HTTP in revision 2026-07-28, superseding prior session-handling behavior."},{"as_of":null,"based_on":["t27_o4"],"kind":"claim","local_id":"t27_c3","object":"servers","predicate":"SHOULD be implemented by","stance":"qualified","subject":"proper authentication for all connections","text":"Implementing proper authentication for all connections is qualified as a recommendation (SHOULD) rather than a mandatory requirement."},{"as_of":20260728,"based_on":["t27_o5"],"kind":"claim","local_id":"t27_c4","object":"core protocol revision 2026-07-28","predicate":"are not defined by","stance":"open","subject":"header requirements for notification POSTs","text":"Header requirements for client-to-server notification POST requests are not defined in revision 2026-07-28 and remain an open specification item."},{"as_of":20260728,"based_on":["t27_o6"],"kind":"claim","local_id":"t27_c5","object":"this revision of the core protocol","predicate":"are not defined by","stance":"open","subject":"client-to-server notifications over Streamable HTTP","text":"The core protocol defines no client-to-server notifications over Streamable HTTP, leaving notification POST mechanics largely unused in this revision."},{"as_of":null,"based_on":["t27_o7"],"kind":"claim","local_id":"t27_c6","object":"Streamable HTTP transport","predicate":"is not expected on","stance":"qualified","subject":"notifications/cancelled message","text":"On Streamable HTTP, closing the SSE response stream is the cancellation signal, qualifying that no notifications/cancelled message is expected."},{"about":["notification POST header requirements"],"kind":"question","local_id":"t27_q1","needed":"check later protocol revisions or RFC updates","text":"Will future protocol revisions specify request metadata header requirements for notification POST messages?"},{"about":["removal of protocol-level sessions"],"kind":"question","local_id":"t27_q2","needed":"check backward compatibility section and changelog","text":"How are clients expected to achieve state persistence or resumability following the removal of protocol-level sessions?"}],"scope":{"docs":["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530"],"ranges":[["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530",0,4380]],"topic":null}},"engine_root":"8d0657c62e3343d8a900b0995719a93def44548f5056c1c7c33318fc8da4e4eb","outcome":{"kind":"records","result":{"accepted":["ec5e86c97fa84855f485575817ab0b53afa5956c06eda9a912d91b499f82b039","ede270bd8b92a4ab59e