{"body":{"actor":"w3","audit_root":"58cdecab2e0d16595a39fb50d06b3e3f49ff25087bcf9c43acff913ad3e3a4d7","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T47-26b08c37dd389cf8","kind":"submit","lines":[{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"The initialization phase **MUST** be the first interaction between client and server.","kind":"observe","local_id":"t47_o1","terms":["initialization ordering"]},{"as_of":null,"based_on":["t47_o1"],"kind":"claim","local_id":"t47_c1","object":"the first interaction between client and server","predicate":"MUST be","stance":"reported","subject":"initialization phase","text":"Initialization must be the first client-server interaction."},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"The client **MUST** initiate this phase by sending an `initialize` request containing:","kind":"observe","local_id":"t47_o2","terms":["client initialization request"]},{"as_of":null,"based_on":["t47_o2"],"kind":"claim","local_id":"t47_c2","object":"an initialize request","predicate":"MUST initiate initialization by sending","stance":"reported","subject":"client","text":"The client must initiate initialization by sending an initialize request."},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"After successful initialization, the client **MUST** send an `initialized` notification","kind":"observe","local_id":"t47_o3","terms":["initialized notification"]},{"as_of":null,"based_on":["t47_o3"],"kind":"claim","local_id":"t47_c3","object":"an initialized notification after successful initialization","predicate":"MUST send","stance":"reported","subject":"client","text":"After successful initialization, the client must send an initialized notification before normal operations."},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"The client **SHOULD NOT** send requests other than\n  [pings](/specification/2025-06-18/basic/utilities/ping) before the server has responded to the\n  `initialize` request.","kind":"observe","local_id":"t47_o4","terms":["pre-initialization client requests"]},{"as_of":null,"based_on":["t47_o4"],"kind":"claim","local_id":"t47_c4","object":"pings","predicate":"SHOULD NOT include requests other than","stance":"qualified","subject":"client requests before initialize response","text":"Before the server responds to initialize, the client should not send requests other than pings."},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"The server **SHOULD NOT** send requests other than\n  [pings](/specification/2025-06-18/basic/utilities/ping) and\n  [logging](/specification/2025-06-18/server/utilities/logging) before receiving the `initialized`\n  notification.","kind":"observe","local_id":"t47_o5","terms":["pre-initialization server requests"]},{"as_of":null,"based_on":["t47_o5"],"kind":"claim","local_id":"t47_c5","object":"pings and logging","predicate":"SHOULD NOT include requests other than","stance":"qualified","subject":"server requests before initialized notification","text":"Before receiving initialized, the server should not send requests other than pings and logging."},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"This **SHOULD** be the _latest_ version supported by the client.","kind":"observe","local_id":"t47_o6","terms":["client version selection"]},{"as_of":null,"based_on":["t47_o6"],"kind":"claim","local_id":"t47_c6","object":"the latest version supported by the client","predicate":"SHOULD be","stance":"qualified","subject":"client protocol version","text":"The client should send the latest protocol version it supports in initialize."},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"If the client does not support the version in the server's response, it **SHOULD**\ndisconnect.","kind":"observe","local_id":"t47_o8","terms":["unsupported negotiated version"]},{"as_of":null,"based_on":["t47_o8"],"kind":"claim","local_id":"t47_c8","object":"disconnect when it does not support the server response version","predicate":"SHOULD","stance":"qualified","subject":"client","text":"If the client does not support the server's selected version, it should disconnect."},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"If using HTTP, the client **MUST** include the `MCP-Protocol-Version:\n<protocol-version>` HTTP header on all subsequent requests to the MCP\nserver.","kind":"observe","local_id":"t47_o9","terms":["HTTP protocol version header"]},{"as_of":null,"based_on":["t47_o9"],"kind":"claim","local_id":"t47_c9","object":"the MCP-Protocol-Version header on all subsequent requests","predicate":"MUST include","stance":"reported","subject":"HTTP client requests","text":"For HTTP, the client must include the MCP-Protocol-Version header on all subsequent MCP server requests."},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"Client and server capabilities establish which optional protocol features will be\navailable during the session.","kind":"observe","local_id":"t47_o10","terms":["capability negotiation","optional features"]},{"as_of":null,"based_on":["t47_o10"],"kind":"claim","local_id":"t47_c10","object":"which optional protocol features are available during the session","predicate":"establish","stance":"reported","subject":"client and server capabilities","text":"Negotiated client and server capabilities determine which optional protocol features are available during a session."},{"doc_id":"d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d","exact_quote":"Both parties **MUST**:\n\n- Respect the negotiated protocol version\n- Only use capabilities that were successfully negotiated","kind":"observe","local_id":"t47_o11","terms":["operation constraints","negotiated capabilities"]},{"as_of":null,"based_on":["t47_o11"],"kind":"claim","local_id":"t47_c11","object":"respect the negotiated version and use only successfully negotiated capabilities","predicate":"MUST","stance":"reported","subject":"client and server during operation","text":"During operation, both parties must respect the negotiated version and use only successfully negotiated capabilities."}],"scope":{"docs":["d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d"],"ranges":[["d_487ca4ef224fdb205202f2d1e490f283ebe2344493a1f4c00e2cc952de5a677d",0,5981]],"topic":null}},"engine_root":"e7f2ecc18a3e8f3130914cdc2c5c0f0723689d8b0e7cb252efeef348f3bd103c","outcome":{"kind":"records","result":{"accepted":["31bb4dccebbddfa3fc3f28ecad0766e7aa50b6587865467b81a7565c3baf39f7","aed2531bcb9f13486e4b0fda74ea0dd3b405898051d0841efbf193077c6bda9b","ff0e121d88b61947d388a86cac21e3d6fbe4aed57c1d65af7a5596f5c7446f0b","4f492bfe50637ff7daade80f03020aac3c601e9090abeaecbea990c4be26e43d","f146acdb77082974a6afb8ec1a242ce1029fb857900d586f07b547b9cea83b63","aee4e3d8254fba060e45171c6fb6c291a28e6fd3cbae7987a12ce74365e57834","351a9f1fb36e39aa7f3d9fb67994de465677a669e4617f1c5b357e4a37948ef1","