{"body":{"actor":"w2","audit_root":"9bc1c3038f27a1246b4d0a0555e2fbd4862f9502d48c9bb84f9f5d8f3bfb89e8","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"TR41-6364894ba7058df3","kind":"submit","lines":[{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"There is no negotiation handshake. Every request carries its protocol","kind":"observe","local_id":"t41_o1","terms":["no handshake; version declared per request"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"capabilities as per-request metadata (revision `2026-07-28` and later).","kind":"observe","local_id":"t41_o4","terms":["modern versions start at revision 2026-07-28"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"The client **SHOULD** select a mutually supported version from the `supported`","kind":"observe","local_id":"t41_o7","terms":["client response to unsupported version error"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"**MAY** call it before sending any other requests to learn the server's","kind":"observe","local_id":"t41_o8","terms":["server/discover optional for clients"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"Servers **MUST** implement","kind":"observe","local_id":"t41_o9","terms":["server/discover mandatory for servers"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"Extension identifiers\n**MUST** follow the [`_meta` key naming rules](/specification/2026-07-28/basic/index#meta),","kind":"observe","local_id":"t41_o10","terms":["extension identifier naming"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"Extensions **SHOULD** document their expected\nfallback behavior.","kind":"observe","local_id":"t41_o12","terms":["extension fallback documentation"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"attempt a modern request and inspect the body of a `400 Bad Request`","kind":"observe","local_id":"t41_o14","terms":["Streamable HTTP era detection via 400 body"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"Clients **SHOULD** cache the result for the lifetime of the server","kind":"observe","local_id":"t41_o15","terms":["caching of era determination"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"A server that supports only [modern](#terminology) versions **SHOULD** name","kind":"observe","local_id":"t41_o17","terms":["modern-only server error to initialize requests"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"the protocol versions it supports in any error it returns to an `initialize`","kind":"observe","local_id":"t41_o18","terms":["diagnostic content of initialize errors"]},{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","exact_quote":"The era determination is a property of the server, not of an individual","kind":"observe","local_id":"t41_o19","terms":["era is per server, not per request"]},{"as_of":null,"based_on":["t41_o9","t41_o8"],"kind":"claim","local_id":"t41_c4","object":"servers and clients","predicate":"MUST be implemented by servers; MAY be called by clients","stance":"reported","subject":"server/discover","text":"Servers MUST implement server/discover, while clients MAY call it before other requests and are not required to."},{"as_of":null,"based_on":["t41_o10"],"kind":"claim","local_id":"t41_c5","object":"_meta key naming rules with a mandatory prefix","predicate":"MUST follow","stance":"reported","subject":"extension identifiers","text":"Extension identifiers MUST follow the _meta key naming rules and carry a mandatory prefix."},{"as_of":null,"based_on":["t41_o12"],"kind":"claim","local_id":"t41_c7","object":"expected fallback behavior","predicate":"SHOULD document","stance":"reported","subject":"extensions","text":"Extensions SHOULD document their expected fallback behavior."},{"as_of":null,"based_on":["t41_o17","t41_o18"],"kind":"claim","local_id":"t41_c10","object":"any error returned to initialize","predicate":"SHOULD name supported protocol versions","stance":"reported","subject":"modern-only server errors to initialize requests","text":"A server supporting only modern versions SHOULD name its supported protocol versions in any error returned to an initialize request, on any transport."},{"about":["stdio backward compatibility","server/discover probe"],"kind":"question","local_id":"t41_q1","needed":"Check the linked stdio transport page section 'backward-compatibility' for probe error classification.","text":"Does the stdio backward-compatibility page define the exact probe failure cases and the meaning of 'any error that is not a recognized modern error'?"},{"about":["Streamable HTTP backward compatibility","UnsupportedProtocolVersionError schema"],"kind":"question","local_id":"t41_q2","needed":"Check the linked Streamable HTTP transport page and the schema page for the 400 response body and error data structure.","text":"Do the linked Streamable HTTP backward-compatibility and schema pages define the body format of a 400 Bad Request and the UnsupportedProtocolVersionError data fields?"}],"scope":{"docs":["d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa"],"ranges":[["d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa",0,5784]],"topic":null}},"engine_root":"11b3df4064c2885ff1a809f97206734e178dd5fb0f6aeb430dccad3cc64b8b40","outcome":{"kind":"records","result":{"accepted":["9b58f70763501ac1c8db4903014123d47d169a2d896ef26c7fc0d10c53d0a377","87e822c21b11289bb370a232696b005e8505b65ebecd2be6e603f0089d96b030","44504df799b2f46aee46426800a962ddbec30293179ec76252fec1ce8fe8d85a","8d535f912cf48ebb1509057ad96815774a6ae3f53bafded6ee303beb0bd1df20","b541f74ef1ce0ad1b01b7c4fe71b392deec530d8b1a06ca9303d34baa1d0c5b2","cdf16b177aeab3486309c2c098711fca94b65ca476ddb5f41585075329d9e6cf","57b53a51c5f67e3978ba86187b7834fb4e5ca6a2f85b000b49e0bf6f13963bfd","d88c90cbd08023f6fcb9a5e97eb50a4b67d57c40e0a2587d3f63d25f05c6606a","48c3c998052f6efc2de7e2fc68f478e35869c09e7c6b579219b774860783f8ac","76078ff6f8582b4f661252057e9dcad49082fda1d5d109304e9282d1d680b716","60bbcbaf317cf4d0208fceb59a58e17cc6a297dca417efc2cf9cab1f8be56094","a8e1d62ba9c873f47b44e06c7684cd0bed6e66f60f17624188c1342e9708e3f5","1b2f5d74748e57616e39e8f38a49463883665a2ba0603a950729b7218a6ffd50","18081feda3a4de6d5356a01cfe35502ecfd7f682f537fb9d6a22316ed1576515","5bce09e2446b45feed67377fa37cdb843742efc099e5b9be8cef3e63eecd2be1","0901b8424679c9b9ad1264eaf7f8f08ba8ee355cfc3e678522de94a71843db60","bc3c9768679990473004f676a17ed181d82ca2cc559f166d01ea3fd759274bcd","2a22f1dbe001915d0cdf6fdf49507aa3120f075d88abd7f4890548dc60601e12"],"error":null,"failed_index":null}},"request_hash":"1533a9f9c1e544f0175349b83899c706c940b41a8bb0b30e25b4d31bdf2c7fc7","submission_id":"TR41-6364894ba7058df3#1"},"hash":"d6004aa1b6c4553127a6f2ba8ce944d1915006dc46c415e259e7dc605364e671","header