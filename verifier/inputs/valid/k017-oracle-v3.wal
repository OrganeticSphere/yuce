{"body":{"actor":"kernel","audit_root":"0a9501a88805295ee0f8da4f28348058ce7fd90247c1947a4f4e8fe6d0a918f5","command":{"checkpoint":{"context":{"accepted":["@58499b816234d287","@8054810094b905fb","@fc4674d6e47bda61","@da3ad2c9b3be8697","@4b288f446491a2f5","@b68137950a21ff2f","@7da05ca2c6110f14","@c5b43e232a098f41","@4e1e385494199195","@5fa67ff5f45ecf7c","@aa9f2e061ad3e4b3","@21266513c1f7331d","@2d4ba48e84670865","@e53c2bb79e9018f6","@598c237042b43d1c","@fd190c47d82de619","@71b93ca601fe3fec","@78696876cf3e95f6","@651353cb700508b0","@45f404008e976301","@72180f753baa1afd","@80ba9845f5ce4242","@4b91b94cd2f8f99a","@bf42a0e96c0c39f7"],"attempt":1,"excluded":[{"index":22,"local_id":"t56_c8","rests_on":"t56_o8"},{"index":25,"local_id":"t56_c11","rests_on":"t56_o13"},{"index":26,"local_id":"t56_c12","rests_on":"t56_o14"}],"kind":"EXTEND","refused":[{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"- The server **SHOULD NOT** close the SSE stream before sending a JSON-RPC _response_\n     per each received JSON-RPC _request_, unless the [session](#session-management)","negation_before":"- The server **SHOULD NOT** close the SSE stream before sending a JSON-RPC _response_","rule":"negation_before","suggested_exact_quote":"- The server **SHOULD NOT** close the SSE stream before sending a JSON-RPC _response_\n     per each received JSON-RPC _request_, unless the [session](#session-management)","suggested_span":{"doc_id":"d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b","end_byte":5294,"start_byte":5124}},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":7,"local_id":"t56_o8"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"The server **MUST** provide a single HTTP endpoint path (hereafter referred to as the\n**MCP endpoint**) that supports both POST and GET methods.","rule":"ends_mid_clause","suggested_exact_quote":"The server **MUST** provide a single HTTP endpoint path (hereafter referred to as the\n**MCP endpoint**) that supports both POST and GET methods.","suggested_span":{"doc_id":"d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b","end_byte":2597,"start_byte":2453},"trailing_word":"the"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":11,"local_id":"t56_o13"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"The client **MUST** include an `Accept` header, listing both `application/json` and\n   `text/event-stream` as supported content types.","rule":"ends_mid_clause","suggested_exact_quote":"The client **MUST** include an `Accept` header, listing both `application/json` and\n   `text/event-stream` as supported content types.","suggested_span":{"doc_id":"d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b","end_byte":3520,"start_byte":3386},"trailing_word":"and"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":12,"local_id":"t56_o14"},{"error":{"code":"NO_EVIDENCE","expected_by_kernel":{"missing_identifiers":["8599201b"]},"field":"based_on","message":"a claim names only identifiers its quotes hold: add a quote of this section that holds each one listed, or leave it out of the claim","obligation":null,"status":"error"},"index":18,"local_id":"t56_c4"}],"task_id":"T56-eeff61a849775e7a","work_key":"doc:d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b#0"},"from":0,"key":"task-repair:T56-eeff61a849775e7a:1","to":0},"kind":"batch","operations":[]},"engine_root":"ade10c2303c87733064effadb5b42d9128ee85fca39a2b545d0aa12a5248a203","outcome":{"kind":"value","result":{"accepted_operations":0,"checkpointed":true,"error":null,"failed_index":null,"results":[]}},"request_hash":"9dea5ec875b7f93f1d6b75426898f284f09e4f4abbf45007bf5bc6dfb1e77931","submission_id":"T56-eeff61a849775e7a#repair1"},"hash":"b415a82c32ab38fdc5084cf14efeaa1e85a3417ccc05c24ac0ce0bf7a1bb9da8","header":{"body_hash":"a490f11359eda12fd5f291404c6caafcc9d401f80ca964cf36e03699f3a5381d","format":"sbgk-session-log/3","previous":"3148ce2c94b1c55700663948ff4de1f5745c1c0bfb9a890a2f6a3a3ebb0d1b33","records_root":"fe7c90ca2214e168f5ffe6cccb15729c3b8a03c403e48c406441cd589fdd8c41","seq":283,"wal_op":"audit"}}
{"body":{"actor":"w2","audit_root":"2343968cd48c6c898df663274219b21776874cca8c93beb0256e70338aa2dc03","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T56-eeff61a849775e7a","kind":"submit","lines":[{"doc_id":"d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b","exact_quote":"- The server **SHOULD NOT** close the SSE stream before sending a JSON-RPC _response_\n     per each received JSON-RPC _request_, unless the [session](#session-management)","kind":"observe","local_id":"t56_o8","terms":["session expiry as exception to stream staying open","session management referenced, not defined here"]},{"doc_id":"d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b","exact_quote":"The server **MUST** provide a single HTTP endpoint path (hereafter referred to as the\n**MCP endpoint**) that supports both POST and GET methods.","kind":"observe","local_id":"t56_o13","terms":["single MCP endpoint supporting POST and GET"]},{"doc_id":"d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b","exact_quote":"The client **MUST** include an `Accept` header, listing both `application/json` and\n   `text/event-stream` as supported content types.","kind":"observe","local_id":"t56_o14","terms":["client Accept header requirement"]},{"as_of":null,"based_on":["t56_o8"],"kind":"claim","local_id":"t56_c8","object":"session expiry","predicate":"is referenced as ending SSE stream obligation","stance":"open","subject":"session management","text":"Session expiry is an exception to keeping the SSE stream open, but session management is only linked here and not defined in this section."},{"as_of":null,"based_on":["t56_o13","t56_o11"],"kind":"claim","local_id":"t56_c11","object":"POST and GET methods","predicate":"MUST provide single path supporting","stance":"reported","subject":"MCP endpoint","text":"Streamable HTTP has one MCP endpoint that MUST support POST and GET; the transport uses HTTP POST and GET requests."},{"as_of":null,"based_on":["t56_o14"],"kind":"claim","local_id":"t56_c12","object":"application/json and text/event-stream","predicate":"MUST include","stance":"reported","subject":"client Accept header","text":"Clients MUST include an Accept header listing both application/json and text/event-stream on every POST."}],"scope":{"docs":["d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b"],"ranges":[["d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b",0,5820]],"topic":null}},"engine_root":"cbc80f95f360afb550274e49ef08373ca5483c4be5f761b0d8974791a25d9228","outcome":{"kind":"records","result":{"accepted":["90168d1d0a66763c780f2b110eb3c6051c2c6a0cef41e3ff1ac410a91cf3777a","3cbf2955de5346ce23b108833948c7c9d48eff090bd1e9fd2e7439b77b666c5c","4dddbfbb3648d64459344dc8ebedc9b998bdcccc9fc3fb360db989e3cb9c292f","0a5fd67794c0828af8f1002cd51055b0c4cff5332aef811cb9df6a1ff29ba84d","b59124aa76765643f2c6bf14d5a48625f9ddcd83c60e7988f5ee816acbfa7f1e","69c08f0b251ea4f17f52118b5180a047f191152e4a9307bd38638862d855c737"],"error":null,"failed_index":null}},"request_hash":"d50b2b6f709069cd2093e0494524df79f5db0a4d2cd828d656010a5b9d5172e1","submission_id":"T56-eeff61a849775e7a#2"},"hash":"3bc969dd49c086dfd8b1c76f513cb6a0f07504b645f69a789f026fa76c73db03","header":{"body_hash":"8076adaed4f569386301838ec46822ce34fd679cd6607131adcb93ff7d60252d","format":"sbgk-session-log/3","previous":"b415a82c32ab38fdc5084cf14efeaa1e85a3417ccc05c24ac0ce0bf7a1bb9da8","records_root":"bdc4b952cea1c52c623203690e158008a011b5e3b36960ec762e7f5b903f11d9","seq":284,"wal_op":"audit"}}
{"body":{"actor":"w2","audit_root":"caea0f6c988434b9e3a108e0760f7bec8a40a6f3f361f7869834b1c42343c784","command":{"checkpoint":{"context":{"abandoned":false,"agent":"w2","circle":10,"circle_phase":"READ","kind":"EXTEND","link_task":null,"offered":31,"refusals":1,"stored":30,"sync_step":19,"task_id":"T56-eeff61a849775e7a"},"from":0,"key":"task:doc:d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b#0","to":0},"kind":"batch","operations":[]},"engine_root":"cbc80f95f360afb550274e49ef08373ca5483c4be5f761b0d8974791a25d9228","outcome":{"kind":"value","result":{"accepted_operations":0,"checkpointed":true,"error":null,"failed_index":null,"results":[]}},"request_hash":"d40e1a0994f0c9be2d3533dda3819f51f4421d6405e83bd92777456629196d37","submission_id":"T56-eeff61a849775e7a#done3"},"hash":"24d002931eabc93e07c41778c84e01da3ecbf0893e9c1e2029c331e3d785c5b6","header":{"body_hash":"e66e0942624d956da7b541e09148940c194dc6467009077431af9a9b1b649893","format":"sbgk-session-log/3","previous":"3bc969dd49c086dfd8b1c76f513cb6a0f07504b645f69a789f026fa76c73db03","records_root":"fe7c90ca2214e168f5ffe6cccb15729c3b8a03c403e48c406441cd589fdd8c41","seq":285,"wal_op":"audit"}}
{"body":{"actor":"w3","audit_root":"23738e60a706defd27dd6d2a4ffe142000d8db4b662fd491a5a59b165037ddf4","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T58-e284ecf0d880404f","kind":"submit","lines":[{"doc_id":"d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b","exact_quote":"The client **MAY** issue an HTTP GET to the MCP endpoint.","kind":"observe","local_id":"t58_o1","terms":["client HTTP GET","SSE stream","optional capability"]},{"as_of":null,"based_on":["t58_o1"],"kind":"claim","local_id":"t58_c1","object":"to open an SSE stream","predicate":"MAY be issued","stance":"qualified","subject":"client HTTP GET to MCP endpoint","text":"Opening an SSE stream through an HTTP GET is optional for the client."},{"doc_id":"d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b","exact_quote":"The server **MAY** send JSON-RPC _requests_ and _notifications_ on the stream. These","kind":"observe","local_id":"t58_o2","terms":["server SSE messages","JSON-RPC requests","JSON-RPC notifications"]},{"as_of":null,"based_on":["t58_o2"],"kind":"claim","local_id":"t58_c2","object":"JSON-RPC requests and notifications","predicate":"MAY carry","stance":"qualified","subject":"server-initiated SSE stream","text":"Server-initiated SSE streams may carry JSON-RPC requests and notifications, so this message path remains optional and scoped to those message types."},{"doc_id":"d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b","exact_quote":"The server **MUST NOT** send a JSON-RPC _response_ on the stream **unless**","kind":"observe","local_id":"t58_o3","terms":["SSE response restriction","JSON-RPC response","stream resumption"]},{"as_of":null,"based_on":["t58_o3"],"kind":"claim","local_id":"t58_c3","object":"resuming a stream associated with a previous client request","predicate":"MUST NOT be sent unless","stance":"qualified","subject":"JSON-RPC responses on SSE stream","text":"A server must not send JSON-RPC responses on an SSE stream except when resuming a stream associated with a previous client request."},{"doc_id":"d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b","exact_quote":"The client **MAY** remain connected to multiple SSE streams simultaneously.","kind":"observe","local_id":"t58_o4","terms":["multiple SSE streams","client connections","optional concurrency"]},{"as_of":null,"based_on":["t58_o4"],"kind":"claim","local_id":"t58_c4","object":"multiple SSE streams simultaneously","predicate":"MAY remain connected to","stance":"qualified","subject":"client SSE connections","text":"Clients may maintain multiple SSE streams simultaneously; the specification leaves this connection pattern optional."},{"doc_id":"d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b","exact_quote":"If the client wishes to resume after a broken connection, it **SHOULD** issue an HTTP","kind":"observe","local_id":"t58_o6","terms":["broken connection recovery","client resumption","Last-Event-ID"]},{"as_of":null,"based_on":["t58_o6"],"kind":"claim","local_id":"t58_c6","object":"HTTP GET with Last-Event-ID","predicate":"SHOULD issue","stance":"qualified","subject":"client resumption after broken connection","text":"After a broken connection, client resumption is recommended rather than mandatory, using an HTTP GET with Last-Event-ID."},{"doc_id":"d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b","exact_quote":"The server **MAY** use this header to replay messages that would have been sent","kind":"observe","local_id":"t58_o7","terms":["Last-Event-ID","message replay","server recovery behavior"]},{"as_of":null,"based_on":["t58_o7"],"kind":"claim","local_id":"t58_c7","object":"the header to replay messages","predicate":"MAY use","stance":"open","subject":"server replay after Last-Event-ID","text":"Using Last-Event-ID to replay missed messages is optional for the server, leaving replay behavior open."},{"doc_id":"d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b","exact_quote":"The server **MAY** terminate the session at any time, after which it **MUST** respond","kind":"observe","local_id":"t58_o9","terms":["session termination","HTTP 404","session lifecycle"]},{"as_of":null,"based_on":["t58_o9"],"kind":"claim","local_id":"t58_c9","object":"the server at any time","predicate":"MAY be terminated by","stance":"reported","subject":"MCP session","text":"Servers may terminate sessions at any time; subsequent requests using that session ID must receive HTTP 404 Not Found."},{"doc_id":"d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b","exact_quote":"Clients that no longer need a particular session (e.g., because the user is leaving\n   the client application) **SHOULD** send an HTTP DELETE","kind":"observe","local_id":"t58_o10","terms":["session cleanup","client termination","HTTP DELETE"]},{"as_of":null,"based_on":["t58_o10"],"kind":"claim","local_id":"t58_c10","object":"HTTP DELETE with Mcp-Session-Id","predicate":"SHOULD use","stance":"qualified","subject":"client session cleanup","text":"Client-initiated session cleanup is recommended through HTTP DELETE, but remains a SHOULD-level behavior; servers may reject it with HTTP 405."}],"scope":{"docs":["d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b"],"ranges":[["d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b",5820,11806]],"topic":null}},"engine_root":"d621a97280e138ec1ae784b5e15fbc50085c0846547869cad8591bef0489ad8a","outcome":{"kind":"records","result":{"accepted":["ac7cc434be1874a4db9e81fe3e88ebfb32344bd26c79544f9e44568faaebacb9","db6c6a6d37cc817ed14d93535100e6177b6a9d2a285e2647199ee1c97818355e","5ea0c0df1699357bb4be3800eb2400b84c966301d4b7e55de886db034d2677fe","9c6f9ce09e91bd2160f0f743becf0d23a299c9eca81c272183d79546e409a881","6768df1ccd89d036c13b9c03983e7b1ada59fd0a8deab261d778e45d4546fe19","45bad887e5e8c0a64869186d5041607f65cae4524ff1ed225cea8dd7822e0b64","e0208efb76a5c2688bd00e1418a7e05339d7d4bc174eee73b26e30cf828da98f","2ec15393fb40c6648b1f3a8fc46d79d6cc3bc8fa3910b3b34f55808171206534","56df4c752f85ac88bcbe342df247535d18a3a2d7a5cb37169af9453c176ea3bb","2dddb3d9720f75340bff317d0bbb7b7c9d1943ce81e3708bc9d8bf6c0584b23a","061513d49f21315796c5991d5c2ea4d0bbebe38e3acf0a9b193ba46efbe60f98","e9c223a7b25ea9f0963e0be7bbb712838c0aca1befc0e4399b3a5af0b3d2ed3a","317f6e77bad70165973b0177ed730b1a826cbf4bfb7a7503adf8e7d57e0074da","594a4b68bbc60d3bd2c9be10179de3ace225a66d1bdcfec895c975dfcab4779e","bd0a598af8a377a4b337e28bd6835664b82d91b1eb93e22196418c7e216fba43","5131007f4f610ee8cc61955d9f9cb9aa527a6f853c2ee5a6c45757c090654c0c"],"error":null,"failed_index":null}},"request_hash":"421267a94b6bbe24c98c925b54df370abcdcf36ff23a630fd1469cceafc7231e","submission_id":"T58-e284ecf0d880404f#1"},"hash":"26093dec21ebd54bcaac22b418919c71ad79b4345dafc89d775438e5dd104e6f","header":{"body_hash":"514c392399056f7c4d828ca29cb80f98983e71e0813b726b45f386399618193b","format":"sbgk-session-log/3","previous":"24d002931eabc93e07c41778c84e01da3ecbf0893e9c1e2029c331e3d785c5b6","records_root":"c7aa0a7edc0b674ad3ebde2d8af2931d02bd554f00394f156178292e32cafa27","seq":286,"wal_op":"audit"}}
{"body":{"actor":"kernel","audit_root":"a63fac6f5f7cc34096d7c068a946d1d9079b68313da283c2f2cbddc7e1e9add4","command":{"checkpoint":{"context":{"accepted":["@ac7cc434be1874a4","@db6c6a6d37cc817e","@5ea0c0df1699357b","@9c6f9ce09e91bd21","@6768df1ccd89d036","@45bad887e5e8c0a6","@e0208efb76a5c268","@2ec15393fb40c664","@56df4c752f85ac88","@2dddb3d9720f7534","@061513d49f213157","@e9c223a7b25ea9f0","@317f6e77bad70165","@594a4b68bbc60d3b","@bd0a598af8a377a4","@5131007f4f610ee8"],"attempt":1,"excluded":[{"index":9,"local_id":"t58_c5","rests_on":"t58_o5"},{"index":15,"local_id":"t58_c8","rests_on":"t58_o8"}],"kind":"EXTEND","refused":[{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"Servers **MAY** attach an `id` field to their SSE events, as described in the\n   [SSE standard](https://html.spec.whatwg.org/multipage/server-sent-events.html#event-stream-interpretation).","rule":"ends_mid_clause","suggested_exact_quote":"Servers **MAY** attach an `id` field to their SSE events, as described in the\n   [SSE standard](https://html.spec.whatwg.org/multipage/server-sent-events.html#event-stream-interpretation).","suggested_span":{"doc_id":"d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b","end_byte":7787,"start_byte":7599},"trailing_word":"the"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":8,"local_id":"t58_o5"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"A server using the Streamable HTTP transport **MAY** assign a session ID at\n   initialization time, by including it in an `Mcp-Session-Id` header on the HTTP\n   response containing the `InitializeResult`.","rule":"ends_mid_clause","suggested_exact_quote":"A server using the Streamable HTTP transport **MAY** assign a session ID at\n   initialization time, by including it in an `Mcp-Session-Id` header on the HTTP\n   response containing the `InitializeResult`.","suggested_span":{"doc_id":"d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b","end_byte":9204,"start_byte":9000},"trailing_word":"at"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":14,"local_id":"t58_o8"}],"task_id":"T58-e284ecf0d880404f","work_key":"doc:d_4bc9c307374945cef1fa7bdb9143f1965e53a345ab1ed3bf2b06f2510e14915b#1"},"from":0,"key":"task-repair:T58-e284ecf0d880404f:1","to":0},"kind":"batch","operations":[]},"engine_root":"d621a97280e138ec1ae784b5e15fbc50085c0846547869cad8591bef0489ad8a","outcome":{"kind":"value","result":{"accepted_operations":0,"checkpointed":true,"error":null,"failed_index":null,"results":[]}},"request_hash":"7cf14daa74293983ca93bf54d57b1ad746a14eeb3326920c06cd6d02233329e1","submission_id":"T58-e284ecf0d880404f#repair1"},"hash":"5497cbbb8c09528b8773c061333f5fb72b139522ed1029b78df1fd2e15ee1b8a","header":{"body_hash":"e5d97be32474383e18513d933f0f8e44cd5b755833343c66d345e384507d75a0","format":"sbgk-session-log/3","previous":"26093dec21ebd54bcaac22b418919c71ad79b4345dafc89d775438e5dd104e6f","records_root":"fe7c90ca2214e168f5ffe6cccb15729c3b8a03c403e48c406441cd589fdd8c41","seq":287,"wal_op":"audit"}}
