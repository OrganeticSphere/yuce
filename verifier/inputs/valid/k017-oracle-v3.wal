{"body":{"actor":"w1","audit_root":"4448dec2d7fd513ee674fa28c3700d4dad2cae55f6bf1674eb4737f4be5b6168","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"TR34-1196e86d0de711de","kind":"submit","lines":[{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"`io.modelcontextprotocol/protocolVersion` field carried in the request body's","kind":"observe","local_id":"t34_o2","terms":["header-body version match","_meta protocolVersion"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"with `404 Not Found` and a JSON-RPC error with code `-32601`","kind":"observe","local_id":"t34_o5","terms":["unknown method","404 Method not found"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"These headers are **REQUIRED** for compliance.","kind":"observe","local_id":"t34_o7","terms":["Mcp-Method","Mcp-Name","required request headers"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"HTTP headers using an `x-mcp-header` extension property in the parameter's","kind":"observe","local_id":"t34_o9","terms":["x-mcp-header","custom headers from tool parameters"]},{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","exact_quote":"While the use of `x-mcp-header` is optional for servers, clients **MUST**","kind":"observe","local_id":"t34_o10","terms":["asymmetric obligation","server optional client mandatory"]},{"as_of":null,"based_on":["t34_o2"],"kind":"claim","local_id":"t34_c2","object":"io.modelcontextprotocol/protocolVersion in body _meta","predicate":"MUST match","stance":"reported","subject":"MCP-Protocol-Version header value","text":"The MCP-Protocol-Version header value MUST match the io.modelcontextprotocol/protocolVersion field in the request body's _meta."},{"as_of":null,"based_on":["t34_o5"],"kind":"claim","local_id":"t34_c5","object":"404 Not Found with JSON-RPC code -32601","predicate":"MUST receive","stance":"reported","subject":"unimplemented RPC method","text":"If the server does not implement the requested RPC method it MUST respond 404 Not Found with JSON-RPC error code -32601 (Method not found)."},{"as_of":null,"based_on":["t34_o7"],"kind":"claim","local_id":"t34_c7","object":"all requests / tools/call, resources/read, prompts/get","predicate":"are REQUIRED for compliance","stance":"reported","subject":"Mcp-Method and Mcp-Name headers","text":"Mcp-Method (from method) is required for all requests and Mcp-Name (from params.name or params.uri) for tools/call, resources/read and prompts/get; these headers are REQUIRED for compliance."},{"as_of":null,"based_on":["t34_o9"],"kind":"claim","local_id":"t34_c9","object":"x-mcp-header extension property in inputSchema","predicate":"MAY be designated by servers via","stance":"qualified","subject":"tool parameters mirrored into HTTP headers","text":"Servers MAY designate tool parameters to be mirrored into HTTP headers via an x-mcp-header extension property in the parameter's inputSchema."},{"as_of":null,"based_on":["t34_o10"],"kind":"claim","local_id":"t34_c10","object":"clients","predicate":"is optional for servers but MUST be supported by","stance":"qualified","subject":"x-mcp-header support","text":"Use of x-mcp-header is optional for servers, but clients MUST support the feature and MUST mirror designated parameter values into HTTP headers."},{"based_on":["t34_o9","t34_o10"],"falsifier":"A later revision making x-mcp-header mandatory for servers or optional for clients without change.","kind":"hypothesis","local_id":"t34_h2","text":"The x-mcp-header mechanism is an open extension point: server-side optionality plus mandatory client mirroring may be tightened or qualified in later revisions."},{"about":["Server Validation","headerless request rejection"],"kind":"question","local_id":"t34_q1","needed":"Read the Server Validation section of this document and compare its rules with the MAY/MUST split here.","text":"Does the referenced Server Validation section define the rejection behavior for headerless requests when legacy clients are unsupported?"},{"about":["x-mcp-header","Tool Definitions"],"kind":"question","local_id":"t34_q2","needed":"Read the server/tools#x-mcp-header section and check for constraints not stated here.","text":"Does the Tool Definitions section constrain which parameter types may carry x-mcp-header and how values are encoded?"}],"scope":{"docs":["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530"],"ranges":[["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530",10358,14905]],"topic":null}},"engine_root":"83854f52d67a32d58dbb45532848edc4078d23c1158a807b38ef64b52ef8a565","outcome":{"kind":"records","result":{"accepted":["9b7937db35008a3984b26c09c7c17ea9db913bfbfc1ad1c1649e28d146901ef0","51e704f89c1951017b2602b01396c1008c1f56a9ab98cb5d43cc3c4dcdacf0c4","5909223b8f3531e1957a1151b34c981624c213007110360a8c502cf317936681","17eb9f76ef8cc885778ce8579912f88cf01aaa34ca7010ce040c4425a1922bda","67167646b3269a95d05a7617e0780625821322cceddc43c3292a20b6cd9bf97b","b3b9ef69ece078881330cc997126f14a9ee042a9f07b59b6e0a3a934171c8ea5","5a5160