ss token handling","MCP server requests","OAuth 2.1 Section 5"]},{"as_of":null,"based_on":["t21_o7"],"kind":"claim","local_id":"t21_c7","object":"OAuth 2.1 Section 5 Resource Requests","predicate":"MUST conform to","stance":"reported","subject":"access token handling","text":"Access token handling for MCP server requests must conform to OAuth 2.1 Section 5 Resource Requests."}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",19354,24431]],"topic":null}},"engine_root":"a02c1751f02b63702c9c44838d40176c3ede51b660182edae1ab62b7836684c1","outcome":{"kind":"records","result":{"accepted":["ae1756e19234002ff7e203cc756dae66fcaac1fff8f7eb0043e6175f06bad959","0619ac49b798c92175ae3d65516e9c14cf1e1bd720ecdfc5e4e72bff62b8e731","0cd3a5a29382006e8cb0dd8b0aadb3499dc105a92a29271fd31824928b1b3966","90f912c8e67cdc7c706346e7d6939b14da96c41bc920dedf72010574f4977d45"],"error":null,"failed_index":null}},"request_hash":"b89d0dd156790a99b14276fcc70b395acb34b9507ab2e167b47966adba222749","submission_id":"T21-eedeffd323234662#2"},"hash":"abc17cafe9a3874d2416c451bffff0a15cc709b1a8d6434450bd5991b4913145","header":{"body_hash":"abcb5a1e5537c14ae79daf497fd58f66fe00a34eafe079aebc97d386eea54207","format":"sbgk-session-log/3","previous":"efe9c14a2a05921868433d10ce654e46c6523bf857f89262a0218faa62d7d16c","records_root":"6989cf42ad6d756382b58a16eee64548f9155a7ace52b51bd21c46e54a4af2fa","seq":106,"wal_op":"audit"}}
