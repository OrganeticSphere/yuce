:null}},"engine_root":"b06559a851e6723e2d855252c10b8354d045352610a8fea8aa3fdd5d19f89052","outcome":{"kind":"records","result":{"accepted":["cf44edeb8c9b072ca353797778012ec73decfe0c206017adc783d4807e0467e5","8666bd154759bbf8dc559111abfa34a3451fbe3aa8581078eff5b67374c3b0ca"],"error":null,"failed_index":null}},"request_hash":"9f512c45b207d9fc1eff64c86036e6ba9eab8a412ff05b4e62e18d7de165957a","submission_id":"T76-7f49c50edd5a2f25#3"},"hash":"7bb84bd52934f561c2519b4a98d1c71667b48d2739a2b15da9e6e32c19613014","header":{"body_hash":"8f06d51871984e0b94b7d50a61f75b207b7f41bf73b8824aa609c3d4ccd95490","format":"sbgk-session-log/3","previous":"a93e650ff648e82ad6f5d1d575e6139c1c4606986c2c5e1468e189de5317e1b3","records_root":"5c9f91b3b996dfe0969f731fa3a591bc23e9c75bd0af90ad89128d210b7d8aac","seq":372,"wal_op":"audit"}}
