{"body":{"actor":"w1","audit_root":"730ec70236dd4dd16896e6439d19b412882151d5d25f6462bdf50ef4b8873bdd","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"TR59-5695de4ea44b318c","kind":"submit","lines":[{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"and the message patterns. Other components **MAY** be implemented based on the specific needs of the\napplication.","kind":"observe","local_id":"t59_o2","terms":["optional components","MAY","implementation scope"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"All messages between MCP clients and servers **MUST** follow the\n[JSON-RPC 2.0](https://www.jsonrpc.org/specification) specification.","kind":"observe","local_id":"t59_o3","terms":["JSON-RPC 2.0","message format requirement"]},{"doc_id":"d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb","exact_quote":"- The request ID **MUST NOT** match the ID of any other request the sender has issued and\n  not yet received a response for.","kind":"observe","local_id":"t59_o5","terms":["request ID uniqueness","outstanding requests"]},{"as_of":null,"based_on":["t59_o1","t59_o2"],"kind":"claim","local_id":"t59_c1","object":"all implementations","predicate":"MUST be supported by","stance":"reported","subject":"base protocol, versioning, and message patterns","text":"All implementations MUST support the base protocol, versioning, and message patterns; other components MAY be implemented per application needs."},{"as_of":null,"based_on":["t59_o3"],"kind":"claim","local_id":"t59_c2","object":"JSON-RPC 2.0 specification","predicate":"MUST follow","stance":"reported","subject":"messages between MCP clients and servers","text":"All messages between MCP clients and servers MUST follow the JSON-RPC 2.0 specification."},{"as_of":null,"based_on":["t59_o4","t59_o5"],"kind":"claim","local_id":"t59_c3","object":"null and outstanding request IDs","predicate":"MUST NOT be null nor duplicate an outstanding request ID","stance":"reported","subject":"request ID","text":"Unlike base JSON-RPC, request IDs MUST NOT be null, and a request ID MUST NOT match any other request the sender has issued without a response."}],"scope":{"docs":["d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb"],"ranges":[["d_68a9337c46c31a3f0e9eafcca98f89260dc7a424155fdeaa631a415f80aa23eb",0,4563]],"topic":null}},"engine_root":"f6eeba084f7a1d53e6c107fb6031de4c4b78d45bc215ba89e58648fb7fdf9a7e","outcome":{"kind":"records","result":{"accepted":["4a9aee260f1c68e2162b36fe358567b959a0d1ab4155d809babc1415a2c3ef4c","69cbb54c18b0d03ffd45b89daf55667c335eab40154386d6c37f9d3a3153e15a","74d7b82cf6c05b425399ffd7f625a2f8ca82d0b10fbe02bad9c9fde36a403d2e","2dac39024369e2313b91c3fea44a240194648434d82dfcaddf11061d5e93849f","020e676fa4597071380d71f4ae1467cd3f3153b20a2cad046d4a9124f95c9815","9ed0e2d68277401a89cd6620054ad816aa97244c0a629ec063b8a14c6826daab"],"error":null,"failed_index":null}},"request_hash":"5e542b3369051eeb8f0343c2700d4f4f65a7314a6414b5f7add8ce0f516e6fa3","submission_id":"TR59-5695de4ea44b318c#2"},"hash":"83a176603370b0d2c3af11fbaa74e4a10eeecdced4a71598ec545ee11b5e1067","header":{"body