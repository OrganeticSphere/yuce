{"body":{"actor":"w2","audit_root":"799e4f8aaf5eebbc19b5e317444b0fbab1d9b54159deaa6c2e41efe366666057","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T13-6cd7143bbd3eabb3","kind":"submit","lines":[{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Authorization is **OPTIONAL** for MCP implementations. When supported:","kind":"observe","local_id":"t13_o1","terms":["authorization optional status","conditional on support"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Implementations using alternative transports **MUST** follow established security best","kind":"observe","local_id":"t13_o3","terms":["alternative transports","security best practices"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"implements a selected subset of their features to ensure security and interoperability","kind":"observe","local_id":"t13_o4","terms":["subset of referenced specifications","omitted features"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"OAuth 2.1 IETF DRAFT ([draft-ietf-oauth-v2-1-13](https://datatracker.ietf.org/doc/html/draft-ietf-oauth-v2-1-13))","kind":"observe","local_id":"t13_o5","terms":["OAuth 2.1 draft basis","draft status"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"3. Authorization servers and MCP clients **MAY** support the OAuth 2.0 Dynamic Client Registration","kind":"observe","local_id":"t13_o6","terms":["dynamic client registration optional"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP clients **MUST** use OAuth 2.0 Protected Resource Metadata for authorization server discovery.","kind":"observe","local_id":"t13_o7","terms":["client discovery via protected resource metadata"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP clients **MUST** support both discovery mechanisms to obtain the information required to interact with the authorization server.","kind":"observe","local_id":"t13_o8","terms":["both discovery mechanisms required of clients"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"The specific use of `authorization_servers` is beyond the scope of this specification; implementers should consult","kind":"observe","local_id":"t13_o9","terms":["authorization_servers usage out of scope"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"2. Authorization servers and MCP clients **SHOULD** support OAuth Client ID Metadata Documents","kind":"observe","local_id":"t13_o12","terms":["client ID metadata documents recommended"]},{"as_of":null,"based_on":["t13_o1"],"kind":"claim","local_id":"t13_c1","object":"OPTIONAL, conditional on support","predicate":"is","stance":"qualified","subject":"authorization","text":"Authorization is optional, and the OPTIONAL status is conditioned on the implementation supporting it ('When supported')."},{"as_of":null,"based_on":["t13_o3"],"kind":"claim","local_id":"t13_c3","object":"established security best practices","predicate":"MUST follow","stance":"reported","subject":"alternative transports","text":"Alternative transports MUST follow established security best practices for their protocol."},{"as_of":null,"based_on":["t13_o4"],"kind":"claim","local_id":"t13_c4","object":"a selected subset","predicate":"are implemented as","stance":"open","subject":"referenced specifications features","text":"The section states it implements only a selected subset of the referenced specifications but does not enumerate which features are omitted."},{"as_of":null,"based_on":["t13_o9"],"kind":"claim","local_id":"t13_c6","object":"beyond scope of this specification","predicate":"is","stance":"open","subject":"authorization_servers field usage","text":"The specific use of authorization_servers is declared beyond scope; implementers are referred to RFC9728 for guidance."},{"as_of":null,"based_on":["t13_o6"],"kind":"claim","local_id":"t13_c8","object":"authorization servers and MCP clients","predicate":"MAY be supported by","stance":"qualified","subject":"OAuth 2.0 Dynamic Client Registration","text":"Dynamic Client Registration (RFC7591) is optional (MAY) for authorization servers and MCP clients, not required."},{"as_of":null,"based_on":["t13_o12"],"kind":"claim","local_id":"t13_c9","object":"authorization servers and MCP clients","predicate":"SHOULD be supported by","stance":"qualified","subject":"OAuth Client ID Metadata Documents","text":"Client ID Metadata Documents support is a SHOULD recommendation for authorization servers and MCP clients rather than a MUST requirement."},{"as_of":null,"based_on":["t13_o5"],"kind":"claim","local_id":"t13_c10","object":"draft-ietf-oauth-v2-1-13","predicate":"is pinned to","stance":"reported","subject":"OAuth 2.1 basis","text":"The OAuth 2.1 basis is pinned to draft-ietf-oauth-v2-1-13, an IETF draft rather than a final RFC."},{"about":["OAuth 2.1 draft status","OAuth 2.1 requirements"],"kind":"question","local_id":"t13_q1","needed":"Check the IETF datatracker status of draft-ietf-oauth-v2-1-13 and later revisions of this authorization section.","text":"Is draft-ietf-oauth-v2-1-13 still a draft, or has it been finalized such that later revisions of this section change the OAuth 2.1 requirements?"},{"about":["omitted features","referenced specifications"],"kind":"question","local_id":"t13_q2","needed":"Compare this section against RFC8414, RFC7591, RFC9728 and the cited drafts to list the omitted features.","text":"Which features of the referenced specifications were omitted from the selected subset?"},{"about":["authorization server selection"],"kind":"question","local_id":"t13_q3","needed":"Check RFC9728 Section 7.6 and any MCP client guidance on selecting among authorization servers.","text":"How should a client choose among multiple authorization servers beyond the RFC9728 Section 7.6 guidance?"},{"about":["stdio transport credentials"],"kind":"question","local_id":"t13_q4","needed":"Check the MCP stdio transport section for the credential retrieval mechanism.","text":"What mechanism do stdio implementations use to retrieve credentials from the environment?"}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",0,5106]],"topic":null}},"engine_root":"b3a1b9dd35382f92ff5d46c7ba947b4fa9daf2bb0392ba97f7dd58de44bec346","outcome":{"kind":"records","result":{"accepted":["d63e792a3db96854196265250a483851ad79d2e70a35dff0660c0af57d5f5798","3adb2da82fe627c3e671534b3b024cb77bdfdfd27d249267c21a8f2e8421883f","31772f74beb59675b6f895e9ea718ecc45aac5b6e11cd3602ab02afef3950321","c5a135bf0c970231ecd30240ec30ecb7ea82b230393b31f64bcaaf3f519ea67b","7fcc29d81b58eecb5048f7c5785cdd6c9e3dee29cd46f5cf52ae0e9be3aafd93","734d7b411eea5b743d52dabffcc88b111ae1f236125de19ce7dee946449abb37","3abe32fdf4e28c77b55b7dc2219c0714e9bed2becf85952e23d5c92c6a597cab","257de7ce6c238dbde5f7119ee1187e3d08a19a1fb2570dcf71561b812d486046","1508ff11ce465f8b5874c33fc2ed10f951d3b5c3731a71c3d305fe1a9b111a49","c8433f8a1df56a4154b6dd2ad7ffe98151da3db1f9ef0f33bcb40ad5bcf420ac","055c3b232f4d91ca3898c658c421637b3ec6181