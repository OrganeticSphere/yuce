{"body":{"actor":"w4","audit_root":"fcb372b95e9e795441e61b25567ba1c2c9dc65a61a798df4647f5f8c80a1a369","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T67-06b0084826f48c87","kind":"submit","lines":[{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"Authorization is **OPTIONAL** for MCP implementations. When supported:","kind":"observe","local_id":"t67_o1","terms":["authorization requirement","optional"]},{"as_of":null,"based_on":["t67_o1"],"kind":"claim","local_id":"t67_c1","object":"OPTIONAL for MCP implementations","predicate":"is qualified as","stance":"qualified","subject":"authorization","text":"Authorization is qualified as optional for MCP implementations rather than a mandatory requirement."},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"- Implementations using an HTTP-based transport **SHOULD** conform to this specification.","kind":"observe","local_id":"t67_o2","terms":["HTTP transport","specification conformance","SHOULD"]},{"as_of":null,"based_on":["t67_o2"],"kind":"claim","local_id":"t67_c2","object":"SHOULD conform to this specification","predicate":"is qualified as","stance":"qualified","subject":"HTTP-based transport conformance","text":"Conformance to the authorization specification for HTTP-based transports is qualified as a recommendation (SHOULD) rather than an unconditional mandate."},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"- Implementations using an STDIO transport **SHOULD NOT** follow this specification, and\n  instead retrieve credentials from the environment.","kind":"observe","local_id":"t67_o3","terms":["STDIO transport","credentials","SHOULD NOT"]},{"as_of":null,"based_on":["t67_o3"],"kind":"claim","local_id":"t67_c3","object":"this specification, instead retrieving credentials from environment","predicate":"SHOULD NOT follow","stance":"qualified","subject":"STDIO transport implementations","text":"STDIO transport implementations are qualified to not follow this authorization specification and should instead retrieve credentials from the environment."},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"implements a selected subset of their features to ensure security and interoperability","kind":"observe","local_id":"t67_o4","terms":["standards compliance","subset of features"]},{"as_of":null,"based_on":["t67_o4"],"kind":"claim","local_id":"t67_c4","object":"selected subset of features from referenced specifications","predicate":"implements","stance":"qualified","subject":"authorization mechanism","text":"The authorization mechanism is qualified as implementing only a selected subset of features from the referenced specifications."},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"The implementation details of the authorization server are beyond the scope of this specification.","kind":"observe","local_id":"t67_o5","terms":["authorization server","implementation details","beyond scope"]},{"as_of":null,"based_on":["t67_o5"],"kind":"claim","local_id":"t67_c5","object":"the scope of this specification","predicate":"are beyond","stance":"open","subject":"authorization server implementation details","text":"Implementation details of the authorization server are left open and declared beyond the scope of this specification."},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"1. Authorization servers and MCP clients **SHOULD** support the OAuth 2.0 Dynamic Client Registration","kind":"observe","local_id":"t67_o6","terms":["Dynamic Client Registration","OAuth 2.0","SHOULD"]},{"as_of":null,"based_on":["t67_o6"],"kind":"claim","local_id":"t67_c6","object":"SHOULD be supported by authorization servers and MCP clients","predicate":"is qualified as","stance":"qualified","subject":"OAuth 2.0 Dynamic Client Registration support","text":"Support for OAuth 2.0 Dynamic Client Registration is qualified as a recommendation (SHOULD) rather than a strict requirement."},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"The specific use of `authorization_servers` is beyond the scope of this specification; implementers should consult","kind":"observe","local_id":"t67_o7","terms":["authorization_servers","beyond scope","open item"]},{"as_of":null,"based_on":["t67_o7"],"kind":"claim","local_id":"t67_c7","object":"the scope of this specification","predicate":"is beyond","stance":"open","subject":"specific use of authorization_servers","text":"The specific use of the authorization_servers field is left open as beyond the scope of this specification, deferring to RFC9728."},{"doc_id":"d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546","exact_quote":"The responsibility for selecting which authorization server to use lies with the MCP client","kind":"observe","local_id":"t67_o8","terms":["multiple authorization servers","client selection responsibility"]},{"about":["authorization server implementation details","specification scope"],"kind":"question","local_id":"t67_q1","needed":"check later revisions of the authorization specification","text":"Will later revisions specify authorization server implementation details or retain the deferral to external specifications?"},{"about":["Dynamic Client Registration","normative requirement strength"],"kind":"question","local_id":"t67_q2","needed":"check subsequent specification revisions for RFC7591 requirements","text":"Will OAuth 2.0 Dynamic Client Registration support be upgraded from SHOULD to MUST in subsequent revisions?"}],"scope":{"docs":["d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546"],"ranges":[["d_75c650256ff6f4b1aae9eed534d15874767a71fb43d85848301cad48e7055546",0,5211]],"topic":null}},"engine_root":"66a6bc272e210b0d6fb58b73b7e6ec276bb463f1228f4a859e431b16780802ac","outcome":{"kind":"records","result":{"accepted":["e7765546aa2bd9f17069e14202924b815f46cf74dff641361e18e6f08eb85c6a","beb555cb45e2a6e1f002c8d7e87bb57b30fbfd2c39f635dbb0334f111ccabdb3","e7d4fc132417401e1c8baf4ebdf8c09b3d2e1f30cf40c374c9482ed0035a1298","94aa13f28e0819d52ae9dc230a481983e329407dc6d3e142e93b3cf03ee5cd89","1e0fbfe68a54ffa014f2971c2a1378c7edfe08602be2d52909e0862007c02f57","a42bb279c4e076fee2e0a78c28a5b8b48b6769f341cd71154c3ef0694019f892","e3a8d86723536f1549f96cd89a387511dab7119d0935122cde8f2e8dc8982671","b4b661a6d5251cd9f75da4a6321dbb651d5378a1869571106690386cf605a2fd","9fa26226d8c0a63853fc4d22ea11f83f1cf3273c764414a9af45b97b743c0876","d4c946544459c56a182a5828a9c29c08099b6b6e5f2d5f61da577dad158f8b3b","5bb08f2fc2e2c00b3a18a77ab48e8782f5a5f0ba40a7f4769f1d3c3297380dd7","a9d211b9223d36ebae7476dd88c596a85d186be33ef1c1681f1315c29891854f","b487a8216a03d43437c80e9ad9ca4217adaf2bd3e9094400d1692abdae331cc0","951a59fa1ce85ea446184096b79fe65df86be5b35a4faf456bd274fe4f66f0e1","62ade6e935343e18f220cb0aec873f184ecad27b128e0ad42c6954406b6dad1e","2cf1f10b764573f8386a41ac48f1178287bff792b26a7b6eba4833ad8a8812cb","c677d7820ed0e9df8c388861fe7ad87248ec9caabee144d3245b2fbb1de54911"],"error":null,"failed_index":null}