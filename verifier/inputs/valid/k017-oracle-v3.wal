{"body":{"actor":"w1","audit_root":"b2cb3fb619f86f7e63c4fd0d5529b824b5a72a59b8845122e9de1a1a79af166d","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T50-a6bdb90b627068ec","kind":"submit","lines":[{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"The client **MAY** capture, forward, or ignore the server's `stderr` output and\n  **SHOULD NOT** assume `stderr` output indicates error conditions.","kind":"observe","local_id":"t50_o3","terms":["client stderr handling","optional MAY","SHOULD NOT assume errors"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"built on such streams **SHOULD** reuse this framing and the message rules on\nthis page;","kind":"observe","local_id":"t50_o5","terms":["custom transports","framing reuse","SHOULD"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"All request metadata for the stdio transport is carried inline in the\nJSON-RPC message body.","kind":"observe","local_id":"t50_o8","terms":["request metadata","no header layer"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"Servers **SHOULD** stop work on a cancelled request as soon as\npractical and **MUST NOT** send any further messages for it.","kind":"observe","local_id":"t50_o9","terms":["cancellation","SHOULD stop work","MUST NOT send further"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"The server **MAY** initiate shutdown by closing its output stream to the\nclient and exiting.","kind":"observe","local_id":"t50_o12","terms":["server-initiated shutdown","MAY"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"Because the protocol is stateless, any in-flight requests are simply lost and\nthe client can retry them against the fresh process.","kind":"observe","local_id":"t50_o14","terms":["statelessness","in-flight request loss","retry"]},{"as_of":null,"based_on":["t50_o2","t50_o3"],"kind":"claim","local_id":"t50_c2","object":"clients","predicate":"MAY be written and MAY be captured, forwarded or ignored by","stance":"qualified","subject":"server stderr output","text":"Server stderr logging is optional (MAY); clients MAY capture, forward or ignore it and SHOULD NOT assume stderr output indicates error conditions."},{"as_of":null,"based_on":["t50_o5"],"kind":"claim","local_id":"t50_c3","object":"stdio framing and message rules","predicate":"SHOULD reuse","stance":"qualified","subject":"custom transports on byte streams","text":"Custom transports built on reliable bidirectional byte streams SHOULD reuse this framing and message rules; only subprocess-specific aspects need channel-specific equivalents."},{"as_of":null,"based_on":["t50_o8"],"kind":"claim","local_id":"t50_c5","object":"JSON-RPC message body","predicate":"is carried inline in","stance":"reported","subject":"stdio request metadata","text":"All stdio request metadata is carried inline in the JSON-RPC message body via _meta.io.modelcontextprotocol/*; there is no header layer."},{"as_of":null,"based_on":["t50_o9"],"kind":"claim","local_id":"t50_c6","object":"cancelled requests","predicate":"SHOULD stop work and MUST NOT send further messages for","stance":"qualified","subject":"stdio cancellation","text":"On cancellation the client MUST send notifications/cancelled; servers SHOULD stop work as soon as practical and MUST NOT send further messages for that request."},{"as_of":null,"based_on":["t50_o13","t50_o14","t50_o15"],"kind":"claim","local_id":"t50_c8","object":"lost in-flight requests","predicate":"SHOULD be handled by restarting and retrying","stance":"qualified","subject":"unexpected server termination","text":"If the server exits unexpectedly the client SHOULD restart it; because the protocol is stateless in-flight requests are lost and may be retried, and subscriptions/listen streams must be re-established."}],"scope":{"docs":["d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12"],"ranges":[["d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12",0,5317]],"topic":null}},"engine_root":"eabc563883b4f9d59584e020abf8db2f563faf2b7587da23826100ce3eb61c7a","outcome":{"kind":"records","result":{"accepted":["11cbb3c480e829541661ab2b89ee95ac532d22639551d492d05475e77f23b959","547849a610263f7952e7f80349840a83e3e2bfe894219e3c91e57e01ae6a1a57","54a60d4b369944f1de674a253746f830ab6bc23f0981b722546cd9e3e509ec6f","1bfa89fd02ff5b338e73612aef43eaa5ab8a75f3fb74f0971a76557af5b06492","8fbd969503819db0c190377b8c60c68a064ea1f97120fe86c18bfd779a41e157","69622b2516c367afa56814378abe9cc1a0d95be0b019aecfe92955f7b1105840","8393e9b909443172487591b2fb4c70697dc7d0fa8f68bce49ea2ef6bcd2285fe","096fd9e0053b8e6cde5ec1a3037f6808cc764d0df828ba7e6feb83a64aea9d32","217ee8da52888347cc93bf877a9be09dca4bb54bbc0b7f3b3fa64c62d01a6505","3f68afe8582cf0dae99b531e1078696f48577c6a4636c10e77cc77b450fc6081","4e8f55b1d865dcd9f1438659ffb36f93223ae42e057dcb35bc2db9bbd00c26d3"],"error":null,"failed_index":null}},"request_hash":"55cc6e9cdb4587b4d31e14af029e72f3b0b518aa88b9f9d4d56b6e669245a488","submission_id":"T50-a6bdb90b627068ec#2"},"hash":"1776699874798f804e8a6c772bfdec10ac2cd01d7c4d9ba78a575fc3d5c2cbcc","header":{"body_hash":"94874de095bee6e4e8c3484572feadea7172434c0eeb97ed472d7576f08b2acf","format":"sbgk-session-log/3","previous":"701c85ad5a36be01d7397ce304f0d133b51d4632f71af9ab57f345f3d6cdea64","records_root":"fbde8e0fc16b1243e52a523e3a42c2c453c89fdea76122974d15d860fd9725ff","seq":239,"wal_op":"audit"}}
