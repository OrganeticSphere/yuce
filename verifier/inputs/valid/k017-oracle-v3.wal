PC message format and lifecycle requirements defined by MCP.","kind":"observe","local_id":"t18_o11","terms":["custom transports must keep JSON-RPC format and lifecycle"]},{"as_of":null,"based_on":["t18_o3"],"kind":"claim","local_id":"t18_c3","object":"protocol version 2025-03-26","predicate":"SHOULD assume","stance":"qualified","subject":"server missing protocol version header","text":"If a server receives no MCP-Protocol-Version header and has no other way to identify the version, it SHOULD assume 2025-03-26. This qualifies the header requirement."},{"as_of":null,"based_on":["t18_o6","t18_o5"],"kind":"claim","local_id":"t18_c5","object":"old SSE and POST endpoints","predicate":"SHOULD continue hosting","stance":"reported","subject":"servers supporting older clients","text":"Servers wanting to support older clients SHOULD continue hosting both the SSE and POST endpoints of the old transport alongside the new MCP endpoint."},{"as_of":null,"based_on":["t18_o10","t18_o11"],"kind":"claim","local_id":"t18_c10","object":"JSON-RPC message format and lifecycle requirements","predicate":"MUST preserve","stance":"reported","subject":"custom transports","text":"Clients and servers MAY implement custom transports; custom transports MUST preserve the JSON-RPC message format and MCP lifecycle requirements."}],"scope":{"docs":["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b"],"ranges":[["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b",11113,13956]],"topic":null}},"engine_root":"1dd5ee8d4c4b2cdfdfeb5b00167b9dc8793ef96bd1b12dc68890c6cebe1ee2d3","outcome":{"kind":"records","result":{"accepted":["e3ba623b232a8bde63ec22d9255cdb51c5ae1997831df75a198a52d54774e5f8","4cf4ebdf0c3ca64f7b1e3f3d6055a5e4f94e0bad39ab422aff1acca8da1b1541","c130fa08dc3c2254c6c8686c03004fd530cc0b3f879882cd5f0e9d3c3640b2c3","0fc7f94f3bf593ac7ba38830e341d6f942d5c87830fb6ff29b971b9bbe192211","bb6812b39404d72c5869fccb1857b4b73d395a7c6066ccb967577f76d24219c9","cbe6784ffdd2c49a1a6d