{"body":{"actor":"w1","audit_root":"2277ea78b8103461fc684ae543ddeb9f606ac4af898fc5aa62dd006be0b77b29","command":{"allowed_records":["1be4f3affb896e226a575da5b5f03b2d1b2083e28a48fa28046b38e8ad6bc1c2","2b69da0515e0d3f1ca105f29947813ed89ac48dc89f48179cf85540d29684acc","5a42ca58e9c15b6db21d90b908e7f65a9dd8d5ad76dab6766dd773820a5db98c","78696876cf3e95f672e7f304cec973c76e30dc5e6aadca8a371ffe68971ba3d2","8f76e3403705c6aa9d8148a6322fd7b6a701cd2dfde5245d1bb59484c322c42f","931a61a051ec316ffbe720982ea9d05243d14af58d333910026e7d46ea12de5e","9b4e968da73e3a5bf18424c572e40d8bb160c4a551999c6e33f70fbaac57b522","a0e4413f3c34cdc7a02085fada314617c07de291bf638efcd22d7b5519cf480d","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","d288030808e624df7214d04c4eae85e563c20999214c98dfe8250a4a150ecd97","f3931a4ac10e7d17e366811fb7aeab037ac07597c4e86fb0ab8eb32c593ac243"],"directive":"TQ88-12641ec9edeff49f","kind":"submit","lines":[{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"- To avoid message loss due to disconnection, the server **MAY** make the stream","kind":"observe","local_id":"t88_o1","terms":["resumability","message loss","MAY","disconnection"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"- The risk of message loss **MAY** be mitigated by making the stream","kind":"observe","local_id":"t88_o2","terms":["multiple connections","message loss","MAY","resumable"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"- The server **MAY** use this header to replay messages that would have been sent","kind":"observe","local_id":"t88_o4","terms":["Last-Event-ID","replay","MAY"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"This replaces the [HTTP+SSE","kind":"observe","local_id":"t88_o5","terms":["revision","replaces earlier transport"]},{"as_of":null,"based_on":["t88_o1","t88_o2"],"kind":"claim","local_id":"t88_c1","object":"this section","predicate":"is stated only as MAY, never MUST, in","stance":"confirmed","subject":"resumable stream mitigation","text":"Within this section, resumability as a message-loss mitigation is stated only with MAY (server may make stream resumable; risk MAY be mitigated); no MUST makes it mandatory."},{"about":["resumability","message loss mitigation","later revisions"],"kind":"question","local_id":"t88_q1","needed":"Later revision(s) of the Transports section (e.g. post-2025-06-18) wording on resumability-and-redelivery and multiple-connections message loss; compare MAY/MUST and whether Last-Event-ID is retained.","text":"Does any later revision of the Transports section change the MAY on making streams resumable (or on SSE event ids / Last-Event-ID replay) into a MUST, or remove resumability entirely?"}],"scope":{"docs":["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b"],"ranges":[["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b",0,5241],["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b",5241,11113]],"topic":null}},"engine_root":"1df0d68c729265a83b812e7bff51a804fd27cc2e4310c70d917d6dc7982e3024","outcome":{"kind":"records","result":{"accepted":["fdba27edda46af7613000d029ca01aeb14b998a6624dbbf3c7113647b5891d0a","833b42dc012ae394d5ce2eca5b955a9651f928b70248baae8e6721cd1998498d","d79a6c37abbad2b9c07266dffa49e549b718d5db78d4d1449ce6c5d7fb846451","b6a910204343beb46740c6eeab1aa9aec58a74d3f1525610de9123f778eb5622","1881fe8dc44b3d410ffbdbbf700fdcfebc450166154a284471e9b65b7da26ea5","4ba7b5386166e319146182631ddbac2cd23756253035a81176446d791a879327"],"error":null,"failed_index":null}},"request_hash":"ba7f922435cb50d60effca385445eb94e7558ae3e5fa4f3c1f2830e4a3dbd366","submission_id":"TQ88-12641ec9edeff49f#1"},"hash":"db8bb0301e3b564a5f8385c3c23f7a4731a8482b574b98b5c9795f3f76467b82","header":{"body_hash":"4e5c29a3a19ed808756963acc5f756f1779d3f1c6c5577ff5583b8dd2b0b8758","format":"sb