ent additional custom transport mechanisms to suit\ntheir specific needs.","kind":"observe","local_id":"t76_o4","terms":["custom transports","implementation optionality"]},{"as_of":null,"based_on":["t76_o4"],"kind":"claim","local_id":"t76_c3","object":"clients and servers","predicate":"MAY be implemented by","stance":"open","subject":"additional custom transport mechanisms","text":"Custom transport mechanisms remain optional for clients and servers, subject to the protocol's transport-agnostic design."},{"doc_id":"d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e","exact_quote":"Implementers who choose to support custom transports **MUST** ensure they preserve the\nJSON-RPC message format and lifecycle requirements defined by MCP.","kind":"observe","local_id":"t76_o5","terms":["custom transports","JSON-RPC format","lifecycle requirements"]}],"scope":{"docs":["d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e"],"ranges":[["d_8017d8e69074855ca0a15f149f1ca5ab2d7c017afd7b2b6894c50a162486402e",13999,15986]],"topic":null}},"engine_root":"aab89909aebcd7886c53ed4cdde32b40180c3b601bde49991cb7f4ffc89271d8","outcome":{"kind":"records","result":{"accepted":["3ae856a8c62dcd9b56dbe207c6e433dd61e2a5a2e695aec815ec51c7ddcc6515","0b30d182073d0e64778df7974fa9e25a826d17e6d21093646db8aac2ee5892fa","4adf7bd89b79924569edc68c21aa05a5bb529eed9294e7826a0279ff31f004e0","ceb7d60d4c1e9373a75b696e334e4e2ec6452f7b61b678d64befa8492f1b47a0","a6d02fcec7dc20e7f0bcee54e48a4cff887cf4113854ee1c29da4a34492087df"],"error":null,"failed_index":null}},"request_hash":"662efcebbf682b554e2728c8da628c85c25c347c618ccaa75861454a3e2c8f9b","submission_id":"T76-7f49c50edd5a2f25#2"},"hash":"15f0a0a44c98476ab21588049ff6f98ae17b70dd3ede89a9e758c8c525dbfbca","header":{"body_hash":"2e647bb38ed6a2832f5f8b5e0987f02128f8894440f8b2d1fe7667779005dafa","format":"sbgk-session-log/3","previous":"ded755e21be20aabdd9daf3538125269b2b936ba76d77daddf5130ff0199efb3","records_root":"e588d5368974639e696e