{"body":{"actor":"w1","audit_root":"2afac262abe12697e69c89d4b9549d5ea8afd1d2ff38c7a72c3e8898871e2465","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T50-a6bdb90b627068ec","kind":"submit","lines":[{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"The client **SHOULD** initiate shutdown by:\n\n1. Closing the input stream to the child process (the server).","kind":"observe","local_id":"t50_o10","terms":["shutdown procedure","SHOULD","close input stream"]},{"as_of":null,"based_on":["t50_o10","t50_o11","t50_o12"],"kind":"claim","local_id":"t50_c7","object":"closing input stream and waiting for exit","predicate":"SHOULD be initiated by","stance":"qualified","subject":"stdio shutdown","text":"Shutdown is recommended (SHOULD): client closes server stdin, waits for exit, then force-terminates; servers SHOULD exit promptly on stdin close/EOF and MAY initiate shutdown by closing stdout."},{"based_on":["t50_o2","t50_o3","t50_o5","t50_o10","t50_o13"],"falsifier":"A later revision of this section stating these MAY/SHOULD items as unconditional MUST requirements without change.","kind":"hypothesis","local_id":"t50_h1","text":"The stdio section's optionality (MAY stderr handling, SHOULD shutdown/restart, SHOULD framing reuse for custom transports) is a candidate for later tightening to MUST."}],"scope":{"docs":["d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12"],"ranges":[["d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12",0,5317]],"topic":null}},"engine_root":"a4e719ceea0d4de3851aebf834b0f088721a4f1b29cc7e790d909f7d525be2d7","outcome":{"kind":"records","result":{"accepted":["a2475eb8c5b05f71980c1b43e1dc298c8bad4efcaa3b606e9e757f36554d2d44","65611ac68928dca3f39fe2a8b42013a28e9e9afc1c874c7a76980a830886df2c","46d7a071ee993feee78c93bac3655c3fb2a0be9eaaa0163eada38ea523e9bcc4"],"error":null,"failed_index":null}},"request_hash":"b3953eb9b7093019b1925cd9ed00d9cb69445e99a8a019bb22ef89425f258715","submission_id":"T50-a6bdb90b627068ec#3"},"hash":"cadc8a7cbeb79a1ca094d5427ee6607ea0fa4395c27a965ceaf99d8eba5a8ef7","header":{"body_hash":"f39941d760d2ff5e5b83f19f3d8dc07ad8c2205bef09fc87d7efacd67f4b5db2","format":"sbgk-session-log/3","previous":"f9e08938aadd80dfc459fca30af9c382c18e55aad05616ba55158a1d74eb22d0","records_root":"a09a422512d4e8410a3e8d11271252d8985f9558d4b468c55c7cb7f919351c78","seq":241,"wal_op":"audit"}}
