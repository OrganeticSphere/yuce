{"body":{"actor":"w2","audit_root":"6c3cbcb97101458d1c5d9855a14e0dc131ff80e9a98a69385c35afb10c758444","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"TR52-6a9780014834bd40","kind":"submit","lines":[{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"setting its preferred modern version in `_meta`. The probe has three","kind":"observe","local_id":"t52_o2","terms":["preferred modern version carried in _meta","three probe outcomes"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"modern but does not support the requested version. Use one of the versions","kind":"observe","local_id":"t52_o4","terms":["UnsupportedProtocolVersionError meaning","use advertised supported versions"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"Do **not** fall back to `initialize`.","kind":"observe","local_id":"t52_o5","terms":["prohibition on falling back to initialize for modern servers"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"The fallback **MUST NOT** be keyed to one specific error code: legacy servers","kind":"observe","local_id":"t52_o8","terms":["fallback not tied to a single error code"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"errors (commonly `-32601` or `-32602`) or not at all.","kind":"observe","local_id":"t52_o9","terms":["legacy server error codes for unknown pre-initialize requests","non-response by legacy servers"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"A client that only supports modern versions does not need to probe, but","kind":"observe","local_id":"t52_o10","terms":["modern-only clients need not probe"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"Probing yields a\ndeterministic failure instead.","kind":"observe","local_id":"t52_o13","terms":["deterministic failure as result of probing"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"See [Versioning: Backward Compatibility][lifecycle-compat] for the era model","kind":"observe","local_id":"t52_o14","terms":["era model delegated to versioning page"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"and a compatibility matrix for implementors.","kind":"observe","local_id":"t52_o15","terms":["compatibility matrix delegated to external page"]},{"as_of":null,"based_on":["t52_o8","t52_o9"],"kind":"claim","local_id":"t52_c5","object":"one specific error code","predicate":"MUST NOT be keyed to","stance":"reported","subject":"legacy fallback trigger","text":"The legacy fallback MUST NOT be keyed to one specific error code, because legacy servers answer unknown pre-initialize requests with implementation-defined errors or not at all."},{"as_of":null,"based_on":["t52_o14","t52_o15"],"kind":"claim","local_id":"t52_c7","object":"Versioning: Backward Compatibility","predicate":"are delegated to an external page and left open here","stance":"open","subject":"era model and compatibility matrix","text":"The era model and the compatibility matrix for implementors are not given in this section and are delegated to the Versioning page's backward-compatibility subsection."},{"about":["reasonable timeout","legacy server classification"],"kind":"question","local_id":"t52_q1","needed":"Check the Versioning backward-compatibility subsection and the linked schema pages for a defined timeout value or client guidance.","text":"What numeric value or procedure defines the 'reasonable timeout' that classifies a server as legacy, and is it specified anywhere?"},{"about":["era model","compatibility matrix","probe fallback"],"kind":"question","local_id":"t52_q2","needed":"Read /specification/2026-07-28/basic/versioning#backward-compatibility-with-initialization-based-versions and compare its rules with this section.","text":"Does the compatibility matrix and era model on the Versioning page confirm or alter the probe-and-fallback rules stated here?"}],"scope":{"docs":["d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12"],"ranges":[["d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12",5317,7172]],"topic":null}},"engine_root":"ffd76ac50240d7bd19db9643ddc2890b19dfb309ac2bcb1d35f9eb6f134b0e70","outcome":{"kind":"records","result":{"accepted":["5340c128c5120dcb42e738700e284b954f5a15ca270d934577a8883e84185dc7","d63b14c35616240d3091d1e1088f31f746c44e84eeed9e1625d9a09925dac057","6337ceb2379a6634654f09b6927b9a67e55e6571291e6670a16e0e397efe9db0","4f52092e1b43e95d9607634ef843559bf56ef1bde4291b1acaa578b42d3e8ae8","b3a81dca7ed511bd4fe6219dfdacfb1aa448241e236aebc21b71838e79b23312","480ce3cc5ae7567fd454693b4e4f2147ea726009acb084c33050096378b8ced7","1c627d8fd7cdc4178867e5016640eb21682b7ab9b2bc2faae55081fc63837edc","5d239c56b828f3de1a649a95e3c5e1c074c9c4aeacf4b716f3a6603979ca53ac","3d74f54406f540cf03590d78674b4abf8ce1a3928e9ea72fe58a301cf0695c9e","4d513b329bace977b1a55498dd1c05d6faf83325bfa9be971c31d65fd57c36be","60aecb07ef49a3c9a68dfcadbe5