{"body":{"actor":"w2","audit_root":"4aed5f918b76b72678c07e8e1e79f05d68ef1b60d08d90511e591f513c3d572d","command":{"allowed_records":["006670e1f2cbe58a9be00cf503c6deb8660629b945aadc6e92cdf9a67f13bab4","13c7f1e617b06d97c9e6c142c6a9652c800fe37b9792052889bf07a876967287","252ccbde209a7ee22c2b1ddc484722fa36c83c7a544d477de23d06947e632715","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","3cc0161058b5e2d97cdde754baa68cb65373ce00cad3e495872d705a0d02054e","5b208f1ae301239409e024f8502075fef6ce842f14f8767c74f4c4140e2a824d","9e907af9c47b8b787317b3a622e5fd9e61d9769b0e8f5a2e6c23b41060dbb72d","b26a5ecc912713520eba6300cb2942bae3e7629e487403ffdb4a2a1638028248","c1008f0567bacc3dff92f1037a77604dfb8d2d7ffbfeb65390e92aa7695a6ad6","c80ab31fa204b049ceed65a3cf9d23a2550bcf9b0cd73a970a4d05759383d3e0","eb2d96f150b0bd02f853b372acf7daf976ddf48b6715e8b336012e1cd6a8e21f","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"TR6-5efdcb7c37a6d865","kind":"submit","lines":[{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"2. PKCE is **REQUIRED** for all clients","kind":"observe","local_id":"t6_o1","terms":["PKCE requirement scope","all clients"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"3. Token rotation **SHOULD** be implemented for enhanced security","kind":"observe","local_id":"t6_o2","terms":["token rotation","recommendation strength"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"4. Token lifetimes **SHOULD** be limited based on security requirements","kind":"observe","local_id":"t6_o3","terms":["token lifetime limits","no fixed value given"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"MCP servers **MAY** support delegated authorization through third-party authorization","kind":"observe","local_id":"t6_o4","terms":["third-party authorization flow","optional support"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"In this flow, the MCP server acts as both an OAuth client (to the third-party","kind":"observe","local_id":"t6_o5","terms":["MCP server dual role","client and authorization server"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"MCP servers implementing third-party authorization **MUST**:","kind":"observe","local_id":"t6_o6","terms":["session binding requirements"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"4. Handle third-party token expiration and renewal","kind":"observe","local_id":"t6_o7","terms":["third-party token expiry and renewal","no mechanism specified"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"3. Implement appropriate session timeout handling","kind":"observe","local_id":"t6_o8","terms":["session timeout","no value given"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"1. Validate all redirect URIs","kind":"observe","local_id":"t6_o9","terms":["redirect URI validation","security considerations"]},{"doc_id":"d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d","exact_quote":"We strongly recommend that local clients implement OAuth 2.1 as a public client:","kind":"observe","local_id":"t6_o10","terms":["local clients as public clients","best practice"]},{"as_of":null,"based_on":["t6_o1"],"kind":"claim","local_id":"t6_c1","object":"all clients","predicate":"is required for","stance":"qualified","subject":"PKCE requirement","text":"Section broadens PKCE beyond the earlier public-client example: PKCE is REQUIRED for all clients, not only public clients."},{"as_of":null,"based_on":["t6_o2","t6_o3"],"kind":"claim","local_id":"t6_c2","object":"security requirements (unspecified)","predicate":"should be implemented / limited","stance":"reported","subject":"token rotation and lifetime","text":"Token rotation SHOULD be implemented and token lifetimes SHOULD be limited based on security requirements; no specific rotation policy or lifetime values are given."},{"as_of":null,"based_on":["t6_o4","t6_o5"],"kind":"claim","local_id":"t6_c3","object":"MCP server as client and authorization server","predicate":"is optional and has MCP server in dual role","stance":"reported","subject":"third-party authorization flow","text":"Third-party authorization is optional (MAY); the MCP server acts as an OAuth client to the third-party server and as an authorization server to the MCP client."},{"as_of":null,"based_on":["t6_o6","t6_o7"],"kind":"claim","local_id":"t6_c4","object":"token mapping, status validation, expiration and renewal handling","predicate":"requires","stance":"reported","subject":"third-party session binding","text":"Servers implementing third-party authorization MUST keep a secure mapping of third-party to MCP tokens, validate third-party token status, and handle expiration and renewal."},{"as_of":null,"based_on":["t6_o6","t6_o8","t6_o9"],"kind":"claim","local_id":"t6_c5","object":"redirect URI validation and session timeout handling","predicate":"requires","stance":"reported","subject":"third-party security considerations","text":"Servers implementing third-party authorization MUST validate all redirect URIs and handle session timeouts; the section gives no timeout values."},{"about":["token lifetime","session timeout"],"kind":"question","local_id":"t6_q1","needed":"Check the rest of the specification and the cited OAuth 2.1 draft for numeric lifetime or timeout guidance.","text":"Concrete token lifetime values and session timeout durations are left unspecified; the section defers them to security requirements."},{"about":["third-party token renewal","redirect URI validation"],"kind":"question","local_id":"t6_q2","needed":"Check the remainder of the authorization document for the renewal procedure and redirect URI validation rules.","text":"The method for handling third-party token expiration and renewal, and the detailed redirect URI validation rules, are not described in this section."}],"scope":{"docs":["d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d"],"ranges":[["d_0b1e9103fea8fa5ef272198e7fcb3c264c0d113b3cb79352242dd7fd7884d30d",11692,15070]],"topic":null}},"engine_root":"61916c6f36397165d6f4a4b22531b1e90d763021081f917e4706d2aa7b7db275","outcome":{"kind":"records","result":{"accepted":["c0f3cba36cc87de6802723506910a234c9197181aa2370f50dd17ff523cd0b72","d9b8bf2d3f5d28f15aabb782fe8baaf91ff1b70e44fed03d4a10252cf8a7b800","b46c13ddbb0777c332870e613ccf194b9226db7e8bd12188b06081eb16268fba","201821d2f1d7a0f6845fe7bf4571a8eef72d4a900faf06a5541adf7099a421f1","c63e44d449b26c97291b4f6cfd9ac46f2ca033901dd22c6bef05bbf131937607","b3896e8eccf1f861034d9caa11619e6aee00aec042881289ff9fa6c8b48f4cda","6812667d741ad64c1d49b8e46e53d84d43b32d98455238df3f1392c59dfdad6f","97ce1d62b2ef3e5586bcd3a270104bae2c29cf166e398650f2603f7458e934c8","4e2a1e12cdb83173c3dcd289d835cfaedd846a8316ad007e1def9109365ffbf7","7f26c0dd98725da14981581579e906a156d1b0f200afca67f437c9c7e81b9738","61bc7a9cd6ae47a44929ffa55c9c2c9d065d3bacd8b5553afea7614d24eb682c","559cebc42c5f94fd2abe98ec8bc21e38a7a35580544433d20c62a0f113f5b819","b0fd37356f8d029ca5493c6f3d6e7663b27aa9e6889452f41b16b247ca347600","c28cf3604086f15d4d8306597062e8489e8bfd47abd2b065d49442e25ae4f18c","95354e65c1298f7fd1737c0d506726ade41bbc16bf9aef189cd3dc260b277fc7","b5ad4da7e2ed38138e9d4a1f7208c60ea8f4b3a0f59c096018f5baf934ce9ee1","cab952c45cedb0d45ac275cab98b11155c4f54148a91f136471c549f598fdf88"],"error":null,"failed_index":null}},"request_hash":"7f5dc2b30365fca6997294114db275ed17e1504d6dc86bd7ef4cf86931b06dac","submission_id":"TR6-5efdcb7c37a6d865#1"},"hash":"128ca227b06f4ac01c45c2a5d324a8b19ade1dd23322cae934f4de5ad3d42916","header":{"body_hash":"2604bb85986a0f0f663fe797cac9e8b6c8113bef76441099f0113647707d0596","format":"sbgk-session-log/3