{"body":{"actor":"w2","audit_root":"4fd0a27a83a731b82f7ad010800c0719982f2434ff1abaf14381497eb16e5a4c","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T48-2685fe9700651000","kind":"submit","lines":[{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"in its advertised `supported` list. Do **not** fall back to `initialize`.","kind":"observe","local_id":"t48_o4","terms":["recognized modern error: use advertised version, no fallback to initialize"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"The fallback **MUST NOT** be keyed to one specific error code: legacy servers","kind":"observe","local_id":"t48_o7","terms":["fallback detection must not depend on a single error code"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"A client that only supports modern versions does not need to probe, but","kind":"observe","local_id":"t48_o8","terms":["modern-only clients need not probe"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"See [Versioning: Backward Compatibility][lifecycle-compat] for the era model","kind":"observe","local_id":"t48_o11","terms":["era model and compatibility matrix deferred to versioning page"]},{"doc_id":"d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12","exact_quote":"[server-discover]: /specification/2026-07-28/schema#discoverrequest","kind":"observe","local_id":"t48_o12","terms":["server/discover request defined in 2026-07-28 schema"]},{"as_of":null,"based_on":["t48_o4"],"kind":"claim","local_id":"t48_c3","object":"use advertised supported version","predicate":"must not fall back to initialize","stance":"reported","subject":"client receiving recognized modern error","text":"When a client receives a recognized modern error, it must use a version from the server's advertised supported list and must not fall back to initialize."},{"as_of":null,"based_on":["t48_o7"],"kind":"claim","local_id":"t48_c5","object":"one specific error code","predicate":"MUST NOT be keyed to one specific error code","stance":"reported","subject":"fallback to initialize","text":"The fallback to initialize MUST NOT be keyed to one specific error code, since legacy servers respond with implementation-defined errors or not at all."},{"as_of":null,"based_on":["t48_o11"],"kind":"claim","local_id":"t48_c8","object":"Versioning: Backward Compatibility","predicate":"are deferred to another page","stance":"open","subject":"era model and compatibility matrix","text":"The full era model and compatibility matrix for implementors are not given in this section and are deferred to the Versioning: Backward Compatibility page."},{"as_of":20260728,"based_on":["t48_o12"],"kind":"claim","local_id":"t48_c9","object":"2026-07-28 schema","predicate":"is defined in","stance":"reported","subject":"server/discover request definition","text":"The server/discover request is defined in the 2026-07-28 schema, which is the spec version this section links to."},{"about":["probe timeout","fallback to initialize"],"kind":"question","local_id":"t48_q1","needed":"Check the Versioning: Backward Compatibility page or the 2026-07-28 schema; this section gives no value.","text":"What value of 'reasonable timeout' triggers the legacy classification when no response arrives to server/discover?"},{"about":["recognized modern error","UnsupportedProtocolVersionError"],"kind":"question","local_id":"t48_q2","needed":"Check the 2026-07-28 schema page linked as /specification/2026-07-28/schema; the section names only one error.","text":"Beyond UnsupportedProtocolVersionError, which modern JSON-RPC errors count as 'recognized' and so stop the fallback to initialize?"}],"scope":{"docs":["d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12"],"ranges":[["d_46be7e4179c08889e46e432fb507e04ddb0ad5be742316f30490452fb8a74c12",5317,7172]],"topic":null}},"engine_root":"ada67c09a31bb7da435c0e73c8fec5c6b120b495c07bd88b48bd7fb8eeed9c82","outcome":{"kind":"records","result":{"accepted":["361a45e9944aa9bab439e4994d4307c3f6c27338b1a088c9c8380bc16579ae52","4da02a42188cea64ece1e224b708a718729fd45820cb90b9acbb273b351e5284","d78a1073ad9761dd30334ace74dd133f3094fe85a501e7518754df99b9a96d95","8b66fe610326b9241b31370f0433aec4e9144f66ce9dfb56deac24dc06e39711","42d4cc6d91a516c87dde8499660706598b82e97082dd4be3f6e9c7a862f876d9","4b6aa9846b40e71637b0d1dfc2ec060c86e6264da79afb99a040ee3a5916cb15","b3aa3baef9920bcffde6ff29af341478b679f74f607187e8ed50232c256b840c","141cec82143891c1b964c2a61f91859f089dfcb3279c031ace976f383a123054","4273971b8b1200db4e7b75c534b8442dd269bb6e6bac2e5047613860b4491520","7a92d080ed291ec7e5287815da2f452b3e54335d7f97971ff6e45fb27dc1a14a","06a3ef5f376c6307806894f6914cdf5a8e81036d7f86593ecda243ddc4a33b0a"],"error":null,"failed_index":null}},"request_hash":"521af2a1d56be6e5b96bcefc3855127b76fe191b1e0b2199fae82ac6040ed579","submission_id":"T48-2685fe9700651000#1"},"hash":"b12bb092a20a10fe939cee44d116acb8c18e12bb826e2a2ea11826a8e1dc1136","header":{"body_hash":"d38719bb62307144ce4439b69e8baa442ea1ef7ddce1c180739a8e277cfe0dde","format":"sbgk-session-log/3","previous