{"body":{"actor":"w1","audit_root":"7465c36225fbb218e5b079a52521483ae0b8c8b8f83e9ab92c7e09bd32ecab45","command":{"allowed_records":["0c258bcced19e3a25c8f06ab9defce3ef088fcb9f622c65d2834f76439ff7204","48fd24ed2b3b734c865cf1416ceb3a658772ba914bd977c0895b1e9e09b701be","50eb20936dcfc15db39371cbb1f432dca55a3b5f92c17c0c3a4c251d500061fa","5a42ca58e9c15b6db21d90b908e7f65a9dd8d5ad76dab6766dd773820a5db98c","72ee06392007eb545205f5cd5953cf29fce16821e7cd9e7d07e89de9b785f22e","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","9aba4a5d947b220887aa17e578ce5a00d7a9ae1745c1611c6a9f5b5c8a2aa742","af0faccc5daeb8f8ff71d005318d39f2bcc842b79a6eb91e691fa94cbe877160","b72098723000200784c0466158907cdad8ab8c27c953ad8e014b4a65aee49dad","dfbfb4af7a45e541154ad723dcf9920bd15080cf5ebe39818040df4cad537d9c","ed306e2586dbfbee812afd607b87b3c11663c0e33a7e67ea3eabb265bc83f547","eea181e6e6b7316dad73f7ac4623a3db46d57c2a7f9f116f14152ebcd2fcd43f"],"directive":"TQ139-84348c23bb40870b","kind":"submit","lines":[{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The server **MUST** provide a single HTTP endpoint path (hereafter referred to as the\n**MCP endpoint**) that supports both POST and GET methods.","kind":"observe","local_id":"t139_o2","terms":["single MCP endpoint","no separate endpoint event"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"Every JSON-RPC message sent from the client **MUST** be a new HTTP POST request to the\nMCP endpoint.","kind":"observe","local_id":"t139_o3","terms":["POST to MCP endpoint","no separate POST endpoint"]},{"doc_id":"d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b","exact_quote":"The client **MAY** issue an HTTP GET to the MCP endpoint. This can be used to open an\n   SSE stream, allowing the server to communicate to the client, without the client first\n   sending data via HTTP POST.","kind":"observe","local_id":"t139_o4","terms":["GET to same MCP endpoint","no separate SSE endpoint"]},{"as_of":null,"based_on":["t139_o1","t139_o2","t139_o3","t139_o4"],"kind":"claim","local_id":"t139_c1","object":"single MCP endpoint of Streamable HTTP","predicate":"are superseded by","stance":"superseded","subject":"separate endpoint event and separate HTTP POST endpoint of HTTP+SSE","text":"Streamable HTTP replaces the 2024-11-05 HTTP+SSE transport and defines a single MCP endpoint serving both POST and GET, so no separate endpoint event or separate POST endpoint is specified."}],"scope":{"docs":["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b"],"ranges":[["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b",0,5241],["d_1ec5d9d1465c47e1696aa6369bdc6582a4210481ce571922656ff4fa73cb170b",5241,11113]],"topic":null}},"engine_root":"cbab76c71c94c1c49f4227ef18f561887c92990e5ead10ad3747e528b001663d","outcome":{"kind":"records","result":{"accepted":["b09b4c77560ef0d884092166446af1e923bb199a2822ac519af165e5d3236313","29631d8ff713a59002793c0e4068182489ecc6dd19fa95a9c36f279ce0c43645","fae618111a8f215bfef771de00b315dd7343298168ed70f296f88d29534385c8","e0e0743c9ea551f37037ae8c1f8cedf1197e4fa929dd8e4984c8004bdd19a3be"],"error":null,"failed_index":null}},"request_hash":"ac23ebee934e750dc8e56f1ec2e36d1e42ac37c0797047a3ff7df580a829da83","submission_id":"TQ139-84348c23bb40870b#2"},"hash":"d2078cf636398cb22ba6ae59d9ac179e7fe9ecda8a89df87acb723ac6adf3b45","header":{"body_hash":"324784f03c7d039311eaa32be4daf35b2b2354df0f268d2b8904d51e3775986d","format":"sbgk-session-log/3","previous":"21fc377d69ba86a9ca876ab8ed046cb17ab70669a79a4747a6032a7984d11155","records_root":"20a3fd1e11f6c986e88776c37740c601bf8a22fa096ca7cbb74c8d24575a6fbe","seq":634,"wal_op":"audit"}}
