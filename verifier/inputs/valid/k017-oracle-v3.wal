esh tokens are not a resource requirement."},{"as_of":null,"based_on":["t44_o14","t44_o15"],"kind":"claim","local_id":"t44_c14","object":"draft-13 and draft-14 in different sections","predicate":"are pinned to","stance":"open","subject":"OAuth draft version references","text":"The section cites draft-ietf-oauth-v2-1-13 for token handling but draft-ietf-oauth-v2-1-14 for refresh-token confidentiality; the pinning is inconsistent and left unresolved here."}],"scope":{"docs":["d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d"],"ranges":[["d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d",14820,20184]],"topic":null}},"engine_root":"6577738a344afa726e301a708e26e0521618b5a9a8c91e41ab8aace2517dcef8","outcome":{"kind":"records","result":{"accepted":["34da8b7ab6379361f41de661204e803af0f952a6ab7c8a3040a9c2ee33359e13","86f123c789152af3da63da65f98c02f1310e615dc57354b9280711d7112f2011","2b540e04017442ff773d721293ce300bc2089415188c277a633b1a77afca4cbc","20691611c859a2794d61da3f41e9d9431d719da585e0b9e0115bdcaf8dabbfee"],"error":null,"failed_index":null}},"request_hash":"79dea1b61cd7025996918cddfef7d7c7086bfd2e7e2f4d5c7c13fabac725918d","submission_id":"T44-aedafb4bbd71a2eb#2"},"hash":"2340517cd1b6e0555a19c4291e490f14f4d8784dd715a2113d57ab57992768b8","header":{"body_hash":"5ad5fa45de83c6c1cf4488f392884230f6844ddf62880b847d39984687555ea4","format":"sbgk-session-log/3","previous":"9c351257b62ceca5951c5c2ba87db3f5a2fd7e32f4a2dcd594b96edbd3ec6bc7","records_root":"40224e5f16fc080bbebfa5ab9068bfce0cb1b3c8b8345b324605af9e1ab8869a","seq":215,"wal_op":"audit"}}
