{"body":{"actor":"w1","audit_root":"bca17eda2a0f3ff569211c12c9eae66d2b503d6ec97ba4f1492fd10c76f23629","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T82-0227ccd72aba18f6","kind":"submit","lines":[{"doc_id":"d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b","exact_quote":"The client **SHOULD NOT** send requests other than\n  [pings](/specification/2024-11-05/basic/utilities/ping) before the server\n  has responded to the `initialize` request.","kind":"observe","local_id":"t82_o2","terms":["client","SHOULD NOT","pre-initialize requests"]},{"doc_id":"d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b","exact_quote":"The server **MAY** initiate shutdown by closing its output stream to the client and\nexiting.","kind":"observe","local_id":"t82_o7","terms":["stdio shutdown","server MAY","output stream"]},{"doc_id":"d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b","exact_quote":"| Client   | `experimental` | Describes support for non-standard experimental features                            |","kind":"observe","local_id":"t82_o8","terms":["experimental capability","non-standard features"]},{"as_of":null,"based_on":["t82_o2"],"kind":"claim","local_id":"t82_c2","object":"before initialization completes","predicate":"SHOULD NOT be sent other than pings (and logging for server)","stance":"reported","subject":"pre-initialization requests","text":"Before the server responds to initialize, the client SHOULD NOT send requests other than pings; the server SHOULD NOT send requests other than pings and logging before the initialized notification."},{"as_of":null,"based_on":["t82_o6","t82_o7"],"kind":"claim","local_id":"t82_c5","object":"transport-level connection termination","predicate":"defines no specific messages and leaves server-initiated stdio shutdown as MAY","stance":"open","subject":"shutdown phase","text":"Shutdown defines no specific messages; termination is signaled via the underlying transport, and for stdio the server MAY initiate shutdown by closing its output stream and exiting."},{"as_of":null,"based_on":["t82_o8"],"kind":"claim","local_id":"t82_c6","object":"support for non-standard experimental features","predicate":"is described only as","stance":"open","subject":"experimental capability","text":"The experimental capability is defined only as describing support for non-standard experimental features, leaving its contents unspecified."},{"based_on":["t82_o2","t82_o3","t82_o4","t82_o7"],"falsifier":"A later revision of this Lifecycle section stating these MAY/SHOULD items as unconditional MUST requirements without change.","kind":"hypothesis","local_id":"t82_h1","text":"The section's MAY/SHOULD items (pre-initialize request restrictions, latest-version preference, disconnect on unsupported version, stdio server shutdown) are candidates for tightening to MUST in later revisions."},{"based_on":["t82_o6","t82_o7"],"falsifier":"A later revision defining specific shutdown messages or normative termination procedures within this section.","kind":"hypothesis","local_id":"t82_h2","text":"Because shutdown defines no specific messages and defers to the transport, graceful-termination conformance remains underspecified and open."}],"scope":{"docs":["d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b"],"ranges":[["d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b",0,5932]],"topic":null}},"engine_root":"8057793fa9dd2e11c3b04e8148b1220adf40ae61359c98202ebbb7daad553b0e","outcome":{"kind":"records","result":{"accepted":["680445e8f9bb406631f6e097be520794b0e792182ebb260a0199926c0229de48","f6629f42b17f558e03098a647200dff3ca9c644b1d54989747435dab943aba45","6797adf1b06d096c0166f353eda33508c3040a4c32b479b62144cfeb91b964c8","3746d35082713166592e2d28b446e9c86ba114b5e873607fc82be6d2cb6de811","9e688f1b743c69942174b63a3f34ea5c1c60b61312f1991f48ab592849881300","2d24ecf7bfa7b8ba793445fc642379ffb46102f5d5ef73198ac36338d1cff184","325d9af0b2f1f15531afa8c801e1d235da29a6ab9b7cae20fe7ce017eecffe9c","ada8a88ad8ab017f1baae086c786b4a246903fca388ca49c68b5b8d45fbba2b2"],"error":null,"failed_index":null}},"request_hash":"ad0ac0b89cd0dba29577526de7d86208e910d647f35e2cc64e14aeb55e884870","submission_id":"T82-0227ccd72aba18f6#2"},"hash":"766a2bcac7cb13f1c547b1687b78536f09c71d2d8697a7e218c5bd91862e6850","header":{"body_hash":"80add464caa1f31b5eb78f2b0833b4af03b4a736f916d63696a5539929ea0cfd","format":"sbgk-session-log/3","previous":"3bf908bcd591ecac725d1f3fa939f58ab63cd1438938df3a6617bc238c2dc00e","records_root":"e9b4b8172fcd292bbf560eaa458bc1260394d186c3a98b82e4984267d81a6183","seq":407,"wal_op":"audit"}}
{"body":{"actor":"w1","audit_root":"e0adfbb2bf820ea4c2291f24e3a65046e8a0b4991280eb7383a470fa6ae6ba59","command":{"checkpoint":{"context":{"abandoned":false,"agent":"w1","circle":16,"circle_phase":"READ","kind":"EXTEND","link_task":null,"offered":18,"refusals":1,"stored":18,"sync_step":31,"task_id":"T82-0227ccd72aba18f6"},"from":0,"key":"task:doc:d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b#0","to":0},"kind":"batch","operations":[]},"engine_root":"8057793fa9dd2e11c3b04e8148b1220adf40ae61359c98202ebbb7daad553b0e","outcome":{"kind":"value","result":{"accepted_operations":0,"checkpointed":true,"error":null,"failed_index":null,"results":[]}},"request_hash":"026a640d8c58049e59db35cd125a055f982423a6eb9706f53e5dc3ec8ae6bf81","submission_id":"T82-0227ccd72aba18f6#done3"},"hash":"bab7dab432e2a154e9abe51297613235f4fc850063f6e2e3b8e9b23a9a81ea34","header":{"body_hash":"4549ee879ede1024eaaec93d4d9935d1a3744a5f855b8fefe619c564a0699851","format":"sbgk-session-log/3","previous":"766a2bcac7cb13f1c547b1687b78536f09c71d2d8697a7e218c5bd91862e6850","records_root":"fe7c90ca2214e168f5ffe6cccb15729c3b8a03c403e48c406441cd589fdd8c41","seq":408,"wal_op":"audit"}}
{"body":{"actor":"w2","audit_root":"048dd5135ded587883d7125b94ceefe78a82aedf748e67e1fea957fc3f589153","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T81-cd3e598e29eca3d8","kind":"submit","lines":[{"doc_id":"d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b","exact_quote":"For HTTP [transports](/specification/2024-11-05/basic/transports), shutdown","kind":"observe","local_id":"t81_o1","terms":["HTTP transport shutdown, scoped to the 2024-11-05 spec version"]},{"doc_id":"d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b","exact_quote":"is indicated by closing the associated HTTP connection(s).","kind":"observe","local_id":"t81_o2","terms":["HTTP shutdown signalled by closing connections"]},{"doc_id":"d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b","exact_quote":"Implementations **SHOULD** be prepared to handle these error cases:","kind":"observe","local_id":"t81_o3","terms":["SHOULD-level obligation to handle listed error cases"]},{"doc_id":"d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b","exact_quote":"- Initialize request timeout","kind":"observe","local_id":"t81_o4","terms":["initialize request timeout as a listed error case, with no value given"]},{"doc_id":"d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b","exact_quote":"Implementations **SHOULD** implement appropriate timeouts for all requests, to prevent","kind":"observe","local_id":"t81_o5","terms":["SHOULD-level obligation to implement request timeouts"]},{"doc_id":"d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b","exact_quote":"hung connections and resource exhaustion.","kind":"observe","local_id":"t81_o6","terms":["purpose of request timeouts: hung connections and resource exhaustion"]},{"doc_id":"d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b","exact_quote":"\"message\": \"Unsupported protocol version\",","kind":"observe","local_id":"t81_o7","terms":["example initialization error message for version mismatch"]},{"doc_id":"d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b","exact_quote":"\"supported\": [\"2024-11-05\"],","kind":"observe","local_id":"t81_o8","terms":["example error data listing supported protocol versions"]},{"as_of":20241105,"based_on":["t81_o1","t81_o2"],"kind":"claim","local_id":"t81_c1","object":"closing the associated HTTP connection(s)","predicate":"is indicated by","stance":"reported","subject":"HTTP transport shutdown","text":"For HTTP transports, shutdown is indicated by closing the associated HTTP connection(s). The section gives no further shutdown procedure for HTTP."},{"as_of":20241105,"based_on":["t81_o3","t81_o4"],"kind":"claim","local_id":"t81_c2","object":"protocol version mismatch, capability negotiation failure, initialize timeout, shutdown timeout","predicate":"SHOULD be prepared to handle","stance":"qualified","subject":"implementations handling listed error cases","text":"Implementations SHOULD be prepared to handle protocol version mismatch, failure to negotiate required capabilities, initialize request timeout, and shutdown timeout. The obligation is SHOULD, not MUST."},{"as_of":20241105,"based_on":["t81_o5","t81_o6"],"kind":"claim","local_id":"t81_c3","object":"implementations, for all requests","predicate":"SHOULD be implemented by","stance":"qualified","subject":"request timeouts","text":"Implementations SHOULD implement appropriate timeouts for all requests to prevent hung connections and resource exhaustion. No timeout values are specified."},{"as_of":20241105,"based_on":["t81_o7","t81_o8"],"kind":"claim","local_id":"t81_c4","object":"unsupported protocol version","predicate":"uses error code and data for","stance":"reported","subject":"example initialization error","text":"The example initialization error uses code -32602 with message Unsupported protocol version, and data listing supported versions and the requested version."},{"based_on":["t81_o5","t81_o6"],"falsifier":"A later revision of this section stating request timeouts as MUST with concrete values, or leaving the SHOULD wording unchanged with no values added.","kind":"hypothesis","local_id":"t81_h1","text":"The timeout and error-handling obligations are SHOULD-level and unquantified, so a later revision may tighten them to MUST or specify timeout values."},{"about":["shutdown procedure for stdio","HTTP shutdown rule scope"],"kind":"question","local_id":"t81_q1","needed":"Check the stdio subsection of the basic/transports page for the 2024-11-05 spec, and any later revision of this section.","text":"Does the stdio transport define its own shutdown procedure? This section only gives the HTTP shutdown rule and links to the transports page for the rest."},{"about":["initialize request timeout","shutdown timeout"],"kind":"question","local_id":"t81_q2","needed":"Check the lifecycle or initialization section of this spec version and any later revision for concrete timeout values or defaults.","text":"Which timeout durations apply to the initialize request and shutdown, since the section lists those timeouts without values?"}],"scope":{"docs":["d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b"],"ranges":[["d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b",5932,6663]],"topic":null}},"engine_root":"4fc4dd52524ba92f6afe2b1887ab72cb889511d6841cd30ccfe897fdcb6f1238","outcome":{"kind":"records","result":{"accepted":["23cd1eee9b6cba925c11e3e79a05b7b9ae1d62e8723db267838c7296d2c1512e","f2057bb65c81fd5df4ac34f529a13c1fc8f447d05f3b79e22eae9b9d3c348b28","b2013687d6517ed9e3e973ad00d1af9c3bba54d69b3a10558c81bebace87c059","370d62fd77991679387d5523ce4487dc020639073fbf565fcb680c9cadd52bff","0690d460ca97cfb0406098e3fc499252c058375011536d5a4aef0ffa5c591107","87f41d349ae96688a59c27aae31050cfe7025ea430839fa15c774ade96ee0bf7","fe0ed5f0f11504786600de654358410d40bce69c1ba1d2d56481c15b46130ea8","958fb0553530e51126d259aec0a02dacadb0cf28497a695105a5b787529ae33d","6c89196f6be7813b07468315ba4e57c707b13095fac152a0ab378aa9190619b7","9efe311fe786e4f797cbe14a4447a2294f3e0ee5832b2a996b1f82654517e6c3","f3de9ab80acff6b09ff3da3f81780be68f7c7b9ad68c32dc7a252819b8c2992c","d08a557a5be00292d605006ba6322887f52af53c96566dbd7b8e1f4471200c32","9fc37d4a5ec412e32ede9d81f5db549b495203bed90bb8af07f7443de835c261","186a64c6d5131654cffe805b09e25d57ae8c06fa55ca0badab1cb81fdeb436ab","84d3a132b7ce4e2dc5c5d3737e3ff4e2cd7009bd34648dce16ce98355bbdf09f"],"error":null,"failed_index":null}},"request_hash":"7fa9ca667ba44c9bb18586c68174c39091e37104399603eae769180e6b05391d","submission_id":"T81-cd3e598e29eca3d8#1"},"hash":"8d93376c7c52d7c68518a281acf3f230fd9bbf081a330c2b70c5fb53cfc77776","header":{"body_hash":"cb9a615be4d91e9c34169f20250311385e92849c631c04b1268b056a62eddd02","format":"sbgk-session-log/3","previous":"bab7dab432e2a154e9abe51297613235f4fc850063f6e2e3b8e9b23a9a81ea34","records_root":"977fc1f5133317c9f6dcfb4ebd766f9507d552769651cc6f26e807c67ee9026e","seq":409,"wal_op":"audit"}}
{"body":{"actor":"w2","audit_root":"7b6e1e20c27811631a4ff5f214e62188cb2a271e3ed864d8c3ddff283c941f59","command":{"checkpoint":{"context":{"agent":"w2","circle":16,"circle_phase":"READ","kind":"EXTEND","link_task":null,"sync_step":31,"task_id":"T81-cd3e598e29eca3d8"},"from":0,"key":"task:doc:d_fa3701ce93fcc66c4295e04ec7b3872281e470d71ce102bb1c7df86bd76bea1b#1","to":0},"kind":"batch","operations":[]},"engine_root":"4fc4dd52524ba92f6afe2b1887ab72cb889511d6841cd30ccfe897fdcb6f1238","outcome":{"kind":"value","result":{"accepted_operations":0,"checkpointed":true,"error":null,"failed_index":null,"results":[]}},"request_hash":"fc84f45bd2b99f933258d4f701bc04faa92938d0aef5b2016110e40743626972","submission_id":"T81-cd3e598e29eca3d8#done2"},"hash":"780dfc7891d0a82e8ac6f75d2a09ec922d8fb2ab2075f56777ce5e87144fb41e","header":{"body_hash":"20c5f506d917f1d199c2238ae85b472976f685d7145378083080992c14af7c68","format":"sbgk-session-log/3","previous":"8d93376c7c52d7c68518a281acf3f230fd9bbf081a330c2b70c5fb53cfc77776","records_root":"fe7c90ca2214e168f5ffe6cccb15729c3b8a03c403e48c406441cd589fdd8c41","seq":410,"wal_op":"audit"}}
{"body":{"actor":"w4","audit_root":"eec3448554304286bcbc156f3b93b9dc750f242e51f5c2fec4f9c2a4ac454499","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T83-5eb036d2b9b0abfa","kind":"submit","lines":[{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Features listed here remain part of the specification but are scheduled for removal under the [feature lifecycle and deprecation policy](/community/feature-lifecycle).","kind":"observe","local_id":"t83_o1","terms":["deprecated features","removal schedule","feature lifecycle policy"]},{"as_of":null,"based_on":["t83_o1"],"kind":"claim","local_id":"t83_c1","object":"feature lifecycle and deprecation policy","predicate":"are scheduled for removal under","stance":"qualified","subject":"deprecated features","text":"Deprecated features remain part of the specification but are scheduled for removal under the feature lifecycle and deprecation policy."},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"These features remain fully functional during the deprecation window but new\n   implementations should not add support for them.","kind":"observe","local_id":"t83_o2","terms":["Roots","Sampling","Logging","deprecation window","implementations"]},{"as_of":null,"based_on":["t83_o2"],"kind":"claim","local_id":"t83_c2","object":"new implementations","predicate":"remain functional during deprecation window but should not be added by","stance":"superseded","subject":"Roots, Sampling, and Logging features","text":"Roots, Sampling, and Logging remain functional during their deprecation window, but new implementations should not add support for them."},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Reclassify the HTTP+SSE transport (deprecated since protocol version\n   `2025-03-26`) as Deprecated under the feature lifecycle policy","kind":"observe","local_id":"t83_o3","terms":["HTTP+SSE transport","reclassification","feature lifecycle policy"]},{"as_of":20250326,"based_on":["t83_o3"],"kind":"claim","local_id":"t83_c3","object":"feature lifecycle policy","predicate":"is reclassified as Deprecated under","stance":"superseded","subject":"HTTP+SSE transport","text":"The HTTP+SSE transport is reclassified as Deprecated under the feature lifecycle policy after being deprecated since protocol version 2025-03-26."},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Migrate to [Streamable HTTP](/specification/2026-07-28/basic/transports/streamable-http).","kind":"observe","local_id":"t83_o4","terms":["HTTP+SSE transport","Streamable HTTP","migration"]},{"as_of":null,"based_on":["t83_o4"],"kind":"claim","local_id":"t83_c4","object":"Streamable HTTP","predicate":"are instructed to migrate to","stance":"superseded","subject":"HTTP+SSE transport users","text":"Implementations using HTTP+SSE transport are directed to migrate to Streamable HTTP."},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Omit the field or use `\"none\"`; these values will be removed no later than\n   the Sampling feature itself.","kind":"observe","local_id":"t83_o5","terms":["includeContext","thisServer","allServers","removal schedule"]},{"as_of":null,"based_on":["t83_o5"],"kind":"claim","local_id":"t83_c5","object":"the Sampling feature itself","predicate":"will be removed no later than","stance":"superseded","subject":"includeContext values 'thisServer' and 'allServers'","text":"The includeContext values 'thisServer' and 'allServers' are deprecated and scheduled for removal no later than the Sampling feature itself."},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"Deprecate the OAuth 2.0 Dynamic Client Registration Protocol\n   ([RFC7591](https://datatracker.ietf.org/doc/html/rfc7591)) as a client registration\n   mechanism in favor of\n   [Client ID Metadata Documents](/specification/2026-07-28/basic/authorization/client-registration#client-id-metadata-documents)","kind":"observe","local_id":"t83_o6","terms":["OAuth 2.0 Dynamic Client Registration Protocol","RFC 7591","Client ID Metadata Documents","client registration"]},{"as_of":null,"based_on":["t83_o6"],"kind":"claim","local_id":"t83_c6","object":"Client ID Metadata Documents","predicate":"is deprecated in favor of","stance":"superseded","subject":"OAuth 2.0 Dynamic Client Registration Protocol (RFC7591)","text":"The OAuth 2.0 Dynamic Client Registration Protocol (RFC7591) is deprecated as a client registration mechanism in favor of Client ID Metadata Documents."},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"It remains available for backwards compatibility with authorization servers that do\n   not support Client ID Metadata Documents.","kind":"observe","local_id":"t83_o7","terms":["RFC 7591","backwards compatibility","authorization servers"]},{"as_of":null,"based_on":["t83_o7"],"kind":"claim","local_id":"t83_c7","object":"authorization servers not supporting Client ID Metadata Documents","predicate":"remains available for backwards compatibility with","stance":"qualified","subject":"RFC 7591 client registration","text":"RFC 7591 client registration remains available for backwards compatibility with authorization servers lacking Client ID Metadata Documents support."},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"`schema.json` now correctly reflects that the Typescript definition of minimum/maximum/default are `number`'s and not just `integers`.","kind":"observe","local_id":"t83_o8","terms":["schema.json","minimum","maximum","default","number type"]},{"as_of":null,"based_on":["t83_o8"],"kind":"claim","local_id":"t83_c8","object":"TypeScript definition of numbers rather than integers","predicate":"now correctly reflect","stance":"superseded","subject":"schema.json minimum, maximum, and default definitions","text":"schema.json now defines minimum, maximum, and default as numbers rather than integers in alignment with TypeScript definitions."},{"doc_id":"d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936","exact_quote":"defining the Active, Deprecated, and Removed feature states, a minimum\n   twelve-month deprecation window, and a\n   [registry of deprecated features](/specification/2026-07-28/deprecated)","kind":"observe","local_id":"t83_o9","terms":["feature lifecycle policy","feature states","twelve-month deprecation window","registry"]},{"as_of":null,"based_on":["t83_o9"],"kind":"claim","local_id":"t83_c9","object":"twelve-month deprecation window","predicate":"defines feature states and a minimum","stance":"reported","subject":"feature lifecycle and deprecation policy","text":"The feature lifecycle policy defines Active, Deprecated, and Removed states with a minimum twelve-month deprecation window and a registry."},{"about":["feature removal timeline","Roots","Sampling","Logging","HTTP+SSE transport","RFC 7591"],"kind":"question","local_id":"t83_q1","needed":"check later protocol revisions or deprecated features registry for removal dates","text":"When will deprecated features (Roots, Sampling, Logging, HTTP+SSE, RFC 7591) transition from Deprecated to Removed after their 12-month window?"}],"scope":{"docs":["d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936"],"ranges":[["d_e78b49b5f4912f5115eb9b9dbd5b8785bf919e27b2c1bfd2e93e784e7ef9a936",8411,11714]],"topic":null}},"engine_root":"c583ac7b603533db6ad5ac52c41896477012c9e69fea7ce32b208d3d35a415f1","outcome":{"kind":"records","result":{"accepted":["4ca828f032e9dfd76e76a860a176dad7b658e2dd7b10689cc13328d922157a4e","d50921b6a3ae39866f3cd85bc39ec330b6eb69425955a09bb43ec9eef05e1cd3","b4d6646990e10d1d31f61b5085980a6b10bd96c286c01da9b17b3caf44612964","42fc653958bda4e4500520479aa7b8e49d9a12c43ad9d685484534fb508130bb","05a455cb6b5c4e54e7c75865505d18fe887e9c6224936edfaa2b7d6d47c3d7b2","498e29a804c4c80be2d3975a3b7431498bfac2b91172bba2470a5d7be26dd5cd","86f543419f5f9d4df69d6d0c85bd594fe57c986ba069bbfbc3fa1e57f89f0a46","7402544b9b73fb63bb45c481ab41991fd0c77bd8f71ce47d6eb8eb35879e0266","fd8da75c8866f017226c86810e8693285aab17818378d3d1b220a24ca32cbe2e","734672d4609d6220b59f04f1adc0cd148fa598f049d42940c5cb76468d3529bc","81a98d97043ce86af9b79b6f6417f96c17faf2411c2860890007515820deef4e","6ad41717391c708f4111add04ad6a85846309dd1fc0b0016b54fd50f7ac894be","647dc2362d1ccec0c8a3b87b1951b4b5f4e406b7d8a23e63566583fe49e60ba7","3b4726ca4485fb61700ad9508ff98499a167227770b274244bb54512c8928ca9","951df18912389a6e6686b2ec43085d657e593e9610f3274a2e0a7ebc5be88933","60b8d0c82c42509e7c007acd14e3681251127dbc51b1f6b380d09151dd79ad5a","cfdc617c9ef8b257114b4f619af34c958d92d0c2e828867813ecb70f5ac0d895","76281e82230eba548d811a3be3bee3a83fa0afd63bd95098e3ca8558ae084efc","c965a7b2ddbac5feff873992da1e575d75dd24cc422a0c0bb11df9d0d3f448a0"],"error":null,"failed_index":null}},"request_hash":"c21b86a6beda71b46a5f563da1b675133db815eaa9981b927860113a0f52921b","submission_id":"T83-5eb036d2b9b0abfa#1"},"hash":"6b8feb5e29273f9576e43ceebb5ba8f8fbfb3c893408b3394ff662125385e764","header":{"body_h