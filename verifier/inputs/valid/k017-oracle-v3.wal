{"body":{"actor":"kernel","audit_root":"0304a6f0edd1a3d4a0851454a5c96a04ad17e92a59460cbe6fc0e6ec54a4b4c5","command":{"checkpoint":{"context":{"accepted":["@6f03161e0401c3cd","@47e867a693b828a6","@310784a1122188fa","@a428b435fcd62628","@c7a4a43f2ed68aac","@330214496a7eccd9","@20eb03ec9b048c29","@6e83581947b5fecf","@41c43083696f7828","@7d44f0db5b710422","@aff400730deb8acd","@8dcc0cd45a42845c","@4c217b98ff9c679e","@b3fc507e81d4cb65"],"attempt":1,"excluded":[{"index":12,"local_id":"t32_c3","rests_on":"t32_o4"},{"index":17,"local_id":"t32_c8","rests_on":"t32_o9"},{"index":18,"local_id":"t32_h1","rests_on":"t32_o7"}],"kind":"EXTEND","refused":[{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"Intermediate servers that do not recognize an `Mcp-Param-{Name}` header\n**MUST** forward it and otherwise ignore it, as required by the\n[HTTP Semantics RFC][http-semantics].","negation_before":"Intermediate servers that do not recognize an `Mcp-Param-{Name}` header","rule":"negation_before","suggested_exact_quote":"Intermediate servers that do not recognize an `Mcp-Param-{Name}` header\n**MUST** forward it and otherwise ignore it, as required by the\n[HTTP Semantics RFC][http-semantics].","suggested_span":{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","end_byte":22079,"start_byte":21906},"trailing_word":"the"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":3,"local_id":"t32_o4"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"When validating integer parameter values, servers **SHOULD** compare the\nheader value and the body value numerically rather than as strings (e.g.,\n`42.0` and `42` are considered equal).","rule":"ends_mid_clause","suggested_exact_quote":"When validating integer parameter values, servers **SHOULD** compare the\nheader value and the body value numerically rather than as strings (e.g.,\n`42.0` and `42` are considered equal).","suggested_span":{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","end_byte":24306,"start_byte":24121},"trailing_word":"the"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":6,"local_id":"t32_o7"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"header indicates a version that requires header–body validation. If the\nversion is older or the header is absent, the intermediary **SHOULD** reject\nthe request rather than trusting unvalidated header values.","rule":"ends_mid_clause","suggested_exact_quote":"header indicates a version that requires header–body validation. If the\nversion is older or the header is absent, the intermediary **SHOULD** reject\nthe request rather than trusting unvalidated header values.","suggested_span":{"doc_id":"d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530","end_byte":26554,"start_byte":26344},"trailing_word":"the"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":8,"local_id":"t32_o9"},{"error":{"code":"NO_EVIDENCE","expected_by_kernel":{"missing_identifiers":["42.0"]},"field":"based_on","message":"a claim names only identifiers its quotes hold: add a quote of this section that holds each one listed, or leave it out of the claim","obligation":null,"status":"error"},"index":15,"local_id":"t32_c6"}],"task_id":"T32-f5258f08f497b736","work_key":"doc:d_36ab192089a83fd6eabe5