 concurrency statement.","text":"Does any later revision make concurrent dual-era service (currently MAY) a requirement or remove it?"}],"scope":{"docs":["d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa"],"ranges":[["d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa",5784,11293]],"topic":null}},"engine_root":"0d465874c5aba70742e837a4d723aa15c4265da2979060de75c09e8dae4814fa","outcome":{"kind":"records","result":{"accepted":["453798179c9c4a6b284ba3fc746503bbc3d230226ca00e67053da316a8c5bdea","ca3774898b5e46022b051b158a2f0b902838249e8342624d26f66182849ec393","49ce61e6c4ba0573ed9c515510e47e995d1aac089e0106dc9a04b5c9c8c71c29"],"error":null,"failed_index":null}},"request_hash":"588e0b307f7c4b199a682d1f368f146f63f84364086cbc3e9577e6916b2f6976","submission_id":"TR39-027452cf14b782b8#1.1"},"hash":"a6ee02dc3e33f026330828f4d650ba37cd00176b24c4472f5958dc5f03f00a8a","header":{"body_hash":"7f2f47e2028c92852e82a1c004748cbeabc930c77483a585a818aa1468dc2e23","format":"sbgk-session-log/3","previous":"07a832386683018eae404901efb6f82ea0d8c81ddc53ca85e03fbeab63346547","records_root":"2932d3e791bdd74eb8fa5542ad00414daf554ca3f521be9f099e2dd35e339517","seq":177,"wal_op":"audit"}}
