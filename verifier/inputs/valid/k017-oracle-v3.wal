{"body":{"actor":"w2","audit_root":"6f5c56c3a0dcca8b7673d44bf5131c48dd9a42148238e3309b081a185dd5ac07","command":{"allowed_records":["055c3b232f4d91ca3898c658c421637b3ec6181635f6eec74ea53ca4449c86b5","0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","c8433f8a1df56a4154b6dd2ad7ffe98151da3db1f9ef0f33bcb40ad5bcf420ac","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"T20-95d8f5fbd544cfbb","kind":"submit","lines":[{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP clients **SHOULD** check for this capability and **MAY** fall back to Dynamic Client Registration","kind":"observe","local_id":"t20_o1","terms":["discovery fallback from Client ID Metadata Documents to DCR is optional"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"MCP clients **SHOULD** support an option for static client credentials such as those supplied by a preregistration flow. This could be:","kind":"observe","local_id":"t20_o2","terms":["preregistration support is a SHOULD for clients"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"This option is included for backwards compatibility with earlier versions of the MCP authorization spec.","kind":"observe","local_id":"t20_o3","terms":["DCR included only for backwards compatibility"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"to allow MCP clients to obtain OAuth client IDs without user interaction.","kind":"observe","local_id":"t20_o4","terms":["purpose of DCR: client IDs without user interaction"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"When implementing authorization flows, MCP clients **SHOULD** follow the principle of least privilege by requesting","kind":"observe","local_id":"t20_o5","terms":["least privilege scope request as a SHOULD"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"from the initial `WWW-Authenticate` header in the 401 response, if provided","kind":"observe","local_id":"t20_o6","terms":["first priority for scope selection is the WWW-Authenticate scope parameter"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"The `scopes_supported` field is intended to represent the minimal set of scopes necessary","kind":"observe","local_id":"t20_o8","terms":["scopes_supported intended as minimal basic-functionality set"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"with additional scopes requested incrementally through the step-up authorization flow steps","kind":"observe","local_id":"t20_o9","terms":["additional scopes via step-up flow, referenced to Scope Challenge Handling"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"This approach accommodates the general-purpose nature of MCP clients, which typically lack domain-specific knowledge to make informed decisions about individual scope selection.","kind":"observe","local_id":"t20_o10","terms":["rationale for requesting all available scopes"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"4. (Optional) Domain allowed via trust policy","kind":"observe","local_id":"t20_o11","terms":["optional domain trust check during metadata validation, policy undefined here"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"Cache metadata for future requests<br/>(respecting HTTP cache headers)","kind":"observe","local_id":"t20_o12","terms":["metadata caching respects HTTP cache headers, no duration given"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"\"client_id_metadata_document_supported\": true","kind":"observe","local_id":"t20_o13","terms":["AS metadata property advertising Client ID Metadata Document support"]},{"doc_id":"d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54","exact_quote":"This approach minimizes user friction while following the principle of least privilege.","kind":"observe","local_id":"t20_o14","terms":["claimed tradeoff of requesting all scopes"]},{"as_of":null,"based_on":["t20_o3","t20_o4"],"kind":"claim","local_id":"t20_c1","object":"optional backwards-compatibility path","predicate":"is retained as","stance":"qualified","subject":"Dynamic Client Registration","text":"DCR is a MAY and is kept only for backwards compatibility with earlier spec versions, qualifying its role relative to Client ID Metadata Documents."},{"as_of":null,"based_on":["t20_o1"],"kind":"claim","local_id":"t20_c2","object":"DCR or pre-registration","predicate":"SHOULD check capability and MAY fall back","stance":"qualified","subject":"MCP clients","text":"Clients SHOULD check the client_id_metadata_document_supported capability and MAY fall back to DCR or pre-registration when it is unavailable."},{"as_of":null,"based_on":["t20_o2"],"kind":"claim","local_id":"t20_c3","object":"static client credentials via preregistration","predicate":"SHOULD support","stance":"reported","subject":"MCP clients","text":"MCP clients SHOULD support static client credentials from a preregistration flow."},{"as_of":null,"based_on":["t20_o8","t20_o9"],"kind":"claim","local_id":"t20_c5","object":"minimal set for basic functionality","predicate":"is intended to represent","stance":"qualified","subject":"scopes_supported","text":"scopes_supported is meant to be a minimal basic set, with further scopes added incrementally via step-up, qualifying the request-all default."},{"as_of":null,"based_on":["t20_o10","t20_o14"],"kind":"claim","local_id":"t20_c6","object":"principle of least privilege","predicate":"minimizes user friction while following","stance":"reported","subject":"requesting all available scopes","text":"Requesting all available scopes is justified as minimizing user friction while following least privilege, a rationale the section asserts without further analysis."},{"as_of":null,"based_on":["t20_o11"],"kind":"claim","local_id":"t20_c7","object":"optional, policy not specified","predicate":"is","stance":"open","subject":"domain trust policy check","text":"The optional domain check via trust policy is left undefined in this section."},{"as_of":null,"based_on":["t20_o12"],"kind":"claim","local_id":"t20_c8","object":"HTTP cache headers, no duration given","predicate":"respects","stance":"open","subject":"Client ID Metadata Document cache","text":"Metadata caching follows HTTP cache headers, but no cache duration or refresh rule is stated."},{"as_of":null,"based_on":["t20_o13"],"kind":"claim","local_id":"t20_c9","object":"client_id_metadata_document_supported: true","predicate":"advertises support via","stance":"reported","subject":"authorization server metadata","text":"Authorization servers advertise Client ID Metadata Document support via a boolean property in their AS metadata."},{"based_on":["t20_o1","t20_o3"],"falsifier":"A later revision making DCR a MUST for authorization servers, or dropping the backwards-compatibility note without qualification.","kind":"hypothesis","local_id":"t20_h1","text":"DCR stays optional and legacy here, so a later revision could deprecate it or tighten its status, qualifying the current MAY."},{"about":["domain trust policy","Client ID Metadata Documents validation"],"kind":"question","local_id":"t20_q1","needed":"Check the Client ID Metadata Documents validation or security sections elsewhere in the spec for the trust policy definition.","text":"What defines the trust policy used for the optional domain check during Client ID Metadata Document validation?"},{"about":["metadata cache lifetime"],"kind":"question","local_id":"t20_q2","needed":"Check the Client ID Metadata Documents caching guidance and any HTTP caching requirements in the same spec version.","text":"How long may clients cache metadata documents, and how are refreshes handled beyond the HTTP cache headers?"},{"about":["Scope Challenge Handling","step-up authorization"],"kind":"question","local_id":"t20_q3","needed":"Read the Scope Challenge Handling section of the same authorization spec and compare with the scope priority rules here.","text":"The step-up scope handling referenced here is deferred; what does the Scope Challenge Handling section specify for incremental scope requests?"}],"scope":{"docs":["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54"],"ranges":[["d_34f79fc515679e3aad5c296e9d9d5778e565fdf5e53b905d53c0850fb198fe54",14801,19354]],"topic":null}},"engine_root":"df1882f2fb919532aab27311a2ec88aec21184b1e05c4ddd5dddacd574d846d8","outcome":{"kind":"records","result":{"accepted":["2717d31c36e57ba9b7fa1b953031cd1505934237892d537cbddfbfaae14edf9b","5e07011fb84567166767163dcbaeaa1f771bb0c883d5d32af1865b1207fe5649","76b5b0021a839f13f049bad24f931448ef6d40c5257d10b34e1b1d950f4ceb98","d12d439b1c86313c184931c6fb370280f4127aac9210fb474eb17aeb8c3e1465","f33a4047ff19ab955c03167483648189474c61913f912a7e4901d0f752f7b9c6","ea6cd43270cc619ee6d39ba1e4ec9caae3e1a5a5debe6c7b7a89dde5eeab8b78","03510373ef0f51bc76074934f443c26e94254e34339d3d76452682a2eaeba6d8","39772bfac5a81e3ec5588ed7cf0a4bddd9e9a84b38ff34265cf3b6ceea586cf6","cd8ba9248a4b6e0393e038ad79766931f9e4c72bf5728c5bdd4bb44d0a00eab9","0df90ecba9980a0b