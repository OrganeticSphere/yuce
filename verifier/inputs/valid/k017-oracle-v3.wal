:"t41_o11"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"probe with `server/discover` and fall back on any error that is not a\n  recognized modern error.","rule":"ends_mid_clause","suggested_exact_quote":"probe with `server/discover` and fall back on any error that is not a\n  recognized modern error.","suggested_span":{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","end_byte":4677,"start_byte":4581},"trailing_word":"a"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":11,"local_id":"t41_o13"},{"error":{"code":"BAD_FIELD","expected_by_kernel":{"exact_bytes_in_section":"process (stdio) or origin (HTTP), and **MAY** persist it across restarts of\nthe same server configuration, re-probing if the cached assumption later\nfails.","rule":"ends_mid_clause","suggested_exact_quote":"process (stdio) or origin (HTTP), and **MAY** persist it across restarts of\nthe same server configuration, re-probing if the cached assumption later\nfails.","suggested_span":{"doc_id":"d_39bd634003813aff0451340f032539c02df334ef4f7b8a8958dbeef0bd1ee6aa","end_byte":5483,"start_byte":5328},"trailing_word":"of"},"field":"exact_quote","message":"a quote keeps the clause it belongs to: quote from the start of the sentence when it negates what follows, and to the end of the clause when the quote ends on a word like 'from' or 'with'","obligation":null,"status":"error"},"index":14,"local_id":"t41_o16"},{"error":{"code":"NO_EVIDENCE","expected_by_kernel":{"missing_identifiers":["UnsupportedProtocolVersionError"]},"field":"based_on","message":"a claim names only identifiers its quotes hold: add a quote of this section that holds each one listed, or leave it out of the claim","obligation":null,"status":"error"},"index":19,"local_i