{"body":{"actor":"w1","audit_root":"2c41325f1b0b0a43baa499c244e597fe064dbe382f0b065b7f7fc4d330c30099","command":{"allowed_records":["0c885f8470b25ebc51ca36f0f4f71018d6629a236e1f6a39a44d0602f73e5234","30b42a7ab9212b145c26f8c3152765d0ba3af8c5c020549baecd1d39ce47c3f4","30d75310ba2bad3440c9def6f6c7440e10fb0f2207a2e4b6988cb09b04e3db91","399b4b685f545ff205588b497f5477cb14da443874d8c3bf084e061f8a65e49a","3a2f36073d683624bd9f06eef7e4a1fa227212e198efbf74274040a652e4c6ff","63ce29418b3e97097f4c4bbaa7d41fe413c01a8b153b1416b04ba6a71f5e028b","6ca6665902277bc7a80dca0e5b2f93e1864409a7c11629686cc7bebe27acca7d","76f502a4467387cf1b20986139e5b7161f6c6ec4bf2369089e98440ac3fe68a8","8599201b97088cc4f0ffaade38e4e5019522853c782930f3cd8c6b365549c2fa","b57ad2fc70004f64ca8630d261d42642ea3533a01cbd708cbc2b8c0c3755afb4","bb4a5f59d822ad177ec3ce946ebe0b9bea40d6a0e6affa45895c672741758b02","f9b13ccee8f191b798c3d14c9931c1efc4ca0b830a1b81f22055d85becb402bd"],"directive":"TR46-1c17e380aa68cb97","kind":"submit","lines":[{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"MCP clients **MUST** send this parameter regardless of whether authorization servers support it.","kind":"observe","local_id":"t46_o1","terms":["resource parameter","RFC 8707","client obligation"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"MCP clients **SHOULD** provide the most specific URI that they can for the MCP server they intend to access","kind":"observe","local_id":"t46_o2","terms":["canonical server URI","specificity","SHOULD"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"implementations **SHOULD** accept uppercase scheme and host components for robustness and interoperability","kind":"observe","local_id":"t46_o3","terms":["canonical URI","case handling","robustness"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"implementations **SHOULD** consistently use the form without the trailing slash for better interoperability","kind":"observe","local_id":"t46_o4","terms":["trailing slash","canonical URI","interoperability"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Note that authorization **MUST** be included in every HTTP request from client to server.","kind":"observe","local_id":"t46_o6","terms":["authorization header","every request"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"2. Access tokens **MUST NOT** be included in the URI query string","kind":"observe","local_id":"t46_o7","terms":["access token","query string","prohibition"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"MCP servers **MUST** validate that access tokens were issued specifically for them as the intended audience,","kind":"observe","local_id":"t46_o8","terms":["audience validation","resource server","RFC 8707"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"Invalid or expired tokens **MUST** receive a HTTP 401","kind":"observe","local_id":"t46_o9","terms":["invalid token","expired token","HTTP 401"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"MCP clients **MUST NOT** send tokens to the MCP server other than ones issued by the MCP server's authorization server.","kind":"observe","local_id":"t46_o10","terms":["token provenance","client obligation"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"MCP servers **MUST NOT** accept or transit any other tokens.","kind":"observe","local_id":"t46_o11","terms":["token acceptance","transit","prohibition"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"**MUST NOT** assume refresh tokens will be issued; the AS retains discretion","kind":"observe","local_id":"t46_o12","terms":["refresh token","authorization server discretion"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"| 403         | Forbidden    | Invalid scopes or insufficient permissions |","kind":"observe","local_id":"t46_o14","terms":["HTTP 403","scope errors","error table"]},{"doc_id":"d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d","exact_quote":"This section covers handling insufficient scope errors during runtime operations when","kind":"observe","local_id":"t46_o15","terms":["scope challenge","runtime operations","insufficient scope"]},{"as_of":null,"based_on":["t46_o1"],"kind":"claim","local_id":"t46_c1","object":"resource parameter","predicate":"MUST be sent by clients regardless of AS support","stance":"reported","subject":"resource parameter on authorization requests","text":"MCP clients MUST send the RFC 8707 resource parameter on authorization requests regardless of whether authorization servers support it."},{"as_of":null,"based_on":["t46_o2","t46_o3","t46_o4"],"kind":"claim","local_id":"t46_c2","object":"canonical server URI","predicate":"SHOULD be most specific, case-tolerant, slash-free","stance":"qualified","subject":"canonical server URI form","text":"Clients SHOULD provide the most specific canonical server URI they can, and implementations SHOULD accept uppercase scheme/host and consistently omit trailing slashes."},{"as_of":null,"based_on":["t46_o6","t46_o7"],"kind":"claim","local_id":"t46_c4","object":"HTTP requests","predicate":"MUST be present in header and MUST NOT be in query string","stance":"reported","subject":"authorization header and token placement","text":"Authorization MUST be included in every HTTP request from client to server, and access tokens MUST NOT appear in the URI query string."},{"as_of":null,"based_on":["t46_o10","t46_o11"],"kind":"claim","local_id":"t46_c6","object":"tokens from other issuers","predicate":"MUST NOT be violated by sending, accepting or transiting foreign tokens","stance":"reported","subject":"token provenance","text":"Clients MUST NOT send tokens other than those issued by the server's authorization server, and servers MUST NOT accept or transit any other tokens."},{"as_of":null,"based_on":["t46_o14","t46_o9"],"kind":"claim","local_id":"t46_c8","object":"401/403/400 mapping","predicate":"MUST be returned as","stance":"reported","subject":"authorization error status codes","text":"Authorization errors map to HTTP 401 (authorization required or invalid token), 403 (invalid scopes or insufficient permissions) and 400 (malformed authorization request)."},{"about":["OAuth 2.1 draft status","token requirements"],"kind":"question","local_id":"t46_q1","needed":"Check later revisions of this authorization section for RFC citations replacing the draft links.","text":"Does any later revision replace the draft-ietf-oauth-v2-1-13/-14 citations with a final OAuth 2.1 RFC, and if so do the token requirements change?"},{"about":["canonical server URI","optionality"],"kind":"question","local_id":"t46_q2","needed":"Compare later revisions of the Canonical Server URI subsection for requirement-strength changes.","text":"Are the SHOULD-level canonical URI rules (specificity, uppercase acceptance, trailing slash) tightened to MUST in later revisions?"}],"scope":{"docs":["d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d"],"ranges":[["d_3bcac267170918a3c71fa359fb054f85c896015d8dbca609854b53c88d2ff29d",14820,20184]],"topic":null}},"engine_root":"2bd3131bd73e1558e9a8be78016fac5264af11d85ae48c396851a578ce6947d1","outcome":{"kind":"records","result":{"accepted":["a0a5dee7a2c281b823d0bb70014a28781e6282cf48b8d18f69c21c8328b80ef4","17d4d44a01c463c8ec09a25f2d1e8123c30c179e73240dcae6ef0999e99dab56","fd7ad7ef96bd77338824b68c7c366c653e3acec5178c93ea9090e8c6031d13f3","982cc0d6f02625a2bb46706ea8abba94ee6508bf6c75298d54f75bdbf44c0788","009697c09b3ab81314ac2d544f726cfc6f648625f0713146e5f1374838625911","8404d2