,"kind":"claim","local_id":"t29_c5","object":"long-lived streams","predicate":"are encouraged on","stance":"qualified","subject":"SSE keep-alive comment lines","text":"Servers are encouraged, not required, to send SSE comment keep-alive lines on long-lived streams; clients must ignore them."},{"as_of":null,"based_on":["t29_o5","t29_o6"],"kind":"claim","local_id":"t29_c6","object":"cancellation of that request","predicate":"MUST be treated as","stance":"reported","subject":"closing the SSE response stream","text":"Closing the SSE response stream MUST be treated by the server as cancellation of that request; the server SHOULD stop work and MUST NOT send further messages for it."},{"as_of":null,"based_on":["t29_o7","t29_o10"],"kind":"claim","local_id":"t29_c7","object":"the subscriptions/listen stream","predicate":"are not delivered on","stance":"reported","subject":"request-scoped notifications","text":"Request-scoped notifications such as progress and message are not delivered on the subscriptions/listen stream; they flow only on the originating request's response stream."}],"scope":{"docs":["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530"],"ranges":[["d_36ab192089a83fd6eabe54d7808ec33520aa72f22c33d5866c34b0aebcb7a530",4380,10358]],"topic":null}},"engine_root":"895c9fa26dd7f03c379f25184e72738874fdb2ed5691ced7ae094c67d738755d","outcome":{"kind":"records","result":{"accepted":["c3df64358abbd0119f58b661fb51afa2d115911f388e37d088e25578768f5bc8","1693f5dff9a56461d528584736a01c7d0685db62d91c6f4dc2953527332f2935","fc618f62ed3981c7323f2e1e21de1319ec38ec15f1663377915c02cb04ef9659","3d43b6ef9c905911c3f621ecca85064e1b32ddf983313cb3da15fd98fcf0e66f","5449d6db4b624a1589b03d71662945385c998dd7d3143c6f4160558ac51729e4","4aca91d18f939f409a638d93054c7476935767d4068db0d5df2613e9567ddee0"],"error":null,"failed_index":null}},"request_hash":"1e1efcd451c61f3d4cb80e4b7c38d960d5a5f3748307badf961831d228636f3a","submission_id":"T29-64933bc2769416a0#2"},"hash":"255cfa8eb8ab6